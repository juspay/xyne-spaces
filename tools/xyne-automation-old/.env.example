# Environment Configuration
# TEST_ENV determines the default values for all settings below
# Valid values: local, test, sbx, prod
TEST_ENV=local

# =====================================================
# OPTIONAL OVERRIDES
# Uncomment and set values below to override defaults
# =====================================================

# Backend API URL
# Defaults: local/test=http://localhost:3001, sbx=https://sbx-api.xyne.com, prod=https://api.xyne.com
# BACKEND_URL=http://localhost:3001

# Dashboard URL
# Defaults: local/test=http://localhost:5173, sbx=https://sbx-dashboard.xyne.com, prod=https://dashboard.xyne.com
# DASHBOARD_URL=http://localhost:5173

# Browser Type (chromium, firefox, webkit)
# Default: chromium
# BROWSER=chromium

# Headless Mode
# Defaults: local=false, test/sbx/prod=true
# HEADLESS=false

# Retry count for failed tests
# Defaults: 0 locally, 2 in CI
# RETRIES=0

# Timeout in milliseconds (default: 30000)
# TIMEOUT=30000

# CI mode (auto-detected from CI environment)
# CI=true


# ============================================
# Authentication Configuration
# ============================================

# Google Access Token for bypassing OAuth login
# Instructions to get your token:
# 1. Open Xyne-Space in your browser
# 2. Login with Google
# 3. Open Developer Tools (F12) → Application tab → Cookies
# 4. Find and copy the 'google_access_token' cookie value
# 5. Paste it below
GOOGLE_ACCESS_TOKEN=your-google-access-token

# Juspay API Key for test-automate.sh
# Uncomment and add your API key below
JUSPAY_API_KEY=your_api_key_here

# LiteLLM base URL (default: https://grid.ai.example.com)
LITELLM_BASE_URL=https://grid.ai.example.com

# --- Referenced in code but missing (env normalization); secrets empty ---
BACKEND_URL=
BASE_URL=
BRANCH_NAME=
BROWSER=
BUILD_NUMBER=
CUSTOM_REPORT_NAME=
DASHBOARD_URL=
ENABLE_BROWSER_CONSOLE_LOGS=
EXECUTOR_NUMBER=
HEADLESS=
OUTPUT_MODE=
PROJECT_ROOT=
REPORT_TIMESTAMP=
RETRIES=
STAGE_NAME=
TIMEOUT=
