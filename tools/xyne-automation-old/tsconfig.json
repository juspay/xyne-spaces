{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "./",
    "paths": {
      "@/*": ["./*"],
      "@/config": ["./config/index"],
      "@/fixtures/*": ["./fixtures/*"],
      "@/lib/*": ["./lib/*"]
    },
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "config/**/*.ts",
    "lib/**/*.ts",
    "tests/**/*.ts",
    "fixtures/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
