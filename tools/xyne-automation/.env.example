# Environment selection
# Valid values: local, local-test, test, sbx, prod
TEST_ENV=local

# Optional service overrides
# BACKEND_URL=http://localhost:3001
# DASHBOARD_URL=http://localhost:5173

# Runtime defaults
TIMEOUT=30000
RETRIES=3

# Optional browser-related flags for future use
# BROWSER=chrome
# HEADLESS=false
# ENABLE_BROWSER_CONSOLE_LOGS=false

