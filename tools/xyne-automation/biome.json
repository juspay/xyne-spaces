{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "files": {
    "includes": ["**", "!.gauge", "!**/reports", "!**/playwright-report", "!dist", "!node_modules"]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:"],
              [":PACKAGE:"],
              ["@/config", "@/config/**"],
              ["@/lib", "@/lib/**"],
              ["@/fixtures", "@/fixtures/**"],
              ["@/tests", "@/tests/**"],
              ["./*", "../*", "./**", "../**"]
            ],
            "identifierOrder": "natural"
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    },
    "globals": [
      "Buffer",
      "console",
      "process",
      "setInterval",
      "setTimeout",
      "clearInterval",
      "clearTimeout"
    ]
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsole": "error",
        "noDebugger": "error"
      },
      "correctness": {
        "noUnusedImports": "error"
      },
      "style": {
        "useNodejsImportProtocol": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../*", "./*"],
                "message": "Relative imports are not allowed. Use @ path aliases instead."
              }
            ]
          }
        }
      }
    }
  }
}
