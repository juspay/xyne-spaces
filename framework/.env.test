# LLM Module Integration Test Environment Variables
# Using Application Default Credentials from gcloud CLI

# Your Google Cloud Project ID
VERTEX_PROJECT_ID=dev-ai-epsilon

# Using ADC (gcloud auth application-default login)
# Since you're authenticated via gcloud CLI, we'll use ADC instead of key file
VERTEX_USE_ADC=true

# Vertex AI region
VERTEX_REGION=us-east5

# Test configuration
TEST_TIMEOUT=30000
DEBUG=true