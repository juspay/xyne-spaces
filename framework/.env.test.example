# Example environment variables for LLM module testing
# Copy this file to .env.test and fill in your actual values

# Vertex AI Configuration
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_KEY_FILE=path/to/your/service-account-key.json
VERTEX_REGION=us-central1

# Test Configuration
TEST_TIMEOUT=30000

# Optional: Enable debug logging during tests
DEBUG=true
