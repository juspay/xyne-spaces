    "format": "prettier --write \"src/**/*.{js,ts,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "description": "A modular, extensible agentic AI framework built in TypeScript",
