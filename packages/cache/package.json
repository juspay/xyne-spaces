{
  "name": "@xyne/cache",
  "version": "0.1.0",
  "description": "Whole-snapshot refreshing keyed map for Xyne Node.js services (zero deps)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "tsc && node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.7.0"
  }
}
