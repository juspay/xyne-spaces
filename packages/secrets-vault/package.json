{
  "name": "@xyne/secrets-vault",
  "version": "1.0.0",
  "type": "module",
  "description": "Central store for long-lived s2s secrets (GCP SA keys, etc.) with versioning and rotation cutover, backed by SecretDefinition/SecretVersion in the non_zero schema",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
