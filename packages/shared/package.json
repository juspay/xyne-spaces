{
  "name": "@xyne/shared",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared code between dashboard and backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sdlc": {
      "types": "./dist/sdlc.d.ts",
      "import": "./dist/sdlc.js",
      "default": "./dist/sdlc.js"
    },
    "./zero": {
      "types": "./dist/zero/index.d.ts",
      "import": "./dist/zero/index.js",
      "default": "./dist/zero/index.js"
    },
    "./zero/queries": {
      "types": "./dist/zero/queries.d.ts",
      "import": "./dist/zero/queries.js",
      "default": "./dist/zero/queries.js"
    },
    "./zero/mutators": {
      "types": "./dist/zero/mutators.d.ts",
      "import": "./dist/zero/mutators.js",
      "default": "./dist/zero/mutators.js"
    },
    "./zero/messageMetadata": {
      "types": "./dist/zero/messageMetadata.d.ts",
      "import": "./dist/zero/messageMetadata.js",
      "default": "./dist/zero/messageMetadata.js"
    },
    "./zero/ticketMetadata": {
      "types": "./dist/zero/ticketMetadata.d.ts",
      "import": "./dist/zero/ticketMetadata.js",
      "default": "./dist/zero/ticketMetadata.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./machines": {
      "types": "./dist/machines/index.d.ts",
      "import": "./dist/machines/index.js",
      "default": "./dist/machines/index.js"
    },
    "./messages": {
      "types": "./dist/messages/index.d.ts",
      "import": "./dist/messages/index.js",
      "default": "./dist/messages/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js",
      "default": "./dist/platform/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js",
      "default": "./dist/logger/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./automations/variable-ref": {
      "types": "./dist/automations/variable-ref.d.ts",
      "import": "./dist/automations/variable-ref.js",
      "default": "./dist/automations/variable-ref.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "watch": "tsc --watch",
    "test": "tsc && node --test \"test/*.test.mjs\"",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@rocicorp/zero": "1.9.0",
    "@standard-schema/spec": "^1.1.0",
    "fast-xml-parser": "^5.10.1",
    "fuse.js": "^7.1.0",
    "uuid": "^14.0.0",
    "xstate": "^5.24.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "@xstate/react": ">=4.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@xstate/react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@tanstack/react-query": "^5.96.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.0",
    "@types/uuid": "^8.3.4",
    "@xstate/react": "^6.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.3.3"
  }
}
