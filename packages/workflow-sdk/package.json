{
  "name": "@xyne/workflow-sdk",
  "version": "3.2.62",
  "description": "Workflow engine SDK \u2014 steps, triggers, executor, agents, and a framework-agnostic HTTP router.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@ssh.bitbucket.juspay.net/xyne/xyne-spaces.git",
    "directory": "packages/workflow-sdk"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/authz-conformance": {
      "types": "./dist/testing/authz-conformance.d.ts",
      "import": "./dist/testing/authz-conformance.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./agents/host": {
      "types": "./dist/agents/host.d.ts",
      "import": "./dist/agents/host.js"
    },
    "./runtime": {
      "types": "./dist/runtime/types.d.ts",
      "import": "./dist/runtime/types.js"
    },
    "./router": {
      "types": "./dist/router/types.d.ts",
      "import": "./dist/router/types.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js"
    },
    "./expression": {
      "types": "./dist/expression/index.d.ts",
      "import": "./dist/expression/index.js"
    },
    "./conversational-flow": {
      "types": "./dist/conversational-flow/index.d.ts",
      "import": "./dist/conversational-flow/index.js"
    },
    "./ai-builder": {
      "types": "./dist/ai-builder/index.d.ts",
      "import": "./dist/ai-builder/index.js"
    },
    "./ai-builder/server": {
      "types": "./dist/ai-builder/server.d.ts",
      "import": "./dist/ai-builder/server.js"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.79.0",
    "@earendil-works/pi-ai": ">=0.79.0",
    "@earendil-works/pi-coding-agent": ">=0.79.0",
    "typebox": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "jsonata": "^2.2.2",
    "undici": "^7.30.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.79.0",
    "@earendil-works/pi-ai": "^0.79.0",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.1",
    "typebox": "^1.1.38",
    "typescript": "^5.8.0",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
