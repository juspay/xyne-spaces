{
  "name": "@xyne/spaces-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Xyne Spaces API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "src/exclusions.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:catalog-scopes": "node scripts/generate-catalog-scopes.mjs",
    "coverage": "node scripts/generate-catalog-scopes.mjs --check && node scripts/coverage.mjs",
    "verify": "npm run typecheck && npm run coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "xyne",
    "spaces",
    "sdk",
    "api",
    "client"
  ],
  "author": "Xyne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xyne/xyne-spaces.git",
    "directory": "packages/xyne-spaces-sdk"
  }
}
