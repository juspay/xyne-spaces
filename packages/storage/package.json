{
  "name": "@xyne/storage",
  "version": "1.0.0",
  "type": "module",
  "description": "Provider-agnostic object storage (GCS, S3 or Azure Blob, selected by config) shared by the backend, claw and dashboard-edge apps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "@aws-sdk/lib-storage": "3.1017.0",
    "@aws-sdk/s3-request-presigner": "3.1097.0",
    "@azure/identity": "4.13.2",
    "@azure/storage-blob": "12.33.0",
    "@google-cloud/storage": "7.21.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/uuid": "9.0.8",
    "typescript": "5.9.3"
  }
}
