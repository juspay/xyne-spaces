{
  "name": "@xyne/workflow-ui",
  "version": "1.3.62",
  "description": "Workflow builder + execution-viewer React UI for @xyne/workflow-sdk.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@ssh.bitbucket.juspay.net/xyne/xyne-spaces.git",
    "directory": "packages/workflow-ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc && tailwindcss -i src/styles.css -o dist/styles.css --minify && node scripts/scope-css.mjs && node scripts/wrap-css-layer.mjs",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": ">=6.20.0",
    "@codemirror/lang-javascript": ">=6.2.0",
    "@codemirror/state": ">=6.0.0",
    "@codemirror/theme-one-dark": ">=6.1.0",
    "@codemirror/view": ">=6.43.0",
    "@tanstack/react-query": ">=5.0.0",
    "@uiw/react-codemirror": ">=4.25.0",
    "@xyne/workflow-sdk": ">=3.2.54",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.2",
    "@tiptap/extension-link": "^2",
    "@tiptap/pm": "^2",
    "@tiptap/react": "^2",
    "@tiptap/starter-kit": "^2",
    "@xyflow/react": "^12.0.0",
    "clsx": "^2.0.0",
    "docx-preview": "^0.3.7",
    "lucide-react": "^0.456.0",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "5.4.296",
    "react-markdown": "^9.1.0",
    "read-excel-file": "^6.0.1",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.0",
    "tiptap-markdown": "^0.8",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.0.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.1",
    "@xyne/workflow-sdk": "file:../workflow-sdk",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
