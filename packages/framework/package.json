    "@types/node": "^22.15.3",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "10.1.2",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "2.31.0",
    "globals": "16.0.0",
    "jest": "29.7.0",
    "prettier": "3.5.3",
    "ts-jest": "^29.1.0",
    "tsx": "^4.20.4",
    "typescript": "5.8.3",
