#!/usr/bin/env sh


echo "Running pre-commit checks..."

exec < /dev/tty

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- Secret scanning (fail fast, before expensive build checks) ---------------
# Scans ONLY staged changes so no secret can be committed by accident.
# Config: .gitleaks.toml  | Accepted findings: .gitleaksignore
echo "🔐 Scanning staged changes for secrets (gitleaks)..."
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --redact --no-banner \
        --config "$REPO_ROOT/.gitleaks.toml" \
        --gitleaks-ignore-path "$REPO_ROOT/.gitleaksignore"; then
    echo ""
    echo "❌ gitleaks found a potential secret in your staged changes. Commit blocked."
    echo "   • If it's a real secret: remove it, use an env var / secret manager."
    echo "   • If it's a verified false positive: add its fingerprint to .gitleaksignore"
    echo "     (get it reviewed — see comments in that file)."
    exit 1
  fi
  echo "✅ No secrets detected in staged changes."
else
  echo "⚠️  gitleaks not installed — SKIPPING secret scan."
  echo "   Install it: brew install gitleaks   (https://github.com/gitleaks/gitleaks)"
fi

# Get list of changed files
CHANGED_FILES=$(git diff --cached --name-only)

# Check if backend files are changed
BACKEND_CHANGED=$(echo "$CHANGED_FILES" | grep '^backend/' || true)

# Check if dashboard files are changed
DASHBOARD_CHANGED=$(echo "$CHANGED_FILES" | grep '^dashboard/' || true)

# Check if xyne-automation files are changed
AUTOMATION_CHANGED=$(echo "$CHANGED_FILES" | grep '^xyne-automation/' || true)

# Backend checks (only if backend files changed)
if [ -n "$BACKEND_CHANGED" ]; then
  echo "🔧 Checking backend (backend files changed)..."
  cd "$REPO_ROOT/backend"

  echo "Running backend typecheck..."
  npm run typecheck || exit 1

  echo "Running backend build..."
  npm run build || exit 1
else
  echo "⏭️  Skipping backend checks (no backend files changed)"
fi

# Dashboard checks (only if dashboard files changed)
if [ -n "$DASHBOARD_CHANGED" ]; then
  echo "🎨 Checking dashboard (dashboard files changed)..."
  cd "$REPO_ROOT/dashboard"

  echo "Running dashboard lint (errors only)..."
  npm run lint:errors-only || exit 1

  echo "Running dashboard build..."
  npm run validate || exit 1
else
  echo "⏭️  Skipping dashboard checks (no dashboard files changed)"
fi

# Automation checks (only if xyne-automation files changed)
if [ -n "$AUTOMATION_CHANGED" ]; then
  echo "🤖 Checking automation (xyne-automation files changed)..."
  cd "$REPO_ROOT/xyne-automation"

  echo "Running automation validate..."
  npm run validate || exit 1
else
  echo "⏭️  Skipping automation checks (no xyne-automation files changed)"
fi

# If no relevant files changed, still run a basic check
if [ -z "$BACKEND_CHANGED" ] && [ -z "$DASHBOARD_CHANGED" ] && [ -z "$AUTOMATION_CHANGED" ]; then
  echo "ℹ️  No backend or dashboard files changed, running basic dashboard check..."
  cd "$REPO_ROOT/dashboard"
  npm run lint:errors-only || exit 1
fi

# Run service change analysis (ensure we're in repo root)
echo "Running service change analysis..."
cd "$REPO_ROOT"
bash scripts/change-analysis.sh || exit 1

# Run schema-migration validation for all schema files
echo "Running schema-migration validation..."
bash scripts/validate-schema-migrations.sh || exit 1

# Enum guard: block new Postgres enums / CREATE TYPE / ALTER TYPE (XYNE-16525)
echo "Running enum guard..."
npm run test:enum || exit 1

echo ""
echo "✅ All pre-commit checks passed!"
