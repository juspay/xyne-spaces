#!/usr/bin/env sh

BRANCH_NAME=$(git branch --show-current)
REMOTE="$1"

REQUIRED_PATTERN="^(fix|feature)\/.+$"
TEMP_BRANCH_PATTERN="\-test-reports$"

# Block direct push to temp report branches
if echo "$BRANCH_NAME" | grep -qE "$TEMP_BRANCH_PATTERN"; then
  echo ""
  echo "🛑 \033[1;31mPush rejected: Cannot push directly to a test-reports branch.\033[0m"
  echo ""
  echo "   Temp branches ending with '-test-reports' are reserved for automated test report flow."
  echo "   They are created automatically by the post-commit hook and deleted by Jenkins after processing."
  echo ""
  echo "   \033[1;33mTo rename your branch:\033[0m"
  echo "      git branch -m ${BRANCH_NAME} ${BRANCH_NAME%-test-reports}"
  echo ""
  exit 1
fi

if ! echo "$BRANCH_NAME" | grep -qE "$REQUIRED_PATTERN"; then
  echo "Branch naming validation failed!"
  echo "Branch name: '$BRANCH_NAME'"
  echo "Required pattern: (fix|feature)/(name)"
  echo "Please rename your branch using: git branch -m $BRANCH_NAME (fix|feature)/(name)"
  exit 1
fi

exit 0
