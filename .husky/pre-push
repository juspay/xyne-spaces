BRANCH_NAME=$(git branch --show-current)
LAST_COMMIT_MSG=$(git log -1 --format=%s)
REMOTE="$1"

REQUIRED_PATTERN="^(fix|feature)\/.+$"

if [[ ! $BRANCH_NAME =~ $REQUIRED_PATTERN ]]; then
  echo "Branch naming validation failed!"
  echo "Branch name: '$BRANCH_NAME'"
  echo "Required pattern: (fix|feature)/(name)"
  echo "Please rename your branch using: git branch -m $BRANCH_NAME (fix|feature)/(name)"
  exit 1
fi

if echo "$LAST_COMMIT_MSG" | grep -q "added automation test reports"; then
  echo ""
  echo "🛑 \033[1;31mPush rejected: preventing accidental push of temporary report commit.\033[0m"
  echo ""
  echo "   To push the report and automatically revert the temporary commit (restoring clean branch), run:"
  echo ""
  echo "   👉 \033[1;33mgit push $REMOTE $BRANCH_NAME --no-verify\033[0m && \033[1;33mgit reset --hard HEAD~1\033[0m"
  echo "   \033[0;37m(Only add --force if necessary)\033[0m"
  echo ""
  exit 1
fi

exit 0