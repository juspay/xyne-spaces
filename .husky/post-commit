#!/usr/bin/env sh

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN_BOLD='\033[1;36m'
NC='\033[0m' # No Color

# Non-interactive control (for agents / CI):
#   XYNE_RUN_TESTS=0 or CI=1 → skip tests silently
#   XYNE_RUN_TESTS=1         → run tests without prompting
#   unset + TTY available    → prompt as before
#   unset + no TTY           → skip with a helpful message
if [ "$XYNE_RUN_TESTS" = "0" ] || [ -n "$CI" ]; then
    exit 0
fi

RUN_TESTS=false

if [ "$XYNE_RUN_TESTS" = "1" ]; then
    RUN_TESTS=true
elif ( exec </dev/tty ) 2>/dev/null; then
    exec < /dev/tty

    echo ""
    echo "🧪 ${CYAN_BOLD}Run automation tests now?${NC}"
    echo "   ${YELLOW}(Running tests locally is faster and more reliable than waiting for Jenkins)${NC}"
    echo ""
    printf "   Run tests? [Y/n] "
    read -r response

    case "$response" in
        [yY][eE][sS]|[yY]|"")
            echo "   ${GREEN}Running tests...${NC}"
            RUN_TESTS=true
            ;;
        *)
            echo "   ${YELLOW}Skipping tests.${NC}"
            echo ""
            echo "   ${BLUE}You can retrigger this flow later by running:${NC}"
            echo "      npm run test && npm run test:push"
            echo ""
            exit 0
            ;;
    esac
else
    echo ""
    echo "ℹ️  Non-interactive shell — skipping post-commit test prompt."
    echo "   Set XYNE_RUN_TESTS=1 to run automation tests, or XYNE_RUN_TESTS=0 (or CI=1) to silence this message."
    echo "   Run later with: npm run test && npm run test:push"
    exit 0
fi

if [ "$RUN_TESTS" = "true" ]; then
  echo ""
  echo "🔒 Verifying test code integrity..."
  if ! npm run test:integrity; then
      echo "❌ Test code integrity check failed!"
      echo "   Please ensure your test code is in sync with main."
      exit 1
  fi

  echo ""
  echo "🧪 Running automation tests..."
  echo "   (This may take several minutes...)"
  echo ""

  if npm run test; then
    echo ""
    echo "✅ Tests completed successfully!"

    echo ""
    echo "📤 Pushing test reports to remote for Jenkins processing..."
    npm run test:push
  else
    echo ""
    echo "⚠️  Tests completed with failures."
    echo "❌ Skipping push — automation tests did not pass."
    echo ""
    echo "   ${BLUE}You can retrigger this flow later by running:${NC}"
    echo "      npm run test && npm run test:push"
    echo ""
    exit 1
  fi
fi
