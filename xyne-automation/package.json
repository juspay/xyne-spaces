{
  "name": "xyne-automation",
  "version": "1.0.0",
  "description": "automation testing framework for xyne-spaces",
  "main": "index.js",
  "scripts": {
    "test": "npx cucumber-js",
    "test:api": "npx cucumber-js --profile api",
    "test:ui": "npx cucumber-js --profile ui",
    "test:e2e": "npx cucumber-js --profile e2e",
    "test:debug": "NODE_OPTIONS='--inspect' npx cucumber-js --format progress",
    "clean": "rm -rf report/*",
    "lint": "eslint . && npm run type-check",
    "type-check": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "Ameer Noufil <ameer.noufil@juspay.com>",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^12.5.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/chai": "^5.2.3",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "chai": "^6.2.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "axios": "^1.13.2"
  }
}
