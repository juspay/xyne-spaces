{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "DS_LOGS",
        "label": "Logs",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "workspace",
        "label": "Workspace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
        "definition": "label_values(slack_migration_jobs, workspace)",
        "query": { "query": "label_values(slack_migration_jobs, workspace)", "refId": "workspace" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Messages ingested (all-time)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [{ "instant": true, "refId": "A", "expr": "sum(slack_migration_messages{status=\"COMPLETED\", workspace=~\"$workspace\"})" }]
    },
    {
      "type": "stat",
      "title": "Channels migrated",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [{ "instant": true, "refId": "A", "expr": "sum(slack_migration_jobs{status=\"COMPLETED\", type=\"CHANNEL\", workspace=~\"$workspace\"})" }]
    },
    {
      "type": "stat",
      "title": "DMs migrated",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [{ "instant": true, "refId": "A", "expr": "sum(slack_migration_jobs{status=\"COMPLETED\", type=\"DM\", workspace=~\"$workspace\"})" }]
    },
    {
      "type": "stat",
      "title": "Conversations migrated",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [{ "instant": true, "refId": "A", "expr": "sum(slack_migration_conversations{status=\"COMPLETED\", workspace=~\"$workspace\"})" }]
    },
    {
      "type": "stat",
      "title": "Awaiting approval",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [{ "instant": true, "refId": "A", "expr": "sum(slack_migration_jobs{status=\"AWAITING_APPROVAL\", workspace=~\"$workspace\"})" }]
    },
    {
      "type": "stat",
      "title": "Failed jobs",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [{ "instant": true, "refId": "A", "expr": "sum(slack_migration_jobs{status=\"FAILED\", workspace=~\"$workspace\"})" }]
    },
    {
      "type": "timeseries",
      "title": "Jobs by status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sum by (status) (slack_migration_jobs{workspace=~\"$workspace\"})", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries",
      "title": "Queue depth (waiting / active)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (queue, workspace) (slack_migration_queue_waiting{workspace=~\"$workspace|\"})", "legendFormat": "wait · {{queue}} {{workspace}}" },
        { "refId": "B", "expr": "sum by (queue, workspace) (slack_migration_queue_active{workspace=~\"$workspace|\"})", "legendFormat": "active · {{queue}} {{workspace}}" }
      ]
    },
    {
      "type": "piechart",
      "title": "Completed jobs by type",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "pieType": "donut", "legend": { "displayMode": "list", "placement": "right", "values": ["value"] } },
      "targets": [{ "instant": true, "refId": "A", "expr": "sum by (type) (slack_migration_jobs{status=\"COMPLETED\", workspace=~\"$workspace\"})", "legendFormat": "{{type}}" }]
    },
    {
      "type": "logs",
      "title": "Recent migration errors (excl. GCS delete-perm 403)",
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "${DS_LOGS}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [{ "refId": "A", "expr": "container:\"migration\" AND level:error AND NOT \"storage.objects.delete\"", "queryType": "instant" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["slack-migration", "xyne"],
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "title": "Xyne · Slack Self-Serve Migration",
  "uid": "xyne-slack-migration",
  "version": 1
}
