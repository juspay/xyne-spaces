# Development Dockerfile for sandbox backend (hot-reload via volume mount)
# Used by sandbox system for per-agent isolated backend instances

FROM mirror.gcr.io/library/node:22.22.3-slim

WORKDIR /app

# Install build dependencies and tools needed for native modules, Prisma, and health checks
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    git \
    openssl \
    libssl-dev \
    ca-certificates \
    curl \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# pnpm workspace: the build context is the repo root. Manifests and the lockfile
# are copied first so the install layer caches independently of source changes.
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/shared/package.json           packages/shared/
COPY packages/storage/package.json          packages/storage/
COPY packages/framework/package.json        packages/framework/
COPY apps/backend/package.json              apps/backend/
COPY apps/backend/eslint-rules/package.json apps/backend/eslint-rules/

# Only backend and its workspace dependencies; `...` pulls in shared + framework.
# --ignore-scripts: only the manifests are present at this layer, so the
# `prepare` hooks on @xyne/shared and @xyne/icons (which run tsc) would fail
# with no sources or tsconfig.json. The explicit build steps after the source
# COPY below do that work instead.
RUN pnpm install --frozen-lockfile --prod=false --ignore-scripts --filter xyne-spaces-backend...

COPY packages/shared    packages/shared
COPY packages/storage   packages/storage
COPY packages/framework packages/framework
COPY apps/backend       apps/backend

# backend consumes these from their built dist/
RUN pnpm --filter @xyne/shared --filter @xyne/storage --filter agentic-framework run build

# /app is where the entrypoint and the sandbox volume mounts expect the backend
WORKDIR /repo/apps/backend
RUN ln -s /repo/apps/backend /app

# logger.ts imports the version from the repo-root package.json (../../../package.json)
COPY package.json /package.json

# Generate Prisma client
RUN pnpm run db:generate
RUN pnpm run db:common:generate

# Expose dev server port
EXPOSE 3001

# Create entrypoint script
# shared/framework are pre-built on host before containers start (see sandbox.sh cmd_create)
# We just need to push prisma schema and start the dev server
RUN cat > /entrypoint.sh << 'ENTRY'
#!/bin/sh
set -e
echo "[sandbox] Running prisma db push..."
cd /repo/apps/backend && pnpm run db:push
echo "[sandbox] Starting backend dev server..."
cd /repo/apps/backend && exec pnpm exec tsx watch \
  --ignore ../../packages/shared/node_modules \
  --ignore ../../packages/storage/node_modules \
  --ignore ../../packages/framework/node_modules \
  src/index.ts
ENTRY
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD []
