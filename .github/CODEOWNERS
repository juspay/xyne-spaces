# Code owners for security-sensitive access-control code.
#
# When a PR touches any path below, GitHub requires an approval from the
# owning team IN ADDITION to the normal required reviews — enforced by the
# "Require review from Code Owners" branch-protection setting on main.
#
# NOTE: the @juspay/xyne-acl-guardians team needs at least read access to
# this repository for CODEOWNERS to take effect.

# Prisma ACL query layer (backend database access control)
/apps/backend/src/database/acl/ @juspay/xyne-acl-guardians

# Prisma ACL middleware — client extension enforcing ACL + tenant context
/apps/backend/src/database/tenant/ @juspay/xyne-acl-guardians

# Zero ACL definitions (backend + shared)
/apps/backend/src/zero/acl/ @juspay/xyne-acl-guardians
/packages/shared/src/zero/acl/ @juspay/xyne-acl-guardians

# Zero mutators (backend, dashboard, shared)
/apps/backend/src/zero/mutators.ts @juspay/xyne-acl-guardians
/apps/dashboard/src/zero/mutators.ts @juspay/xyne-acl-guardians
/packages/shared/src/zero/mutators.ts @juspay/xyne-acl-guardians
/apps/backend/src/zero/formsMutatorHelpers.ts @juspay/xyne-acl-guardians
/packages/shared/src/zero/formsMutatorHelpers.ts @juspay/xyne-acl-guardians

# ---------------------------------------------------------------------------
# Call infrastructure.
#
# Same mechanism as the ACL rules above: a PR touching any path here needs an
# approval from @juspay/xyne-call-guardians on top of the normal reviews.
#
# NOTE: the @juspay/xyne-call-guardians team needs at least read access to this
# repository for these rules to take effect.
#
# The backend has no call-specific directory — calls live alongside everything
# else in services/, controllers/ and routes/ — so those are matched by prefix
# rather than by folder. Patterns are case-sensitive: liveKit* on the backend
# service, livekit* on the controllers and route.

# Backend call services, controllers, routes and validators (incl. LiveKit)
/apps/backend/src/services/call*.ts @juspay/xyne-call-guardians
/apps/backend/src/services/liveKit*.ts @juspay/xyne-call-guardians
/apps/backend/src/services/externalCall*.ts @juspay/xyne-call-guardians
/apps/backend/src/services/recurringCall*.ts @juspay/xyne-call-guardians
/apps/backend/src/controllers/call*.ts @juspay/xyne-call-guardians
/apps/backend/src/controllers/scheduleCall*.ts @juspay/xyne-call-guardians
/apps/backend/src/controllers/livekit*.ts @juspay/xyne-call-guardians
/apps/backend/src/routes/call*.ts @juspay/xyne-call-guardians
/apps/backend/src/routes/livekit*.ts @juspay/xyne-call-guardians
/apps/backend/src/validators/call*.ts @juspay/xyne-call-guardians

# Transcription agent — LiveKit worker that transcribes calls and serves the
# voice-input HTTP endpoints (deployed as the xyne-transcription-agent chart)
/apps/backend/python-agent/ @juspay/xyne-call-guardians

# Call client
/apps/dashboard/src/services/Call/ @juspay/xyne-call-guardians
/apps/dashboard/src/components/Call/ @juspay/xyne-call-guardians
/apps/dashboard/src/hooks/useCall*.ts @juspay/xyne-call-guardians
