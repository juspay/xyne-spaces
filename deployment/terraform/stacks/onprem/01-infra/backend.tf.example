terraform {
  backend "s3" {
    bucket       = "example-tfstate"
    key          = "xyne/01-infra/terraform.tfstate"
    region       = "default"
    use_lockfile = true

    # Ceph RGW is S3-compatible but is not AWS. These skips stop the provider
    # reaching for STS, IMDS and region validation, none of which exist here.
    endpoints                   = { s3 = "https://s3.example.internal:7442" }
    use_path_style              = true
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
  }
}
