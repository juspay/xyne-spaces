region = "ap-south-1"
name   = "xyne"
domain = "spaces.example.com"

dns_zone     = "Z0123456789EXAMPLE"
worker_names = ["default"]

eks_public_access_cidrs = ["203.0.113.0/24"]
internet_egress_cidrs   = ["0.0.0.0/0"]
deployer_principal_arn  = "arn:aws:iam::123456789012:role/platform-deployer"

zero_pool_enabled = false
vespa_enabled     = false
sandbox_enabled   = false
bastion_enabled   = false

postgres_mode     = "managed"
postgres_password = "replace-with-a-long-random-password"

redis_mode = "managed"
redis_auth = "replace-with-a-long-random-token"

storage_mode = "managed"

livekit_enabled    = false
livekit_api_key    = "APIexamplekey"
livekit_api_secret = "replace-with-the-livekit-api-secret"
