{
  "name": "dpip-daily-ingestion-v2",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=console-source/index.js",
    "postbundle": "node scripts/copy-report.mjs",
    "gcp-build": "npm run build",
    "prestart": "npm run build",
    "start": "functions-framework --target=ingestDpip",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "5.0.5",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
