{
    "connector": "fiservemea",
    "headers": {
        "x-connector": "fiservemea",
        "x-auth": "signature-key",
        "x-api-key": "$FISERVEMEA_API_KEY",
        "x-api-secret": "$FISERVEMEA_API_SECRET",
        "x-key1": "$FISERVEMEA_KEY1",
        "x-merchant-id": "test_merchant",
        "x-tenant-id": "default"
    },
    "card_pm": {
        "No3DSAutoCapture": {
            "Request": {
                "amount": 3000,
                "minor_amount": 3000,
                "currency": "USD",
                "capture_method": "AUTOMATIC",
                "card": {
                    "card_number": "4005550000000019",
                    "card_exp_month": "12",
                    "card_exp_year": "2050",
                    "card_cvc": "123",
                    "card_network": "VISA"
                }
            },
            "Response": {
                "status": "CHARGED"
            }
        },
        "No3DSManualCapture": {
            "Request": {
                "amount": 3000,
                "minor_amount": 3000,
                "currency": "USD",
                "capture_method": "MANUAL",
                "card": {
                    "card_number": "4005550000000019",
                    "card_exp_month": "12",
                    "card_exp_year": "2050",
                    "card_cvc": "123",
                    "card_network": "VISA"
                }
            },
            "Response": {
                "status": "AUTHORIZED"
            }
        },
        "Capture": {
            "Request": {
                "amount_to_capture": 3000,
                "currency": "USD"
            },
            "Response": {
                "status": "CHARGED"
            }
        },
        "Void": {
            "Request": {
                "cancellation_reason": "Customer requested cancellation",
                "currency": "USD"
            },
            "Response": {
                "status": "VOIDED"
            }
        },
        "Refund": {
            "Request": {
                "payment_amount": 3000,
                "minor_payment_amount": 3000,
                "refund_amount": 3000,
                "minor_refund_amount": 3000,
                "currency": "USD",
                "reason": "Customer requested refund"
            },
            "Response": {
                "status": "REFUND_SUCCESS"
            }
        },
        "SyncPayment": {
            "Request": {
                "currency": "USD"
            },
            "Response": {
                "status": "CHARGED"
            }
        },
        "SyncRefund": {
            "Response": {
                "status": "REFUND_SUCCESS"
            }
        }
    }
}