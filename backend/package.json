{
  "name": "xyne-spaces-backend",
  "version": "1.0.0",
  "description": "Backend server for Xyne Spaces application",
  "main": "dist/index.js",
  "type": "module",
  "imports": {
    "#zero-internal/query-internals": "./node_modules/@rocicorp/zero/out/zql/src/query/query-internals.js",
    "#zero-internal/pg-query-executor": "./node_modules/@rocicorp/zero/out/zero-server/src/pg-query-executor.js",
    "#zero-internal/schema": "./node_modules/@rocicorp/zero/out/zero-server/src/schema.js",
    "#zero-internal/compiler": "./node_modules/@rocicorp/zero/out/z2s/src/compiler.js",
    "#zero-internal/sql": "./node_modules/@rocicorp/zero/out/z2s/src/sql.js"
  },
  "scripts": {
    "postinstall": "cd ../shared && npm install && npm run build && cd ../framework && npm install && npm run build",
    "build": "tsc",
    "build:watch": "tsc -w",
    "start": "tsx dist/index.js",
    "start:prod": "NODE_ENV=production tsx dist/index.js",
    "start:api": "NODE_ENV=production node dist/index.js",
    "start:worker": "NODE_ENV=production tsx dist/worker.js",
    "dev": "dotenv -e .env.local -- sh -c 'NODE_ENV=development CHOKIDAR_USEPOLLING=true tsx watch src/index.ts'",
    "dev:api": "NODE_ENV=development tsx watch src/index.ts",
    "dev:worker": "dotenv -e .env.local -- sh -c 'NODE_ENV=development tsx watch src/worker.ts'",
    "dev:test": "dotenv -e .env.local -- sh -c 'NODE_ENV=test tsx src/index.ts'",
    "ysweet": "cd ../ysweet && podman-compose up -d",
    "ysweet:down": "cd ../ysweet && podman-compose down",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "prepare": "husky"
  },
  "keywords": [
    "xyne",
    "spaces",
    "backend",
    "api",
    "typescript",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@blocknote/core": "^0.47.1",
    "@blocknote/server-util": "^0.47.1",
    "@clearfeed-ai/slack-to-html": "^1.1.0",
    "@google-cloud/storage": "^7.7.0",
    "@langfuse/client": "^4.5.1",
    "@langfuse/otel": "^4.5.1",
    "@langfuse/tracing": "^4.5.1",
    "@napi-rs/canvas": "^0.1.88",
    "@opencode-ai/sdk": "^1.1.42",
    "@openfeature/server-sdk": "^1.20.1",
    "@opentelemetry/sdk-node": "^0.209.0",
    "@parse/node-apn": "^7.0.1",
    "@prisma/client": "^5.22.0",
    "@rocicorp/zero": "0.25.12",
    "@slack/web-api": "^7.12.0",
    "@types/bull": "^3.15.9",
    "@types/multer": "^2.0.0",
    "@types/node-rsa": "^1.1.4",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^2.10.3",
    "@xyne/shared": "file:../shared",
    "@xyne/vespa-ts": "^1.5.0",
    "@xynehq/jaf": "0.1.37",
    "@y-sweet/sdk": "^0.9.1",
    "agentic-framework": "file:../framework",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "eventsource": "^4.1.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^10.4.0",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^2.34.0",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "livekit-server-sdk": "^2.14.0",
    "marked": "^17.0.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-html-parser": "^6.1.13",
    "node-rsa": "^1.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "simple-git": "^3.30.0",
    "socket.io": "^4.8.1",
    "superposition-provider": "^0.97.0",
    "unified": "^11.0.5",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "yauzl": "^3.2.0",
    "yjs": "^13.6.27",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@passionfroot/prisma-generator-zero": "^0.4.0",
    "@prisma/internals": "^5.22.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/eventsource": "^1.1.15",
    "@types/express": "^4.17.21",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^29.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.33",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.1.0",
    "prisma": "^5.22.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "ts-patch": "^3.3.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
