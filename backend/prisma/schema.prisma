  id                   String       @id @default(cuid())
  userId               String
  stageId              String       // Stage ID (no FK constraint)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime?    @updatedAt

  @@unique([stageId, userId])
  @@index([stageId])
  @@map("stage_approvers")
  @@schema("public")
}

// ============================================================================
// RELEASE MANAGEMENT MODELS
// ============================================================================

// Release Management Enums

enum ApplicationReleaseTicketStatus {
  NOT_TESTED
  TESTING
  PASSED
  FAILED
  EXCLUDED
  @@schema("public")
}

enum ReleaseEventType {
  RELEASE
  TICKET
  SUBTICKET
  TESTING
  SYSTEM
  CANVAS
  @@schema("public")
}

enum RCAStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  CLOSED
  @@schema("public")
}

// Services that can be released
model Application {
  id              String    @id @default(cuid())
  name            String
  projectId       String    // Project ID (no FK constraint)
  boardId         String    // Board ID (no FK constraint)
  channelId       String?   // Channel ID (no FK constraint)
  regex           String    // Used to identify service 
  repoUrl         String
  deployedCommit  String?   // Used to identify the commit that is currently deployed
  lastDeployedAt  DateTime?
  ownerTeam       String
  createdAt       DateTime  @default(now())

  @@index([projectId])
  @@index([channelId])
  @@index([boardId])
  @@map("applications")
  @@schema("public")
}

// Individual application releases under a parent release ticket
// Mapping between application release and actual dev tickets
model ApplicationReleaseTicket {
  id                    String                          @id @default(cuid())
  applicationReleaseId  String                          // SubTicket ID from ApplicationRelease
  ticketId              String                          // Ticket ID in the actual dev board
  title                 String
  status                ApplicationReleaseTicketStatus  @default(NOT_TESTED)
  testedBy              String?                         // User ID (no FK constraint)
  testedAt              DateTime?
  failureReason         String?
  createdAt             DateTime                        @default(now())

  @@index([applicationReleaseId])
  @@index([ticketId])
  @@index([status])
  @@map("application_release_tickets")
  @@schema("public")
}


// Captures all events tied to the release for audit trail
model ReleaseEvent {
  id                    String            @id @default(cuid())
  releaseId             String            // Always present - Release ticket ID
  applicationReleaseId  String?           // App-specific events (SubTicket ID)
  eventType             ReleaseEventType
  eventName             String            // Specific action
  message               String            // Human-readable message
  userId                String?           // NULL = system event
  userName              String?           // Name of the user
  channelId             String            // Channel where release lives
  conversationId        String            // Thread for this release
  payload               Json?             // Flat, event-specific data
  createdAt             DateTime          @default(now())

  @@index([releaseId])
  @@index([applicationReleaseId])
  @@index([channelId, conversationId])
  @@index([eventType])
  @@index([createdAt])
  @@map("release_events")
  @@schema("public")
}

model ReleaseChange {
  id                    String         @id @default(cuid())
  releaseId             String         // Release ticket ID
  applicationReleaseId  String?        // Application release ID (SubTicket ID)
  applicationId         String?        // Application ID
  approvedBy            String?        // User ID (no FK constraint)
  approvedAt            DateTime?
  createdAt             DateTime       @default(now())

  @@index([releaseId])
  @@index([applicationReleaseId])
  @@index([applicationId])
  @@map("release_changes")
  @@schema("public")
}

model ReleaseChangeType {
  id              String   @id @default(cuid())
  applicationId   String   // Application ID
  changeType      String   // e.g., "env", "migrations", "database", etc.

  @@index([id])
  @@index([applicationId])
  @@index([changeType])
  @@map("release_change_types")
  @@schema("public")
}

enum TicketStageRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED

  @@schema("public")
}

model TicketStageRequest {
  id              String                    @id @default(cuid())
  ticketId        String
  stageId         String
  formId          String?
  status          TicketStageRequestStatus @default(DRAFT)
  submittedBy     String
  reviewedBy      String?
  updatedBy       String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([ticketId])
  @@index([stageId])
  @@index([formId])
  @@unique([ticketId, stageId])
  @@map("ticket_stage_requests")
  @@schema("public")
}
enum COEStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  @@schema("public")
}

enum SEVERITY {
  SEV_1
  SEV_2
  SEV_3
  @@schema("public")
}


// Root cause analysis for issues
model RCA {
  id                    String     @id @default(cuid())
  title                 String
  ticketId              String     // Ticket ID
  ownerId               String     // User ID (no FK constraint)
  summary               String?
  rootCause             String?
  severity              SEVERITY
  status                RCAStatus  @default(DRAFT)
  bugTypeId             String     // bug type
  categoryTypeId        String     // category type
  issueCategoryId       String?
  issueStartAt          DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([ticketId])
  @@index([ownerId])
  @@index([status])
  @@map("rcas")
  @@schema("public")
}

// Impact caused by an issue
model Impact {
  id                    String      @id @default(cuid())
  ticketId              String      // Ticket ID
  rcaId                 String?     // RCA ID
  impactTypeId          String
  impact                String      // Description of impact
  createdAt             DateTime    @default(now())

  @@index([ticketId])
  @@index([rcaId])
  @@index([impactTypeId])
  @@map("impacts")
  @@schema("public")
}

// Actions to fix issues identified in RCA
model COE {
  id              String        @id @default(cuid())
  rcaId           String        // RCA ID
  ownerId         String        // User ID (no FK constraint)
  actionTypeId    String        // COEActionType ID
  action          String        // Description of the action
  status          COEStatus     @default(OPEN)
  dueDate         DateTime?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?

  @@index([rcaId])
  @@index([ownerId])
  @@index([status])
  @@index([actionTypeId])
  @@map("coes")
  @@schema("public")
}

enum AttributionConfidence {
  LOW
  MEDIUM
  HIGH
  @@schema("public")
}

model ReleaseAttribution {
  id                      String                 @id @default(cuid())
  ticketId                String                 // Ticket ID of the newly reported issue
  releaseId               String                 // Release ticket ID
  releaseApplicationId    String?                // Application release ID (SubTicket ID)
  rootCauseTicketId       String?                // Root cause ticket
  confidence              AttributionConfidence  @default(LOW)
  createdAt               DateTime               @default(now())

  @@index([ticketId])
  @@index([releaseId])
  @@index([releaseApplicationId])
  @@index([rootCauseTicketId])
  @@map("release_attributions")
  @@schema("public")
}

// ============================================================================
// RECAP FEATURE MODELS
// ============================================================================

// Stores daily AI-generated summaries for each channel
model ChannelDailyRecap {
  channelId String
  recapDate DateTime @db.Date
  summary   String // Final bullet summary text for the day

  @@id([channelId, recapDate])
  @@index([recapDate])
  @@map("channel_daily_recaps")
  @@schema("public")
}

// ============================================================================
// SURFACE NUDGE FRAMEWORK
// ============================================================================

enum SurfaceAreaType {
  MESSAGE
  TICKET
  CANVAS
  CALL
  CONVERSATION
  @@schema("public")
}

enum SurfaceLinkKind {
  RELATES_TO
  @@schema("public")
}

enum SessionRecordingProcessStatus {
  PENDING      // File synced to GCS, needs SOP/fact extraction
  PROCESSING   // Extraction job running
  COMPLETED    // Extraction done
  FAILED       // Extraction failed
  @@schema("workflow")
}

// GCS Path format: sessions/${userId}/${sessionId}/recording.json
model SessionRecordingFile {
  id                String   @id @default(cuid())
  sessionId         String   @unique
  userId            String
  url               String?  // Full GCS URI: gs://bucket/path/to/file.json
  status            SessionRecordingProcessStatus @default(PENDING)
  lastProcessedTurn Int?     // Last turn ID that was processed for SOP/fact extraction

  @@index([status])
  @@index([sessionId])
  @@map("session_recording_files")
  @@schema("workflow")
}

model SurfaceLink {
  id          String          @id @default(cuid())

  sourceType  SurfaceAreaType
  sourceId    String

  targetType  SurfaceAreaType
  targetId    String

  linkKind    SurfaceLinkKind
  createdBy   String
  projectId   String
  createdAt   DateTime        @default(now())

  @@unique([sourceType, sourceId, targetType, targetId, linkKind])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([projectId])
  @@map("surface_links")
  @@schema("public")
}

model Apps {
  id String @id @default(cuid())
  name String
  description String?
  createdBy String
  createdAt DateTime
  updatedAt DateTime

  // Relations
  createdByUser User           @relation("AppsCreatedBy", fields: [createdBy], references: [id])
  installations InstalledApps[]

  @@index([name])
  @@index([createdBy])
  @@map("apps")
  @@schema("public")
}

model InstalledApps {
  id String @id @default(cuid())
  appId String
  userId String
  webhookUrl String?
  signingSecret String
  createdAt DateTime
  updatedAt DateTime

  // Relations
  app             Apps         @relation(fields: [appId], references: [id])
  user            User         @relation("InstalledAppsUser", fields: [userId], references: [id])

  @@index([appId])
  @@index([userId])
  @@map("installed_apps")
  @@schema("public")
}
