  @@index([callId, createdAt])
  @@map("call_messages")
  @@schema("non_zero")
}

// User-Team membership (many-to-many, no FK constraints)
model UserGroupMapping {
  id             String              @id @default(cuid())
  userId         String              // No FK constraint
  userGroupId    String              // No FK constraint
  responsibility UserResponsibility  @default(MEMBER) // User responsibility level within this group
  onCallSetNumber    Int?                // Deprecated: use onCallSetNumbers instead. Only set when autoRotationEnabled is true
  onCallSetNumbers   Int[]               // Array of set numbers for on-call rotation
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  user      User      @relation(fields: [userId], references: [id])
  userGroup UserGroup @relation(fields: [userGroupId], references: [id])

  @@unique([userId, userGroupId])
  @@index([userId])
  @@index([userGroupId])
  @@index([userGroupId, createdAt(sort: Desc), id(sort: Asc)]) // for getUserGroupMembers
  @@index([userGroupId, onCallSetNumber]) // for on-call rotation queries (deprecated)
  @@index([userGroupId, onCallSetNumbers]) // for on-call rotation queries
  @@map("user_group_mappings")
  @@schema("public")
}

// User Assignment State - tracks on-call status and active status for assignment
model UserAssignmentState {
