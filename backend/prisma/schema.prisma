  applicationBoard Board @relation("ApplicationBoard", fields: [boardId], references: [id], onDelete: Restrict)
  mainReleaseBoard Board? @relation("MainReleaseBoardApplications", fields: [mainReleaseBoardId], references: [id], onDelete: Restrict)

  @@unique([mainReleaseBoardId, name])
