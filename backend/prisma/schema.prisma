// Chat Feature Models - New Schema Design

// Organization Models
model Organization {
  orgId       String   @id @default(cuid())
  name        String   @unique // Organization name
  description String?
  createdBy   String   // User ID (no FK constraint)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      Status   @default(ACTIVE)
  metadata    Json?

  // Relations
  members OrgMember[]
  workspaces Workspace[]

  workspaceOrgs         WorkspaceOrganization[]
  invitations           Invitation[]
  @@index([status, name])
  @@map("organizations")
  @@schema("public")
}

model OrgMember {
  memberId    String   @id @default(cuid())
  orgId       String   // Organization ID (no FK constraint)
  userId      String   @default("deprecated")   // Deprecated not using, only here for backward compatibility
  email       String   @unique // Email address — globally unique, one org per email
  role        OrgRole  // OWNER | ADMIN | MEMBER | VIEWER
  passwordHash String?  // For email-password based login; null for existing Google/Microsoft SSO users unless explicitly set by forgot password
  joinedAt    DateTime @default(now())
  invitedBy   String?  // Who invited this user (no FK constraint)
  leftAt      DateTime?

  // Relations
  organization Organization @relation(fields: [orgId], references: [orgId])
  users        User[]

  @@index([orgId])
  @@index([orgId, joinedAt])
  @@map("org_members")
  @@schema("public")
}

model WorkspaceOrganization {
  id           String      @id @default(cuid())
  orgId        String
  workspaceId  String
  role         WorkspaceRole
  leftAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([orgId, workspaceId])
  @@index([orgId])
  @@index([workspaceId])
  @@index([workspaceId, createdAt(sort: Desc), id])
  @@map("workspace_organizations")
  @@schema("public")
}

// Workspace Models
model Workspace {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  createdBy   String
  status      Status   @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  organization      Organization         @relation(fields: [orgId], references: [orgId])
  users             User[]
  invitations       Invitation[]
  projects          Project[]
  workspaceOrgs     WorkspaceOrganization[]
  agents            Agent[]
  models            Model[]
  tools             Tool[]
  userGroups        UserGroup[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("workspaces")
  @@schema("public")
}


model Invitation {
  id           String        @id @default(cuid())
  orgId        String?
  workspaceId  String?
  email        String
  role         WorkspaceRole @default(MEMBER)
  invitedBy    String
  invitedAt    DateTime      @default(now())
  expiredAt    DateTime?     // Expiration date - 15 days from creation by default, or updated on revoke
  acceptedAt   DateTime?     // When the invitation was accepted
  invitationId String?       @unique // Unique link ID for invitation URL
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  organization Organization? @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([workspaceId])
  @@index([email])
  @@index([invitationId])
  @@index([createdAt(sort: Desc), id])
  @@map("invitations")
  @@schema("public")
}

// Project Models
model Project {
  id             String           @id @default(cuid())
  name           String
  code           String // Project shortcode for ticket IDs (e.g., EUL, INF)
  ticketSequence Int              @default(0) // Atomic counter for project-scoped ticket numbering
  description    String?
  workspaceId    String // Workspace this project belongs to
  type           ProjectType      @default(DEFAULT)
  createdBy      String // User ID (no FK constraint)
  updatedBy      String? // User ID (no FK constraint)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime?        @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  tickets  Ticket[]
  channels Channel[]
  boards   Board[]
  canvasFolders CanvasFolder[]
  canvases      Canvas[]

  @@unique([name, workspaceId])
  @@unique([code, workspaceId])

  @@index([workspaceId, createdAt(sort: Desc), id])
  @@map("projects")
  @@schema("public")
}

// Board Models
model Board {
  id                  String               @id @default(cuid())
  name                String
  boardType           BoardType            @default(DEFAULT)
  projectId           String               // Project ID (no FK constraint)
  workspaceId         String               // Workspace for ACL optimization (denormalized from project)
  createdBy           String               // User ID (no FK constraint)
  updatedBy           String?              // User ID (no FK constraint)
  description         String?              // Board description
  metadata            Json?                // Board configuration including ticketFormConfig
  vcsProvider         VCSProviderType?      // Main release board VCS provider
  releaseTrackingMode ReleaseTrackingMode? // Main release board tracking mode
  createdAt           DateTime             @default(now())
  updatedAt           DateTime?            @updatedAt

  // Relations
  project               Project                @relation(fields: [projectId], references: [id])
  tickets               Ticket[]               @relation("TicketBoard")
  stages                Stage[]
  boardComplexityScores BoardComplexityScore[]
  workloadMappings      UserWorkloadMapping[]
  expertiseMappings     UserExpertiseMapping[]
  mainReleaseApplications Application[] @relation("MainReleaseBoardApplications")
  ownedApplication        Application?  @relation("ApplicationBoard")
  incomingWebhooks      AppIncomingWebhook[]

  @@unique([name, projectId])
  @@index([projectId])

  @@index([workspaceId, createdAt(sort: Desc), id])
  @@index([projectId, createdAt, id])
  @@map("boards")
  @@schema("public")
}

model Stage {
  id                   String       @id @default(cuid())
  name                 String
  eta                  Int?
  boardId              String       // Board ID (no FK constraint)
  sequenceNumber       Int
  createdBy            String       // User ID (no FK constraint)
  updatedBy            String?      // User ID (no FK constraint)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime?    @updatedAt
  defaultTicketStatus     TicketStatus    @default(IN_PROGRESS)  // Deprecated - use defaultTicketStatusV2
  defaultTicketStatusV2   TicketStatusV2 @default(STARTED)

  // Relations
  board           Board            @relation(fields: [boardId], references: [id])
  ticketStageEtas TicketStageEta[]

  @@index([boardId])
  @@index([boardId, sequenceNumber]) // for stagesByBoard
  @@map("stages")
  @@schema("public")
}

// Stage to PR Status mapping table - maps which PR statuses trigger stage transitions
model StagePRStatusMapping {
  id        String        @id @default(cuid())
  stageId   String        // Stage ID (no FK constraint)
  prStatus  PRStatusEvent
  createdAt DateTime      @default(now())

  @@unique([stageId, prStatus])
  @@map("stage_pr_status_mappings")
  @@schema("public")
}

// Stage transition table — defines allowed movements and gates for NON_LINEAR boards
model StageTransition {
  id                          String       @id @default(cuid())
  boardId                     String
  fromStageId                 String?      // null = global transition (from any)
  toStageId                   String
  formId                      String?
  requiresApproval            Boolean?      // NULL treated as false in code
  bypassApprovalForAutomation Boolean?      // NULL treated as false in code
  visitSlaMode                VisitSlaMode? // NULL treated as STAGE_DEFAULT in code
  fixedEtaHours               Int?
  onReenter                   ReenterMode?  // NULL treated as RESET in code
  createdAt                   DateTime?     // set by app on insert; NULL treated as creation time in code
  updatedAt                   DateTime      @updatedAt

  transitionApprovers StageApprovers[]

  @@unique([boardId, fromStageId, toStageId])
  @@index([boardId])
  @@index([fromStageId])
  @@index([boardId, toStageId])
  @@index([toStageId])
  @@map("stage_transitions")
  @@schema("public")
}

enum ApproverType {
  USER
  ROLE
  @@schema("public")
}

// Channel Models
model Channel {
  id              String            @id @default(cuid())
  name            String
  description     String?
  type            ChannelType       @default(DEFAULT)
  scopeType       ChannelScopeType  // DEFAULT | DM | TICKET | DOCUMENT | GROUP_DM
  visibility      ChannelVisibility @default(PUBLIC) // PUBLIC | PRIVATE
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lastActivityAt  DateTime          @default(now())
  createdBy       String            // User ID (no FK constraint)
  metadata        Json?             // Additional metadata for future extension
  projectId       String            // Project to which the channel is linked
  workspaceId     String            // Workspace for ACL optimization (denormalized from project)
  participantCount Int                    @default(0)
  isMigrated      Boolean?                @default(false)
  addUserPolicy   ChannelAddUserPolicy?  @default(EVERYONE)
  isArchived      Boolean                @default(false)
  showTicketsTabTicketsInChat Boolean?   @default(true)

  // Relations
  conversations      Conversation[]
  participants       ChannelParticipant[]
  conversationParticipants   ConversationParticipant[]
  participantsStatus ChannelUserStatus[]
  createdByUser      User                 @relation("ChannelCreatedBy", fields: [createdBy], references: [id])
  project            Project              @relation(fields: [projectId], references: [id])
  tickets            Ticket[]             @relation("TicketChannel")
  calls              Call[]
  channelStats       ChannelStats?
  incomingWebhooks   AppIncomingWebhook[]
  canvasFolders      CanvasFolder[]
  emails             Email[]

  @@index([projectId])
  @@index([workspaceId, visibility, id]) // ACL workspace filtering + visibility
  @@index([createdBy])
  @@index([isArchived])

  @@index([workspaceId, id])
  @@index([workspaceId, name, id])
  @@map("channels")
  @@schema("public")
}

model ChannelStats {
  channelId        String                @id
  lastActivityAt   DateTime              
  participantCount Int                   @default(0)
  addUserPolicy    ChannelAddUserPolicy? @default(EVERYONE)
  lastRecapHadMessages   Boolean?             // null = not processed, true = recap with messages, false = recap with 0 messages

  // Relations
  channel          Channel               @relation(fields: [channelId], references: [id])

  @@index([channelId])
  @@map("channel_stats")
  @@schema("public")
}

model ChannelParticipant {
  id                        String      @id @default(cuid())
  channelId                 String      // Channel ID (no FK constraint)
  userId                    String      // User ID (no FK constraint)
  joinedAt                  DateTime    @default(now())
  role                      ChannelRole @default(MEMBER) // ADMIN | MEMBER

  // deprecated columns will be removed in future
  lastViewedAt              DateTime    @default(now()) // Track when user last viewed channel
  lastViewedConversationId  String?     // Track last conversation viewed for optimization
  isStarred                 Boolean     @default(false)
  isClosed                  Boolean     @default(false) // Track if user has closed/hidden this DM

  // Relations
  channel Channel @relation(fields: [channelId], references: [id])
  user    User    @relation("ChannelParticipantUser", fields: [userId], references: [id])

  @@unique([channelId, userId]) // Prevent duplicate participants
  @@index([channelId]) // Fast channel participant lookup
  @@index([userId]) // Fast user channel lookup
  @@index([userId, isStarred]) // Fast Starred Channels Lookup
  @@index([userId, isClosed]) // Fast closed DMs lookup
  @@index([channelId, userId, id])
  @@index([userId, role, id])

  @@index([channelId, id])
  @@map("channel_participants")
  @@schema("public")
}

model ChannelUserStatus {
  id                        String      @id @default(cuid())
  channelId                 String      // Channel ID (no FK constraint)
  userId                    String      // User ID (no FK constraint)
  lastViewedAt              DateTime    @default(now()) // Track when user last viewed channel
  lastViewedConversationId  String?     // Track last conversation viewed for optimization
  isStarred                 Boolean     @default(false)
  isClosed                  Boolean     @default(false) // Track if user has closed/hidden this DM
  unreadCount               Int         @default(0) // Track unread count for this channel
  sectionId                 String?     // Custom sidebar section this channel is placed in for the user (null = default group)
  sectionPosition           String?     // Fractional index (generateKeyBetween) within the custom section
  selectedBoardId           String?     // Track user's preferred board for this channel
  conversationSeenCutoffAt  DateTime?    // Track createdAt of the 25th most recent conversation seen by the user
  // Recap subscription fields
  isRecapSubscribed         Boolean     @default(false) // User opted into AI recaps for this channel
  lastSeenRecapDate         DateTime?   @db.Date // Last recap date the user has seen for this channel
  customRecapPrompt         String?     // Optional custom prompt for personalized recaps

  desktopNotificationLevel  NotificationLevel?    // Channel notification preference (desktop); null = inherit UserPreference.globalDesktopNotificationLevel
  mobileNotificationLevel   NotificationLevel?   // Channel notification preference (mobile); null = inherit UserPreference.globalMobileNotificationLevel
  threadReplyNotificationsEnabled Boolean?       // Per-channel override: null = inherit UserPreference.threadReplyNotificationsEnabled
  channelWideMentionsEnabled      Boolean?       // Per-channel override: null = inherit UserPreference.channelWideMentionsEnabled

  isDeleted                 Boolean     @default(false) // Soft delete flag
  updatedAt                 DateTime?   // No default, nullable, set manually in code 

  // Relations
  channel Channel @relation(fields: [channelId], references: [id])
  user    User    @relation("ChannelUserStatusUser", fields: [userId], references: [id])

  @@unique([channelId, userId]) // Prevent duplicate participants
  @@index([channelId]) // Fast channel participant lookup
  @@index([userId]) // Fast user channel lookup
  @@index([userId, isStarred]) // Fast Starred Channels Lookup
  @@index([userId, isClosed]) // Fast closed DMs lookup
  @@index([userId, isRecapSubscribed]) // Fast recap subscriptions lookup

  @@index([userId, isDeleted, id])
  @@index([userId, sectionId]) // Fast lookup of channels within a section + cleanup on section delete
  @@map("channel_user_status")
  @@schema("public")
}

// Per-user custom sidebar sections (Slack-style). Personal to each user, scoped per workspace.
model ChannelSection {
  id          String    @id @default(cuid())
  userId      String    // Owner — sections are per-user (no FK constraint)
  workspaceId String    // Workspace scope for ACL + per-workspace sections (no FK constraint)
  name        String    // Section label (the "tag" name)
  emoji       String?   // Optional emoji icon
  position    String    // Fractional index (generateKeyBetween) among the user's sections
  isCollapsed Boolean   @default(false) // Per-user collapse state, synced across devices
  isDeleted   Boolean   @default(false) // Soft delete flag
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? // Nullable, set manually in code (matches ChannelUserStatus convention)

  @@index([userId, workspaceId, isDeleted]) // Fast lookup of a user's sections in a workspace
  @@map("channel_sections")
  @@schema("public")
}

// Conversation Models (threads within channels)
model Conversation {
  conversationId    String   @id @default(cuid())
  channelId         String   // Channel this thread belongs to (no FK constraint)
  createdBy         String   // User who started the thread (no FK constraint)
  initialMessageId  String   // First message - use this for thread preview (no FK constraint)
  workspaceId       String?  // Workspace for ACL optimization (denormalized from channel)
  parentMessageId   String?  // Parent message that this conversation is replying to (no FK constraint)
  lastActivityAt    DateTime @default(now())
  replyCount        Int      @default(0)
  pinned            Boolean  @default(false)
  ticketId          String?  // Direct reference to ticket (no FK constraint)
  metadata          Json?
  callId            String?
  replies_md        String?
  ticket_md         String?
  initial_message_md String?
  parent_message_md  String?
  doNotPostToChannel Boolean?
  createdAt         DateTime @default(now())

  // Relations
  channel         Channel                  @relation(fields: [channelId], references: [id])
  messages        Message[]
  createdByUser   User                     @relation("ConversationCreatedBy", fields: [createdBy], references: [id])
  participants    ConversationParticipant[]
  messageAttachments MessageAttachment[]

  @@index([channelId, lastActivityAt])
  @@index([workspaceId]) // ACL workspace filtering
  @@index([channelId]) // Alternative simple index
  @@index([ticketId]) // Fast ticket lookup
  @@index([callId])
  @@index([conversationId, callId])
  @@index([channelId, createdAt(sort: Desc), conversationId(sort: Asc)])
  @@index([channelId, doNotPostToChannel, createdAt(sort: Desc), conversationId(sort: Asc)])
  @@index([createdBy])
  @@index([initialMessageId])
  @@map("conversations")
  @@schema("public")
}

// Conversation Participant Models (track who participated in threads)
model ConversationParticipant {
  id                String                        @id @default(cuid())
  conversationId    String                        // Conversation ID (no FK constraint)
  userId            String                        // User ID (no FK constraint)
  participationType ConversationParticipation?    // AUTHOR, MENTIONED, or NULL (manual subscription)
  isSubscribed      Boolean                       @default(true) // Notification subscription status
  joinedAt          DateTime                      @default(now())
  lastReadAt        DateTime?                     // Track when user last read this thread conversation
  lastReplyAt       DateTime?                     // Denormalized: set to conversation.lastActivityAt when a reply is sent. NULL = no replies.
  channelId         String?                       // Denormalized from conversation.channelId for direct ACL check

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [conversationId])
  channel      Channel?     @relation(fields: [channelId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId]) // One participation record per user per conversation
  @@index([conversationId]) // Fast conversation participant lookup
  @@index ([conversationId,participationType,joinedAt,id])
  @@index([userId]) // Fast user conversation lookup
  @@index([userId, lastReplyAt(sort: Desc), id]) // For userConversationsPaginatedV2

  @@index([userId, id])
  @@map("conversation_participants")
  @@schema("public")
}

enum EmailType {
  DEFAULT
  REPLY
  REPLY_ALL
  @@schema("public")
}

model Email {
  id String @id @default(cuid())
  type EmailType
  subject String
  body String
  to String[]
  from String
  cc String[] @default([])
  bcc String[] @default([])
  replyTo String[] @default([])
  conversationId String
  channelId String
  externalThreadId String
  externalMessageId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id]) // emulated (relationMode="prisma"), no DB FK
  @@unique([externalMessageId, channelId])
  @@index([conversationId])
  @@index([externalThreadId])
  @@index([channelId])
  @@index([conversationId, id])
  @@map("emails")
  @@schema("public")
}

model EmailDraft {
  id String @id @default(cuid())
  conversationId String
  userId String?
  channelId String
  draftContent String
  attachmentIds Json? // Array of attachment IDs for draft attachments
  autoDraftStatus AutoDraftStatus?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, conversationId])
  @@index([userId, conversationId, id])
  @@index([conversationId])
  @@index([channelId])
  @@map("email_drafts")
  @@schema("public")
}

model EmailRead {
  id              String   @id @default(cuid())
  ticketId        String
  userId          String
  lastReadEmailId String
  lastReadEmailAt DateTime
  createdAt       DateTime
  updatedAt       DateTime @updatedAt

  @@unique([ticketId, userId])
  @@index([userId])
  @@index([ticketId])
  @@map("email_reads")
  @@schema("public")
}

model EmailSignature {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, name, id])
  @@map("email_signatures")
  @@schema("public")
}

model EmailChannelPreference {
  channelId                    String   @id // Channel ID (no FK constraint) - Primary key
  ownerUserId                  String?  // User ID who owns this preference (no FK constraint)
  assigneeUserGroupId          String?  // User group ID for assignee (no FK constraint)
  boardId                      String?  // Target board for ticket creation (no FK constraint)
  sendAsEmail                  String?  // Optional alias email for outbound replies (e.g. support@...)
  defaultCc                    String?  // Comma-separated list of emails to pre-populate CC in compose
  classificationEnabled        Boolean  @default(false)
  classificationPrompt         String?  // Custom system prompt for the classification LLM
  categoryField                String?  // Label for the top-level category
  subCategoryField             String?  // Label for the sub-category
  emailMergeMode               EmailMergeMode @default(ENABLED) // Auto-merge similar emails (cross-thread duplicate merge + per-email demerge); enum so future variants can be added
  priorityClassificationEnabled Boolean @default(false)
  priorityClassificationPrompt String?  // Custom system prompt for the priority classification LLM
  priorityClassificationThreshold Float @default(0.5) // Minimum confidence threshold (0.0 - 1.0) to auto-apply priority
  autoDraftMode          AutoDraftMode @default(OFF)
  autoDraftAgentSlug     String?
  deskType               DeskType @default(EMAIL)
  dlEmail                String?
  workspaceId            String?
  @@index([ownerUserId])
  @@index([assigneeUserGroupId])
  @@index([boardId])
  @@unique([workspaceId, dlEmail])
  @@map("email_channel_preferences")
  @@schema("public")
}

model ClassificationMapping {
  id         String   @id @default(cuid())
  channelId  String
  category   String
  subCategory String?
  userGroupId String
  createdAt  DateTime @default(now())

  @@index([channelId])
  @@index([channelId, category])
  @@map("classification_mappings")
  @@schema("public")
}

// SLA policy configured per board and per priority level.
// When a board's metadata.slaPolicyType is set to 'priority', these policies are used
// to compute response/resolution deadlines for tickets based on their priority.
// responseHours and resolutionHours can be calendar hours (businessHoursOnly=false)
// or business hours (businessHoursOnly=true, Mon-Fri workdayStart–workdayEnd in timezone).
model BoardSlaPolicy {
  id              String         @id @default(cuid())
  boardId         String
  priority        TicketPriority
  responseHours   Float          // SLA first-response window in hours
  resolutionHours Float          // SLA resolution window in hours
  businessHoursOnly Boolean      @default(true)
  timezone        String         @default("UTC") // IANA timezone string e.g. "Asia/Kolkata"
  workdayStart    Int            @default(9)     // Hour of day (0-23) when business day starts
  workdayEnd      Int            @default(18)    // Hour of day (0-23) when business day ends
  isActive        Boolean        @default(true)
  createdAt       DateTime
  updatedAt       DateTime       @updatedAt

  @@unique([boardId, priority])
  @@index([boardId])
  @@index([isActive])
  @@map("board_sla_policies")
  @@schema("public")
}

// Message Models
model Message {
  messageId           String      @id @default(cuid())
  conversationId      String      // Every message belongs to a conversation (no FK constraint)
  childConversationId String?     // Child conversation created from this message (no FK constraint)
  senderId            String      // User who sent the message (no FK constraint)
  workspaceId         String?     // Workspace for ACL optimization (denormalized from conversation)
  content             String      // Text content
  msgType             MessageType @default(USER) // USER | BOT | SYSTEM
  hasAttachment       Boolean     @default(false) // Quick check for attachments
  edited              Boolean     @default(false) // Whether the message has been edited
  isDeleted           Boolean     @default(false)
  showInChannel       Boolean     @default(false) // Whether message should appear in channel
  visibleTo           String?     // null = public (visible to all), userId = visible only to the userId 
  createdAt           DateTime    @default(now())
  metadata            Json?       // Future extensibility
  nudgeCount          Int?        @default(0) // Proactive nudge count for this message
  isSent              Boolean     @default(true) // Whether the message is sent
  reactions_md      String?
  link_preview_md   String?

  // Relations
  messageSearch  MessageSearch? // One-to-one relation with search index
  conversation   Conversation   @relation(fields: [conversationId], references: [conversationId])
  sender         User           @relation("MessageSender", fields: [senderId], references: [id])
  reactions      Reaction[]
  reactionCounts ReactionCount[]
  externalMessages   ExternalMessage[] @relation("ExternalMessageEntity")

  @@index([conversationId, createdAt]) // Fast conversation message lookup
  @@index([workspaceId]) // ACL workspace filtering
  @@index([conversationId]) // Alternative simple index
  @@index([visibleTo]) // Fast visibility filtering
  @@index([conversationId, visibleTo]) // Composite index for visibility queries
  @@index([senderId])
  @@index([msgType, createdAt])

  @@index([conversationId, createdAt, messageId])
  @@map("messages")
  @@schema("public")
}
//Message Search Model
model MessageSearch {
  messageId        String      @id
  plaintextContent String
  searchVector     Unsupported("tsvector")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  message          Message     @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  @@map("message_search")
  @@schema("workflow")
}


// File Attachment Models
model MessageAttachment {
  id                 String                @id @default(cuid())
  entityType         AttachmentEntityType  // TICKET, CHAT, DRAFT, DELAYED_MESSAGE, etc.
  entityId           String                // Ticket id or message id (mandatory)
  workspaceId        String                // Workspace for ACL optimization
  storageProvider    String                // Storage provider where file is stored
  originalFilename   String                // Original filename uploaded by user
  mimetype           String                // image/png, application/pdf, etc.
  size               Int                   // Size in bytes
  width              Int?                  // Width in pixels (for images/videos)
  height             Int?                  // Height in pixels (for images/videos)
  uploadedByUserId   String                // User who uploaded (no FK constraint)
  createdAt          DateTime              @default(now())
  url                String                // URL for fetching the attachment (mandatory)
  createdBy          String                // User who uploaded the attachment (no FK constraint)
  metadata           Json?                 // Width/height for images, duration for videos, etc.
  conversationId     String?                // Every message belongs to a conversation (no FK constraint)
  thumbnailUrl       String?               // For images/videos
  isDeleted          Boolean               @default(false) // Soft-delete: true when attachment has been removed
  uploadStatus       AttachmentUploadStatus? // Tracks upload state

  // Relations
  conversation       Conversation?          @relation(fields: [conversationId], references: [conversationId])

  @@index([entityType])
  @@index([conversationId])
  @@index([entityId])
  @@index([entityId, id])
  @@map("message_attachments")
  @@schema("public")
}

// Reaction Models
model Reaction {
  reactionId  String   @id @default(cuid())
  messageId   String   // Message being reacted to (no FK constraint)
  userId      String   // User who reacted (no FK constraint)
  emojiName   String   // Any Unicode emoji: "👍", "❤️", "😄", "🎉", etc.
  createdAt   DateTime @default(now())

  // Relations
  message Message @relation(fields: [messageId], references: [messageId])

  @@unique([messageId, userId, emojiName]) // User can only react once per emoji per message
  @@index([messageId]) // Fast lookup of message reactions
  @@index([messageId, reactionId])
  @@map("reactions")
  @@schema("public")
}

model ReactionCount {
  countId     String   @id @default(cuid())
  messageId   String   // Message being counted (no FK constraint)
  emojiName   String   // The emoji being counted
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  // Relations
  message Message @relation(fields: [messageId], references: [messageId])

  @@unique([messageId, emojiName]) // One count record per emoji per message
  @@index([messageId]) // Fast lookup of message reaction counts
  @@index([messageId, countId])
  @@map("reaction_counts")
  @@schema("public")

}

// Custom Emoji Models
model CustomEmoji {
  id        String   @id @default(cuid())
  name      String   // Shortcode without colons, e.g. "party_parrot"
  url       String   // GCS path to the emoji image
  createdBy String   // User ID who created the emoji (no FK constraint)
  createdAt DateTime @default(now())

  @@unique([name])

  @@index([createdAt(sort: Desc), id])
  @@map("custom_emojis")
  @@schema("public")
}

// Activity Feed System
model Activity {
  id              String   @id @default(cuid())
  userId          String   // User who receives this notification (no FK constraint)
  workspaceId     String?  // Workspace for ACL optimization
  actorAction     String   // Action performed: 'mentioned_user', 'group_mention', 'replied', 'added', 'created', etc.
  /// @deprecated Use messageId, reactionId, or callId instead. Will be removed in future migration.
  actionSource    String   // Source entity: 'message', 'reaction', 'channel' (singular)
  /// @deprecated Use messageId, reactionId, or callId instead. Will be removed in future migration.
  actionSourceId  String   // ID of the source entity (no FK constraint)
  // New FK columns to replace polymorphic pattern
  messageId       String?  // FK to messages.messageId (no constraint)
  reactionId      String?  // FK to reactions.reactionId (no constraint)
  callId          String?  // FK to calls.id (no constraint)
  ticketId        String?  // FK to tickets.id (no constraint)
  conversationId  String?  // FK to conversations.conversationId (no constraint)
  channelId       String?  // Channel where the activity occurred (optional, not present for ticket activities)
  pullRequestId   String?  // FK to pull_requests.id (optional, present only for PR-related ticket activities)
  canvasId        String?  // FK to canvas.id for canvas mention activities (no constraint)
  blockId         String?  // Block ID within the canvas for canvas mention activities
  actorId         String  // User who performed the action (no FK constraint)
  classification  ActivityClassification @default(PENDING)
  classificationConfidence Float?
  classificationJobType ActivityClassificationJobType?
  isRead          Boolean  @default(false)
  isThreadActivity Boolean?  // True when activity is for a message inside a thread (not the initial message)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt  // For tracking when batched activity was last updated
  conversationSeenCutoffAt  DateTime?    // Track createdAt of the 25th most recent conversation from the activity


  @@index([userId, createdAt, id]) // for userActivitiesPaginated
  @@index([workspaceId]) // ACL workspace filtering
  @@index([userId, actorAction, createdAt, id]) // for userActivitiesPaginated
  @@index([userId, classification, createdAt, id]) // for userActivitiesPaginated
  @@index([userId, actorAction, classification, createdAt, id]) // for userActivitiesPaginated
  @@index([userId, actorAction, isRead]) // for userMissedCalls
  @@index([userId, isRead, createdAt]) // for userUnreadActivities
  @@index([userId, isRead, actionSource]) // for userUnreadThreadActivities (deprecated)
  @@index([userId, isRead, isThreadActivity]) // for filtering thread vs channel activities
  @@index([userId, createdAt]) // Fast lookup of user activities sorted by time
  @@index([userId, updatedAt]) // Fast lookup for batched activity updates
  @@index([userId, classification, createdAt]) // Fast lookup for classification tabs
  @@index([classification, classificationJobType, createdAt])
  @@index([classificationJobType, actionSourceId, channelId, classification])
  @@index([actionSource, actionSourceId]) // Fast lookup by source entity (deprecated)
  @@index([messageId]) // Fast lookup by message
  @@index([reactionId]) // Fast lookup by reaction
  @@index([callId]) // Fast lookup by call
  @@index([ticketId]) // Fast lookup by ticket
  @@index([channelId]) // Fast lookup by channel
  @@index([conversationId, userId]) // Fast lookup for reply batching
  @@index([actorId])

  @@index([userId, updatedAt(sort: Desc), id])
  @@index([userId, actorAction, isRead, id])
  @@map("activities")
  @@schema("public")
}

// Per-user OAuth tokens for external providers (Slack send-as-user, etc.)
model UserExternalToken {
  id              String    @id @default(cuid())
  userId          String
  provider        String                    // "slack", "google", "microsoft", etc.
  providerUserId  String?                   // External ID (e.g. Slack "U0123ABCDEF")
  encryptedToken  String                    // AES-256-CBC encrypted OAuth token
  refreshToken    String?                   // Encrypted refresh token (for providers that need it)
  expiresAt       DateTime?                 // Token expiry (null = never expires, e.g. Slack)
  connectedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
  @@index([provider])
  @@index([userId])
  @@map("user_external_tokens")
  @@schema("non_zero")
}

// External Source Integration Models
model ExternalSource {
  id              String   @id @default(cuid())
  name            String   @unique           // "zoho-euler", "slack-external"
  sourceType      String                    // "zoho", "slack", "jira", etc. - flexible string
  displayName     String                    // "Zoho (Euler Team)"
  channelId       String?                   // Target channel for messages (legacy/optional)
  workspaceId     String?
  boardId         String?                   // @deprecated - Use EmailChannelPreference.boardId instead. Target board for ticket creation (no FK constraint) - N:1 with Board
  ownerUserId     String?                   // @deprecated - Use EmailChannelPreference table instead. Owner for user-scoped integrations like Gmail search
  credentials     String                    // Encrypted credentials (IV:ciphertext format)
  isActive        Boolean  @default(true)
  lastSyncCursor  String?                   // Per-adapter resume cursor. Google: Gmail historyId. Microsoft: ISO timestamp of last synced receivedDateTime.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workspaceId, sourceType])
  @@index([boardId])
  @@index([ownerUserId])
  @@index([channelId])
  @@map("external_sources")
  @@schema("workflow")
}

enum ExternalEntityType {
  MESSAGE
  EMAIL
  TICKET
  ATTACHMENT
  CANVAS
  @@schema("public")
}

model ExternalMessage {
  id                 String   @id @default(cuid())
  externalSourceId   String                // External source ID (no FK constraint)
  externalId         String                // Message ID in external system (for deduplication)
  externalThreadId   String                // Thread/ticket ID in external system (to find conversation)
  entityType         ExternalEntityType    @default(MESSAGE)            
  entityId           String?               // Entity ID for MESSAGE, Email ID
  messageId          String                // Link to our Message (no FK constraint)
  direction          MessageDirection      // INCOMING | OUTGOING
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relation: entityId
  entity             Message?  @relation("ExternalMessageEntity", fields: [entityId], references: [messageId])

  @@unique([externalSourceId, externalId])  // Prevent duplicates
  @@index([externalSourceId, externalThreadId])  // Fast lookup by thread
  @@index([messageId])                           // Fast lookup by message
  @@map("external_messages")
  @@schema("workflow")
}

enum MessageDirection {
  INCOMING   // From external source → Xyne
  OUTGOING   // From Xyne → external source (Phase 2)
  @@schema("public")
}

enum ActivityClassification {
  ACTIONABLE
  FYI
  SKIP
  PENDING
  PROCESSING
  ERROR
  @@schema("public")
}

enum ActivityClassificationJobType {
  SINGLE
  SPECIAL_MENTION_AUDIENCE
  @@schema("public")
}

enum NudgeType {
  EXISTING_TICKET
  CREATE_TICKET
  SET_REMINDER
  ADD_TO_KB
  REVERSE_KB_LOOKUP
  THREAD_FOLLOW_UP
  DECISION_PENDING
  WAITING_ON_BLOCKED_BY
  @@schema("public")
}

enum NudgeKind {
  CREATE_TICKET_FROM_MESSAGE
  FIND_RELATED_TICKET_FROM_MESSAGE
  FIND_RELATED_MESSAGE_FROM_MESSAGE
  LINK_PASTE_TO_SURFACE
  FORWARD_MESSAGE_LINK
  DELETE_MESSAGE_CLEANUP
  SCHEDULE_CALL_FROM_THREAD
  @@schema("public")
}

enum NudgeState {
  ACTIVE
  DISMISSED
  ACTED_ON
  @@schema("public")
}

model ProactiveNudge {
  id                      String             @id @default(cuid())
  messageId               String

  type                    NudgeType
  priority                String             // HIGH, MEDIUM, LOW

  title                   String
  description             String             @db.Text

  // Interactive Elements
  evidenceSpans           String             @db.Text // Primary evidence snippet
  actions                 Json?              // Payload for CTAs and execution results

  state                   String             @default("ACTIVE") // ACTIVE, DISMISSED, ACTED_ON

  createdAt               DateTime           @default(now())

  @@unique([messageId])
  @@index([state])
  @@map("proactive_nudges")
  @@schema("public")
}

model SurfaceNudge {
  id          String            @id @default(cuid())
  nudgeKind   NudgeKind
  sourceId    String
  title       String
  description String            @db.Text
  priority    String?           @default("medium")
  actions     Json?
  state       NudgeState        @default(ACTIVE)
  visibleTo   String?
  surfaceNudgeCountId String?
  projectId   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([sourceId, state])
  @@index([projectId, state])
  @@index([surfaceNudgeCountId, state])
  @@index([createdAt])
  @@map("surface_nudges")
  @@schema("public")
}

model SurfaceNudgeCount {
  id             String   @id
  nudgeCount     Int
  userId         String?
  channelId      String?
  gid            String?
  gidType        String?
  messageId      String?
  ticketId       String?
  canvasId       String?
  callId         String?
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([messageId, userId])
  @@index([messageId, channelId])
  @@index([messageId, gid, gidType])
  @@index([ticketId, userId])
  @@index([ticketId, channelId])
  @@index([ticketId, gid, gidType])
  @@index([canvasId, userId])
  @@index([canvasId, channelId])
  @@index([canvasId, gid, gidType])
  @@index([callId, userId])
  @@index([callId, channelId])
  @@index([callId, gid, gidType])
  @@index([conversationId, userId])
  @@index([conversationId, channelId])
  @@index([conversationId, gid, gidType])
  @@map("surface_nudge_counts")
  @@schema("public")
}

// Notification System Enums
enum NotificationType {
  TICKET_STATUS_CHANGE
  TICKET_ASSIGNMENT
  TICKET_REASSIGNMENT
  TICKET_DUE_DATE_CHANGED
  TICKET_PRIORITY_CHANGED
  TICKET_USER_GROUP_CHANGED
  TICKET_TITLE_CHANGED
  TICKET_DESCRIPTION_CHANGED
  TICKET_RCA_CREATED
  TICKET_RCA_UPDATED
  TICKET_SUBTICKET_ADDED
  TICKET_RELATED_TICKET_ADDED
  TICKET_RELATED_TICKET_REMOVED
  CHANNEL_READ
  THREAD_READ
  CHANNEL_MESSAGE
  MENTION
  DIRECT_MESSAGE
  WORKFLOW_COMPLETION
  WORKFLOW_FAILURE
  THREAD_REPLY
  INCOMING_CALL
  MISSED_CALL
  CALL_DISMISS
  CALL_REMINDER
  CALL_SCHEDULED
  CALL_UPDATED
  EMAIL_FETCH_COMPLETED
  EMAIL_FETCH_FAILED
  CANVAS_SHARED
  EMAIL_REPLY_RECEIVED
  MESSAGE_DELETED
  MESSAGE_EDITED
  @@schema("public")
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
  DELIVERED
  FAILED
  @@schema("public")
}

enum NotificationDeliveryMethod {
  BROWSER
  EMAIL
  SLACK
  MOBILE
  IOS
  ANDROID
  @@schema("public")
}

enum NotificationLevel {
  ALL                    // All new posts - Messages and threads you follow
  MENTIONS_ONLY          // Just mentions - @you, @channel, @here
  THREADS_ONLY           // Only thread replies - For threads a user is subscribed to
  NONE
  @@schema("public")
}

// Notification System Models
model Notification {
  id                String                      @id @default(cuid())
  userId            String                      // User receiving the notification (no FK constraint)
  type              NotificationType
  title             String
  message           String
  status            NotificationStatus          @default(UNREAD)
  deliveryMethods   NotificationDeliveryMethod[]
  metadata          Json?                       // Additional context data
  relatedEntityType String?                     // "ticket", "workflow", "message", etc.
  relatedEntityId   String?                     // ID of the related entity
  actionUrl         String?                     // URL to navigate when notification is clicked
  expiresAt         DateTime?                   // Optional expiration for time-sensitive notifications
  readAt            DateTime?                   // When the notification was read
  dismissedAt       DateTime?                   // When the notification was dismissed
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([userId, status])
  @@index([type])
  @@index([relatedEntityType, relatedEntityId])
  @@index([createdAt])
  @@map("notifications")
  @@schema("workflow")
}

model NotificationPreference {
  id               String           @id @default(cuid())
  userId           String           // User ID (no FK constraint)
  notificationType NotificationType
  browserEnabled   Boolean          @default(true)
  emailEnabled     Boolean          @default(false)
  slackEnabled     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, notificationType])
  @@map("notification_preferences")
  @@schema("public")
}

model BrowserNotificationSubscription {
  id         String    @id @default(cuid())
  userId     String    // User ID (no FK constraint)
  endpoint   String    @unique // Push service endpoint
  p256dh     String    // Public key for encryption
  auth       String    // Authentication secret
  userAgent  String?   // Browser/device info
  isActive   Boolean   @default(true)
  lastUsedAt DateTime? // Track when subscription was last used
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("browser_notification_subscriptions")
  @@schema("workflow")
}

// Call Models
model Call {
  id               String      @id @default(cuid())
  externalId       String      @unique // Public ID for linking/sharing
  title            String?     // Meeting/call title
  createdByUserId  String      // User who initiated the call (no FK constraint)
  organizerId      String?     // Who organized the meeting
  channelId        String?     // Channel where call is happening (null for GOOGLE_CALENDAR origin)
  orgName          String?     // Organization name (no FK constraint)
  description      String?     // Meeting description/agenda
  callType         CallType    @default(VIDEO)
  callOrigin       CallOrigin  @default(CHANNEL)
  status           CallStatus  @default(ACTIVE)
  roomLink         String?     // LiveKit room URL/token
  startsAt         DateTime?   // Scheduled start time
  endsAt           DateTime?   // Scheduled end time
  timezone         String      @default("UTC")
  isRecurring      Boolean     @default(false)
  recurringSeriesId String?    // Links to parent series (app handles)
  recurrenceRule   String?     // RRULE format: "FREQ=WEEKLY;BYDAY=MO,WE,FR"
  instanceDate     DateTime?   // For recurring instances
  recordingEnabled Boolean     @default(false)
  recordingUrl     String?     // GCS path: recordings/{callId}.mp4
  transcript       String?     // Call transcript
  aiSummary        String?     // AI-generated summary
  startedAt        DateTime    @default(now())
  endedAt          DateTime?   // NULL = still active
  lastActivityAt   DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  metadata         Json?       // LiveKit room config, max participants, etc.
  callUpdatesChannel String?   // Non-null = post call updates to this channel (Case 3); null = no broadcast

  // Relations
  channel      Channel?          @relation(fields: [channelId], references: [id])
  participants CallParticipant[]
  recurringSeries RecurringCallSeries? @relation(fields: [recurringSeriesId], references: [id])

  @@index([externalId]) // Fast lookup by public ID
  @@index([createdByUserId]) // Fast lookup of user's calls
  @@index([organizerId]) // Fast lookup by organizer
  @@index([channelId]) // Fast lookup by channel
  @@index([status, lastActivityAt]) // Fast active calls lookup
  @@index([startsAt]) // Fast lookup by scheduled time
  @@index([recurringSeriesId]) // Fast lookup of recurring series
  @@index([isRecurring]) // Fast lookup of recurring calls
  @@index([instanceDate]) // Fast lookup by instance date
  @@index([orgName]) // Fast org call lookup

  @@index([status, startedAt(sort: Desc), externalId])
  @@index([status, startsAt, externalId])
  @@map("calls")
  @@schema("public")
}

model CallParticipant {
  id           String              @id @default(cuid())
  callId       String              // Call ID (no FK constraint)
  userId       String              // User ID (no FK constraint)
  invitedBy    String              // User who sent invitation (no FK constraint)
  invitedAt    DateTime            @default(now())
  response     InvitationResponse? // INVITED | REQUESTED | ACCEPTED | null (rejected/left)
  meetingStatus MeetingStatus      @default(PENDING)
  respondedAt  DateTime?           // When they accepted/rejected
  joinedAt     DateTime?           // NULL = not joined yet
  leftAt       DateTime?           // NULL = still in call
  metadata     Json?               // Connection quality, device info, etc.
  displayName  String?             // Name for external users
  isExternal   Boolean             @default(false)  // True for external lobby users

  // Relations
  call Call @relation(fields: [callId], references: [id])

  @@unique([callId, userId]) // Prevent duplicate participants
  @@index([callId]) // Fast call participant lookup
  @@index([userId]) // Fast user call lookup
  @@index([callId, leftAt]) // Fast active participants lookup
  @@index([response]) // Fast response lookup
  @@map("call_participants")
  @@schema("public")
}

model RecurringCallSeries {
  id             String                    @id @default(cuid())
  title          String                    // Series title
  description    String?                   // Series description/agenda
  organizerId    String                    // User who created the series (no FK constraint)
  channelId      String                    // Channel where calls happen (no FK constraint)
  recurrenceRule String                    // RRULE pattern; UNTIL/COUNT are supported — backend derives endsOn from them
  timezone       String                    // IANA timezone e.g. "America/New_York"
  startTime      String                    // Time of day, 24h format e.g. "10:00"
  endTime        String                    // Time of day, 24h format e.g. "11:00"
  status         RecurringCallSeriesStatus @default(ACTIVE)
  startsOn       DateTime                  // Series start date (first possible occurrence)
  endsOn         DateTime?                 // Series end date (null = indefinite)
  metadata           Json?                     // Extra config e.g. { "reminderMinutes": 10 }
  callUpdatesChannel String?                   // Non-null = post call updates to this channel (Case 3); null = no broadcast
  createdAt          DateTime                  // Set explicitly in code
  updatedAt          DateTime                  @updatedAt

  // Relations
  instances Call[] // All Call instances generated from this series

  @@index([organizerId])  // Fast lookup of series created by a user
  @@index([channelId])    // Fast lookup of series in a channel
  @@index([status])       // Fast lookup of active series
  @@map("recurring_call_series")
  @@schema("public")
}

// Canvas Feature Models (Notion/Slack Canvas-like documents)

enum CanvasVisibility {
  PUBLIC
  PRIVATE
  @@schema("public")
}

enum CanvasRole {
  OWNER
  EDITOR
  VIEWER
  @@schema("public")
}

enum DocType {
  Canvas
  Quarto
  @@schema("public")
}

// Canvas folders for manual canvas organization within a project, a specific
// channel, or a user's personal "My Canvases" scope.
model CanvasFolder {
  id        String   @id @default(cuid())
  projectId String?
  channelId String?
  name      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project? @relation(fields: [projectId], references: [id])
  channel  Channel? @relation(fields: [channelId], references: [id])
  canvases Canvas[] @relation("FolderCanvases")

  // Prisma can model channel-scoped uniqueness; project-root and personal-root
  // nullable uniqueness are enforced by partial unique indexes in the SQL migration.
  @@unique([projectId, channelId, name], map: "canvas_folders_projectId_channelId_name_key")
  @@index([projectId])
  @@index([channelId])
  @@index([projectId, channelId])
  @@index([createdBy])
  @@map("canvas_folders")
  @@schema("public")
}

model Canvas {
  id           String           @id @default(cuid())
  title        String
  content      Json // BlockNote JSON block array
  channelId    String? // Optional: Link to a channel (no FK constraint)
  folderId     String? // Optional: Link to a folder (NULL = ungrouped/personal)
  projectId    String? // Direct project link for canvases not in folders
  createdBy    String // User ID (no FK constraint)
  viewAccessId String? @unique // Random ID for view-only access
  editAccessId String? @unique // Random ID for edit access
  visibility   CanvasVisibility @default(PRIVATE)
  isTemplate   Boolean          @default(false)
  lastEditedBy String? // Last user who edited (no FK constraint)
  lastEditedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  metadata     Json? // Tags, categories, custom properties
  isCollaborative   Boolean   @default(false)

  // Doc type - Canvas or Quarto
  docType      DocType          @default(Canvas)

  // Relations
  participants CanvasParticipant[]
  userStatuses CanvasUserStatus[]
  versions     CanvasVersion[]
  folder       CanvasFolder? @relation("FolderCanvases", fields: [folderId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  // Quarto Doc fields - when docType is Quarto
  userRepo     String?          // Combined org/repo/branch identifier (for backward compatibility)
  repoId       String?          // Repo ID (no FK constraint) - for editing capability
  branchName   String?          // Branch name for the Quarto doc
  entryFile    String?          // Entry file path within the bundle
  quartoDocumentType String?    // "docs" | "book" | "slides" | "website" (type of Quarto document)
  gcsPath      String?          // Path in GCS where the bundle is stored

  @@unique([userRepo]) // One doc per repo/branch combination (backward compatibility)
  @@unique([repoId, branchName]) // One doc per repo/branch combination (when repoId is set)
  @@index([createdBy])
  @@index([channelId])
  @@index([folderId])
  @@index([projectId])
  @@index([visibility])
  @@index([isTemplate])
  @@index([viewAccessId])
  @@index([editAccessId])
  @@index([docType])

  @@index([createdBy, updatedAt(sort: Desc), id])
  @@index([docType, updatedAt(sort: Desc), id])
  @@map("canvases")
  @@schema("public")
}

model CanvasVersion {
  id          String   @id @default(cuid())
  canvasId    String
  name        String
  content     Json
  contentHash String
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@unique([canvasId, contentHash])
  @@index([canvasId, updatedAt])
  @@index([createdBy])

  @@map("canvas_versions")
  @@schema("public")
}

model CanvasParticipant {
  id          String     @id @default(cuid())
  canvasId    String // Canvas ID (no FK constraint)
  userId      String? // User ID (no FK constraint)
