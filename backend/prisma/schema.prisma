  approvedBy            String?        // User ID (no FK constraint)
  approvedAt            DateTime?
  createdAt             DateTime       @default(now())

  @@index([releaseId])
  @@index([applicationReleaseId])
  @@index([applicationId])
  @@map("release_changes")
  @@schema("public")
}

/// Per-instance anchor for a single env/migration change emitted during
/// release commit analysis. Each row pairs with a `form_entity_values`
/// bag (entityId = this row's id) that holds the variable kind-specific
/// fields (envKey/oldValue/newValue, changeLog/query, etc.). Legacy
/// pre-v2 rows existed as a per-(app, kind) lookup registry and have
/// all linkage columns NULL — release-scoped reads filter on
/// `releaseId IS NOT NULL` so they don't bleed into v2 surfaces.
model ReleaseChangeType {
  id              String   @id @default(cuid())
  applicationId   String   // Application ID
  changeType      String   // e.g., "env", "migrations", "database", etc.
  releaseId            String? // Parent release Ticket id (matches release_events.releaseId)
  applicationReleaseId String? // Per-app SubTicket id (matches release_events.applicationReleaseId)
  devTicketXyneId      String? // Dev ticket xyneId carried from the source commit's PR title
  commitId             String? // Source commit hash
  filePath             String? // File path of the change (identifies the instance + dedupes)
  // No @default(now()): avoid a DB-level now() default on a Zero-synced table.
  // The repository sets createdAt explicitly on every write; pre-existing rows
  // are backfilled with a fixed literal in the migration, which drops the default.
  createdAt            DateTime?

  @@index([id])
  @@index([applicationId])
  @@index([changeType])
  @@index([releaseId])
  @@index([applicationReleaseId])
  @@index([devTicketXyneId])
  @@map("release_change_types")
  @@schema("public")
}

