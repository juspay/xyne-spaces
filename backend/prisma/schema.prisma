  FYI
  SKIP
  PENDING
  PROCESSING
  ERROR
  @@schema("public")
}

enum ActivityClassificationJobType {
  SINGLE
  SPECIAL_MENTION_AUDIENCE
  @@schema("public")
}

// Notification System Enums
enum NotificationType {
  TICKET_STATUS_CHANGE
  TICKET_ASSIGNMENT
  TICKET_REASSIGNMENT
  MENTION
  DIRECT_MESSAGE
  WORKFLOW_COMPLETION
  WORKFLOW_FAILURE
  THREAD_REPLY
  INCOMING_CALL
  MISSED_CALL
  CALL_DISMISS
  @@schema("public")
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
  DELIVERED
  FAILED
  @@schema("public")
}

enum NotificationDeliveryMethod {
  BROWSER
  EMAIL
  SLACK
  MOBILE
  IOS
  ANDROID
  @@schema("public")
}

// Notification System Models
model Notification {
  id                String                      @id @default(cuid())
  userId            String                      // User receiving the notification (no FK constraint)
  type              NotificationType
  title             String
  message           String
  status            NotificationStatus          @default(UNREAD)
  deliveryMethods   NotificationDeliveryMethod[]
  metadata          Json?                       // Additional context data
  relatedEntityType String?                     // "ticket", "workflow", "message", etc.
  relatedEntityId   String?                     // ID of the related entity
  actionUrl         String?                     // URL to navigate when notification is clicked
  expiresAt         DateTime?                   // Optional expiration for time-sensitive notifications
  readAt            DateTime?                   // When the notification was read
  dismissedAt       DateTime?                   // When the notification was dismissed
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([userId, status])
  @@index([type])
  @@index([relatedEntityType, relatedEntityId])
  @@index([createdAt])
  @@map("notifications")
  @@schema("public")
}

model NotificationPreference {
  id               String           @id @default(cuid())
  userId           String           // User ID (no FK constraint)
  notificationType NotificationType
  browserEnabled   Boolean          @default(true)
  emailEnabled     Boolean          @default(false)
  slackEnabled     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, notificationType])
  @@map("notification_preferences")
  @@schema("public")
}

model BrowserNotificationSubscription {
  id         String    @id @default(cuid())
  userId     String    // User ID (no FK constraint)
  endpoint   String    @unique // Push service endpoint
  p256dh     String    // Public key for encryption
  auth       String    // Authentication secret
  userAgent  String?   // Browser/device info
  isActive   Boolean   @default(true)
  lastUsedAt DateTime? // Track when subscription was last used
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("browser_notification_subscriptions")
  @@schema("public")
}

// Call Models
model Call {
  id               String      @id @default(cuid())
  externalId       String      @unique // Public ID for linking/sharing
  title            String?     // Meeting/call title
  createdByUserId  String      // User who initiated the call (no FK constraint)
  organizerId      String?     // Who organized the meeting
  channelId        String      // Channel where call is happening (no FK constraint)
  orgName          String?     // Organization name (no FK constraint)
  description      String?     // Meeting description/agenda
  callType         CallType    @default(VIDEO)
  status           CallStatus  @default(ACTIVE)
  roomLink         String?     // LiveKit room URL/token
  startsAt         DateTime?   // Scheduled start time
  endsAt           DateTime?   // Scheduled end time
  timezone         String      @default("UTC")
  isRecurring      Boolean     @default(false)
  recurringSeriesId String?    // Links to parent series (app handles)
  recurrenceRule   String?     // RRULE format: "FREQ=WEEKLY;BYDAY=MO,WE,FR"
  instanceDate     DateTime?   // For recurring instances
  recordingEnabled Boolean     @default(false)
  transcript       String?     // Call transcript
  aiSummary        String?     // AI-generated summary
  startedAt        DateTime    @default(now())
  endedAt          DateTime?   // NULL = still active
  lastActivityAt   DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  metadata         Json?       // LiveKit room config, max participants, etc.

  @@index([externalId]) // Fast lookup by public ID
  @@index([createdByUserId]) // Fast lookup of user's calls
  @@index([organizerId]) // Fast lookup by organizer
  @@index([channelId]) // Fast lookup by channel
  @@index([status, lastActivityAt]) // Fast active calls lookup
  @@index([startsAt]) // Fast lookup by scheduled time
  @@index([recurringSeriesId]) // Fast lookup of recurring series
  @@index([isRecurring]) // Fast lookup of recurring calls
  @@index([instanceDate]) // Fast lookup by instance date
  @@index([orgName]) // Fast org call lookup
  @@map("calls")
  @@schema("public")
}

model CallParticipant {
  id           String              @id @default(cuid())
  callId       String              // Call ID (no FK constraint)
  userId       String              // User ID (no FK constraint)
  invitedBy    String              // User who sent invitation (no FK constraint)
  invitedAt    DateTime            @default(now())
  response     InvitationResponse? // INVITED | ACCEPTED | null (rejected/left)
  respondedAt  DateTime?           // When they accepted/rejected
  joinedAt     DateTime?           // NULL = not joined yet
  leftAt       DateTime?           // NULL = still in call
  metadata     Json?               // Connection quality, device info, etc.

  @@unique([callId, userId]) // Prevent duplicate participants
  @@index([callId]) // Fast call participant lookup
  @@index([userId]) // Fast user call lookup
  @@index([callId, leftAt]) // Fast active participants lookup
  @@index([response]) // Fast response lookup
  @@map("call_participants")
  @@schema("public")
}

// Canvas Feature Models (Notion/Slack Canvas-like documents)

enum CanvasVisibility {
  PUBLIC
  PRIVATE
  @@schema("public")
}

enum CanvasRole {
  OWNER
  EDITOR
  VIEWER
  @@schema("public")
}

enum DocType {
  Canvas
  Quarto
  @@schema("public")
}

model Canvas {
  id           String           @id @default(cuid())
  title        String
  content      Json // BlockNote JSON block array
  channelId    String? // Optional: Link to a channel (no FK constraint)
  createdBy    String // User ID (no FK constraint)
  viewAccessId String? @unique // Random ID for view-only access
  editAccessId String? @unique // Random ID for edit access
  visibility   CanvasVisibility @default(PRIVATE)
  isTemplate   Boolean          @default(false)
  lastEditedBy String? // Last user who edited (no FK constraint)
  lastEditedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  metadata     Json? // Tags, categories, custom properties
  isCollaborative   Boolean   @default(false)

  // Doc type - Canvas or Quarto
  docType      DocType          @default(Canvas)
  // Quarto Doc fields - when docType is Quarto
  userRepo     String?          // Combined org/repo/branch identifier (for backward compatibility)
  repoId       String?          // Repo ID (no FK constraint) - for editing capability
  branchName   String?          // Branch name for the Quarto doc
  entryFile    String?          // Entry file path within the bundle
  quartoDocumentType String?    // "docs" | "book" | "slides" | "website" (type of Quarto document)
  gcsPath      String?          // Path in GCS where the bundle is stored

  @@unique([userRepo]) // One doc per repo/branch combination (backward compatibility)
  @@unique([repoId, branchName]) // One doc per repo/branch combination (when repoId is set)
  @@index([createdBy])
  @@index([channelId])
  @@index([visibility])
  @@index([isTemplate])
  @@index([viewAccessId])
  @@index([editAccessId])
  @@index([docType])
  @@map("canvases")
  @@schema("public")
}

model CanvasParticipant {
  id        String     @id @default(cuid())
  canvasId  String // Canvas ID (no FK constraint)
  userId    String // User ID (no FK constraint)
  role      CanvasRole @default(VIEWER) // OWNER | EDITOR | VIEWER
  joinedAt  DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([canvasId, userId]) // User can only have one role per canvas
  @@index([canvasId])
  @@index([userId])
  @@map("canvas_participants")
  @@schema("public")
}

// Bookmark Feature Models
enum BookmarkEntityType {
  MESSAGE
  CONVERSATION
  TICKET
  CANVAS
  @@schema("public")
}

model Bookmark {
  id         String             @id @default(cuid())
  userId     String             // User who bookmarked (no FK constraint)
  entityId   String             // ID of the bookmarked entity
  entityType BookmarkEntityType // Type of entity bookmarked
  createdAt  DateTime           @default(now())
  metadata   Json?              // Additional metadata

  @@unique([userId, entityId, entityType]) // User can only bookmark an entity once
  @@index([userId, entityType]) // Fast lookup of user's bookmarks by type
  @@index([userId, createdAt]) // Fast lookup of user's bookmarks sorted by time
  @@map("bookmarks")
  @@schema("public")
}

// Vespa Insertion Logs
enum VespaInsertionStatus {
  PENDING
  FAILED
  @@schema("public")
}

enum VespaOperationType {
  INSERT
  UPDATE
  DELETE
  @@schema("public")
}

model VespaInsertionLogs {
  id           String                @id @default(cuid())
  entityId     String
  entityType   String
  type         VespaOperationType    // INSERT | UPDATE | DELETE
  status       VespaInsertionStatus  @default(PENDING)
  namespace    String?
  cluster      String?
  errorMessage String?
  errorDetails Json?
  retryCount   Int                   @default(0)
  createdAt    DateTime              @default(now())
  resolvedAt   DateTime?
  userId       String?               // User who initiated the operation

  @@index([entityId])
  @@index([entityType])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([entityId, entityType])
  @@map("vespa_insertion_logs")
  @@schema("public")
}

// Repository Configuration for IDE Integration
model Repo {
  id         String @id @default(cuid())
  name       String         // e.g., "xyne-spaces"
  url        String         // SSH or HTTPS URL
  baseBranch Json           // Base branches to checkout from: ["main", "develop"]
  prefix     String         // Branch prefix: "feature"
  createdBy  String         // User who added the repo

  @@unique([url, createdBy]) // Same repo can be added by different users
  @@index([name])
  @@map("repos")
  @@schema("public")
}

// Form Models
enum FormFieldType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  SINGLE_SELECT
  MULTI_SELECT
  USER
  @@schema("public")
}

enum FormContextType {
  BOARD
  @@schema("public")
}

enum FormEntityType {
  TICKET
  @@schema("public")
}

model Form {
  id              String         @id @default(cuid())
  formName        String
  formDescription String?
  entityType      FormEntityType
  contextType     FormContextType
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([createdBy])
  @@index([entityType, contextType])
  @@map("forms")
  @@schema("public")
}

model FormContextMapping {
  id          String         @id @default(cuid())
  formId      String
  contextId   String
  contextType FormContextType
  entityType  FormEntityType

  @@unique([contextId, contextType, formId])
  @@unique([contextId, entityType])
  @@index([contextId, contextType])
  @@map("forms_context_mapping")
  @@schema("public")
}

model FormFields {
  id         String   @id @default(cuid())
  formId     String   // Reference to Form
  fieldName  String   // Name of the field
  fieldType  FormFieldType
  fieldEnum  Json?
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([formId, fieldName]) // Prevent duplicate fields per form
  @@index([formId])
  @@map("form_fields")
  @@schema("public")
}

model FormEntityValues {
  id              String   @id @default(cuid())
  entityId        String   // ID of the entity (e.g., ticketId, userId, etc.)
  entityType      String   // Type of entity (e.g., "TICKET", "USER", etc.)
  fieldId         String   // Reference to FormFieldsMapping.id
  fieldValue      String   // Value stored as String (backward compatibility)
  actualFieldValue Json?   // Value stored as Json for structured data (parse based on fieldType)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([entityId, entityType])
  @@index([fieldId])
  @@unique([entityId, entityType, fieldId]) // One value per field per entity
  @@map("form_entity_values")
  @@schema("public")
}

model Dashboard {
  id           String    @id @default(cuid())
  name         String
  description  String?
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("dashboards")
  @@schema("public")
}

model Query {
  id          String    @id @default(cuid())
  title       String
  queryJson   Json
  entityType  FormEntityType
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("queries")
  @@schema("public")
}

model dashboardQueryMapping {
  id          String    @id @default(cuid())
  dashboardId String
  queryId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dashboardId])
  @@map("dashboard_queries_mapping")
  @@schema("public")
}



