# Azure OpenAI Configuration for STT (Speech-to-Text)
AZURE_OPENAI_STT_ENDPOINT=https://genius-gpt-4.openai.azure.com
AZURE_OPENAI_STT_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_STT_API_VERSION=2025-03-01-preview
AZURE_OPENAI_STT_MODEL=gpt-4o-transcribe

# STT Provider Selection: 'azure' (default), 'google', or 'deepgram'
STT_MODEL=azure
# STT provider specifically for voice input dictation (defaults to STT_MODEL if not set)
# Options: azure, google, deepgram
VOICE_INPUT_STT_MODEL=google

# Google Cloud STT Configuration (required when STT_MODEL=google)
# In Docker: GOOGLE_APPLICATION_CREDENTIALS is set via docker-compose to /gcloud/dev_ai_gamma.json
# (mounted from ${HOME}/.config/gcloud/dev-ai-gamma-2e3b02b4e893.json)
# For local runs outside Docker, either set GOOGLE_APPLICATION_CREDENTIALS to the file path:
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/gcloud/dev-ai-gamma-2e3b02b4e893.json
# Or inline the JSON content here:
GOOGLE_VOICE_CREDENTIALS_JSON=
GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_LANGUAGE=en-US
# chirp_3 has no streaming+adaptation; streaming uses chirp_2 (supports streaming hints)
GOOGLE_STT_STREAM_MODEL=chirp_2
# chirp_2 is not in the "us" multi-region; streaming needs a region that hosts it
GOOGLE_STT_STREAM_LOCATION=us-central1

# Deepgram STT Configuration (required when STT_MODEL=deepgram)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# LiveKit Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# GCS Configuration
GCS_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-transcription-bucket
# Path to a credentials JSON (ADC or service-account) passed explicitly to the GCS client.
# In Docker this is set to /gcloud/application_default_credentials.json by docker-compose.
# For local runs, point it at your ADC file or a service-account key:
# GCS_CREDENTIALS_FILE=/Users/you/.config/gcloud/application_default_credentials.json
GCS_CREDENTIALS_FILE=

# Transcript incremental flush: upload the in-memory transcript buffer to GCS every N
# transcription events, so a crash / OOM / forced restart loses at most N events.
# Event-count based (no idle time-based writes). Set to 0 to disable (flush only at end).
TRANSCRIPT_FLUSH_EVERY_N_EVENTS=5

# Backend API Configuration (for webhook notification)
# The Python agent calls this endpoint to trigger transcript processing
BACKEND_URL=http://localhost:3001
TRANSCRIPTION_AGENT_API_KEY=your-secure-shared-key-here

# --- Referenced in code but missing (env normalization); secrets empty ---
AGENT_LIVEKIT_URL=
AI_VOICE_ENABLED_DEFAULT=
APP_ENV=
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
