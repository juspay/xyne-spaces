
# STT Provider Selection: 'azure' (default), 'google', or 'deepgram'
STT_MODEL=azure
# STT provider specifically for voice input dictation (defaults to STT_MODEL if not set)
# Options: azure, google, deepgram
VOICE_INPUT_STT_MODEL=google

# Google Cloud STT Configuration (required when STT_MODEL=google)
# In Docker: GOOGLE_APPLICATION_CREDENTIALS is set via docker-compose to /gcloud/dev_ai_gamma.json
# (mounted from ${HOME}/.config/gcloud/dev-ai-gamma-2e3b02b4e893.json)
# For local runs outside Docker, either set GOOGLE_APPLICATION_CREDENTIALS to the file path:
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/gcloud/dev-ai-gamma-2e3b02b4e893.json
# Or inline the JSON content here:
GOOGLE_VOICE_CREDENTIALS_JSON=
GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_LANGUAGE=en-US
# chirp_3 has no streaming+adaptation; streaming uses chirp_2 (supports streaming hints)
GOOGLE_STT_STREAM_MODEL=chirp_2
# chirp_2 is not in the "us" multi-region; streaming needs a region that hosts it
GOOGLE_STT_STREAM_LOCATION=us-central1

# Deepgram STT Configuration (required when STT_MODEL=deepgram)
DEEPGRAM_API_KEY=deepgram-api-key-here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# LiveKit Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# AGENT_LIVEKIT_URL=ws://livekit:7880 # Overrides LIVEKIT_URL when running in Docker

# STT Provider: 'azure' (default) or 'chutes'
STT_PROVIDER=azure

CHUTES_STT_BASE_URL=https://chutes-whisper-large-v3.chutes.ai
CHUTES_STT_API_KEY=your_chutes_api_key_here

STT_MODEL=azure # 'azure', 'google', or 'deepgram'
AZURE_OPENAI_STT_ENDPOINT=
AZURE_OPENAI_STT_API_KEY=your_azure_api_key_here
AZURE_OPENAI_STT_API_VERSION=2025-03-01-preview
AZURE_OPENAI_STT_MODEL=gpt-4o-transcribe

GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_LANGUAGE=en-US
# GCS Configuration
GCS_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-transcription-bucket
# Path to a credentials JSON (ADC or service-account) passed explicitly to the GCS client.
# In Docker this is set to /gcloud/application_default_credentials.json by docker-compose.
# For local runs, point it at your ADC file or a service-account key:
# GCS_CREDENTIALS_PATH=/Users/you/.config/gcloud/application_default_credentials.json
GCS_CREDENTIALS_PATH=

DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

VAD_ACTIVATION_THRESHOLD=0.45
VAD_MIN_SPEECH_DURATION=0.15
VAD_MIN_SILENCE_DURATION=0.4
VAD_MAX_BUFFERED_SPEECH=5.0

AI_VOICE_ENABLED_DEFAULT=false

# Speaker diarization / voiceprint identification
# Defaults to false (opt-in). Set true to install diarization dependencies/models
# and enable voiceprint fetches, enrollment, and identified transcripts.
DIARIZATION_ENABLED=false

# LLM Chat Completions (for transcript summarization/AI Agent responses)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=your_azure_llm_key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MODEL=gpt-4.1

# Text-to-Speech (TTS)
AZURE_OPENAI_TTS_ENDPOINT=
AZURE_OPENAI_TTS_API_KEY=your_azure_tts_key
AZURE_OPENAI_TTS_API_VERSION=2025-03-01-preview
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_OPENAI_TTS_VOICE=shimmer

# Backend API (for webhook notifications)
BACKEND_URL=http://localhost:3001
TRANSCRIPTION_AGENT_API_KEY=your-secure-shared-key-here

# Google Cloud Storage (for raw transcription .jsonl backup)
GCS_PROJECT_ID=
TRANSCRIPTION_BUCKET_NAME=

# Redis (for conversation state and history)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_TLS=false

NODE_ENV=development
# DEBUG_AUDIO_STORAGE=true
# DEBUG_AUDIO_STORAGE_PATH=/tmp/xyne-audio-debug
