{
  "name": "xyne-spaces",
  "license": "Apache-2.0",
  "version": "1.252.0",
  "description": "Xyne Spaces - Monorepo with Backend and Dashboard",
  "scripts": {
    "prepare": "husky",
    "setup": "pnpm install && pnpm run build:shared",
    "install:all": "pnpm install",
    "build:shared": "pnpm --filter @xyne/shared --filter @xyne/storage --filter @xyne/icons --filter agentic-framework --filter @xyne/litellm-client run build",
    "doctor": "node scripts/xyne-doctor.mjs",
    "doctor:demo": "node scripts/xyne-doctor.mjs --demo",
    "doctor:test": "node --test scripts/xyne-doctor.test.mjs",
    "doctor:llm": "node scripts/ping-llm.mjs",
    "services": "node scripts/xyne-doctor.mjs services",
    "services:raw": "node scripts/select-services.mjs",
    "services:sh": "chmod +x scripts/start-services.sh && ./scripts/start-services.sh",
    "services:win": "bash scripts/start-services-win.sh",
    "secrets": "node scripts/generate-local-secrets.mjs",
    "env:setup": "node scripts/setup-env-files.mjs",
    "services:stop": "docker info > /dev/null 2>&1 && docker compose -f docker-compose.local.yml --profile transcription --profile egress --profile search down || (command -v podman-compose > /dev/null && podman-compose -f docker-compose.local.yml --profile transcription --profile egress --profile search down || podman compose -f docker-compose.local.yml --profile transcription --profile egress --profile search down)",
    "dev": "node scripts/dev-interactive.mjs",
    "dev:all": "node scripts/dev-interactive.mjs",
    "dev:all:raw": "node scripts/dev-interactive.mjs",
    "dev:all:plain": "pnpm exec concurrently --names 'backend,worker,dashboard,claw,auth,auth-ui' --prefix-colors 'blue,cyan,green,yellow,magenta,red' --kill-others --kill-signal SIGTERM --kill-timeout 5000 'pnpm --filter xyne-spaces-backend dev' 'pnpm --filter xyne-spaces-backend dev:worker' 'pnpm --filter xyne-spaces-dashboard dev' 'pnpm --filter xyne-claw dev' 'pnpm --filter xyne-claw-auth dev' 'pnpm --filter xyne-claw-auth-ui dev'",
    "validate": "node scripts/xyne-doctor.mjs validate",
    "bootstrap": "node scripts/xyne-doctor.mjs bootstrap-infra && node scripts/dev-interactive.mjs",
    "bootstrap:infra:raw": "pnpm run env:setup && pnpm run setup && pnpm run secrets && pnpm run services:raw",
    "bootstrap:raw": "pnpm run bootstrap:infra:raw && pnpm run dev:all:plain",
    "up": "node scripts/xyne-doctor.mjs bootstrap-infra && node scripts/dev-interactive.mjs",
    "services:vespa": "chmod +x vespa-core/scripts/deploy-dev.sh && ./vespa-core/scripts/deploy-dev.sh",
    "sandbox": "chmod +x scripts/sandbox.sh && ./scripts/sandbox.sh",
    "cleanup": "chmod +x scripts/cleanup-storage.sh && ./scripts/cleanup-storage.sh",
    "sdlc:cleanup": "bash scripts/cleanup-sdlc-local.sh",
    "reset": "chmod +x scripts/reset-local.sh && ./scripts/reset-local.sh",
    "yama": "node node_modules/@juspay/yama/dist/cli/v2.cli.js",
    "test": "./tools/xyne-automation/scripts/run-test.sh",
    "test:integrity": "pnpm --filter xyne-automation run test:integrity",
    "test:push": "./tools/xyne-automation/scripts/push-report-branch.sh",
    "test:enum": "bash scripts/validate-no-new-enums.sh"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@semantic-release/changelog": "^6.0.1",
    "@semantic-release/commit-analyzer": "^9.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^11.0.0",
    "@semantic-release/release-notes-generator": "^10.0.3",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.0.11",
    "mprocs": "^0.9.6",
    "semantic-release": "^22.0.5"
  },
  "dependencies": {
    "@juspay/yama": "^2.2.0",
    "html-to-text": "^9.0.5"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "release-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]",
        "prerelease": true
      }
    ],
    "repositoryUrl": "ssh://git@github.com/juspay/xyne-spaces.git",
    "tagFormat": "v${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "parserOpts": {
            "headerPattern": "^(?:(?:Pull [Rr]equest #\\d+:\\s*)+)?(\\w+)(?:\\([^)]*\\))?:\\s*(?:(XYNE-\\d+):?\\s*)?(.+)$",
            "headerCorrespondence": [
              "type",
              "ticket",
              "subject"
            ],
            "revertPattern": "^(?:(?:Pull [Rr]equest #\\d+:\\s*)+)?Revert\\s+\"(.+)\"",
            "revertCorrespondence": [
              "header"
            ]
          },
          "releaseRules": [
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "type": "feature",
              "release": "minor"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "revert",
              "release": "patch"
            },
            {
              "revert": true,
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            },
            {
              "type": "build",
              "release": "patch"
            },
            {
              "type": "ci",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": false
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "parserOpts": {
            "headerPattern": "^(?:(?:Pull [Rr]equest #\\d+:\\s*)+)?(\\w+)(?:\\([^)]*\\))?:\\s*(?:(XYNE-\\d+):?\\s*)?(.+)$",
            "headerCorrespondence": [
              "type",
              "ticket",
              "subject"
            ],
            "revertPattern": "^(?:(?:Pull [Rr]equest #\\d+:\\s*)+)?Revert\\s+\"(.+)\"",
            "revertCorrespondence": [
              "header"
            ]
          }
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": false,
          "pkgRoot": "apps/dashboard"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/changelog",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "apps/dashboard/package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]",
          "gitArgs": [
            "--no-verify"
          ]
        }
      ]
    ]
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "packageExtensions": {
      "@semantic-release/commit-analyzer": {
        "dependencies": {
          "conventional-changelog-conventionalcommits": "7.0.2"
        }
      },
      "@semantic-release/release-notes-generator": {
        "dependencies": {
          "conventional-changelog-conventionalcommits": "7.0.2"
        }
      }
    },
    "overrides": {
      "@excalidraw/excalidraw": "0.18.1",
      "@excalidraw/excalidraw>react": "^19.2.1",
      "@excalidraw/excalidraw>react-dom": "^19.2.1",
      "@excalidraw/mermaid-to-excalidraw": "1.1.3",
      "@grpc/grpc-js": "1.14.4",
      "@hapi/wreck": "18.1.2",
      "@hono/node-server": "1.19.15",
      "@isaacs/brace-expansion": "5.0.1",
      "@livekit/components-core": "0.12.12",
      "@livekit/protocol": "1.48.0",
      "@modelcontextprotocol/sdk": "1.29.0",
      "@opentelemetry/auto-instrumentations-node": "0.78.0",
