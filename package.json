      "@terrastruct/d2": "0.1.33",
      "@types/express": "4.17.25",
      "@xmldom/xmldom": "0.8.13",
      "adm-zip": "0.6.0",
      "ajv@6": "6.14.0",
      "ajv@8": "8.18.0",
      "axios": "1.18.1",
      "basic-ftp": "5.3.1",
      "body-parser": "2.3.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "deepmerge-ts": "8.0.0",
      "defu": "6.1.7",
      "diff@8": "8.0.3",
      "dompurify@3": "3.4.13",
      "effect": "3.22.0",
