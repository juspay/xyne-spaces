{
  "name": "xyne-spaces",
  "version": "1.184.0",
  "description": "Xyne Spaces - Monorepo with Backend and Dashboard",
  "scripts": {
    "prepare": "husky",
    "setup": "npm --prefix shared install && npm --prefix icons install && npm install && npm run install:all",
    "install:all": "npm --prefix shared install && npm --prefix icons install && npm --prefix packages/kata-sdk install && npm --prefix xyne-claw-shared install && npm --prefix backend install && npm --prefix dashboard install && npm --prefix xyne-claw install && npm --prefix xyne-claw-auth/backend install && npm --prefix xyne-claw-auth/frontend install",
    "build:shared": "npm --prefix shared run build && npm --prefix icons run build",
    "services": "chmod +x scripts/start-services.sh && ./scripts/start-services.sh",
    "services:win": "bash scripts/start-services-win.sh",
    "services:stop": "docker info > /dev/null 2>&1 && docker compose -f docker-compose.dev.yml down || (command -v podman-compose > /dev/null && podman-compose -f docker-compose.dev.yml down || podman compose -f docker-compose.dev.yml down)",
    "dev:all": "npx concurrently --names 'backend,dashboard,claw,auth' --prefix-colors 'blue,green,yellow,magenta' --kill-others-on-fail 'npm run dev --prefix backend' 'npm run dev --prefix dashboard' 'npm run dev --prefix xyne-claw' 'npm run dev --prefix xyne-claw-auth/backend'",
    "up": "npm run setup && npm run services && npm run dev:all",
    "services:vespa": "chmod +x vespa-core/scripts/deploy-dev.sh && ./vespa-core/scripts/deploy-dev.sh",
    "sandbox": "chmod +x scripts/sandbox.sh && ./scripts/sandbox.sh",
    "cleanup": "chmod +x scripts/cleanup-storage.sh && ./scripts/cleanup-storage.sh",
    "yama": "node node_modules/@juspay/yama/dist/cli/v2.cli.js",
    "test": "./xyne-automation/scripts/run-test.sh",
    "test:integrity": "npm run test:integrity --prefix xyne-automation",
    "test:push": "./xyne-automation/scripts/push-report-branch.sh",
    "test:enum": "bash scripts/validate-no-new-enums.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@semantic-release/changelog": "^6.0.1",
    "@semantic-release/commit-analyzer": "^9.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^11.0.0",
    "@semantic-release/release-notes-generator": "^10.0.3",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.0.11",
    "semantic-release": "^22.0.5"
  },
  "dependencies": {
    "@juspay/yama": "^2.2.0",
    "html-to-text": "^9.0.5"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "release-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]",
        "prerelease": true
      }
    ],
    "repositoryUrl": "ssh://git@github.com/example-org/xyne-spaces.git",
    "tagFormat": "v${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "parserOpts": {
            "headerPattern": "^(?:(?:Pull [Rr]equest #\\d+:\\s*)+)?(\\w+)(?:\\([^)]*\\))?:\\s*(XYNE-\\d+):?\\s*(.+)$",
            "headerCorrespondence": [
              "type",
              "ticket",
              "subject"
            ],
            "revertPattern": "^(?:(?:Pull [Rr]equest #\\d+:\\s*)+)?Revert\\s+\"(.+)\"",
            "revertCorrespondence": [
              "header"
            ]
          },
          "releaseRules": [
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "type": "feature",
              "release": "minor"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "revert",
              "release": "patch"
            },
            {
              "revert": true,
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            },
            {
              "type": "build",
              "release": "patch"
            },
            {
              "type": "ci",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": false
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "parserOpts": {
            "headerPattern": "^(?:(?:Pull [Rr]equest #\\d+:\\s*)+)?(\\w+)(?:\\([^)]*\\))?:\\s*(XYNE-\\d+):?\\s*(.+)$",
            "headerCorrespondence": [
              "type",
              "ticket",
              "subject"
            ],
            "revertPattern": "^(?:(?:Pull [Rr]equest #\\d+:\\s*)+)?Revert\\s+\"(.+)\"",
            "revertCorrespondence": [
              "header"
            ]
          }
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": false,
          "pkgRoot": "dashboard"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/changelog",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "dashboard/package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]",
          "gitArgs": [
            "--no-verify"
          ]
        }
      ]
    ]
  },
  "overrides": {
    "protobufjs@7": "7.6.5",
    "protobufjs@8": "8.7.1",
    "fast-xml-parser@4": "4.5.7",
    "fast-xml-parser@5": "5.10.1",
    "@grpc/grpc-js": "1.14.4",
    "@hono/node-server": "1.19.14",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/exporter-prometheus": "0.220.0",
    "@xmldom/xmldom": "0.8.13",
    "axios": "1.18.1",
    "form-data@2": "2.5.6",
    "form-data@4": "4.0.6",
    "handlebars@4": "4.7.9",
    "hono": "4.12.30",
    "langsmith": "0.8.3",
    "lodash": "4.18.1",
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "minimatch@9": "9.0.9",
    "minimatch@10": "10.2.5",
    "path-to-regexp@0": "0.1.13",
    "path-to-regexp@8": "8.4.2",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.5",
    "tmp": "0.2.7",
    "underscore": "1.13.8",
    "undici@5": "5.29.0",
    "undici@6": "6.27.0",
    "undici@7": "7.28.0",
    "undici@8": "8.7.0",
    "ws@6": "6.2.6",
    "ws@8": "8.21.1",
    "ws@7": "7.5.13",
    "fast-uri@3": "3.1.4",
    "fastify@5": "5.10.0",
    "tar@7": "7.5.20",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "js-yaml@3": "3.15.0",
    "js-yaml@4": "4.3.0",
    "tar@6": "7.5.20",
    "adm-zip": "0.6.0",
    "jws": "4.0.1",
    "fast-xml-builder": "1.3.0",
    "@opentelemetry/core@2": "2.8.0",
    "ajv@8": "8.18.0",
    "jsondiffpatch": "0.7.2",
    "uuid@11": "11.1.1"
  },
  "resolutions": {
    "picomatch": "4.0.5",
    "handlebars": "4.7.9",
    "@opentelemetry/sdk-node": "0.217.0",
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "adm-zip": "0.6.0",
    "fast-xml-parser": "5.10.1",
    "axios": "1.18.1",
    "jsondiffpatch": "0.7.2"
  }
}
