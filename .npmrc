# This is pnpm's default, stated explicitly as a guardrail rather than as config.
# Do not switch to node-linker=hoisted. Hoisting breaks peer resolution here:
# zod-to-json-schema declares zod as a peer and requires it at runtime, and
# hoisting lands it beside the root's zod 4 while packages/framework builds
# against zod 3. Isolated also keeps @rocicorp/zero inside
# apps/backend/node_modules, which apps/backend's #zero-internal/* tsconfig
# paths resolve against.
node-linker=isolated
