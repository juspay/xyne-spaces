# Server
PORT=8000
PYTHONUNBUFFERED=1

# LightOn / OpenAI-compatible endpoint
LIGHTON_URL=http://192.168.1.112:5002/v1/chat/completions
LIGHTON_MODEL=lightonai/LightOnOCR-2-1B-bbox
LIGHTON_ACCESS_TOKEN=
LIGHTON_TIMEOUT_SECONDS=60
LIGHTON_CONCURRENCY=8
LIGHTON_MAX_OUTPUT_TOKENS=8192
LIGHTON_TEMPERATURE=0.0
LIGHTON_RETRIES=2
LIGHTON_IMAGE_MAX_DIM=1540
LIGHTON_SSL_VERIFY=true
LIGHTON_PROMPT=Convert this document image to clean markdown.
LIGHTON_CROP_PROMPT=Read all text in this image.

# Rendering and crop handling
OCR_RENDER_MAX_DIM=1540
OCR_PDF_RENDER_DPI=200
OCR_MAX_PAGES=-1
OCR_JPEG_QUALITY=90
OCR_OFFICE_CONVERT_TIMEOUT_SECONDS=120
OCR_TEXT_PAGE_WIDTH=1240
OCR_TEXT_PAGE_HEIGHT=1754
OCR_TEXT_FONT_SIZE=28
OCR_TEXT_MARGIN=72
# Optional override for text rasterization font.
# OCR_TEXT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
LIGHTON_CROP_PADDING_PIXELS=5
LIGHTON_MIN_CROP_WIDTH=32
LIGHTON_MIN_CROP_HEIGHT=32
LIGHTON_MIN_CROP_AREA=2048
LIGHTON_MAX_IMAGE_REGIONS_PER_PAGE=256
LIGHTON_MAX_CROPS_PER_PAGE=32

# E5 tokenizer-backed chunking
E5_TOKENIZER_PATH=/app/e5-tokenizer
MAX_TOKENS=460
CHUNK_OVERLAP_TOKENS=12
IMAGE_CHUNK_MAX_TOKENS=460

# Redis async results
REDIS_URL=redis://redis:6379/0
OCR_RESULTS_STREAM=docling:results
OCR_RESULT_KEY_PREFIX=docling:result
OCR_RESULT_TTL_SECONDS=604800
OCR_ASYNC_JOB_TTL_SECONDS=86400
OCR_ASYNC_MAX_INFLIGHT=1

# Fleet-wide Redis admission. Set -1 to disable.
OCR_ASYNC_GLOBAL_MAX_INFLIGHT=-1
OCR_ASYNC_GLOBAL_ADMISSION_KEY=docling:async:global:active
OCR_ASYNC_GLOBAL_ADMISSION_LEASE_TTL_SECONDS=86400
OCR_ASYNC_RETRY_AFTER_SECONDS=180
