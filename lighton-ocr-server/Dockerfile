# Hardened runtime: distroless Python (no shell, package manager or pip), pinned by digest.
# LibreOffice (DOCX/PPTX -> PDF) and the Python deps are assembled in a Debian 12 builder
# whose python3 (3.11) matches the distroless interpreter.
FROM debian:12-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-dejavu-core \
    libreoffice-impress \
    libreoffice-writer \
    python3 \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /venv \
    && /venv/bin/pip install --no-cache-dir --timeout 1200 --retries 10 -r /tmp/requirements.txt \
    && /venv/bin/pip uninstall -y pip

# Only the E5 tokenizer is needed locally; embeddings/model inference stay outside.
RUN /venv/bin/python3 -c "from huggingface_hub import snapshot_download; snapshot_download('intfloat/multilingual-e5-large-instruct', local_dir='/app/e5-tokenizer', allow_patterns=['tokenizer.json', 'tokenizer_config.json', 'special_tokens_map.json', 'vocab.txt'])" \
    && rm -rf /app/e5-tokenizer/.cache \
    && test -f /app/e5-tokenizer/tokenizer.json

# Stage LibreOffice + fonts and every shared library they link against into /rootfs.
# glibc is left to the distroless base so loader and libc always match.
RUN set -eu; \
    dpkg -L libc6 | sed 's#^/lib#/usr/lib#' | sort -u > /tmp/skip; \
    { \
      for p in $(dpkg-query -W -f='${Package}\n' | grep -E '^(libreoffice|fonts-|fontconfig|liblangtag|libnss3|uno-libs|ure)'); do dpkg -L "$p"; done; \
      find /usr/lib/libreoffice -type f \( -name '*.so*' -o -name 'soffice.bin' -o -name 'oosplash' \) -exec ldd {} + 2>/dev/null \
        | awk '/=> \//{print $3}' | while read -r l; do echo "$l"; readlink -f "$l"; done; \
    } | sed 's#^/lib#/usr/lib#' | sort -u | comm -23 - /tmp/skip \
      | while read -r f; do if [ -f "$f" ] || [ -L "$f" ]; then echo "$f"; fi; done > /tmp/files; \
    # Generated by maintainer scripts, so not in dpkg -L.
    fc-cache -f; \
    printf '%s\n' /etc/libreoffice /usr/lib/libreoffice /var/lib/libreoffice /var/spool/libreoffice /var/cache/fontconfig >> /tmp/files; \
    mkdir /rootfs; tar -cf - -T /tmp/files | tar -xf - -C /rootfs; \
    rm -f /rootfs/usr/bin/soffice /rootfs/usr/bin/libreoffice /rootfs/usr/lib/libreoffice/program/soffice

# LibreOffice resolves its profile dir via getpwuid, so the chart's UID 1001 needs a passwd entry.
COPY --from=gcr.io/distroless/python3-debian12:nonroot@sha256:7d1042ce588ab97019fe95c24ffca7bc5a82ccdac572511d5e09bda4435c89c5 /etc/passwd /etc/group /tmp/base/
RUN { cat /tmp/base/passwd; echo 'app:x:1001:1001:app:/tmp:/sbin/nologin'; } > /rootfs/etc/passwd \
    && { cat /tmp/base/group; echo 'app:x:1001:'; } > /rootfs/etc/group

FROM gcr.io/distroless/python3-debian12:nonroot@sha256:7d1042ce588ab97019fe95c24ffca7bc5a82ccdac572511d5e09bda4435c89c5

COPY --from=builder /rootfs/ /
COPY --from=builder /venv /venv
COPY --from=builder /app/e5-tokenizer /app/e5-tokenizer

WORKDIR /app
COPY src/ ./

# oosplash is the ELF launcher the soffice shell script execs; it also handles
# LibreOffice's first-run restart.
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    LIBREOFFICE_BIN=/usr/lib/libreoffice/program/oosplash

EXPOSE 8000
# No shell/curl in distroless, so probe /health with python (k8s uses the chart's probes).
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD ["/venv/bin/python3", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5).status == 200 else 1)"]

# Matches the chart's runAsUser.
USER 1001:1001

ENTRYPOINT ["/venv/bin/python3", "-m", "uvicorn"]
CMD ["main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
