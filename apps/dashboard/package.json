{
  "name": "xyne-spaces-dashboard",
  "version": "1.519.0",
  "type": "module",
  "description": "Xyne Spaces - Workflow Automation Dashboard",
  "scripts": {
    "predev": "node scripts/fetch-model.mjs",
    "dev": "vite",
    "dev:test": "vite --mode test",
    "claw:test": "VITE_SANDBOX_TEST_MODE=true vite --mode test",
    "dev:prod": "vite --mode prod-local",
    "fetch-model": "node scripts/fetch-model.mjs",
    "build:prototypes": "node scripts/build-prototypes.mjs",
    "eval:intents": "node scripts/eval-intents.mjs",
    "prebuild": "node scripts/fetch-model.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "lint:errors-only": "eslint . --quiet --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content && pnpm run lint:css",
    "lint:errors-only:ci": "eslint . --quiet && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.app.json --pretty",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "rm -rf dist build coverage",
    "validate": "node ../../scripts/xyne-doctor.mjs dashboard-validate",
    "validate:raw": "pnpm run typecheck && (pnpm run format:check || (pnpm run format && exit 1)) && pnpm run lint && pnpm run check:tailwind-v4",
    "check:tailwind-v4": "node ../../scripts/check-tailwind-v4-classes.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "typescript",
    "workflow",
    "automation",
    "dashboard"
  ],
  "author": "Xyne Team",
  "license": "Apache-2.0",
