{
  "name": "xyne-spaces-dashboard",
  "version": "1.273.4",
  "type": "module",
  "description": "Xyne Spaces - Workflow Automation Dashboard",
  "scripts": {
    "predev": "node scripts/fetch-model.mjs",
    "dev": "vite",
    "dev:sdlc": "vite --mode sdlc",
    "dev:test": "vite --mode test",
    "claw:test": "VITE_SANDBOX_TEST_MODE=true vite --mode test",
    "dev:prod": "vite --mode prod-local",
    "fetch-model": "node scripts/fetch-model.mjs",
    "build:prototypes": "node scripts/build-prototypes.mjs",
    "eval:intents": "node scripts/eval-intents.mjs",
    "prebuild": "node scripts/fetch-model.mjs",
    "build": "tsc --noEmit && vite build",
    "build:sdlc": "tsc --noEmit && vite build --mode sdlc",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:errors-only": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --project tsconfig.app.json --pretty",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "rm -rf dist build coverage",
    "validate": "node ../../scripts/xyne-doctor.mjs dashboard-validate",
    "validate:raw": "pnpm run typecheck && (pnpm run format:check || (pnpm run format && exit 1)) && pnpm run lint",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "typescript",
    "workflow",
    "automation",
    "dashboard"
  ],
  "author": "Xyne Team",
  "license": "Apache-2.0",
