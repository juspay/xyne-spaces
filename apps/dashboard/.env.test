# Override values for Docker container hostnames
# These override the corresponding values from .env.local when running in Docker
# Loaded via docker-compose.test.yml env_file directive

# Test environment - enables test authentication (bypasses Google OAuth)
VITE_ENVIRONMENT=test

# API Configuration - use container hostnames
VITE_API_BASE_URL=http://backend:3001
VITE_API_URL=http://backend:3001/api

# Zero service - use encryption service hostname
VITE_ZERO_SERVER=http://encryption:3013/zero

# Shareable link origin - use container hostname
VITE_SHAREABLE_ORIGIN=http://dashboard:5173

# OpenTelemetry - use container hostname
VITE_OTEL_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics

# Electron Backend URLs - use container hostnames
# (These are needed if tests simulate electron app behavior or check these envs)
VITE_ELECTRON_BACKEND_URL=http://backend:3001
VITE_ELECTRON_ZERO_BACKEND_URL=http://encryption:3013
