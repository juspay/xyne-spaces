# Vite Environment Variables
# For environment variables to be accessible in the frontend, they must be prefixed with VITE_

# API Configuration (backend runs on port 3001 in local dev)
VITE_API_URL=http://localhost:3001/api
VITE_API_BASE_URL=http://localhost:3001
VITE_APPS_PUBLIC_BASE_URL=http://localhost:3001/api/apps
VITE_API_TIMEOUT=10000

# Keycloak Configuration
VITE_KEYCLOAK_URL=http://localhost:9080/
VITE_KEYCLOAK_REALM=xyne
VITE_KEYCLOAK_CLIENT_ID=xyne-frontend

# Development settings
VITE_LOG_LEVEL=debug
VITE_ENVIRONMENT=development
VITE_ZERO_SERVER=http://localhost:4848

# Feature flags (optional)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_WORKFLOW_EDITOR=true
# Show Generate Summary button on call messages.
# Auto-generation via transcription-agent webhook is unaffected by this flag.
VITE_ENABLE_SUMMARY_ACTION_BUTTON=false

# PostHog (both required to enable; EU cloud host is https://eu.i.posthog.com)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Google OAuth (test credentials for local dev)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Genius AI Configuration
VITE_GENIUS_API_KEY=your_genius_api_key_here
VITE_GENIUS_URL=https://genius.example.in

# OpenTelemetry Configuration
VITE_ENABLE_OTEL_METRICS=true
VITE_OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
VITE_OTEL_SERVICE_NAME=xyne-spaces-frontend
VITE_OTEL_EXPORT_INTERVAL_MS=30000

# Activity logging
VITE_ENABLE_ACTIVITY_LOG=true

# Search version
VITE_SEARCH_VERSION = v1.0

# --- Added for completeness (env normalization); secrets empty ---
VITE_ELECTRON_BACKEND_URL=
VITE_ELECTRON_ZERO_BACKEND_URL=
VITE_SHAREABLE_ORIGIN=

# Slack app install page — where a user gets their own User OAuth token for DM migration
VITE_SLACK_APP_INSTALL_URL=
# --- SDLC fast lane ---------------------------------------------------------
# Set only in the SDLC bundle's build; empty here keeps the main bundle unchanged.
# Real values live in .env.sdlc. See docs/sdlc-fast-lane.md.
VITE_XYNE_SURFACE=
VITE_APP_BASE_PATH=
# Replaces API_BASE_URL. Not VITE_API_BASE_URL above, which is the backend origin.
VITE_API_BASE_OVERRIDE=
VITE_ZERO_PATH=
VITE_ZERO_STORAGE_KEY=
VITE_SDLC_APP_BASE_PATH=
VITE_DEV_PORT=
