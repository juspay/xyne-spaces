          "instant": true,
          "legendFormat": "count",
          "range": false,
          "refId": "count"
        }
      ],
      "title": "Client Zero Query Latency",
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "indexByName": {
              "query": 0,
              "p50": 1,
              "p95": 2,
              "p99": 3,
              "count": 4
            },
            "renameByName": {
              "Value #p50": "p50",
              "Value #p95": "p95",
              "Value #p99": "p99",
              "Value #count": "count"
            }
          }
        }
      ],
      "type": "table"
