          "editorMode": "code",
          "exemplar": false,
          "expr": "histogram_quantile(0.99, sum by (le, query) (increase(zero_query_latency_milliseconds_bucket{service_name=\"xynespaces-native\", os_type=~\"$os_type\", service_version=~\"$service_version\", query=~\"$query\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "p99",
          "range": false,
          "refId": "p99"
