          "editorMode": "code",
          "exemplar": false,
          "expr": "sum by (query) (increase(zero_query_latency_milliseconds_count{service_name=\"xynespaces-native\", os_type=~\"$os_type\", service_version=~\"$service_version\", query=~\"$query\"}[$__range]))",
