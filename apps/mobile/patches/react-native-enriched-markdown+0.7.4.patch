+          downY = event.y
+          horizontalClaimCommitted = false
+          if (canScrollSideways) holdGesture()
+          return super.onInterceptTouchEvent(event)
+        }
+
+        MotionEvent.ACTION_MOVE -> {
+          if (horizontalClaimCommitted) return super.onInterceptTouchEvent(event)
+
+          val fingerDx = event.x - downX
+          val absDx = kotlin.math.abs(fingerDx)
+          val absDy = kotlin.math.abs(event.y - downY)
+          if (absDy > touchSlop && absDy >= absDx) {
+            releaseGesture(event)
+            return false
+          }
+          if (absDx <= touchSlop || absDx <= absDy) {
+            if (canScrollSideways) holdGesture()
