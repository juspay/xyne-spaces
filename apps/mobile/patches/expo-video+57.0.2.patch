+
+// Xyne patch: AVFoundation's localizedDescription is often just "unknown error",
+// which hides the cause. Append the NSError domain and code (and the underlying
+// error's, when present) so app telemetry can tell a server/HTTP failure from a
+// network or decoder one. Format: "<description> [Domain:code] [underlying Domain:code]".
+private func describePlaybackError(_ error: Error?) -> String? {
+  guard let error else {
+    return nil
+  }
+  let nsError = error as NSError
+  var description = "\(nsError.localizedDescription) [\(nsError.domain):\(nsError.code)]"
+  if let underlying = nsError.userInfo[NSUnderlyingErrorKey] as? NSError {
+    description += " [underlying \(underlying.domain):\(underlying.code)]"
+  }
+  return description
+}
