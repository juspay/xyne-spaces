+  /** Xyne: lock-screen placeholder for private chat and reminder notifications, else null. */
+  private static String lockScreenPlaceholderFor(NotificationAndroidModel androidModel) {
+    if (androidModel.getVisibility() != NotificationCompat.VISIBILITY_PRIVATE) return null;
+    String category = androidModel.getCategory();
+    if (NotificationCompat.CATEGORY_MESSAGE.equals(category)) return "New message";
+    if (NotificationCompat.CATEGORY_REMINDER.equals(category)) return "New reminder";
+    return null;
+  }
