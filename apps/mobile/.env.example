# Copy to .env.prod (gitignored) and replace placeholders with real values.

APP_ENV=prod
# APNs for prebuild: unset for Xcode device installs, or `production` for TestFlight/App Store.
LOTUS_APS_ENVIRONMENT=production
MTLS_ENABLED=true
WEBVIEW_DEBUGGING_ENABLED=false
DASHBOARD_URL=https://app.example.com/
API_BASE_URL=https://app.example.com/api
GOOGLE_WEB_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MIXPANEL_TOKEN=your-mixpanel-project-token

LOTUS_RELEASE_STORE_PASSWORD=changeme
LOTUS_RELEASE_KEY_PASSWORD=changeme

# LOTUS_REMOTE_LOGGING_ENABLED | Remote -> Grafana
# true                          | Yes — explicitly opt in (private/internal builds only)
# false                         | No — safe default for copied templates
# unset                         | Default rules apply (prod release on, everything else off)
LOTUS_REMOTE_LOGGING_ENABLED=false

# LOTUS_METRICS_ENABLED | Export metrics
# true                  | Yes — even in a debug/dev build
# false                 | No — even in a release build
# unset                 | Default rules apply (release on, debug off)
LOTUS_METRICS_ENABLED=true
# Optional base URL for a test collector; appends /godel/v1/metrics automatically.
LOTUS_TELEMETRY_ENDPOINT=https://spaces.example.com

# SHA-256 of the prod release signing certificate; required for prebuild:prod when integrity is enforced.
LOTUS_INTEGRITY_SIGNING_SHA256=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99

LOTUS_TELEMETRY_MODE=prod
LOTUS_GRAFANA_LOGS_ENDPOINT=https://spaces.example.com
