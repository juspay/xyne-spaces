{
  "name": "xyne-spaces-mobile",
  "main": "index.js",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=dev expo start",
    "start:community": "APP_VARIANT=community expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:errors-only": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --pretty",
    "theme:generate": "node --import tsx scripts/generate-theme-css.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"app/**/*.{ts,tsx,js,jsx,json,css,md}\" \"tests/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"app/**/*.{ts,tsx,js,jsx,json,css,md}\" \"tests/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "test": "pnpm run test:logic && pnpm run test:render && pnpm run test:chat-v3",
    "test:logic": "node --import tsx --experimental-test-isolation=none --test --test-force-exit --test-timeout=30000 \"tests/unit/**/*.test.ts\"",
    "test:logic:watch": "node --import tsx --test --watch \"tests/unit/**/*.test.ts\"",
    "//chat-v3-cleanup": "Phase 11: delete test:chat-v3. ESLint must not keep feature-specific overrides — remove the chat-v3 blocks in eslint.config.mjs.",
    "test:chat-v3": "node --import tsx --experimental-test-isolation=none --test --test-force-exit --test-timeout=30000 \"src/features/chat/v3/__tests__/**/*.test.ts\"",
    "test:render": "jest",
    "test:render:watch": "jest --watch",
    "postinstall": "node -e \"require('./plugins/withNotifeeIosRemoteActions.cjs').patchNotifeeRemoteActions(process.cwd())\"",
    "prebuild:dev": "pnpm run theme:generate && APP_VARIANT=dev expo prebuild",
    "prebuild:prod": "pnpm run theme:generate && APP_VARIANT=prod expo prebuild",
    "prebuild:sandbox": "pnpm run theme:generate && APP_VARIANT=sandbox expo prebuild",
    "prebuild:community": "APP_VARIANT=community expo prebuild",
    "android:dev": "APP_VARIANT=dev expo run:android --variant devDebug --app-id net.juspay.xyne.spaces",
    "android:prod:debug": "APP_VARIANT=prod expo run:android --variant prodDebug --app-id net.juspay.xynespaces",
    "android:prod": "APP_VARIANT=prod expo run:android --variant prodRelease --app-id net.juspay.xynespaces",
    "android:prod:bundle": "cd android && ./gradlew clean && APP_VARIANT=prod ./gradlew bundleProdRelease",
    "android:sandbox:debug": "APP_VARIANT=sandbox expo run:android --variant sandboxDebug --app-id net.juspay.xynespaces",
    "android:sandbox": "APP_VARIANT=sandbox expo run:android --variant sandboxRelease --app-id net.juspay.xynespaces",
    "android:community:debug": "APP_VARIANT=community expo run:android --variant communityDebug --app-id net.juspay.xynespacescommunity",
    "android:community": "APP_VARIANT=community expo run:android --variant communityRelease --app-id net.juspay.xynespacescommunity",
    "android:community:bundle": "cd android && ./gradlew clean && APP_VARIANT=community ./gradlew bundleCommunityRelease",
    "ios:dev": "APP_VARIANT=dev expo run:ios",
    "ios:prod:debug": "APP_VARIANT=prod expo run:ios --configuration Debug",
    "ios:prod": "APP_VARIANT=prod expo run:ios --configuration Release",
    "ios:sandbox": "APP_VARIANT=sandbox expo run:ios",
    "ios:community:debug": "APP_VARIANT=community expo run:ios --configuration Debug",
    "ios:community": "APP_VARIANT=community expo run:ios --configuration Release",
    "airborne:create-remote-files:ios": "npx airborne-devkit create-remote-files -p ios --upload",
    "airborne:create-remote-files:android": "pnpm run airborne:update-local-release-config:android && npx airborne-devkit create-remote-files -p android --upload",
    "airborne:create-remote-package:ios": "npx airborne-devkit create-remote-package -p ios",
    "airborne:create-remote-package:android": "pnpm run airborne:update-local-release-config:android && npx airborne-devkit create-remote-package -p android",
    "airborne:create-local-release-config:ios": "npx airborne-devkit create-local-release-config -p ios",
    "airborne:create-local-release-config:android": "npx airborne-devkit create-local-release-config -p android -b 200 -r 500",
    "airborne:update-local-release-config:ios": "npx airborne-devkit update-local-release-config -p ios",
    "airborne:update-local-release-config:android": "npx airborne-devkit update-local-release-config -p android -b 200 -r 500"
  },
