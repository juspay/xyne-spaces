{
  "name": "xyne-spaces-encryption",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:setup:local": "pnpm run prisma:generate",
    "build": "pnpm run prisma:generate && tsc",
    "dev": "dotenv -e .env.local --override -- sh -c 'NODE_ENV=development tsx watch src/index.ts'",
    "start": "tsx dist/index.js",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/kms": "^5.5.1",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^5.22.0",
    "@xyne/shared": "workspace:*",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.11.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.33",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
