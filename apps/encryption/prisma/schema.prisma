generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserSessionKey {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  userId     String
  wrappedKey Bytes
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  @@map("user_session_keys")
}

model OrgEncryptionConfig {
  id                    String                 @id @default(cuid())
  orgId                 String
  provider              String
  masterKeyRef          String
  useCustomerManagedKey Boolean                @default(false)
  providerConfig        Json?
  status                String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  dataEncryptionKeys    OrgDataEncryptionKey[]

  @@index([orgId])
  @@map("org_encryption_configs")
}

model OrgDataEncryptionKey {
  dekId         String              @id
  configId      String
  entityType    String
  entityId      String
  wrappedDek    Bytes
  status        String
  activatedAt   DateTime
  createdAt     DateTime            @default(now())
  rotatedAt     DateTime?
  deactivatedAt DateTime?
  config        OrgEncryptionConfig @relation(fields: [configId], references: [id])

  @@index([configId])
  @@index([entityType, entityId, status])
  @@map("org_data_encryption_keys")
}
