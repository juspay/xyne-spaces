NODE_ENV=development
HOST=0.0.0.0
API_PORT=3012
ZERO_PROXY_PORT=3013
LOG_LEVEL=info

DATABASE_URL=postgresql://xyne_enc:xyne456@localhost:5433/xyne_dev_db?schema=encryption
JWT_SECRET=replace-with-dev-jwt-secret
ENC_S2S_KEY=replace-with-internal-service-key
ZERO_CACHE_UPSTREAM=http://localhost:4848

# Base64-encoded PEM values. Required before enabling client encryption.
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=
# env is for local development only. Production should use gcp-kms.
KMS_ENC_PROVIDER=env
# Exactly 32 bytes encoded as 64 hex characters; generated for local development.
ENC_ENV_MASTER_KEY_HEX=
GCP_KMS_KEY_RING_REF=
DEK_CACHE_MAX_ENTRIES=1024
ENC_WORKSPACE_ORG_CACHE_MAX_ENTRIES=2048
ZERO_CLIENT_ENCRYPTION_ENABLED=false
API_CLIENT_ENCRYPTION_ENABLED=false
ENABLE_DB_ENCRYPTION=false
