{
  "name": "xyne-spaces-backend",
  "version": "1.266.1",
  "description": "Backend server for Xyne Spaces application",
  "main": "dist/index.js",
  "type": "module",
  "imports": {
    "#zero-internal/query-internals": "./node_modules/@rocicorp/zero/out/zql/src/query/query-internals.js",
    "#zero-internal/pg-query-executor": "./node_modules/@rocicorp/zero/out/zero-server/src/pg-query-executor.js",
    "#zero-internal/schema": "./node_modules/@rocicorp/zero/out/zero-server/src/schema.js",
    "#zero-internal/compiler": "./node_modules/@rocicorp/zero/out/z2s/src/compiler.js",
    "#zero-internal/sql": "./node_modules/@rocicorp/zero/out/z2s/src/sql.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "start": "tsx dist/index.js",
    "start:prod": "NODE_ENV=production tsx dist/index.js",
    "start:api": "NODE_ENV=production tsx --enable-source-maps dist/index.js",
    "start:worker": "NODE_ENV=production tsx --enable-source-maps dist/worker.js",
    "dev": "dotenv -e .env.local -- sh -c 'NODE_ENV=development CHOKIDAR_USEPOLLING=true tsx watch src/index.ts'",
    "dev:sdlc": "dotenv -e .env.sdlc -e .env.local -- sh -c 'NODE_ENV=development CHOKIDAR_USEPOLLING=true tsx watch src/index.ts'",
    "dev:api": "NODE_ENV=development tsx watch src/index.ts",
    "dev:worker": "dotenv -e .env.local -- sh -c 'NODE_ENV=development tsx watch src/worker.ts'",
    "dev:test": "dotenv -e .env.local -- sh -c 'NODE_ENV=test tsx src/index.ts'",
    "claw:test": "dotenv -e .env.local -- sh -c 'NODE_ENV=test SANDBOX_TEST_MODE=true tsx src/index.ts'",
    "ysweet": "podman-compose -f ../../docker-compose.dev.yml up -d ysweet",
    "ysweet:down": "podman-compose -f ../../docker-compose.dev.yml stop ysweet",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:zero-fallback": "pnpm exec tsx tests/verify-zero-fallback.ts 2>&1 | sed -n '/Summary/,/procedure/p'",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "dotenv -e .env.local -- sh -c 'prisma db push'",
    "db:studio": "dotenv -e .env.local -- sh -c 'prisma studio'",
    "db:seed": "ts-node prisma/seed.ts",
    "db:common:generate": "prisma generate --schema prisma-common/schema.prisma",
    "db:common:migrate": "prisma migrate dev --schema prisma-common/schema.prisma",
    "db:common:deploy": "prisma migrate deploy --schema prisma-common/schema.prisma",
    "db:common:push": "dotenv -e .env.local -- sh -c 'prisma db push --schema prisma-common/schema.prisma'",
    "db:common:studio": "dotenv -e .env.local -- sh -c 'prisma studio --schema prisma-common/schema.prisma'",
    "prepare": "husky"
  },
  "keywords": [
    "xyne",
    "spaces",
    "backend",
    "api",
    "typescript",
    "express"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@blocknote/core": "0.54.0",
