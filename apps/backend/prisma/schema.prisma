model User {
  id             String       @id @default(cuid())
  name           String
  email          String
  picture        String?      // Google profile picture URL
  authProvider   String       @default("GOOGLE")
  providerUserId String
  status         String       @default("ACTIVE")
  userType       String       @default("USER") // USER or BOT
  metadata       Json? // Flexible user metadata
  displayName    String?
  workspaceId    String
  role           String          @default("MEMBER")
  orgMemberId    String       // Links to org_members.memberId for organization membership
  leftAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // Presence display fields promoted from user_presence for query performance (dual-written)
  statusEmoji    String?      // @see user_presence.statusEmoji
  statusContent  String?      // @see user_presence.statusContent
  statusExpiryAt DateTime?    // @see user_presence.statusExpiryAt
  lastActiveAt   DateTime?    // @see user_presence.lastActiveAt
  notificationsPausedUntil DateTime? // @see user_presence.notificationsPausedUntil
  assignmentUnavailableUntil DateTime? // @see user_presence.assignmentUnavailableUntil
  calendarVisibility String             @default("PUBLIC")

  // Relations
  workspace                 Workspace             @relation(fields: [workspaceId], references: [id])
  resourceAccess            ResourceAccess[]
  auditLogs                 ACLAuditLog[]
  sessions                  UserSession[]           // User can have multiple sessions (multi-device support)
  apiKeys                   ApiKey[]                // User can have multiple API keys
  presenceStatus            UserPresence?           // One-to-one relation with presence status
  createdTickets            Ticket[]               @relation("TicketCreatedBy")
  updatedTickets            Ticket[]               @relation("TicketUpdatedBy")
  assignedTickets           Ticket[]               @relation("TicketAssignedTo")
  closedTickets             Ticket[]               @relation("TicketClosedBy")
  createdSubTickets         SubTicket[]            @relation("SubTicketCreatedBy")
  updatedSubTickets         SubTicket[]            @relation("SubTicketUpdatedBy")
  assignedSubTickets        SubTicket[]            @relation("SubTicketAssignedTo")
  userGroupMappings         UserGroupMapping[]
  userRoleMappings          UserRoleMapping[]
  createdRoles              Role[]
  channelParticipations     ChannelParticipant[]   @relation("ChannelParticipantUser")
  channelUserStatuses       ChannelUserStatus[]    @relation("ChannelUserStatusUser")
  canvasUserStatuses        CanvasUserStatus[]     @relation("CanvasUserStatusUser")
  createdCanvasCommentThreads CanvasCommentThread[] @relation("CanvasCommentThreadCreatedBy")
  statusUpdatedCanvasCommentThreads CanvasCommentThread[] @relation("CanvasCommentThreadStatusUpdatedBy")
  createdCanvasComments     CanvasComment[]        @relation("CanvasCommentCreatedBy")
  sentMessages              Message[]              @relation("MessageSender")
  createdConversations      Conversation[]         @relation("ConversationCreatedBy")
  createdChannels           Channel[]              @relation("ChannelCreatedBy")
  ticketActivities          TicketActivity[]
  conversationParticipations ConversationParticipant[]
  userAssignmentStates      UserAssignmentState[]  @relation("UserAssignmentStateUser")
  workloadMappings          UserWorkloadMapping[]  @relation("UserWorkloadUser")
  expertiseMappings         UserExpertiseMapping[] @relation("UserExpertiseUser")
  appsCreated               Apps[]                @relation("AppsCreatedBy")
  installedAppsFor          InstalledApps[]        @relation("InstalledAppsUser")
  incomingWebhooksCreated   AppIncomingWebhook[]     @relation("AppIncomingWebhookCreatedBy")
  incomingWebhooksRevoked   AppIncomingWebhook[]     @relation("AppIncomingWebhookRevokedBy")
  orgMember                 OrgMember?              @relation(fields: [orgMemberId], references: [memberId])
  externalTokens            UserExternalToken[]
  recordings                CallRecording[]         // call recordings this user started

  permissions CollectionPermission[]
  requestedTicketExports TicketExport[] @relation("RequestedTicketExports")
  @@unique([providerUserId, workspaceId])
  @@unique([email, workspaceId])
  @@index([email])
  @@index([providerUserId])

  @@index([workspaceId, id])
  @@map("users")
  @@schema("public")
}

// User Preferences
model UserPreference {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                      String   @id @default(cuid())
  userId                  String   @unique  // One preference record per user
  askai_custom_instruction String?  // Custom instruction for Ask AI
  channelSortOrder         String           @default("RECENCY") // Sidebar channel sort
  channelFilterMode        String?          // Channels group filter (null = app default)
  starredFilterMode        String?          // Starred group filter (null = app default)
  starredSortOrder         String?          // Starred group sort (null = app default)
  dmFilterMode             String?          // DM group filter (null = app default)
  dmSortOrder              String?          // DM group sort (null = app default)
  enterSendsMessage        Boolean  @default(true) // true: Enter sends, false: Shift+Enter sends
  allowThreadBroadcastMentions Boolean @default(false) // Allow @channel/@here in thread replies
  showThreadTags           Boolean  @default(false) // Render thread classification chips in chat; opt-in

  // Global notification settings
  globalDesktopNotificationLevel  String?            // Default level for all channels (desktop)
  globalMobileNotificationLevel   String?            // Default level for all channels (mobile)
  threadReplyNotificationsEnabled Boolean           @default(true) // Receive thread reply notifications globally
  channelWideMentionsEnabled      Boolean           @default(true) // Receive @channel and @here mention notifications
  notificationKeywords            String?             // Global keyword-notification list (max 50, each <= 80 chars)
