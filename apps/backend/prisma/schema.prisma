  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  app        Apps                 @relation(fields: [appId], references: [id])
  permission AvailableAppPermission @relation(fields: [permissionId], references: [id])

  @@unique([appId, permissionId])
  @@index([appId])
  @@index([permissionId])
  @@map("app_permission")
  @@schema("public")
}

/// Permissions granted to a specific installation (copied from AppPermissionGrant at install time)
model InstalledAppPermission {
  workspaceId String // denormalized tenant key (stamped on insert)
  id             String                @id @default(cuid())
  installedAppId String
  permissionId   String
  status         String                @default("UNAPPROVED")
  createdAt      DateTime              @default(now())

  installedApp InstalledApps         @relation(fields: [installedAppId], references: [id])
  permission   AvailableAppPermission @relation(fields: [permissionId], references: [id])

  @@unique([installedAppId, permissionId])
  @@index([installedAppId])
  @@index([permissionId])
  @@map("installed_app_permissions")
  @@schema("public")
}

