}

model WorkspaceOrganization {
  id           String      @id @default(cuid())
  orgId        String
  workspaceId  String
  role         String
  leftAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  organization Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([orgId, workspaceId])
  @@index([orgId])
  @@index([workspaceId])
  @@index([workspaceId, createdAt(sort: Desc), id])
  @@map("workspace_organizations")
  @@schema("public")
}

// Workspace Models
model Workspace {
