  users             User[]
  invitations       Invitation[]
  projects          Project[]
  workspaceOrgs     WorkspaceOrganization[]
  agents            Agent[]
  models            Model[]
  tools             Tool[]
  userGroups        UserGroup[]
  roles             Role[]
  ticketExports     TicketExport[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("workspaces")
  @@schema("public")
}

model WorkspaceJoinRequest {
  id               String   @id @default(cuid())
  workspaceId      String
  email            String
  status           String
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime
  updatedAt        DateTime

  @@index([workspaceId, email, updatedAt(sort: Desc)])
  @@index([email, status, updatedAt(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@map("workspace_join_requests")
  @@schema("non_zero")
}

model AiProvisioningStatus {
  id              String   @id @default(cuid())
  subjectType     String
  subjectId       String
  provider        String
  status          String
  attempts        Int
  lastError       String?
  lastAttemptedAt DateTime?
  createdAt       DateTime
  updatedAt       DateTime

  @@unique([subjectType, subjectId, provider])
  @@index([status, updatedAt])
  @@map("ai_provisioning_status")
  @@schema("non_zero")
}

model OrgLLMServiceAccountCredential {
  id                String    @id @default(cuid())
  orgId             String
  provider          String
  purpose           String
  credentials       String    @db.Text
  status            String
  lastProvisionedAt DateTime?
  createdAt         DateTime
  updatedAt         DateTime

  @@unique([orgId, provider, purpose])
  @@index([orgId, status])
  @@map("org_llm_service_account_credentials")
  @@schema("non_zero")
}

model Invitation {
  id           String        @id @default(cuid())
  orgId        String?
  workspaceId  String
  email        String
  role         String        @default("MEMBER")
  invitedBy    String
  invitedAt    DateTime      @default(now())
  expiredAt    DateTime?     // Expiration date - 15 days from creation by default, or updated on revoke
  acceptedAt   DateTime?     // When the invitation was accepted
  invitationId String?       @unique // Unique link ID for invitation URL
  entityId     String?        // projectId | channelId | canvasId
  entityType   String?   // PROJECT | CHANNEL | CANVAS
  channelId    String?       // For PROJECT guests: the specific channel to grant access to
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  organization Organization? @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([workspaceId])
  @@index([email])
  @@index([invitationId])
  @@index([entityId])
  @@index([createdAt(sort: Desc), id])
  @@map("invitations")
  @@schema("public")
}

model GuestAccess {
  id                   String      @id @default(cuid())
  userId               String
  workspaceId          String
  accessibleEntityId   String
  accessibleEntityType String
  invitedBy            String
  createdAt            DateTime

  @@unique([userId, accessibleEntityId, accessibleEntityType])
  @@index([workspaceId, userId])
  @@map("guest_access")
  @@schema("public")
}

// Project Models
model Project {
  id             String           @id @default(cuid())
  name           String
  code           String // Project shortcode for ticket IDs (e.g., EUL, INF)
  ticketSequence Int              @default(0) // Used when ENABLE_COMMON_DB_TICKET_SEQUENCE is disabled
  description    String?
  workspaceId    String // Workspace this project belongs to
  type           String           @default("DEFAULT")
  createdBy      String // User ID (no FK constraint)
  updatedBy      String? // User ID (no FK constraint)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime?        @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  tickets  Ticket[]
  channels Channel[]
  boards   Board[]
  globalFields GlobalField[]
  canvasFolders CanvasFolder[]
  canvases      Canvas[]
  repos         Repo[]

  @@unique([name, workspaceId])
  @@unique([code, workspaceId])

  @@index([workspaceId, createdAt(sort: Desc), id])
  @@map("projects")
  @@schema("public")
}

// Board Models
model Board {
  id                  String               @id @default(cuid())
  name                String
  boardType           String               @default("DEFAULT")
  projectId           String               // Project ID (no FK constraint)
  workspaceId         String               // Workspace for ACL optimization (denormalized from project)
  createdBy           String               // User ID (no FK constraint)
  updatedBy           String?              // User ID (no FK constraint)
  description         String?              // Board description
  metadata            Json?                // Board configuration including ticketFormConfig
  flowPlan            String?              // Serialized design-time DAG for FLOW boards
  vcsProvider         String?               // Main release board VCS provider
  releaseTrackingMode String?              // Main release board tracking mode
  createdAt           DateTime             @default(now())
  updatedAt           DateTime?            @updatedAt

  // Relations
  project               Project                @relation(fields: [projectId], references: [id])
  tickets               Ticket[]               @relation("TicketBoard")
  stages                Stage[]
  boardComplexityScores BoardComplexityScore[]
  workloadMappings      UserWorkloadMapping[]
  expertiseMappings     UserExpertiseMapping[]
  mainReleaseApplications Application[] @relation("MainReleaseBoardApplications")
  ownedApplication        Application?  @relation("ApplicationBoard")
  incomingWebhooks      AppIncomingWebhook[]
  channelMappings       ChannelBoardMapping[]

  @@unique([name, projectId])
  @@index([projectId])

  @@index([workspaceId, createdAt(sort: Desc), id])
  @@index([projectId, createdAt, id])
  @@map("boards")
  @@schema("public")
}

model Stage {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                   String       @id @default(cuid())
  name                 String
  eta                  Int?
  boardId              String       // Board ID (no FK constraint)
  sequenceNumber       Int
  createdBy            String       // User ID (no FK constraint)
  updatedBy            String?      // User ID (no FK constraint)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime?    @updatedAt
  defaultTicketStatus     String          @default("IN_PROGRESS")  // Deprecated - use defaultTicketStatusV2
  defaultTicketStatusV2   String         @default("STARTED")
  requestApprovalOnEntry  Boolean?       // NULL treated as false in code; auto-create approval request when a ticket enters the PREVIOUS stage (linear/DEFAULT boards only)

  // Relations
  board           Board            @relation(fields: [boardId], references: [id])
  ticketStageEtas TicketStageEta[]

  @@index([boardId])
  @@index([boardId, sequenceNumber]) // for stagesByBoard
  @@map("stages")
  @@schema("public")
}

// Stage to PR Status mapping table - maps which PR statuses trigger stage transitions
model StagePRStatusMapping {
  workspaceId String // denormalized tenant key (stamped on insert)
  id        String        @id @default(cuid())
  stageId   String        // Stage ID (no FK constraint)
  prStatus  String
  createdAt DateTime      @default(now())

  @@unique([stageId, prStatus])
  @@map("stage_pr_status_mappings")
  @@schema("public")
}

// Stage transition table — defines allowed movements and gates for NON_LINEAR boards
model StageTransition {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                          String       @id @default(cuid())
  boardId                     String
  fromStageId                 String?      // null = global transition (from any)
  toStageId                   String
  formId                      String?
  requiresApproval            Boolean?      // NULL treated as false in code
  bypassApprovalForAutomation Boolean?      // NULL treated as false in code
  requestApprovalOnEntry      Boolean?      // NULL treated as false in code; auto-create approval request when ticket enters the fromStage (single-outgoing edges only)
  visitSlaMode                String?       // NULL treated as STAGE_DEFAULT in code
  fixedEtaHours               Int?
  onReenter                   String?       // NULL treated as RESET in code
  createdAt                   DateTime?     // set by app on insert; NULL treated as creation time in code
  updatedAt                   DateTime      @updatedAt

  transitionApprovers StageApprovers[]

  @@unique([boardId, fromStageId, toStageId])
  @@index([boardId])
  @@index([fromStageId])
  @@index([boardId, toStageId])
  @@index([toStageId])
  @@map("stage_transitions")
  @@schema("public")
}

// Channel Models
model Channel {
  id              String            @id @default(cuid())
  name            String
  description     String?
  type            String            @default("DEFAULT")
  scopeType       String            // DEFAULT | DM | TICKET | DOCUMENT | GROUP_DM
  visibility      String            @default("PUBLIC") // PUBLIC | PRIVATE
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lastActivityAt  DateTime          @default(now())
  createdBy       String            // User ID (no FK constraint)
  metadata        Json?             // Additional metadata for future extension
  projectId       String            // Project to which the channel is linked
  workspaceId     String            // Workspace for ACL optimization (denormalized from project)
  participantCount Int                    @default(0)
  isMigrated      Boolean?                @default(false)
  addUserPolicy   String?                @default("EVERYONE")
  isArchived      Boolean                @default(false)
  showTicketsTabTicketsInChat Boolean?   @default(true)
  callSummaryPrompt String?              // Per-channel detailed call summary sections override; null = default

  // Relations
  conversations      Conversation[]
  participants       ChannelParticipant[]
  conversationParticipants   ConversationParticipant[]
  participantsStatus ChannelUserStatus[]
  createdByUser      User                 @relation("ChannelCreatedBy", fields: [createdBy], references: [id])
  project            Project              @relation(fields: [projectId], references: [id])
  tickets            Ticket[]             @relation("TicketChannel")
  calls              Call[]
  channelStats       ChannelStats?
  incomingWebhooks   AppIncomingWebhook[]
  canvasFolders      CanvasFolder[]
  emails             Email[]
  boardMappings      ChannelBoardMapping[]
  sdlcRepos          Repo[] @relation("RepoSdlcChannel")
  collectionPermissions CollectionPermission[]

  @@index([projectId])
  @@index([workspaceId, visibility, id]) // ACL workspace filtering + visibility
  @@index([createdBy])
  @@index([isArchived])

  @@index([workspaceId, id])
  @@index([workspaceId, name, id])
  @@map("channels")
  @@schema("public")
}

// Additive channel-to-board association. Board.projectId remains the source of
// project ownership for ticket-producing operations.
model ChannelBoardMapping {
  id          String   @id @default(cuid())
  channelId   String
  boardId     String
  workspaceId String
  isDefault   Boolean
  createdBy   String
  createdAt   DateTime
  updatedAt   DateTime

  channel Channel @relation(fields: [channelId], references: [id])
  board   Board   @relation(fields: [boardId], references: [id])

  @@unique([channelId, boardId])
  @@index([channelId])
  @@map("channel_board_mappings")
  @@schema("public")
}

model ChannelStats {
  workspaceId String // denormalized tenant key (stamped on insert)
  channelId        String                @id
  lastActivityAt   DateTime              
  participantCount Int                   @default(0)
  addUserPolicy    String?               @default("EVERYONE")
  lastRecapHadMessages   Boolean?             // null = not processed, true = recap with messages, false = recap with 0 messages

  // Relations
  channel          Channel               @relation(fields: [channelId], references: [id])

  @@index([channelId])
  @@map("channel_stats")
  @@schema("public")
}

model ChannelParticipant {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                        String      @id @default(cuid())
  channelId                 String      // Channel ID (no FK constraint)
  userId                    String      // User ID (no FK constraint)
  joinedAt                  DateTime    @default(now())
  role                      String      @default("MEMBER") // ADMIN | MEMBER

  // deprecated columns will be removed in future
  lastViewedAt              DateTime    @default(now()) // Track when user last viewed channel
  lastViewedConversationId  String?     // Track last conversation viewed for optimization
  isStarred                 Boolean     @default(false)
  isClosed                  Boolean     @default(false) // Track if user has closed/hidden this DM

  // Relations
  channel Channel @relation(fields: [channelId], references: [id])
  user    User    @relation("ChannelParticipantUser", fields: [userId], references: [id])

  @@unique([channelId, userId]) // Prevent duplicate participants
  @@index([channelId]) // Fast channel participant lookup
  @@index([userId]) // Fast user channel lookup
  @@index([userId, isStarred]) // Fast Starred Channels Lookup
  @@index([userId, isClosed]) // Fast closed DMs lookup
  @@index([channelId, userId, id])
  @@index([userId, role, id])

  @@index([channelId, id])
  @@map("channel_participants")
  @@schema("public")
}

model ChannelUserStatus {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                        String      @id @default(cuid())
  channelId                 String      // Channel ID (no FK constraint)
  userId                    String      // User ID (no FK constraint)
  lastViewedAt              DateTime    @default(now()) // Track when user last viewed channel
  lastViewedConversationId  String?     // Track last conversation viewed for optimization
  isStarred                 Boolean     @default(false)
  isClosed                  Boolean     @default(false) // Track if user has closed/hidden this DM
  unreadCount               Int         @default(0) // Track unread count for this channel
  sectionId                 String?     // Custom sidebar section this channel is placed in for the user (null = default group)
  sectionPosition           String?     // Fractional index (generateKeyBetween) within the custom section
  selectedBoardId           String?     // Track user's preferred board for this channel
  conversationSeenCutoffAt  DateTime?    // Track createdAt of the 25th most recent conversation seen by the user
  // Recap subscription fields
  isRecapSubscribed         Boolean     @default(false) // User opted into AI recaps for this channel
  lastSeenRecapDate         DateTime?   @db.Date // Last recap date the user has seen for this channel
  customRecapPrompt         String?     // Optional custom prompt for personalized recaps

  desktopNotificationLevel  String?               // Channel notification preference (desktop); null = inherit UserPreference.globalDesktopNotificationLevel
  mobileNotificationLevel   String?              // Channel notification preference (mobile); null = inherit UserPreference.globalMobileNotificationLevel
  threadReplyNotificationsEnabled Boolean?       // Per-channel override: null = inherit UserPreference.threadReplyNotificationsEnabled
  channelWideMentionsEnabled      Boolean?       // Per-channel override: null = inherit UserPreference.channelWideMentionsEnabled

  isDeleted                 Boolean     @default(false) // Soft delete flag
  updatedAt                 DateTime?   // No default, nullable, set manually in code 

  // Relations
  channel Channel @relation(fields: [channelId], references: [id])
  user    User    @relation("ChannelUserStatusUser", fields: [userId], references: [id])

  @@unique([channelId, userId]) // Prevent duplicate participants
  @@index([channelId]) // Fast channel participant lookup
  @@index([userId]) // Fast user channel lookup
  @@index([userId, isStarred]) // Fast Starred Channels Lookup
  @@index([userId, isClosed]) // Fast closed DMs lookup
  @@index([userId, isRecapSubscribed]) // Fast recap subscriptions lookup

  @@index([userId, isDeleted, id])
  @@index([userId, sectionId]) // Fast lookup of channels within a section + cleanup on section delete
  @@map("channel_user_status")
  @@schema("public")
}

// Per-user custom sidebar sections (Slack-style). Personal to each user, scoped per workspace.
model ChannelSection {
  id          String    @id @default(cuid())
  userId      String    // Owner — sections are per-user (no FK constraint)
  workspaceId String    // Workspace scope for ACL + per-workspace sections (no FK constraint)
  name        String    // Section label (the "tag" name)
  emoji       String?   // Optional emoji icon
  position    String    // Fractional index (generateKeyBetween) among the user's sections
  isCollapsed Boolean           @default(false) // Per-user collapse state, synced across devices
  isDeleted   Boolean           @default(false) // Soft delete flag
  sortOrder   String?           // Optional per-section channel sort order
  filterMode  String?           // Per-section channel filter (null = app default)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime? // Nullable, set manually in code (matches ChannelUserStatus convention)

  @@index([userId, workspaceId, isDeleted]) // Fast lookup of a user's sections in a workspace
  @@map("channel_sections")
  @@schema("public")
}

// Conversation Models (threads within channels)
model Conversation {
  conversationId    String   @id @default(cuid())
  channelId         String   // Channel this thread belongs to (no FK constraint)
  createdBy         String   // User who started the thread (no FK constraint)
  initialMessageId  String   // First message - use this for thread preview (no FK constraint)
  workspaceId       String  // Workspace for ACL optimization (denormalized from channel)
  parentMessageId   String?  // Parent message that this conversation is replying to (no FK constraint)
  lastActivityAt    DateTime @default(now())
  replyCount        Int      @default(0)
  pinned            Boolean  @default(false)
  ticketId          String?  // Direct reference to ticket (no FK constraint)
  metadata          Json?
  callId            String?
  replies_md        String?
  ticket_md         String?
  initial_message_md String?
  parent_message_md  String?
  doNotPostToChannel Boolean?
  createdAt         DateTime @default(now())
  threadType        String?

  // Relations
  channel         Channel                  @relation(fields: [channelId], references: [id])
  messages        Message[]
  createdByUser   User                     @relation("ConversationCreatedBy", fields: [createdBy], references: [id])
  participants    ConversationParticipant[]
  messageAttachments MessageAttachment[]

  @@index([channelId, lastActivityAt])
  @@index([workspaceId]) // ACL workspace filtering
  @@index([channelId]) // Alternative simple index
  @@index([ticketId]) // Fast ticket lookup
  @@index([callId])
  @@index([conversationId, callId])
  @@index([channelId, createdAt(sort: Desc), conversationId(sort: Asc)])
  @@index([channelId, doNotPostToChannel, createdAt(sort: Desc), conversationId(sort: Asc)])
  @@index([createdBy])
  @@index([initialMessageId])
  @@map("conversations")
  @@schema("public")
}

// Conversation Participant Models (track who participated in threads)
model ConversationParticipant {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                String                        @id @default(cuid())
  conversationId    String                        // Conversation ID (no FK constraint)
  userId            String                        // User ID (no FK constraint)
  participationType String?                       // AUTHOR, MENTIONED, or NULL (manual subscription)
  isSubscribed      Boolean                       @default(true) // Notification subscription status
  joinedAt          DateTime                      @default(now())
  lastReadAt        DateTime?                     // Track when user last read this thread conversation
  lastReplyAt       DateTime?                     // Denormalized: set to conversation.lastActivityAt when a reply is sent. NULL = no replies.
  channelId         String?                       // Denormalized from conversation.channelId for direct ACL check

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [conversationId])
  channel      Channel?     @relation(fields: [channelId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId]) // One participation record per user per conversation
  @@index([conversationId]) // Fast conversation participant lookup
  @@index ([conversationId,participationType,joinedAt,id])
  @@index([userId]) // Fast user conversation lookup
  @@index([userId, lastReplyAt(sort: Desc), id]) // For userConversationsPaginatedV2
  @@index([userId, isSubscribed, lastReplyAt(sort: Desc), id(sort: Desc)], map: "conversation_participants_thread_list_idx")

  @@index([userId, id])
  @@map("conversation_participants")
  @@schema("public")
}

model Email {
  workspaceId String // denormalized tenant key (stamped on insert)
  id String @id @default(cuid())
  type String
  subject String
  body String
  to String[]
  from String
  cc String[] @default([])
  bcc String[] @default([])
  replyTo String[] @default([])
  conversationId String
  channelId String
  externalThreadId String
  externalMessageId String
  sentByUserId String?            // User who sent this outbound email (REPLY / REPLY_ALL / COMPOSE). Null for inbound and automation/system sends. Powers the per-desk "Sent" view.
  rfcMessageId String?
  rating Int?
  clientVersionName String?
  clientVersionCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id]) // emulated (relationMode="prisma"), no DB FK
  @@unique([externalMessageId, channelId])
  @@index([conversationId])
  @@index([externalThreadId])
  @@index([channelId])
  @@index([channelId, rfcMessageId])
  @@index([conversationId, id])
  @@index([sentByUserId, createdAt(sort: Desc)]) // "Sent by me" list, ordered newest-first
  @@map("emails")
  @@schema("public")
}

model EmailDraft {
  workspaceId String // denormalized tenant key (stamped on insert)
  id String @id @default(cuid())
  conversationId String? // null = a brand-new compose draft (no thread yet); set = a reply draft
  userId String?
  channelId String
  draftContent String
  subject String? // compose-draft subject (reply drafts inherit the thread subject)
  fromAddress String? // compose-draft "From" (sender alias)
  attachmentIds Json? // Array of attachment IDs for draft attachments
  toRecipients String? // draft "To" recipients — JSON-stringified string[], parsed app-side
  ccRecipients String? // draft "Cc" recipients — JSON-stringified string[]
  bccRecipients String? // draft "Bcc" recipients — JSON-stringified string[]
  autoDraftStatus String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, conversationId])
  @@index([userId, conversationId, id])
  @@index([conversationId])
  @@index([channelId])
  @@map("email_drafts")
  @@schema("public")
}

model EmailRead {
  workspaceId String // denormalized tenant key (stamped on insert)
  id              String   @id @default(cuid())
  ticketId        String
  userId          String
  lastReadEmailId String
  lastReadEmailAt DateTime
  createdAt       DateTime
  updatedAt       DateTime @updatedAt

  @@unique([ticketId, userId])
  @@index([userId])
  @@index([ticketId])
  @@map("email_reads")
  @@schema("public")
}

// Gmail-style labels for desk/support email conversations. Labels are private to the
// agent who created them (createdBy): ConversationLabel is the per-channel, per-user
// label catalog; ConversationLabelMapping is the many-to-many junction attaching a
// label to a conversation (email thread).
model ConversationLabel {
  id          String   @id @default(cuid())
  name        String
  color       String?  // hex color, mirrors Gmail label color
  channelId   String   // Channel (desk) scope — labels belong to a desk (no FK constraint)
  projectId   String?  // Project (denormalized from channel)
  workspaceId String   // Workspace for ACL optimization (denormalized from channel)
  createdBy   String   // Owner — labels are private to this user (no FK constraint)
  createdAt   DateTime @default(now())
  updatedAt   DateTime // Set manually in code — written only by Zero mutators, never Prisma Client
  deskAutoLabelRuleReferences DeskAutoLabelRuleReference[]

  // Also serves per-user catalog reads + ACL via its (channelId, createdBy) prefix,
  // with the trailing "name" matching the catalog query's orderBy('name').
  @@unique([channelId, createdBy, name]) // No duplicate label names per user within a desk
  @@map("conversation_labels")
  @@schema("public")
}

model ConversationLabelMapping {
  id             String   @id @default(cuid())
  labelId        String
  labelName      String   // Denormalized from ConversationLabel.name for fast reads
  conversationId String
  channelId      String   // Denormalized for ACL (channel membership/visibility)
  workspaceId    String
  createdBy      String   // Owner — the agent who applied the label (no FK constraint)
  createdAt      DateTime @default(now())

  // The unique's conversationId prefix also serves the per-thread chips read.
  @@unique([conversationId, labelId]) // A label can only be applied once per conversation
  @@index([labelId]) // label-panel read, label→mappings correlation, deleteLabel cascade
  @@map("conversation_label_mappings")
  @@schema("public")
}

// Server-only index of personal Desk auto-label rules targeting private conversation labels.
// The datasource uses relationMode = "prisma", so migrations do not create database FKs.
model DeskAutoLabelRuleReference {
  id                String   @id @default(cuid())
  workflowId        String
  labelId           String
  workspaceId       String
  ownerId           String
  channelId         String
  filterFingerprint String
  createdAt         DateTime

  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  label    ConversationLabel @relation(fields: [labelId], references: [id], onDelete: Restrict)

  @@unique([workflowId, labelId])
  @@unique([workspaceId, ownerId, channelId, labelId, filterFingerprint], map: "desk_auto_label_rule_refs_filter_key")
  @@index([workspaceId, ownerId, channelId, createdAt(sort: Desc), id(sort: Desc)], map: "desk_auto_label_rule_refs_owner_channel_idx")
  @@index([workspaceId, channelId], map: "desk_auto_label_rule_refs_channel_idx")
  @@index([workspaceId, labelId], map: "desk_auto_label_rule_refs_label_idx")
  @@map("desk_auto_label_rule_references")
  @@schema("non_zero")
}

// Gmail-style mailbox overlay: a per-user, per-desk filing of a shared ticket
// (Inbox / Archived / Spam / Trash + star). Sparse — a row exists only once the agent
// acts on the ticket; absence means { INBOX, not starred }. The ticket itself stays
// shared at the channel level (untouched). Mirrors the per-user labels scoping.
model TicketUserMailbox {
  id          String       @id @default(cuid())
  ticketId    String       // The shared ticket this overlay files (no FK constraint)
  userId      String       // Owner — the overlay is private to this agent (no FK constraint)
  channelId   String       // Denormalized for ACL + per-user view filtering
  workspaceId String       // Denormalized
  state       String?       // No DDL default on the custom enum type — mutators always write it; readers treat null/absent as INBOX
  starred     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     // Set manually in code — written only by Zero mutators, never Prisma Client

  // Also serves the setState/setStarred upsert lookup and the tickets.userMailbox
  // correlation (spam/starred exists() + related() overlay) via its ticketId prefix.
  @@unique([ticketId, userId]) // one overlay row per agent per ticket
  @@map("ticket_user_mailbox")
  @@schema("public")
}

model EmailSignature {
  workspaceId String // denormalized tenant key (stamped on insert)
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, name, id])
  @@map("email_signatures")
  @@schema("public")
}

model EmailChannelPreference {
  channelId                    String   @id // Channel ID (no FK constraint) - Primary key
  ownerUserId                  String?  // User ID who owns this preference (no FK constraint)
  assigneeUserGroupId          String?  // User group ID for assignee (no FK constraint)
  boardId                      String?  // Target board for ticket creation (no FK constraint)
  sendAsEmail                  String?  // Optional alias email for outbound replies (e.g. support@...)
  defaultCc                    String?  // Comma-separated list of emails to pre-populate CC in compose
  classificationEnabled        Boolean  @default(false)
  classificationPrompt         String?  // Custom system prompt for the classification LLM
  categoryField                String?  // Label for the top-level category
  subCategoryField             String?  // Label for the sub-category
  emailMergeMode               String         @default("ENABLED") // Auto-merge similar emails (cross-thread duplicate merge + per-email demerge); enum so future variants can be added
  twoStepSendEnabled           Boolean  @default(false) // When on, sending shows a review/confirm step before the email actually goes out
  priorityClassificationEnabled Boolean @default(false)
  priorityClassificationPrompt String?  // Custom system prompt for the priority classification LLM
  priorityClassificationThreshold Float @default(0.5) // Minimum confidence threshold (0.0 - 1.0) to auto-apply priority
  autoDraftMode          String        @default("OFF")
  autoDraftAgentSlug     String?
  deskType               String   @default("EMAIL")
  dlEmail                String?
  workspaceId            String
  metricsEnabled         Boolean? // Gates the desk metrics dashboard
  frtStageNames          String?  // JSON-serialised string[] of stage names whose first entry stops the FRT clock
  appWebhookDeliveryEnabled Boolean @default(true) // APP desks only: off means replies are stored without ever calling the app webhook
  deskReportEnabled      Boolean? @default(false) // Gates the scheduled desk-report cron + sidebar panel
  deskReportAgentSlug    String?
  deskReportRangeDays    Int?     @default(1) // 1 = "Last 1 day", 7 = "Last 1 week"
  @@index([ownerUserId])
  @@index([assigneeUserGroupId])
  @@index([boardId])
  @@unique([workspaceId, dlEmail])
  @@map("email_channel_preferences")
  @@schema("public")
}

model ClassificationMapping {
  workspaceId String // denormalized tenant key (stamped on insert)
  id         String   @id @default(cuid())
  channelId  String
  category   String
  subCategory String?
  userGroupId String
  createdAt  DateTime @default(now())

  @@index([channelId])
  @@index([channelId, category])
  @@map("classification_mappings")
  @@schema("public")
}

// SLA policy configured per board and per priority level.
// When a board's metadata.slaPolicyType is set to 'priority', these policies are used
// to compute response/resolution deadlines for tickets based on their priority.
// responseHours and resolutionHours can be calendar hours (businessHoursOnly=false)
// or business hours (businessHoursOnly=true, Mon-Fri workdayStart–workdayEnd in timezone).
model BoardSlaPolicy {
  workspaceId String // denormalized tenant key (stamped on insert)
  id              String         @id @default(cuid())
  boardId         String
  priority        String
  responseHours   Float          // SLA first-response window in hours
  resolutionHours Float          // SLA resolution window in hours
  businessHoursOnly Boolean      @default(true)
  timezone        String         @default("UTC") // IANA timezone string e.g. "Asia/Kolkata"
  workdayStart    Int            @default(9)     // Hour of day (0-23) when business day starts
  workdayEnd      Int            @default(18)    // Hour of day (0-23) when business day ends
  isActive        Boolean        @default(true)
  createdAt       DateTime
  updatedAt       DateTime       @updatedAt

  @@unique([boardId, priority])
  @@index([boardId])
  @@index([isActive])
  @@map("board_sla_policies")
  @@schema("public")
}

// Message Models
model Message {
  messageId           String      @id @default(cuid())
  conversationId      String      // Every message belongs to a conversation (no FK constraint)
  childConversationId String?     // Child conversation created from this message (no FK constraint)
  senderId            String      // User who sent the message (no FK constraint)
  workspaceId         String     // Workspace for ACL optimization (denormalized from conversation)
  content             String      // Text content
  msgType             String      @default("USER") // USER | BOT | SYSTEM
  hasAttachment       Boolean     @default(false) // Quick check for attachments
  edited              Boolean     @default(false) // Whether the message has been edited
  isDeleted           Boolean     @default(false)
  showInChannel       Boolean     @default(false) // Whether message should appear in channel
  visibleTo           String?     // null = public (visible to all), userId = visible only to the userId 
  createdAt           DateTime    @default(now())
  metadata            Json?       // Future extensibility
  nudgeCount          Int?        @default(0) // Proactive nudge count for this message
  isSent              Boolean     @default(true) // Whether the message is sent
  reactions_md      String?
  link_preview_md   String?
  messageActs       String?

  // Relations
  conversation   Conversation   @relation(fields: [conversationId], references: [conversationId])
  sender         User           @relation("MessageSender", fields: [senderId], references: [id])
  reactions      Reaction[]
  reactionCounts ReactionCount[]
  externalMessages   ExternalMessage[] @relation("ExternalMessageEntity")

  @@index([conversationId, createdAt]) // Fast conversation message lookup
  @@index([workspaceId]) // ACL workspace filtering
  @@index([conversationId]) // Alternative simple index
  @@index([visibleTo]) // Fast visibility filtering
  @@index([conversationId, visibleTo]) // Composite index for visibility queries
  @@index([senderId])
  @@index([msgType, createdAt])

  @@index([conversationId, createdAt, messageId])
  @@map("messages")
  @@schema("public")
}

// Lifecycle row for structured message artifacts (slash commands). The banner
// renders and authorizes from this row alone: relating it to `messages` would
// push every message delta through the global artifact subscription, so the few
// fields needed to route to the message are projected here instead.
// `status`/`callExternalId` are the single source of truth for lifecycle and are
// never mirrored back into message content.
model MessageArtifact {
  id               String   @id @default(cuid())
  workspaceId      String
  messageId        String   @unique
  channelId        String
  conversationId   String
  isInitialMessage Boolean
  messagePreview   String
  messageCreatedAt DateTime
  command          String
  status           String
  callExternalId   String?
  updatedAt        DateTime

  @@index([workspaceId, status, messageCreatedAt])
  @@index([channelId])
  @@map("message_artifacts")
  @@schema("public")
}

// File Attachment Models
model MessageAttachment {
  id                 String                @id @default(cuid())
  entityType         String                // TICKET, CHAT, DRAFT, DELAYED_MESSAGE, etc.
  entityId           String                // Ticket id or message id (mandatory)
  workspaceId        String                // Workspace for ACL optimization
  storageProvider    String                // Storage provider where file is stored
  originalFilename   String                // Original filename uploaded by user
  mimetype           String                // image/png, application/pdf, etc.
  size               Int                   // Size in bytes
  width              Int?                  // Width in pixels (for images/videos)
  height             Int?                  // Height in pixels (for images/videos)
  uploadedByUserId   String                // User who uploaded (no FK constraint)
  createdAt          DateTime              @default(now())
  url                String                // URL for fetching the attachment (mandatory)
  createdBy          String                // User who uploaded the attachment (no FK constraint)
  metadata           Json?                 // Width/height for images, duration for videos, etc.
  conversationId     String?                // Every message belongs to a conversation (no FK constraint)
  thumbnailUrl       String?               // For images/videos
  isDeleted          Boolean               @default(false) // Soft-delete: true when attachment has been removed
  uploadStatus       String?                 // Tracks upload state
  position           Int?                  // Display order within a message (lower = earlier); null for legacy rows

  // Relations
  conversation       Conversation?          @relation(fields: [conversationId], references: [conversationId])

  @@index([entityType])
  @@index([conversationId])
  @@index([entityId])
  @@index([entityId, id])
  @@index([entityId, position])
  @@map("message_attachments")
  @@schema("public")
}

// Reaction Models
model Reaction {
  workspaceId String // denormalized tenant key (stamped on insert)
  reactionId  String   @id @default(cuid())
  messageId   String   // Message being reacted to (no FK constraint)
  userId      String   // User who reacted (no FK constraint)
  emojiName   String   // Any Unicode emoji: "👍", "❤️", "😄", "🎉", etc.
  createdAt   DateTime @default(now())

  // Relations
  message Message @relation(fields: [messageId], references: [messageId])

  @@unique([messageId, userId, emojiName]) // User can only react once per emoji per message
  @@index([messageId]) // Fast lookup of message reactions
  @@index([messageId, reactionId])
  @@map("reactions")
  @@schema("public")
}

model ReactionCount {
  workspaceId String // denormalized tenant key (stamped on insert)
  countId     String   @id @default(cuid())
  messageId   String   // Message being counted (no FK constraint)
  emojiName   String   // The emoji being counted
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  // Relations
  message Message @relation(fields: [messageId], references: [messageId])

  @@unique([messageId, emojiName]) // One count record per emoji per message
  @@index([messageId]) // Fast lookup of message reaction counts
  @@index([messageId, countId])
  @@map("reaction_counts")
  @@schema("public")
}

// Custom Emoji Models
model CustomEmoji {
  workspaceId String // denormalized tenant key (stamped on insert)
  id        String   @id @default(cuid())
  name      String   // Shortcode without colons, e.g. "party_parrot"
  url       String   // GCS path to the emoji image
  createdBy String   // User ID who created the emoji (no FK constraint)
  createdAt DateTime @default(now())

  @@unique([name])

  @@index([createdAt(sort: Desc), id])
  @@map("custom_emojis")
  @@schema("public")
}

// Activity Feed System
model Activity {
  id              String   @id @default(cuid())
  userId          String   // User who receives this notification (no FK constraint)
  workspaceId     String  // Workspace for ACL optimization
  actorAction     String   // Action performed: 'mentioned_user', 'group_mention', 'replied', 'added', 'created', etc.
  /// @deprecated Use messageId, reactionId, or callId instead. Will be removed in future migration.
  actionSource    String   // Source entity: 'message', 'reaction', 'channel' (singular)
  /// @deprecated Use messageId, reactionId, or callId instead. Will be removed in future migration.
  actionSourceId  String   // ID of the source entity (no FK constraint)
  // New FK columns to replace polymorphic pattern
  messageId       String?  // FK to messages.messageId (no constraint)
  reactionId      String?  // FK to reactions.reactionId (no constraint)
  callId          String?  // FK to calls.id (no constraint)
  ticketId        String?  // FK to tickets.id (no constraint)
  conversationId  String?  // FK to conversations.conversationId (no constraint)
  channelId       String?  // Channel where the activity occurred (optional, not present for ticket activities)
  pullRequestId   String?  // FK to pull_requests.id (optional, present only for PR-related ticket activities)
  canvasId        String?  // FK to canvas.id for canvas mention activities (no constraint)
  blockId         String?  // Block ID within the canvas for canvas mention activities
  actorId         String  // User who performed the action (no FK constraint)
  classification  String                 @default("PENDING")
  classificationConfidence Float?
  classificationJobType String?
  isRead          Boolean  @default(false)
  isThreadActivity Boolean?  // True when activity is for a message inside a thread (not the initial message)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt  // For tracking when batched activity was last updated
  conversationSeenCutoffAt  DateTime?    // Track createdAt of the 25th most recent conversation from the activity

  @@index([userId, createdAt, id]) // for userActivitiesPaginated
  @@index([workspaceId]) // ACL workspace filtering
  @@index([userId, actorAction, createdAt, id]) // for userActivitiesPaginated
  @@index([userId, classification, createdAt, id]) // for userActivitiesPaginated
  @@index([userId, actorAction, classification, createdAt, id]) // for userActivitiesPaginated
  @@index([userId, actorAction, isRead]) // for userMissedCalls
  @@index([userId, isRead, createdAt]) // for userUnreadActivities
  @@index([userId, isRead, actionSource]) // for userUnreadThreadActivities (deprecated)
  @@index([userId, isRead, isThreadActivity]) // for filtering thread vs channel activities
  @@index([userId, createdAt]) // Fast lookup of user activities sorted by time
  @@index([userId, updatedAt]) // Fast lookup for batched activity updates
  @@index([userId, classification, createdAt]) // Fast lookup for classification tabs
  @@index([classification, classificationJobType, createdAt])
  @@index([classificationJobType, actionSourceId, channelId, classification])
  @@index([actionSource, actionSourceId]) // Fast lookup by source entity (deprecated)
  @@index([messageId]) // Fast lookup by message
  @@index([reactionId]) // Fast lookup by reaction
  @@index([callId]) // Fast lookup by call
  @@index([ticketId]) // Fast lookup by ticket
  @@index([channelId]) // Fast lookup by channel
  @@index([conversationId, userId]) // Fast lookup for reply batching
  @@index([actorId])

  @@index([userId, updatedAt(sort: Desc), id])
  @@index([userId, actorAction, isRead, id])
  @@map("activities")
  @@schema("public")
}

// Per-user OAuth tokens for external providers (Slack send-as-user, etc.)
model UserExternalToken {
  workspaceId String // denormalized tenant key (stamped on insert)
  id              String    @id @default(cuid())
  userId          String
  provider        String                    // "slack", "google", "microsoft", etc.
  providerUserId  String?                   // External ID (e.g. Slack "U0123ABCDEF")
  encryptedToken  String                    // AES-256-CBC encrypted OAuth token
  refreshToken    String?                   // Encrypted refresh token (for providers that need it)
  expiresAt       DateTime?                 // Token expiry (null = never expires, e.g. Slack)
  connectedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
  @@index([provider])
  @@index([userId])
  @@map("user_external_tokens")
  @@schema("non_zero")
}

// External Source Integration Models
model ExternalSource {
  id              String   @id @default(cuid())
  name            String   @unique           // "zoho-euler", "slack-external", "calendar-<userId>-google"
  sourceType      String                    // "zoho", "slack", "jira", "google_calendar", "microsoft_calendar", etc. - flexible string
  displayName     String                    // "Zoho (Euler Team)" or user email for calendar sources
  channelId       String?                   // Target workspace channel for messages
  externalIdentifier String?                // External provider identifier: Google Calendar channel id, Microsoft subscription id, etc.
  workspaceId     String                    // denormalized tenant key (stamped on insert)
  boardId         String?                   // @deprecated - Use EmailChannelPreference.boardId instead. Target board for ticket creation (no FK constraint) - N:1 with Board
  ownerUserId     String?                   // Owner for user-scoped integrations (calendar, gmail search)
  credentials     String                    // Encrypted credentials (IV:ciphertext format)
  isActive        Boolean  @default(true)
  lastSyncCursor  String?                   // Per-adapter resume cursor. Google: Gmail historyId / calendar syncToken. Microsoft: ISO timestamp / calendar deltaLink.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId, sourceType])
  @@index([boardId])
  @@index([ownerUserId])
  @@index([displayName])
  @@index([channelId])
  @@index([externalIdentifier])
  @@map("external_sources")
  @@schema("workflow")
}

model ExternalMessage {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                 String   @id @default(cuid())
  externalSourceId   String                // External source ID (no FK constraint)
  externalId         String                // Message ID in external system (for deduplication)
  externalThreadId   String                // Thread/ticket ID in external system (to find conversation)
  entityType         String                @default("MESSAGE")
  entityId           String?               // Entity ID for MESSAGE, Email ID
  messageId          String                // Link to our Message (no FK constraint)
  direction          String                // INCOMING | OUTGOING
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relation: entityId
  entity             Message?  @relation("ExternalMessageEntity", fields: [entityId], references: [messageId])

  @@unique([externalSourceId, externalId])  // Prevent duplicates
  @@index([externalSourceId, externalThreadId])  // Fast lookup by thread
  @@index([messageId])                           // Fast lookup by message
  @@map("external_messages")
  @@schema("workflow")
}

model ProactiveNudge {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                      String             @id @default(cuid())
  messageId               String

  type                    String
  priority                String             // HIGH, MEDIUM, LOW

  title                   String
  description             String             @db.Text

  // Interactive Elements
  evidenceSpans           String             @db.Text // Primary evidence snippet
  actions                 Json?              // Payload for CTAs and execution results

  state                   String             @default("ACTIVE") // ACTIVE, DISMISSED, ACTED_ON

  createdAt               DateTime           @default(now())

  @@unique([messageId])
  @@index([state])
  @@map("proactive_nudges")
  @@schema("public")
}

model SurfaceNudge {
  workspaceId String // denormalized tenant key (stamped on insert)
  id          String            @id @default(cuid())
  nudgeKind   String
  sourceId    String
  title       String
  description String            @db.Text
  priority    String?           @default("medium")
  actions     Json?
  state       String            @default("ACTIVE")
  visibleTo   String?
  surfaceNudgeCountId String?
  projectId   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([sourceId, state])
  @@index([surfaceNudgeCountId, state])
  @@index([createdAt])
  @@map("surface_nudges")
  @@schema("public")
}

model SurfaceNudgeCount {
  workspaceId String // denormalized tenant key (stamped on insert)
  id             String   @id
  nudgeCount     Int
  userId         String?
  channelId      String?
  gid            String?
  gidType        String?
  messageId      String?
  ticketId       String?
  canvasId       String?
  callId         String?
  conversationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([messageId, userId])
  @@index([messageId, channelId])
  @@index([messageId, gid, gidType])
  @@index([ticketId, userId])
  @@index([ticketId, channelId])
  @@index([ticketId, gid, gidType])
  @@index([canvasId, userId])
  @@index([canvasId, channelId])
  @@index([canvasId, gid, gidType])
  @@index([callId, userId])
  @@index([callId, channelId])
  @@index([callId, gid, gidType])
  @@index([conversationId, userId])
  @@index([conversationId, channelId])
  @@index([conversationId, gid, gidType])
  @@map("surface_nudge_counts")
  @@schema("public")
}

// Notification System Enums
// Notification System Models
model Notification {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                String                      @id @default(cuid())
  userId            String                      // User receiving the notification (no FK constraint)
  type              String
  title             String
  message           String
  status            String                      @default("UNREAD")
  deliveryMethods   String[]
  metadata          Json?                       // Additional context data
  relatedEntityType String?                     // "ticket", "workflow", "message", etc.
  relatedEntityId   String?                     // ID of the related entity
  actionUrl         String?                     // URL to navigate when notification is clicked
  expiresAt         DateTime?                   // Optional expiration for time-sensitive notifications
  readAt            DateTime?                   // When the notification was read
  dismissedAt       DateTime?                   // When the notification was dismissed
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([userId, status])
  @@index([type])
  @@index([relatedEntityType, relatedEntityId])
  @@index([createdAt])
  @@map("notifications")
  @@schema("workflow")
}

model NotificationPreference {
  workspaceId String // denormalized tenant key (stamped on insert)
  id               String           @id @default(cuid())
  userId           String           // User ID (no FK constraint)
  notificationType String
  browserEnabled   Boolean          @default(true)
  emailEnabled     Boolean          @default(false)
  slackEnabled     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, notificationType])
  @@map("notification_preferences")
  @@schema("public")
}

model BrowserNotificationSubscription {
  workspaceId String // denormalized tenant key (stamped on insert)
  id         String    @id @default(cuid())
  userId     String    // User ID (no FK constraint)
  endpoint   String    @unique // Push service endpoint
  p256dh     String    // Public key for encryption
  auth       String    // Authentication secret
  userAgent  String?   // Browser/device info
  isActive   Boolean   @default(true)
  lastUsedAt DateTime? // Track when subscription was last used
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("browser_notification_subscriptions")
  @@schema("workflow")
}

// Call Models
model Call {
  workspaceId String // denormalized tenant key (stamped on insert)
  id               String      @id @default(cuid())
  externalId       String      @unique // Public ID for linking/sharing
  title            String?     // Meeting/call title
  createdByUserId  String      // User who initiated the call (no FK constraint)
  organizerId      String?     // Who organized the meeting
  channelId        String?     // Channel where call is happening (null for GOOGLE_CALENDAR origin)
  orgName          String?     // Organization name (no FK constraint)
  description      String?     // Meeting description/agenda
  callType         String      @default("VIDEO")
  callOrigin       String      @default("CHANNEL")
  status           String      @default("ACTIVE")
  roomLink         String?     // LiveKit room URL/token
  startsAt         DateTime?   // Scheduled start time
  endsAt           DateTime?   // Scheduled end time
  timezone         String      @default("UTC")
  isRecurring      Boolean     @default(false)
  recurringSeriesId String?    // Links to parent series (app handles)
  recurrenceRule   String?     // RRULE format: "FREQ=WEEKLY;BYDAY=MO,WE,FR"
  instanceDate     DateTime?   // For recurring instances
  recordingEnabled Boolean     @default(false)
  recordingUrl     String?     // GCS path: recordings/{callId}.mp4
  transcript       String?     // Call transcript
  aiSummary        String?     // AI-generated summary
  startedAt        DateTime    @default(now())
  endedAt          DateTime?   // NULL = still active
  lastActivityAt   DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  metadata         Json?       // LiveKit room config, max participants, etc.
  callUpdatesChannel String?   // Non-null = post call updates to this channel (Case 3); null = no broadcast
  participantCount Int?        // Denormalized total CallParticipant rows; nullable until backfilled
  participantPreviewUserIds String? // Stringified JSON: list of { userId: string , hasJoined: boolean }
  recordingParticipants String @default("[]") // Stringified JSON: string[] of user ids this recording is about
  summaryTemplateId String?
  labels            String[]    @default([]) // Tag ids (see Tag model); no FK constraint
  markedItems       Json[]      @default([]) // Marked moments/decisions/actions surfaced during the call
  xyneManaged       Boolean     @default(false) // True when Xyne owns this Call's conference link on the source Calendar event (Xyne Call Link Auto-Injection)
  visibility        String?     @default("PRIVATE") // PRIVATE | PUBLIC (see CallVisibility in @xyne/shared; app-validated, no DB enum). Nullable: treated as PRIVATE everywhere it's read, so old Zero mutator bundles omitting it during a rolling deploy don't get rejected by a NOT NULL constraint.

  // Relations
  channel      Channel?          @relation(fields: [channelId], references: [id])
  participants CallParticipant[]
  recordings   CallRecording[]   // 1:N — every recording session for this call
  recurringSeries RecurringCallSeries? @relation(fields: [recurringSeriesId], references: [id])

  @@index([externalId]) // Fast lookup by public ID
  @@index([createdByUserId]) // Fast lookup of user's calls
  @@index([organizerId]) // Fast lookup by organizer
  @@index([channelId]) // Fast lookup by channel
  @@index([status, lastActivityAt]) // Fast active calls lookup
  @@index([startsAt]) // Fast lookup by scheduled time
  @@index([recurringSeriesId]) // Fast lookup of recurring series
  @@index([isRecurring]) // Fast lookup of recurring calls
  @@index([instanceDate]) // Fast lookup by instance date
  @@index([orgName]) // Fast org call lookup
  @@index([summaryTemplateId])

  @@index([status, startedAt(sort: Desc), externalId])
  @@index([status, startsAt, externalId])
  @@map("calls")
  @@schema("public")
}

/// Polymorphic sharing record. `entityId` is resolved according to
/// `shareableEntityType`; application services enforce target existence and access.
/// Sharing target is exactly one of userId, userGroupId, or channelId.
/// `shareableEntityType` and `entityUserAccess` are plain Strings (DB enums are
/// frozen — see scripts/validate-no-new-enums.sh). Allowed values are enforced
/// app-side via the ShareableEntityType / EntityUserAccess consts exported from
/// packages/shared/src/zero/schema.ts (import from '@xyne/shared').
model EntityAccess {
  id                  String   @id @default(cuid())
  workspaceId         String
  shareableEntityType String   // NOTE_TAKER (see ShareableEntityType in @xyne/shared; app-validated, no DB enum)
  entityId            String   // Polymorphic id, resolved by shareableEntityType (no FK constraint)

  userId              String?  // Shared with a specific user (no FK constraint)
  userGroupId         String?  // Shared with a user group (no FK constraint)
  channelId           String?  // Shared with a channel (no FK constraint)

  entityUserAccess    String   @default("VIEW") // VIEW/EDIT/ADMIN/REVOKED (see EntityUserAccess in @xyne/shared; app-validated, no DB enum)
  metadata            Json?    // Share-specific metadata
  createdAt           DateTime @default(now())
  updatedAt           DateTime

  @@unique([workspaceId, shareableEntityType, entityId, userId])
  @@index([workspaceId, shareableEntityType, entityId])
  @@index([workspaceId, userId])
  @@index([workspaceId, userGroupId])
  @@index([workspaceId, channelId])
  @@map("entity_access")
  @@schema("public")
}

model SummaryTemplate {
  id                String   @id @default(cuid())
  workspaceId       String
  name              String
  autoTriggerPrompt String?
  sections          Json
  version           Int      @default(1)
  systemPrompt      String
  defaultOutlet     String   @default("EMAIL") // EMAIL/MESSAGE (see DefaultOutlet in @xyne/shared; app-validated, no DB enum)
  createdBy         String
  createdAt         DateTime @default(now())
  visibility        String   @default("PRIVATE") // PRIVATE | WAITING_FOR_APPROVAL | PUBLIC

  @@index([workspaceId, name])
  @@unique([workspaceId, name, version])
  @@map("summary_templates")
  @@schema("public")
}

model CallParticipant {
  workspaceId String // denormalized tenant key (stamped on insert)
  id           String              @id @default(cuid())
  callId       String              // Call ID (no FK constraint)
  userId       String              // User ID (no FK constraint)
  invitedBy    String              // User who sent invitation (no FK constraint)
  invitedAt    DateTime            @default(now())
  response     String?             // INVITED | REQUESTED | ACCEPTED | null (rejected/left)
  meetingStatus String             @default("PENDING")
  respondedAt  DateTime?           // When they accepted/rejected
  joinedAt     DateTime?           // NULL = not joined yet
  leftAt       DateTime?           // NULL = still in call
  metadata     Json?               // Connection quality, device info, etc.
  displayName  String?             // Name for external users
  email        String?             // Email for external invitees
  isExternal   Boolean             @default(false)  // True for external lobby users

  // Relations
  call Call @relation(fields: [callId], references: [id])

  @@unique([callId, userId]) // Prevent duplicate participants
  @@unique([callId, email]) // Prevent duplicate external email invitees
  @@index([callId]) // Fast call participant lookup
  @@index([userId]) // Fast user call lookup
  @@index([email]) // Fast external invitee lookup
  @@index([callId, leftAt]) // Fast active participants lookup
  @@index([response]) // Fast response lookup
  @@map("call_participants")
  @@schema("public")
}

// One row per recording session (start → stop). A call can have many.
// See docs/call_recording_tech_review.md for the locked design + state machine.
// A partial unique index `call_recordings_one_active ON call_recordings (call_id)
// WHERE status = 'RECORDING_ACTIVE'` is added via raw SQL in the migration (Prisma can't
// express it) — it is the single-active concurrency lock.
model CallRecording {
  workspaceId String // denormalized tenant key (stamped on insert)
  id            String          @id @default(cuid())
  callId        String
  egressId      String?         @unique          // webhook correlation key
  startedBy     String                           // user id; always set at creation. Cascade on user hard-delete
  name          String?                          // prefilled "Recording 1", renamable on stop
  recordingType String                           // explicit at start (no default)
  status        String                           // explicit at insert (born RECORDING_ACTIVE, no default)
  storagePath   String?                          // final MP4 object key, set only on UPLOADED (read by all consumers)
  segmentPrefix String?                          // HLS segment dir, set at start; deleted after a successful stitch
  messageId     String?                          // thread message this recording is posted under
  startedAt     DateTime                         // Set explicitly in code (no DB default — team convention)
  endedAt       DateTime?
  createdAt     DateTime                         // Set explicitly in code (no DB default — team convention)
  updatedAt     DateTime        @updatedAt

  call    Call  @relation(fields: [callId], references: [id], onDelete: Cascade)
  starter User @relation(fields: [startedBy], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_recordings")
  @@schema("non_zero")
}

model RecurringCallSeries {
  workspaceId String // denormalized tenant key (stamped on insert)
  id             String                    @id @default(cuid())
  title          String                    // Series title
  description    String?                   // Series description/agenda
  organizerId    String                    // User who created the series (no FK constraint)
  channelId      String                    // Channel where calls happen (no FK constraint)
  recurrenceRule String                    // RRULE pattern; UNTIL/COUNT are supported — backend derives endsOn from them
  timezone       String                    // IANA timezone e.g. "America/New_York"
  startTime      String                    // Time of day, 24h format e.g. "10:00"
  endTime        String                    // Time of day, 24h format e.g. "11:00"
  status         String                    @default("ACTIVE")
  startsOn       DateTime                  // Series start date (first possible occurrence)
  endsOn         DateTime?                 // Series end date (null = indefinite)
  metadata           Json?                     // Extra config e.g. { "reminderMinutes": 10 }
  callUpdatesChannel String?                   // Non-null = post call updates to this channel (Case 3); null = no broadcast
  createdAt          DateTime                  // Set explicitly in code
  updatedAt          DateTime                  @updatedAt

  // Relations
  instances Call[] // All Call instances generated from this series
  participants RecurringCallParticipant[]

  @@index([organizerId])  // Fast lookup of series created by a user
  @@index([channelId])    // Fast lookup of series in a channel
  @@index([status])       // Fast lookup of active series
  @@map("recurring_call_series")
  @@schema("public")
}

model RecurringCallParticipant {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                String              @id @default(cuid())
  recurringSeriesId String              // RecurringCallSeries ID
  userId            String              // User ID for internal participants; synthetic ID for external invitees
  invitedBy         String              // User who sent invitation (no FK constraint)
  invitedAt         DateTime
  response          String?             // INVITED | REQUESTED | ACCEPTED | null (rejected/left)
  meetingStatus     String              @default("PENDING")
  respondedAt       DateTime?           // When they accepted/rejected
  metadata          Json?               // Future participant-level metadata
  displayName       String?             // Name for external users
  email             String?             // Email for external invitees
  isExternal        Boolean             @default(false)

  // Relations
  recurringSeries RecurringCallSeries @relation(fields: [recurringSeriesId], references: [id], onDelete: Cascade)

  @@unique([recurringSeriesId, userId])
  @@unique([recurringSeriesId, email])
  @@index([recurringSeriesId])
  @@index([userId])
  @@index([email])
  @@index([isExternal])
  @@map("recurring_call_participants")
  @@schema("public")
}

// Canvas Feature Models (Notion/Slack Canvas-like documents)

// Canvas folders for manual canvas organization within a project, a specific
// channel, or a user's personal "My Canvases" scope.
model CanvasFolder {
  workspaceId String // denormalized tenant key (stamped on insert)
  id        String   @id @default(cuid())
  projectId String?
  channelId String?
  name      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project? @relation(fields: [projectId], references: [id])
  channel  Channel? @relation(fields: [channelId], references: [id])
  canvases Canvas[] @relation("FolderCanvases")

  // Prisma can model channel-scoped uniqueness; project-root and personal-root
  // nullable uniqueness are enforced by partial unique indexes in the SQL migration.
  @@unique([projectId, channelId, name], map: "canvas_folders_projectId_channelId_name_key")
  @@index([projectId])
  @@index([channelId])
  @@index([projectId, channelId])
  @@index([createdBy])
  @@map("canvas_folders")
  @@schema("public")
}

model Canvas {
  workspaceId String // denormalized tenant key (stamped on insert)
  id           String           @id @default(cuid())
  title        String
  content      Json // BlockNote JSON block array
  channelId    String? // Optional: Link to a channel (no FK constraint)
  folderId     String? // Optional: Link to a folder (NULL = ungrouped/personal)
  projectId    String? // Direct project link for canvases not in folders
  createdBy    String // User ID (no FK constraint)
  viewAccessId String? @unique // Random ID for view-only access
  editAccessId String? @unique // Random ID for edit access
  visibility   String           @default("PRIVATE")
  isTemplate   Boolean          @default(false)
  isArchived   Boolean          @default(false)
  lastEditedBy String? // Last user who edited (no FK constraint)
  lastEditedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  metadata     Json? // Tags, categories, custom properties
  isCollaborative   Boolean   @default(false)

  // Doc type - Canvas or Quarto
  docType      String           @default("Canvas")

  // Relations
  participants CanvasParticipant[]
  userStatuses CanvasUserStatus[]
  versions     CanvasVersion[]
  commentThreads CanvasCommentThread[]
  folder       CanvasFolder? @relation("FolderCanvases", fields: [folderId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  // SDLC kind/lifecycle + provenance live on the artifact row, keyed by canvas id.
  // Emulated (relationMode="prisma"), no DB FK.
  sdlcArtifact SdlcArtifact?
  // Quarto Doc fields - when docType is Quarto
  userRepo     String?          // Combined org/repo/branch identifier (for backward compatibility)
  repoId       String?          // Repo ID (no FK constraint) - for editing capability
  branchName   String?          // Branch name for the Quarto doc
  entryFile    String?          // Entry file path within the bundle
  quartoDocumentType String?    // "docs" | "book" | "slides" | "website" (type of Quarto document)
  gcsPath      String?          // Path in GCS where the bundle is stored

  @@unique([userRepo]) // One doc per repo/branch combination (backward compatibility)
  @@unique([repoId, branchName]) // One doc per repo/branch combination (when repoId is set)
  @@index([createdBy])
  @@index([channelId])
  @@index([folderId])
  @@index([projectId])
  @@index([visibility])
  @@index([isTemplate])
  @@index([viewAccessId])
  @@index([editAccessId])
  @@index([docType])

  @@index([createdBy, updatedAt(sort: Desc), id])
  @@index([docType, updatedAt(sort: Desc), id])
  @@map("canvases")
  @@schema("public")
}

model CanvasVersion {
  workspaceId String // denormalized tenant key (stamped on insert)
  id          String   @id @default(cuid())
  canvasId    String
  name        String
  content     Json
  contentHash String
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@unique([canvasId, contentHash])
  @@index([canvasId, updatedAt])
  @@index([createdBy])

  @@map("canvas_versions")
  @@schema("public")
}

model CanvasCommentThread {
  id              String                    @id @default(cuid())
  canvasId        String
  blockId         String
  anchorText      String?
  initialCommentId String?
  commentCount    Int                       @default(1)
  status          String                    @default("OPEN")
  statusUpdatedBy String?
  statusUpdatedAt DateTime?
  createdBy       String
  createdAt       DateTime                  @default(now())

  canvas              Canvas          @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  comments            CanvasComment[] @relation("CanvasCommentThreadComments")
  initialComment      CanvasComment?  @relation("CanvasCommentThreadInitialComment", fields: [initialCommentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser       User            @relation("CanvasCommentThreadCreatedBy", fields: [createdBy], references: [id])
  statusUpdatedByUser User?           @relation("CanvasCommentThreadStatusUpdatedBy", fields: [statusUpdatedBy], references: [id])

  @@index([canvasId, createdAt])
  @@map("canvas_comment_threads")
  @@schema("public")
}

model CanvasComment {
  id               String   @id @default(cuid())
  threadId         String
  canvasId         String
  body             String
  mentionedUserIds String   @default("[]")
  isInitial        Boolean  @default(false)
  createdBy        String
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())

  thread       CanvasCommentThread  @relation("CanvasCommentThreadComments", fields: [threadId], references: [id], onDelete: Cascade)
  initialForThreads CanvasCommentThread[] @relation("CanvasCommentThreadInitialComment")
  createdByUser User               @relation("CanvasCommentCreatedBy", fields: [createdBy], references: [id])

  @@index([threadId, isInitial, createdAt])
  @@map("canvas_comments")
  @@schema("public")
}

model CanvasParticipant {
  workspaceId String // denormalized tenant key (stamped on insert)
  id          String     @id @default(cuid())
  canvasId    String // Canvas ID (no FK constraint)
  userId      String? // User ID (no FK constraint)
  userGroupId String? // User group share target (no FK constraint)
  channelId   String? // Channel/DM share target (not canvas home channel, no FK constraint)
  role        String     @default("VIEWER") // OWNER | EDITOR | VIEWER
  joinedAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations (no FK constraints - consistent with userId and canvasId)
  canvas    Canvas     @relation(fields: [canvasId], references: [id])

  @@unique([canvasId, userId]) // User can only have one role per canvas
  @@unique([canvasId, userGroupId]) // Group can only have one role per canvas
  @@unique([canvasId, channelId]) // Channel can only have one role per canvas
  @@index([canvasId])
  @@index([userId])
  @@index([userGroupId])
  @@index([channelId])
  @@map("canvas_participants")
  @@schema("public")
}

model CanvasUserStatus {
  workspaceId String // denormalized tenant key (stamped on insert)
  id        String    @id @default(cuid())
  canvasId   String
  userId     String
  isStarred  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?

  canvas Canvas @relation(fields: [canvasId], references: [id])
  user   User   @relation("CanvasUserStatusUser", fields: [userId], references: [id])

  @@unique([canvasId, userId])
  @@index([canvasId])
  @@index([userId])
  @@index([userId, isStarred])
  @@map("canvas_user_status")
  @@schema("public")
}

// Bookmark Feature Models
model Bookmark {
  workspaceId String // denormalized tenant key (stamped on insert)
  id         String             @id @default(cuid())
  userId     String             // User who bookmarked (no FK constraint)
  entityId   String             // ID of the bookmarked entity
  entityType String             // Type of entity bookmarked
  createdAt  DateTime           @default(now())
  updatedAt  DateTime?
  isDeleted  Boolean            @default(false)
  isCompleted Boolean            @default(false)
  metadata   Json?              // Additional metadata

  @@unique([userId, entityId, entityType]) // User can only bookmark an entity once
  @@index([userId, entityType]) // Fast lookup of user's bookmarks by type
  @@index([userId, createdAt]) // Fast lookup of user's bookmarks sorted by time
  @@index([userId, isCompleted, updatedAt])

  @@index([userId, createdAt(sort: Desc), id])
  @@map("bookmarks")
  @@schema("public")
}

// Link Sharing Feature Models
model Link {
  workspaceId String // denormalized tenant key (stamped on insert)
  id          String         @id @default(cuid())
  url         String
  title       String
  description String?
  favicon     String?
  channelId   String
  createdBy   String         // User ID (no FK constraint)
  visibility  String         @default("DEFAULT")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([createdBy, url, channelId]) // No duplicate URLs per user per channel
  @@index([channelId, visibility]) // Fast lookup of channel links by visibility
  @@index([channelId, createdBy]) // Fast lookup of user's links in channel
  @@map("links")
  @@schema("public")
}

model LinkAccess {
  workspaceId String // denormalized tenant key (stamped on insert)
  id        String   @id @default(cuid())
  linkId    String   // Link ID (no FK constraint)
  userId    String   // User ID (no FK constraint)
  createdAt DateTime @default(now())

  @@unique([linkId, userId]) // User can only have one access record per link
  @@index([userId]) // Fast lookup of links shared with user
  @@index([linkId]) // Fast lookup of users with access to link
  @@map("link_access")
  @@schema("public")
}

// Vespa Insertion Logs
model VespaInsertionLogs {
  workspaceId String // denormalized tenant key (stamped on insert; nullable — legacy rows predate the backfill and cannot be resolved)
  id           String                @id @default(cuid())
  entityId     String
  entityType   String
  type         String                // INSERT | UPDATE | DELETE | POST_INGEST_CLEAN
  status       String                @default("PENDING")
  namespace    String?
  cluster      String?
  errorMessage String?
  errorDetails Json?
  retryCount   Int                   @default(0)
  createdAt    DateTime              @default(now())
  resolvedAt   DateTime?
  userId       String?               // User who initiated the operation

  @@index([entityId])
  @@index([entityType])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([entityId, entityType])
  @@map("vespa_insertion_logs")
  @@schema("workflow")
}

// Repository Configuration for IDE Integration
model Repo {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                   String @id @default(cuid())
  name                 String // e.g., "xyne-spaces"
  url                  String // SSH or HTTPS URL
  canonicalUrl         String?
  baseBranch           Json // Base branches to checkout from: ["main", "develop"]
  prefix               String // Branch prefix: "feature"
  createdBy            String // User who added the repo
  projectId            String?
  channelId            String?
  sdlcSetupExecutionId String? @unique
  accessCapabilities   Json?

  project         Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel         Channel?           @relation("RepoSdlcChannel", fields: [channelId], references: [id], onDelete: Cascade)
  setupExecution  WorkflowExecution? @relation("RepoSetupExecution", fields: [sdlcSetupExecutionId], references: [id], onDelete: SetNull)
  sdlcEntityLinks SdlcEntityLink[]
  sdlcArtifacts   SdlcArtifact[]
  sdlcTracks      SdlcTrack[]

  @@unique([url, createdBy]) // Same repo can be added by different users
  @@unique([workspaceId, canonicalUrl])
  @@index([name])
  @@index([projectId])
  @@index([workspaceId, projectId])
  @@map("repos")
  @@schema("public")
}

// Generic, repository-scoped trace and evidence links for the SDLC hub.
// Entity and relation kinds remain strings so v1 can grow without DB enum churn.
model SdlcEntityLink {
  id           String   @id @default(cuid())
  workspaceId  String
  repoId       String
  sourceType   String
  sourceId     String
  targetType   String
  targetId     String
  relationType String
  createdBy    String
  createdAt    DateTime @default(now())

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, sourceType, sourceId, targetType, targetId, relationType])
  @@index([workspaceId, repoId])
  @@index([repoId, sourceType, sourceId])
  @@index([repoId, targetType, targetId])
  @@map("sdlc_entity_links")
  @@schema("public")
}

// Provenance for SDLC-owned entities (one row per entity).
// entityType is 'CANVAS' for now; 'TICKET' reserved for future flows.
// sourceReferences holds stringified JSON: [{path, commitSha, symbol?, startLine?, endLine?}]
model SdlcArtifact {
  workspaceId         String
  artifactId          String   @id // canvas id (the only artifact kind for now) - Primary key
  repoId              String
  artifactType        String   @default("DEFAULT")
  artifactStatus      String   @default("ACTIVE")
  workflowExecutionId String?
  generationCommit    String?
  sourceReferences    String?
  sourcePaths         String?
  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  repo   Repo   @relation(fields: [repoId], references: [id], onDelete: Cascade)
  canvas Canvas @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([repoId])
  @@index([workflowExecutionId])
  @@index([workspaceId])
  @@index([artifactType, artifactStatus])
  @@map("sdlc_artifacts")
  @@schema("public")
}

// SDLC track: a named workstream inside a repo. Groups PRD canvases and
// conversations via their nullable trackId columns (one track per item).
model SdlcTrack {
  workspaceId String
  id          String   @id @default(cuid())
  repoId      String
  name        String
  description String?
  status      String   @default("ACTIVE") // ACTIVE | COMPLETED | ARCHIVED
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, status])
  @@index([workspaceId])
  @@map("sdlc_tracks")
  @@schema("public")
}

// Form Models
// Lookup value types for dynamic enumeration values
// Lookup values table - stores dynamic enumeration values for various entities
model LookupValue {
  id        String          @id @default(cuid())
  type      String     // Category/type of lookup value
  value     String          // The actual value
  createdAt DateTime        @default(now())

  @@unique([type, value])
  @@index([type])
  @@map("lookup_values")
  @@schema("public")
}

model Form {
  id              String         @id @default(cuid())
  formName        String
  formDescription String?
  entityType      String
  contextType     String
  workspaceId     String         // Workspace for ACL optimization
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  fields FormFields[]

  @@index([createdBy])
  @@index([entityType, contextType])

  @@index([workspaceId, createdAt(sort: Desc), id])
  @@map("forms")
  @@schema("public")
}

model FormContextMapping {
  workspaceId String // denormalized tenant key (stamped on insert)
  id          String         @id @default(cuid())
  formId      String
  contextId   String
  contextType String
  entityType  String

  @@unique([contextId, contextType, formId])
  @@unique([contextId, entityType])
  @@index([contextId, contextType])
  @@map("forms_context_mapping")
  @@schema("public")
}

// Project-scoped reusable field definitions.
// All newly created field definitions live here (unique per project by name + type).
model GlobalField {
  workspaceId String // denormalized tenant key (stamped on insert)
  id          String        @id @default(cuid())
  projectId   String        // Project scope for reuse + ACL
  fieldName   String        // Name of the field
  fieldType   String
  fieldEnum   String?         // Legacy string[]
  fieldOptions String?      // Canonical {id,value}[] options, JSON-stringified
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  project    Project      @relation(fields: [projectId], references: [id])
  formFields FormFields[]

  @@unique([projectId, fieldName, fieldType]) // One definition per name + type per project
  @@index([projectId])
  @@map("global_fields")
  @@schema("public")
}

// Per-form field membership.
// New rows point at a global_fields definition via globalFieldId.
// Legacy (deployed) rows carry their own definition columns (globalFieldId = null).
model FormFields {
  workspaceId String // denormalized tenant key (stamped on insert)
  id             String         @id @default(cuid())
  formId         String         // Form this membership row belongs to
  globalFieldId  String?        // Definition in global_fields (null for legacy rows)
  fieldName      String?        // DEPRECATED: legacy definition only; new definitions live in global_fields
  fieldType      String?        // DEPRECATED: legacy definition only
  fieldEnum      Json?          // DEPRECATED: legacy definition only; string[] projection kept for backward compat
  fieldOptions   String?        // Canonical {id,value}[] options, JSON-stringified; new clients read this, old clients never receive it
  isOptional     Boolean        @default(false) // Per-form optional
  sequenceNumber Int            @default(0)      // Monotonic per-form order; gaps remain after deletes
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  parentOptionId String?

  // Relations
  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
