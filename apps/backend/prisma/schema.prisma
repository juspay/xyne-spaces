// Release Management Enums

// Services that can be released
model Application {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                 String    @id @default(cuid())
  name               String
  projectId          String    // Project ID (no FK constraint)
  boardId            String    @unique // Application release board ID
  mainReleaseBoardId String?   // Owning main release board ID
  channelId          String?   // Channel ID (no FK constraint)
  regex              String    // Used to identify service
  repoUrl            String
  deployedCommit     String?   // Commit-range deployment state
  deployedVersion    String?   // Version-mode deployment state
  lastDeployedAt     DateTime?
  ownerTeam          String
  envPaths           String[]  @default([]) // Environment file paths matched against PR diffs
  migrationPaths     String[]  @default([]) // Migration file paths matched against PR diffs
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt 
  applicationBoard Board @relation("ApplicationBoard", fields: [boardId], references: [id], onDelete: Restrict)
  mainReleaseBoard Board? @relation("MainReleaseBoardApplications", fields: [mainReleaseBoardId], references: [id], onDelete: Restrict)

  @@unique([mainReleaseBoardId, name])
  @@index([projectId])
  @@index([channelId])
  @@index([boardId])
  @@index([mainReleaseBoardId])
  @@map("applications")
  @@schema("public")
}

// Per (per-app SubTicket × dev-ticket) testing cell.
// Ticket details (type, assignee, title) are fetched via the Zero `devTicket`
// relation (ticketId → ticket.id) — no snapshots needed.
model ApplicationReleaseTicket {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                    String                          @id @default(cuid())
  applicationReleaseId  String                          // SubTicket ID from ApplicationRelease
  ticketId              String                          // Dev ticket UUID (FK to tickets.id via Zero relation)
  releaseId             String                          // Release ticket ID
  testedBy              String?                         // User ID (no FK constraint)
  testedAt              DateTime?
  failureReason         String?
  // Nullable, no DB default: Zero client inserts don't run Postgres defaults, so
  // it's written app-side; NULL = not a hotfix. Release-scoped.
  isHotfix              Boolean?
  createdAt             DateTime                        @default(now())
  // No @default(now()): see Application.updatedAt — every write sets it explicitly.
  updatedAt             DateTime?                        @updatedAt

  @@unique([applicationReleaseId, ticketId])
  @@index([applicationReleaseId])
  @@index([ticketId])
  @@index([releaseId, createdAt(sort: Desc), id(sort: Desc)], map: "application_release_tickets_releaseId_createdAt_id_idx")
  @@map("application_release_tickets")
  @@schema("public")
}

// Captures all events tied to the release for audit trail
model ReleaseEvent {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                    String            @id @default(cuid())
  releaseId             String            // Always present - Release ticket ID
  applicationReleaseId  String?           // App-specific events (SubTicket ID)
  eventType             String
  eventName             String            // Specific action
  message               String            // Human-readable message
  userId                String?           // NULL = system event
  userName              String?           // Name of the user
  channelId             String            // Channel where release lives
  conversationId        String            // Thread for this release
  payload               Json?             // Flat, event-specific data
  createdAt             DateTime          @default(now())

  @@index([releaseId])
  @@index([applicationReleaseId])
  @@index([channelId, conversationId])
  @@index([eventType])
  @@index([createdAt])
  // Serves releaseEventsByReleaseId (filter releaseId, order createdAt desc, id desc);
  // avoids a zero-cache TEMP B-TREE sort. Built CONCURRENTLY in a raw migration.
  @@index([releaseId, createdAt(sort: Desc), id(sort: Desc)], map: "release_events_releaseId_createdAt_id_idx")
  @@map("release_events")
  @@schema("public")
}

model ReleaseChange {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                    String         @id @default(cuid())
  releaseId             String         // Release ticket ID
  applicationReleaseId  String?        // Application release ID (SubTicket ID)
  applicationId         String?        // Application ID
  approvedBy            String?        // User ID (no FK constraint)
  approvedAt            DateTime?
  createdAt             DateTime       @default(now())

  @@index([releaseId])
  @@index([applicationReleaseId])
  @@index([applicationId])
  @@map("release_changes")
  @@schema("public")
}

/// Per-instance anchor for a single env/migration change emitted during
/// release commit analysis. Each row pairs with a `form_entity_values`
/// bag (entityId = this row's id) that holds the variable kind-specific
/// fields (envKey/oldValue/newValue, changeLog/query, etc.). Legacy
/// pre-v2 rows existed as a per-(app, kind) lookup registry and have
/// all linkage columns NULL — release-scoped reads filter on
/// `releaseId IS NOT NULL` so they don't bleed into v2 surfaces.
model ReleaseChangeType {
  workspaceId String // denormalized tenant key (stamped on insert)
  id              String   @id @default(cuid())
  applicationId   String   // Application ID
  changeType      String   // e.g., "env", "migrations", "database", etc.
  releaseId            String? // Parent release Ticket id (matches release_events.releaseId)
  applicationReleaseId String? // Per-app SubTicket id (matches release_events.applicationReleaseId)
  devTicketXyneId      String? // Dev ticket xyneId carried from the source commit's PR title
  commitId             String? // Source commit hash
  filePath             String? // File path of the change (identifies the instance + dedupes)
  // No @default(now()): avoid a DB-level now() default on a Zero-synced table.
  // The repository sets createdAt explicitly on every write; pre-existing rows
  // are backfilled with a fixed literal in the migration, which drops the default.
  createdAt            DateTime?

  @@index([id])
  @@index([applicationId])
  @@index([changeType])
  @@index([releaseId])
  @@index([applicationReleaseId])
  @@index([devTicketXyneId])
  // Partial unique dedupe indexes (release_change_types_release_dedupe_key +
  // _nocommit_key) live in a raw migration — Prisma can't express filtered indexes.
  @@map("release_change_types")
  @@schema("public")
}

model TicketStageRequest {
