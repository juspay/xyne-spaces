// User-Team membership (many-to-many, no FK constraints)
model UserGroupMapping {
  workspaceId String // denormalized tenant key (stamped on insert)
  id             String              @id @default(cuid())
  userId         String              // No FK constraint
  userGroupId    String              // No FK constraint
  roleId         String?             // References Role.id; null = legacy rows using responsibility column
  responsibility String?             // Legacy column; new writes set roleId instead
  onCallSetNumber    Int?                // Deprecated: use onCallSetNumbers instead. Only set when autoRotationEnabled is true
  onCallSetNumbers   Int[]               // Array of set numbers for on-call rotation
  startOffset    Int?                // Cold-start fairness offset, added once for brand-new members with zero prior workload history
  isNotified     Boolean  @default(false) // Subscriber flag: when true, this member is notified whenever the group's maxWorkload cap blocks an assignment
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  user      User      @relation(fields: [userId], references: [id])
  userGroup UserGroup @relation(fields: [userGroupId], references: [id])
  role      Role?     @relation(fields: [roleId], references: [id])

  @@unique([userId, userGroupId])
  @@index([userId])
  @@index([userGroupId])
  @@index([roleId])
  @@index([userGroupId, createdAt(sort: Desc), id(sort: Asc)]) // for getUserGroupMembers
  @@index([userGroupId, onCallSetNumber]) // for on-call rotation queries (deprecated)
  @@index([userGroupId, onCallSetNumbers]) // for on-call rotation queries
  @@map("user_group_mappings")
  @@schema("public")
}

