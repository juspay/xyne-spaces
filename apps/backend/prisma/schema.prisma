// User Presence Status Model
model UserPresence {
  workspaceId String // denormalized tenant key (stamped on insert)
  id            String            @id @default(cuid())
  userId        String            @unique // One-to-one with User
  status        String             @default("OFFLINE")
  lastActiveAt  DateTime          @default(now()) // @deprecated — use User.lastActiveAt
  lastSeenAt    DateTime          @default(now())
  isManual      Boolean           @default(false) // If user manually set status
  deviceInfo    String?           // Optional: which device/browser
  statusEmoji   String?           // @deprecated — use User.statusEmoji
  statusContent String?           // @deprecated — use User.statusContent
  statusExpiryAt DateTime?        // @deprecated — use User.statusExpiryAt
  assignmentUnavailableUntil DateTime?  //  @deprecated — use User.assignmentUnavailableUntil When user will be available for ticket assignment again
  notificationsPausedUntil DateTime?    // @deprecated — use User.notificationsPausedUntil; Global notification pause (Slack-style "Pause notifications") - applies to all channels
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status]) // Fast lookup by status
  @@index([lastActiveAt]) // Fast lookup for cleanup
  @@map("user_presence")
  @@schema("public")
}

// User Profile Model
model UserProfile {
  workspaceId String // denormalized tenant key (stamped on insert)
  id                       String    @id @default(cuid())
  userId                   String    @unique // One-to-one with User
  dob                      DateTime? // Date of birth (optional)
  phoneNumber              String?   // Phone number (optional)
  displayName              String?   // Display name (optional) Deprecated - use displayName in User Table 
  team                     String?   // Team name/identifier (optional)
  pronunciation            String?   // Name pronunciation guide (optional)
  manager                  String?   // Manager userId (optional)
  role                     String?   // User role (optional)
  joinedOn                 DateTime? // Date when user joined (optional for backfill)
  voiceSignature           Bytes?    // 256 × float32 = 1024 bytes — speaker embedding for meeting identification
  hasVoiceSignature        Boolean   @default(false) // Zero-syncable flag derived from voiceSignature presence
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([userId]) // Fast lookup by user
  @@map("user_profiles")
  @@schema("public")
}

model Resource {
