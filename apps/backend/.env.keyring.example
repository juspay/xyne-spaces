# This optional file activates key-ring support.
# The original .env.local and ENCRYPTION_KEY remain unchanged.

ENCRYPTION_KEYS='[{"id":"k1","key":"CHANGEME"}]'

# Omit this during reader-preload deployment.
# Add it only after every reader has the key ring.
ENCRYPTION_ACTIVE_KEY_ID=k1

# Optional local diagnostic output.
# No keys, plaintext, or ciphertext are written here.
ENCRYPTION_DIAGNOSTIC_LOG_FILE=logs/encryption-diagnostics.jsonl
