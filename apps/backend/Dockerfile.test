# syntax=docker/dockerfile:1
FROM mirror.gcr.io/library/node:22.22.3-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    git \
    openssl \
    libssl-dev \
    ca-certificates \
    curl \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# --- shared: deps then source ---

# --- framework: deps then source ---

# --- backend: deps then source ---
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/shared/package.json           packages/shared/
COPY packages/framework/package.json        packages/framework/
COPY apps/backend/package.json              apps/backend/
COPY apps/backend/eslint-rules/package.json apps/backend/eslint-rules/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
# --ignore-scripts: only the manifests are present at this layer, so the
# `prepare` hooks on @xyne/shared and @xyne/icons (which run tsc) would fail
# with no sources or tsconfig.json. The explicit build steps after the source
# COPY below do that work instead.
    pnpm install --frozen-lockfile --prod=false --ignore-scripts --filter xyne-spaces-backend...
COPY packages/shared    packages/shared
COPY packages/framework packages/framework
RUN pnpm --filter @xyne/shared --filter agentic-framework run build
COPY apps/backend apps/backend
RUN ln -s /repo/apps/backend /app
WORKDIR /repo/apps/backend

COPY package.json /package.json

# Seed env files at BOTH locations from the tracked, non-secret backend/.env.test:
# - .env: Required by Prisma for db:generate and db:push
# - .env.local: Required by pnpm run dev:test (uses dotenv -e .env.local)
# .env.test is committed (test creds + container hostnames only) and is the single
# source of truth for the test image. docker-compose.test.yml also layers it at runtime.
COPY apps/backend/.env.test .env
COPY apps/backend/.env.test .env.local

COPY scripts/setup-fake-gcs-test.sh /scripts/setup-fake-gcs-test.sh
RUN chmod +x /scripts/setup-fake-gcs-test.sh

RUN pnpm run db:generate
RUN pnpm run db:common:generate

CMD ["sh", "-c", "\
  pnpm run db:push && \
  pnpm exec prisma db execute --file prisma/migrations/20251127175400_add_ticket_xyne_id_sequence/migration.sql --schema prisma/schema.prisma && \
  /scripts/setup-fake-gcs-test.sh && \
  pnpm run dev:test"]
