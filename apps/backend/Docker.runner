# Worker/runner image. Shares the backend codebase and build; the ONLY
# difference from apps/backend/Dockerfile is the entrypoint (dist/worker.js
# instead of dist/index.js). Hardened to distroless for the same reasons as the
# backend (see that file's notes): no shell, no package manager, no
# coreutils/curl/git/ssh/ffmpeg — so an RCE in a worker can't spawn bash, dump
# env, curl the metadata server, or pivot, the way the Oct-2026 incident's
# command-executor did in the old `nixuser` runner.
#
# What this drops vs the old Debian runner (all safe for chat-only):
#   - ffmpeg  : HLS->MP4 recording stitch / video rendition. Flag-gated behind
#               ENABLE_STITCH_WORKER (off in chat-only). spawn('ffmpeg') already
#               rejects on ENOENT (utils/ffmpeg.ts) and BullMQ fails the job
#               without crashing the worker -> graceful degradation.
#   - qpdf    : PDF staging. spawn('qpdf') already guards 'error'
#               (common/pdf/pdfProcessor.ts) -> failed job, not a crash. (The old
#               runner didn't install qpdf either.)
#   - git+ssh : SDLC/VCS. Not imported by worker.ts; SDLC was removed as an app.
#   - curl/wget/jq/procps, global typescript/@xyne/xyne-cli, npm : debug/build
#               conveniences with no runtime caller in the worker path.
#
# Debug: distroless has no shell, so `kubectl exec -- sh` won't work. For a
# one-off, swap the runner tag to :debug-nonroot (busybox) and rebuild. Never
# ship :debug to prod.

FROM node:22.23.4-slim AS base

# Build dependencies for native modules and OpenSSL (builder only).
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    git \
    openssl \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

FROM base AS builder
WORKDIR /repo

# tsc + prisma generate are heap-heavy on this codebase; without this the `tsc`
# build OOMs (V8 heap, exit 134) under a container's default heap. Builder only.
ENV NODE_OPTIONS="--max-old-space-size=8192"

# Manifests + lockfile first so the install layer caches independently of source.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/shared/package.json           packages/shared/
COPY packages/storage/package.json          packages/storage/
COPY packages/cache/package.json            packages/cache/
COPY packages/secrets-vault/package.json    packages/secrets-vault/
COPY apps/backend/package.json              apps/backend/
COPY apps/backend/eslint-rules/package.json apps/backend/eslint-rules/

# devDependencies are required below for prisma generate and tsc.
# --ignore-scripts: only the manifests are present at this layer, so the
# `prepare` hooks on @xyne/shared and @xyne/icons (which run tsc) would fail
# with no sources or tsconfig.json. The explicit build steps after the source
# COPY below do that work instead.
RUN pnpm install --frozen-lockfile --prod=false --ignore-scripts --filter xyne-spaces-backend...

# Linux-native canvas binary; optional, tolerated if unavailable for the arch.
RUN pnpm --filter xyne-spaces-backend add -O @napi-rs/canvas-linux-arm64-gnu || true

COPY packages/shared        packages/shared
COPY packages/storage       packages/storage
COPY packages/cache         packages/cache
COPY packages/secrets-vault packages/secrets-vault
COPY apps/backend           apps/backend
COPY scripts                scripts

# backend consumes these from their built dist/
RUN pnpm --filter @xyne/shared --filter @xyne/storage --filter @xyne/cache --filter @xyne/secrets-vault run build

# Cache-busting argument to ensure db:generate always runs
ARG CACHEBUST=1
RUN pnpm --filter xyne-spaces-backend run db:generate
RUN pnpm --filter xyne-spaces-backend run db:common:generate
RUN pnpm --filter xyne-spaces-backend run build

# ---------------------------------------------------------------------------
# PROD-SLIM via `pnpm deploy` -> /app  (identical to the backend image)
# ---------------------------------------------------------------------------
# Builds a FRESH, flat, prod-only node_modules (no dev tree, no .pnpm store) so
# the dev-tree CVEs don't ship. dist/worker.js is part of the same backend build
# output, so it comes across in this tree. Both Prisma clients are re-attached
# because deploy reinstalls node_modules and skips the gitignored generated dirs:
#   - main schema   -> default output node_modules/.prisma/client
#   - common schema -> custom output prisma-common/generated/client
RUN pnpm --filter xyne-spaces-backend --prod --legacy deploy /app && \
    cp -r "$(find node_modules/.pnpm -path '*@prisma+client@5.22.0_prisma@5.22.0/node_modules/.prisma' -type d | head -1)" /app/node_modules/.prisma && \
    cp -r apps/backend/prisma-common/generated /app/prisma-common/generated

# ---------------------------------------------------------------------------
# Production image
# ---------------------------------------------------------------------------
# Patched OpenSSL from Debian bookworm overlaid onto distroless (same soname,
# ABI-compatible patch bump) — clears the base's libssl3 CVEs until distroless
# ships a patched digest. See the backend Dockerfile for the full rationale.
FROM debian:12-slim AS libssl
RUN apt-get update && apt-get install -y --no-install-recommends libssl3 && \
    awk 'BEGIN{RS="";ORS="\n\n"} /^Package: libssl3\n/{print}' /var/lib/dpkg/status > /libssl3.status && \
    rm -rf /var/lib/apt/lists/*

FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runner
WORKDIR /app

# Overlay the patched OpenSSL shared libs onto the distroless base.
COPY --from=libssl /usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libssl.so.3
COPY --from=libssl /usr/lib/x86_64-linux-gnu/libcrypto.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.3
# Update the dpkg metadata the scanners read so it reflects the patched version.
COPY --from=libssl /libssl3.status /var/lib/dpkg/status.d/libssl3

# The prod-slim `pnpm deploy` tree from the builder, owned by the distroless
# nonroot uid/gid (65532) so the process owns what it reads.
COPY --from=builder --chown=65532:65532 /app /app

# logger.ts reads the version from the repo-root package.json; with the app root
# at /app, its ../../../package.json resolves to /package.json.
COPY --chown=65532:65532 package.json /package.json

USER nonroot

# Metrics/health port (OpenTelemetry). Worker serves no request traffic.
EXPOSE 3001

ENV NODE_ENV=production

# Entrypoint is `node`, so this becomes:
#   node --enable-source-maps --import tsx dist/worker.js
# mirrors the `start:worker` script (tsx --enable-source-maps dist/worker.js).
# tsx is kept as the loader (a few deps ship ESM with extensionless imports that
# bare node ESM rejects); it survives the --prod prune as a runtime dep.
CMD ["--enable-source-maps", "--import", "tsx", "dist/worker.js"]
