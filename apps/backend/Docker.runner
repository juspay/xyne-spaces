# Multi-stage build for production optimization
FROM node:22-slim AS base

ARG user=nixuser
ARG group=xyne
ARG gid=1000

WORKDIR /app

# Install build dependencies for native modules and OpenSSL
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    git \
    openssl \
    libssl-dev \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Build the application.
# The separate shared-builder stage is gone: one workspace install resolves
# @xyne/shared through its workspace:* link, so it no
# longer need their own stage. The `sed -i '/"postinstall":/d'` hack is gone too
# — that postinstall (`cd ../shared && npm install && npm run build`) no longer
# exists.
FROM base AS builder
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

WORKDIR /repo

# Manifests + lockfile first so the install layer caches independently of source.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/shared/package.json           packages/shared/
COPY packages/storage/package.json          packages/storage/
COPY packages/cache/package.json            packages/cache/
COPY packages/secrets-vault/package.json    packages/secrets-vault/
COPY apps/backend/package.json              apps/backend/
COPY apps/backend/eslint-rules/package.json apps/backend/eslint-rules/

# --ignore-scripts: only the manifests exist at this layer, so the `prepare`
# hooks on @xyne/shared (which run tsc) would fail with no sources or
# tsconfig.json. The explicit build below does that work instead.
RUN pnpm install --frozen-lockfile --prod=false --ignore-scripts --filter xyne-spaces-backend...

COPY packages/shared        packages/shared
COPY packages/storage       packages/storage
COPY packages/cache         packages/cache
COPY packages/secrets-vault packages/secrets-vault
COPY apps/backend           apps/backend
COPY scripts                scripts

# backend consumes these from their built dist/
RUN pnpm --filter @xyne/shared --filter @xyne/storage --filter @xyne/cache --filter @xyne/secrets-vault run build

WORKDIR /repo/apps/backend
RUN pnpm run db:generate
RUN pnpm run db:common:generate
RUN pnpm run build
RUN sed -i 's|"baseUrl": "./src"|"baseUrl": "./dist"|' tsconfig.json
RUN rm -rf src tests eslint-rules manual_migrations scripts docs *.md *.cjs
WORKDIR /repo

# Production image
FROM node:22-slim AS runner

ARG user=nixuser
ARG group=xyne
ARG gid=1000

# Switch to root to install packages
USER root

WORKDIR /app

# Install CA certificates and essential tools
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    wget \
    git \
    jq \
    openssl \
    openssh-client \
    libssl-dev \
    procps \
    ffmpeg \
    && update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# ffmpeg is used by the recording stitch worker and the compatible-video
# rendition worker. The HDR -> SDR tone-map needs zscale (libzimg) and the
# rendition needs libx264; fail the build rather than the first transcode.
RUN ffmpeg -hide_banner -filters | grep -q ' zscale ' \
    && ffmpeg -hide_banner -filters | grep -q ' tonemap ' \
    && ffmpeg -hide_banner -encoders | grep -q ' libx264 '

# Create the runtime user (name kept: deployments mount SSH material under /home/nixuser)
RUN groupadd --system ${group} && \
    useradd --system --gid ${group} --create-home --home-dir /home/${user} ${user} && \
    mkdir -p /home/${user}/.ssh && \
    chown -R ${user}:${group} /home/${user} && \
    chmod 700 /home/${user}/.ssh && \
    usermod --shell /bin/bash ${user}

# Copy the built application and source files.
# The whole workspace comes across, not the three packages separately: under
# pnpm's isolated linker a package's node_modules are symlinks into the root
# .pnpm store, so copying them individually would leave every dependency
# dangling.
COPY --from=builder --chown=${user}:${group} /repo /repo
RUN ln -s /repo/apps/backend       ./backend && \
    ln -s /repo/packages/shared    ./shared

# Install global tooling and fix cache ownership.
# The former `npm install tsconfig-paths` here is dropped: backend declares
# tsconfig-paths (^4.2.0), so it is already installed by the workspace install,
# and running npm inside a pnpm package would create a conflicting node_modules.
# The chmod sweeps follow /repo (the real path) rather than the /app symlinks,
# since under the isolated linker the actual files live in the .pnpm store.
RUN mkdir -p logs tmp .cache /home/${user}/.npm && \
    npm install -g @xyne/xyne-cli@latest typescript && \
    cd /repo/apps/backend && \
    pnpm add -O @napi-rs/canvas-linux-arm64-gnu || true && \
    mkdir -p node_modules/.cache && \
    chown -R ${user}:${group} /app/logs /app/tmp /app/.cache /home/${user}/.npm && \
    chmod -R 775 /app/logs /app/tmp /app/.cache && \
    find /repo/node_modules/.pnpm -type d -name .bin -exec chmod -R 755 {} + 2>/dev/null || true && \
    find /repo/apps/backend/node_modules/.bin -type f -exec chmod 755 {} + 2>/dev/null || true && \
    find /repo/node_modules/.pnpm -name "*.mjs" -exec chmod 755 {} + 2>/dev/null || true && \
    find /repo/node_modules/.pnpm -path "*@esbuild*" -name "esbuild" -exec chmod 755 {} + 2>/dev/null || true

# Switch to non-root user
USER ${user}

ENV USER=${user}
ENV HOME=/home/${user}

EXPOSE 3001

ENV NODE_ENV=production

# Override the entrypoint from base image
ENTRYPOINT []

# Set final working directory to backend
WORKDIR /app/backend

# Run production worker from compiled dist folder
CMD ["npm", "run", "start:worker"]
