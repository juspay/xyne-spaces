# Server Configuration
NODE_ENV=development
PORT=3001
# Extra leading path prefix this instance also answers on, in addition to /api.
# Set to /sdlc-api on the SDLC lane's backend so the edge can route the two lanes
# apart on a static prefix without needing rewrite support. Empty = today's behaviour.
API_PATH_PREFIX=
HOST=0.0.0.0
# Set to a positive integer to enforce a member cap per organization; leave unset for no limit
# ORG_MEMBER_LIMIT=10

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,xyne-spaces://.
ALLOWED_REDIRECT_ORIGINS=http://localhost:5173,http://localhost:5174

# Allowed origins for media streaming (video/audio cross-origin access)
# Comma-separated list of trusted origins that can embed and play media files
ALLOWED_MEDIA_ORIGINS=https://spaces.xyne.example.com/,http://localhost:5173/

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
# Streams error-level logs to Fluent Bit (docker-compose.dev.yml) for the
# VictoriaLogs/Grafana error dashboard. Off by default.
LOG_FLUENT_ENABLED=false
LOG_FLUENT_HOST=localhost
LOG_FLUENT_PORT=24224

# Database Configuration
DATABASE_URL=postgresql://xyne:xyne123@localhost:5433/xyne_dev_db?schema=public

# Common Database Configuration (separate instance for shared state, e.g. entity sequences)
COMMON_DATABASE_URL=postgresql://xyne:xyne123@localhost:5433/xyne_common?schema=common
COMMON_DATABASE_POOL_SIZE=2
COMMON_DATABASE_POOL_TIMEOUT_SECONDS=10
ENABLE_COMMON_DB_TICKET_SEQUENCE=true

ZERO_UPSTREAM_DB=postgresql://xyne:xyne123@localhost:5433/xyne_dev_db
ZERO_PORT=4848
ZERO_MUTATE_URL=http://localhost:3002/api/zero/push
ZERO_MUTATE_FORWARD_COOKIES=true
ZERO_QUERY_URL=http://localhost:3002/api/zero/query
ZERO_QUERY_FORWARD_COOKIES=true
ZERO_LOG_LEVEL=info
ZERO_REPLICA_FILE=./zero-replica.db

JWT_SECRET=set-me
ZERO_AUTH_SECRET=set-me

# Number of days until the session cookie and refresh token expire
SESSION_EXPIRY_DAYS=365

# Redis Configuration
REDIS_URL=redis://localhost:6379
# Comma-separated queue names the producer fans out to (default: vespa-ingestion,vespa-files)
VESPA_QUEUE_NAMES=vespa-ingestion,vespa-files,vespa-ingestion-kube
# Queue name this worker instance consumes from (default: vespa-ingestion)
VESPA_WORKER_QUEUE_NAME=vespa-ingestion
#VESPA_WORKER_QUEUE_NAME=vespa-ingestion-kube
#VESPA_WORKER_QUEUE_NAME=vespa-backfill-normal
# Vespa File Queue Configuration (for heavy file/attachment processing)
# This separates file indexing from message indexing to prevent blocking
VESPA_FILE_QUEUE_NAME=vespa-files
VESPA_FILE_WORKER_CONCURRENCY=1
#VESPA_FILE_QUEUE_NAME=vespa-backfill-file

# Vespa BACKFILL Queue Configuration (backfill + migration) — kept fully separate from
# the live queues above so backfill load never disturbs live ingestion.
# Mirrors the live normal/file split (vespa-ingestion / vespa-files):
# Producer fans out: non-file backfill jobs -> vespa-backfill-normal, file jobs -> vespa-backfill-file
VESPA_BACKFILL_QUEUE_NAMES=vespa-backfill-normal,vespa-backfill-file
VESPA_BACKFILL_FILE_QUEUE_NAME=vespa-backfill-file
# Drain these on dedicated worker pods (no code change) by deploying the worker image with:
#   ENABLE_VESPA_WORKER=true VESPA_WORKER_QUEUE_NAME=vespa-backfill-normal   (non-file backfill pod)
#   ENABLE_VESPA_WORKER=true VESPA_WORKER_QUEUE_NAME=vespa-backfill-file     (file backfill pod)
# Message/attachment indexing via conversationService routes to the backfill queues when the
# content's createdAt is older than this many days (historical/migration writes). Default 365.
VESPA_BACKFILL_AGE_DAYS=365
ENABLE_MESSAGE_CLASSIFICATION=false
# Dedicated LiteLLM service account key for thread-type classification. When set it is
# used instead of the org's provisioned key (which would otherwise shadow it).
THREAD_TYPE_CLASSIFICATION_LITELLM_API_KEY=
ENABLE_VESPA_FILE_WORKER=false

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth Configuration (SSO login + Calendar polling)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3001/auth/microsoft/callback
MICROSOFT_TENANT_ID=your-microsoft-tenant-id

# Calendar sync settings (optional — defaults shown)
# MICROSOFT_CALENDAR_SYNC_CRON=*/5 * * * *
# GOOGLE_CALENDAR_SYNC_CRON=*/5 * * * *


# Slack Configuration for notifications
SLACK_BOT_TOKEN=

# Development Authentication (SECURITY WARNING!)
# ONLY enable this in development environments for mock user authentication
# This allows bypassing Google OAuth with special headers from localhost only
# NEVER set this to true in production - serious security vulnerability!
ENABLE_DEV_AUTH=true

# Security
ENCRYPTION_KEY=set-me

# External APIs (add when needed)
# API_KEY=
# API_SECRET=

# LiveKit Configuration
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_CLIENT_URL=http://localhost:5173

# File Storage Configuration
STORAGE_PROVIDER=gcs

# Google Cloud Storage Configuration
GCS_PROJECT_ID=xyne-spaces
GCS_BUCKET_NAME=xyne-spaces-chat-documents
GCS_SESSION_RECORDING_BUCKET_NAME=xyne-session-recordings
TRANSCRIPTION_BUCKET_NAME=transcription-dev-v2

# AWS S3 Configuration (when STORAGE_PROVIDER=s3)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_NAME=xyne-spaces-chat-documents
# S3_ENDPOINT=http://localhost:9000  # MinIO endpoint for local dev

# Actionable/FYI config (user metadata + activity classification worker settings)
LLM_REQUEST_TIMEOUT_MS=120000
# Team Intelligence LLM timeout (independent of LLM_REQUEST_TIMEOUT_MS).
# Set to 0 to disable the timeout entirely (let summary calls run until LiteLLM responds).
TEAM_INTELLIGENCE_LLM_MODEL=open-fast
TEAM_INTELLIGENCE_LLM_REQUEST_TIMEOUT_MS=120000
# Team Intelligence LLM pressure controls. Lower these in production if LiteLLM
# rate limits, terminates streams, or starts timing out. Section concurrency
# accepts a positive number, "all", "max", or "full". Global section concurrency
# overrides scoped section values when set, so TEAM_INTELLIGENCE_SECTION_CONCURRENCY=1
# is the emergency brake for all user/team/org section waves.
TEAM_INTELLIGENCE_LLM_GLOBAL_CONCURRENCY=8
TEAM_INTELLIGENCE_USER_JOB_CONCURRENCY=1
TEAM_INTELLIGENCE_TEAM_JOB_CONCURRENCY=1
TEAM_INTELLIGENCE_ORG_JOB_CONCURRENCY=1
TEAM_INTELLIGENCE_SECTION_CONCURRENCY=
TEAM_INTELLIGENCE_USER_SECTION_CONCURRENCY=3
TEAM_INTELLIGENCE_TEAM_SECTION_CONCURRENCY=3
TEAM_INTELLIGENCE_ORG_SECTION_CONCURRENCY=3
ACTIVITY_CLASSIFICATION_MAX_RETRIES=5
ENABLE_ACTIVITY_CLASSIFICATION_WORKER=true

# Ticket description clean worker (Vespa)
ENABLE_TICKET_CLEANUP_WORKER=true
TICKET_DESC_CLEAN_MAX_RETRIES=3

# Call validation worker (validates active calls against LiveKit every 5 minutes)
ENABLE_CALL_VALIDATION_WORKER=true

# Email classification worker (AI category + priority classification)
ENABLE_EMAIL_CLASSIFICATION_WORKER=true

# AI provisioning worker (xyne-claw + LiteLLM org/user setup)
ENABLE_AI_PROVISIONING_WORKER=false
ENABLE_SDLC_WORKER=false
SDLC_GLOBAL_ACTIVE_LIMIT=9
SDLC_REPO_ACTIVE_LIMIT=3
SDLC_CAPACITY_WAIT_TIMEOUT_MS=86400000
SDLC_CAPACITY_RETRY_DELAY_MS=30000
SDLC_CLAW_RUN_TIMEOUT_MS=10800000
ENABLE_USER_AI_PROVISIONING=false
ORG_DEFAULT_MODELS=kimi-latest,private-large
XYNE_CLAW_AUTH_INTERNAL_URL=http://localhost:3003
AI_PROVISIONING_QUEUE_ATTEMPTS=3
AI_PROVISIONING_QUEUE_BACKOFF_MS=5000
AI_PROVISIONING_REQUEST_TIMEOUT_MS=30000
# LiteLLM per-user budget by workspace type; leave unset to use LiteLLM defaults
# COMMUNITY_WORKSPACE_USER_BUDGET=5
# ENTERPRISE_WORKSPACE_USER_BUDGET=20

# Nudge Framework
ENABLE_PROACTIVE_NUDGE_WORKER=false

# Dynamic dashboards: background ingestion worker for user-configured data sources
ENABLE_DATA_SOURCE_INGESTION_WORKER=true
# Max tables a user can select to ingest per data source
DATA_SOURCE_INGEST_TABLE_LIMIT=30
DATA_SOURCE_EDA_CONCURRENCY=4
DATA_SOURCE_ALLOW_PRIVATE_HOSTS=false

# Dynamic dashboards: AI tile generation (LiteLLM) — model id served by the LiteLLM gateway
DASHBOARD_AI_MODEL=glm-latest

# Dynamic dashboards: query execution timeouts to customer data sources
DASHBOARD_PG_CONNECTION_TIMEOUT_MS=10000
DASHBOARD_CH_REQUEST_TIMEOUT_MS=65000

# Dynamic dashboards: Redis cache TTL for resolved query results (seconds)
DASHBOARD_QUERY_CACHE_TTL_SEC=60

# Investigation API
INVESTIGATION_API_URL=http://127.0.0.1:8000
INVESTIGATION_AUTH_TOKEN=token

