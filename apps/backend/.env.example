# ─── Zero Field Encryption ───────────────────────────────────────────────────
# See docs/ENCRYPTION_IMPLEMENTATION_PLAN.md for full setup guide.
#
# Generate dev keys (one-time):
#   mkdir -p .xyne/dev/keys
#   openssl genrsa -out .xyne/dev/keys/rsa-private.pem 2048
#   openssl rsa -in .xyne/dev/keys/rsa-private.pem -pubout -out .xyne/dev/keys/rsa-public.pem
#   openssl rand -hex 32 > .xyne/dev/keys/hsm-master.key
#   echo '{"srv-key-2024":"'$(openssl rand -hex 32)'"}' > .xyne/dev/keys/server-keys.json
#
# All key material is stored in FILES, not inline. These vars hold file paths.
# Empty path = feature disabled (graceful no-op, no crash).

# Upstream zero-cache URL that the WS proxy forwards to.
ZERO_CACHE_UPSTREAM=http://localhost:4848

# RSA key pair for wrapping/unwrapping client AES session keys during key exchange.
# Production: sourced from HSM. Dev: local PEM files.
ZERO_ENC_RSA_PRIVATE_KEY_PATH=../.xyne/dev/keys/rsa-private.pem
ZERO_ENC_RSA_PUBLIC_KEY_PATH=../.xyne/dev/keys/rsa-public.pem

# HSM provider for wrapping client session keys at rest in the database.
# 'env' = local master key file (dev/test). 'aws-kms'/'gcp-kms'/'azure' = cloud KMS (production).

# Dev only: path to file containing 32-byte hex master key for EnvHsmProvider (AES-256-KW).
ZERO_ENC_HSM_MASTER_KEY_PATH=../.xyne/dev/keys/hsm-master.key

# Production only: cloud KMS key ARN/resource name. Ignored when HSM_PROVIDER=env.
ZERO_ENC_HSM_KEY_ID=

ENABLE_FILE_INDEXING=false

# OpenTelemetry Configuration


# Internal Service Auth (S2S authentication)
