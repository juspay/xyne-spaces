{
  "name": "xyne-spaces-dashboard-edge",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard edge: rule resolver, storage origin and status service behind nginx's disk cache",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --exclude \"**/node_modules/**\" --exclude \"**/dist/**\" --exclude \"**/.git/**\" src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.209.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.217.0",
    "@xyne/storage": "file:../../packages/storage",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "prettier": "3.8.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "overrides": {
      "@azure/msal-node": "7.1.2",
      "@grpc/grpc-js": "1.14.5",
      "@opentelemetry/core": "2.8.0",
      "@opentelemetry/core@2": "2.8.0",
      "@opentelemetry/exporter-prometheus": "0.220.0",
      "@opentelemetry/propagator-jaeger": "2.9.0",
      "@opentelemetry/sdk-node": "0.217.0",
      "ajv@6": "6.14.0",
      "ajv@8": "8.18.0",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.11",
      "fast-xml-builder": "1.3.0",
      "fast-xml-parser@4": "4.5.7",
      "fast-xml-parser@5": "5.12.0",
      "flatted": "3.4.2",
      "form-data@2": "2.5.6",
      "form-data@4": "4.0.6",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "jws": "4.0.1",
      "minimatch@10": "10.2.6",
      "minimatch@3": "3.1.5",
      "minimatch@5": "5.1.9",
      "minimatch@9": "9.0.9",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.5",
      "protobufjs@7": "7.6.5",
      "protobufjs@8": "8.7.1",
      "uuid@10": "11.1.1",
      "uuid@11": "11.1.1",
      "uuid@13": "14.0.2",
      "uuid@3": "11.1.1",
      "uuid@8": "11.1.1",
      "uuid@9": "11.1.1",
      "zod@4": "4.6.6"
    }
  }
}
