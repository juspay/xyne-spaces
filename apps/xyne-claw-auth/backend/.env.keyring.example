# This optional file enables Claw-auth to read versioned
# ciphertext produced by the Spaces backend.
#
# The original .env and SPACES_ENCRYPTION_KEY remain unchanged.

SPACES_ENCRYPTION_KEYS='[{"id":"k1","key":"CHANGEME"}]'

# Optional local diagnostics. Keys and secret values are never logged.
SPACES_ENCRYPTION_DIAGNOSTIC_LOG_FILE=logs/spaces-encryption-diagnostics.jsonl
