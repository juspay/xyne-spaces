{
  "name": "xyne-claw-auth",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "MCP credential management service for XyneClaw",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"**/node_modules/**\" --exclude \"**/dist/**\" --exclude \"**/.git/**\" --env-file=.env src/main.ts",
    "start": "node --import tsx/esm src/main.ts",
    "lint:slack": "eslint src/surfaces/slack",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@mozilla/readability": "0.6.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.209.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.217.0",
    "@prisma/client": "6.19.3",
    "@sinclair/typebox": "0.34.52",
    "@slack/web-api": "8.0.0",
    "@types/pdfkit": "0.17.6",
    "@xyne/icons": "workspace:*",
    "@whiskeysockets/baileys": "6.7.24",
    "@xyne/shared": "workspace:*",
    "@xyne/storage": "workspace:*",
    "bullmq": "5.81.2",
    "cron-parser": "4.9.0",
    "exceljs": "4.4.0",
    "express": "4.22.2",
    "express-rate-limit": "8.5.2",
    "ioredis": "5.11.1",
    "jose": "6.2.4",
    "jsonwebtoken": "9.0.3",
    "jszip": "3.10.1",
    "linkedom": "0.18.13",
    "marked": "18.0.7",
    "multer": "2.5.0",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.18.0",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "slackify-markdown": "5.0.0",
    "tsx": "4.23.1",
    "turndown": "7.2.4",
    "undici": "7.30.1",
    "xyne-claw-shared": "workspace:*",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.5",
    "@types/turndown": "5.0.6",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@opentelemetry/otlp-transformer": {
      "protobufjs": "^8.0.1"
    }
  }
}
