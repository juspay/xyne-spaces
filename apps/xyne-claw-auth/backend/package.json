{
  "name": "xyne-claw-auth",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "MCP credential management service for XyneClaw",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/main.ts",
    "start": "node --import tsx/esm src/main.ts",
    "lint:slack": "eslint src/surfaces/slack",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "0.73.0",
    "@mariozechner/pi-ai": "0.73.0",
    "@mariozechner/pi-coding-agent": "0.73.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@mozilla/readability": "^0.6.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.209.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "^0.209.0",
    "@prisma/client": "^6.0.0",
    "@sinclair/typebox": "^0.34.49",
    "@slack/web-api": "8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@xyne/icons": "workspace:*",
    "@xyne/shared": "workspace:*",
    "@xyne/storage": "workspace:*",
    "bullmq": "^5.72.0",
    "cron-parser": "^4.9.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.8.2",
    "jose": "6.2.4",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.12",
    "marked": "^18.0.4",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "slackify-markdown": "5.0.0",
    "tsx": "^4.19.0",
    "turndown": "^7.2.4",
    "undici": "^7.28.0",
    "xyne-claw-shared": "workspace:*",
    "yaml": "^2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.39.4",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "@opentelemetry/otlp-transformer": {
      "protobufjs": "^8.0.1"
    }
  }
}
