generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                     @id
  email                 String
  name                  String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  connections           UserMcpConnection[]
  identities            GatewayIdentity[]
  agents                Agent[]
  agentConfigs          UserAgentConfig[]
  roles                 UserRole[]
  sharedAgents          AgentShare[]
  sharedSubagents       SubagentShare[]
  skills                Skill[]
  providerCredentials   UserProviderCredentials[]
  surfaceAccessTokens   SurfaceAccessToken[]
  surfaceIdentities     UserSurfaceIdentity[]
  subagentConfigs       UserSubagentConfig[]
  createdChainWorkflows AgentChainWorkflow[]       @relation("CreatedChainWorkflows")
  createdChainBindings  ChannelAgentChainBinding[] @relation("CreatedChainBindings")

  /// Digital Twin opt-in. Pipeline (backfill + daily curator + recall) is fully
  /// dormant when false — nothing about this user's Spaces data gets read.
  digitalTwinEnabled                   Boolean                    @default(false)
  digitalTwinEnabledAt                 DateTime?
  /// Optional string appended to the end of every Digital Twin reply
  /// (mention-driven flow). Capped at 500 chars. Empty / null = no suffix.
  /// Typical use: disclaimer ("— sent via Digital Twin"), contact line,
  /// or a "may contain mistakes" footer.
  digitalTwinResponseSuffix            String?
  /// Per-user memory approval mode. "manual" preserves the existing
  /// review queue; "auto" lets the curator retain high-confidence
  /// candidates immediately while falling back to pending on retain failure.
  digitalTwinMemoryApprovalMode        String                     @default("manual")
  /// Minimum curator confidence required when auto-approval is enabled.
  digitalTwinMemoryAutoApproveMinScore Float                      @default(0.9)
  /// When the twin should auto-reply to an @mention. "always" (default) replies
  /// to every mention when enabled — the original behaviour. "learned" consults
  /// the user's captured respond/ignore patterns and stays silent on a
  /// high-confidence "the user would ignore this" verdict (fail-open to reply).
  digitalTwinRespondPolicy             String                     @default("learned")
  /// Per-source backfill state. JSON shape:
  ///   { messages: { from, to, cursor, complete },
  ///     calls:    { from, to, cursor, complete },
  ///     canvases: { from, to, cursor, complete } }
  /// `cursor` walks newest → oldest; `complete=true` set when cursor crosses `from`.
  /// Restart-resumable: BullMQ jobs re-pick up from cursor on pod restart.
  digitalTwinBackfillState             Json?
  userMemoryCandidates                 UserMemoryCandidate[]
  digitalTwinPipelineEvents            DigitalTwinPipelineEvent[]
  agentMemoryFiles                     AgentMemoryFile[]
  twinBehaviorSignals                  TwinBehaviorSignal[]
  localHarnessDevices                  LocalHarnessDevice[]
  localHarnessRuns                     LocalHarnessRun[]

  /// Daily Brief opt-in (morning digest). When true, the leader-locked daily
  /// cron enqueues a brief-generation job for this user; when false the cron
  /// simply skips them (no per-user scheduler to tear down). Mirrors the
  /// digitalTwinEnabled opt-in pattern.
  dailyBriefEnabled   Boolean                @default(false)
  dailyBriefEnabledAt DateTime?
  dailyBriefActivity  DailyBriefActivity[]
  /// Per-user, per-agent custom instructions (injected into every agent run for
  /// this user) + feature-generated content (first consumer: Daily Brief).
  agentInstructions   UserAgentInstruction[]
  generatedContent    GeneratedContent[]

  /// Multi-tenancy (phase 1, org-only). Required: every user belongs to exactly
  /// one org (the "Juspay" default until multi-org ships). Enforced NOT NULL by
  /// migration `20260705170000_phase1_orgid_notnull` AFTER the backfill filled
  /// every row. Every user-creation path sets it at insert time (users-jit.ts,
  /// routes/users.ts). Does NOT change `User.id` (still the Spaces user id).
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  orgMemberships OrgMember[]

  @@unique([email, orgId])
  @@map("users")
}

/// Deterministic, file-based agent memory (Memory v2). Generic across agents —
/// scoped by (agentSlug, userId, name). Unlike the Hindsight-backed candidate
/// memories (semantic recall), these are named documents fetched deterministically
/// by key — e.g. the Digital Twin's `soul.md` (always-loaded persona), `people.md`,
/// `projects.md`. Up to 3 per (agent,user) may be flagged loadInPrompt, each
/// ≤ 20k chars, and are injected verbatim into the agent's system prompt so it
/// works well with zero tool calls. For the twin these are compiled by the soul
/// synthesizer from approved facts, editable by the user, and writable by the
/// agent mid-chat. userId NULL = shared across all users of that agent.
model AgentMemoryFile {
  id           String   @id @default(cuid())
  /// Which agent these files belong to (agent slug, e.g. "digital-twin").
  agentSlug    String
  /// Owner user for per-user agents (the twin). NULL = shared across all users
  /// of this agent (regular agent knowledge files).
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Stable name / key, unique per (agent, user). Ends in `.md` by convention.
  name         String
  /// Verbatim document content (≤ 20k chars, enforced in the app layer).
  content      String   @default("")
  /// User-toggleable: inject this file into the agent's system prompt. At most
  /// 3 per (agent, user) may be true (enforced in the app layer).
  loadInPrompt Boolean  @default(false)
  /// Display / injection order.
  sortOrder    Int      @default(0)
  /// Provenance of the last write: "seed" | "synthesizer" | "user" | "agent".
  /// The synthesizer skips files last edited by the user so it never clobbers
  /// hand edits.
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([agentSlug, userId, name])
  @@index([agentSlug, userId, loadInPrompt])
  @@map("agent_memory_files")
}

/// Durable behavioural signal for the Digital Twin: one row per inbound mention
/// the user did (responded) or did not (ignored) reply to. Written by the
/// Context Assembler at ingestion — INDEPENDENT of the curator LLM, so a failed
/// distill never loses the signal (Memory v2, gap-1 durability fix). Powers the
/// learned respond/ignore gate. Idempotent on (userId, sourceMessageId) so a
/// re-backfill upserts rather than duplicates.
model TwinBehaviorSignal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "mention" | "dm" | "reply" — how the user was pulled in.
  eventType       String   @default("mention")
  /// "responded" | "ignored".
  outcome         String
  channelId       String?
  channelName     String?
  /// "dm" | "group_dm" | "public" | "private".
  channelType     String?
  /// Who pulled them in (actor of the mention), if known.
  actorId         String?
  /// Response latency in ms when responded; how long unanswered when ignored.
  latencyMs       Int?
  /// The inbound message that triggered it (dedup key + gate context).
  sourceMessageId String?
  /// Short excerpt of the trigger message, for the gate + observability.
  triggerPreview  String?
  occurredAt      DateTime
  createdAt       DateTime @default(now())

  /// What the respond/ignore gate DECIDED at mention time ("respond" | "ignore"
  /// | null=gate didn't run). Set by the webhook when it silences the twin.
  gateDecision        String?
  gateConfidence      Float?
  gateReason          String?
  gateAt              DateTime?
  /// Feedback signal: the gate stayed silent (gateDecision="ignore") but the
  /// user DID respond themselves → a wrong silence. Reconciled by the daily
  /// pipeline (assembler) and fed back to future gate decisions.
  shouldHaveResponded Boolean   @default(false)

  @@unique([userId, sourceMessageId])
  @@index([userId, occurredAt])
  @@index([userId, outcome])
  @@index([userId, channelType, outcome])
  @@index([userId, shouldHaveResponded])
  @@map("twin_behavior_signals")
}

/// The user's accept / decline / edit / ignore of a Digital Twin PROPOSED
/// response (the approve/decline DM). Distinct from TwinBehaviorSignal (which is
/// about the respond/ignore GATE): this captures how good the twin's actual
/// DRAFT was. A "pending" row is written when the approval DM is sent; it is
/// updated on approve/decline, and reconciled to "ignored" by the daily job if
/// the user never acts. The daily learning loop consumes decided rows and marks
/// `learnedAt` so the twin's memory learns what got accepted vs edited vs
/// declined vs ignored — the feedback loop, moved OFF the immediate accept path.
model TwinResponseFeedback {
  id              String    @id @default(cuid())
  userId          String
  conversationId  String
  channelId       String?
  channelName     String?
  /// The inbound message that triggered the twin (dedup + link key).
  sourceMessageId String?
  /// The incoming message text the twin was responding to.
  incomingTask    String?
  /// The twin's proposed delivery. "react" | "reply" | "react_and_reply".
  deliveryAction  String    @default("reply")
  deliveryEmoji   String?
  /// "origin_thread" | "origin_channel" | "channel" | "thread".
  destinationKind String?
  /// The twin's proposed reply text (the draft shown for approval).
  draftMessage    String?
  /// What the user actually approved (may be edited); null on decline/ignore.
  finalMessage    String?
  /// "pending" | "accepted" | "accepted_edited" | "declined" | "ignored".
  status          String    @default("pending")
  proposedAt      DateTime  @default(now())
  decidedAt       DateTime?
  /// Set once the daily learning loop has consumed this row.
  learnedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@unique([userId, sourceMessageId])
  @@index([userId, status])
  @@index([userId, decidedAt])
  @@index([status, proposedAt])
  @@map("twin_response_feedback")
}

/// Top-level tenant. Phase 1 introduces exactly one org ("Juspay") that every
/// existing user is backfilled into; multi-org comes later. Additive only —
/// nothing about agent behavior or the Spaces integration depends on this yet.
enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum SurfaceIdentityMode {
  USER_ID
  ACCESS_TOKEN
}

enum SurfaceStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id                  String    @id @default(cuid())
  name                String    @unique
  description         String?
  createdBy           String
  status              OrgStatus @default(ACTIVE)
  metadata            Json?
  /// Which agent (by slug) executes this org's Daily Brief. NULL ⇒ fall back to
  /// the deployment default (CONFIG.dailyBriefAgentSlug / env, default "ask-ai").
  /// Changed at runtime via the daily-brief settings API (org-admin only).
  dailyBriefAgentSlug String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members             OrgMember[]
  users               User[]
  agents              Agent[]
  skills              Skill[]
  subagentDefinitions SubagentDefinition[]
  surfaceTenantLinks  SurfaceTenantLink[]

  @@map("organizations")
}

model Surface {
  id                     String                @id @default(cuid())
  key                    String                @unique
  identityMode           SurfaceIdentityMode
  supportsUserResolution Boolean               @default(false)
  capabilities           Json?
  status                 SurfaceStatus         @default(ACTIVE)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  connectedSurfaces      ConnectedSurface[]
  identities             UserSurfaceIdentity[]
  agents                 SurfaceAgent[]
  accessTokens           SurfaceAccessToken[]

  @@map("surfaces")
}

model ConnectedSurface {
  id              String        @id @default(cuid())
  orgId           String
  surfaceId       String
  surface         Surface       @relation(fields: [surfaceId], references: [id], onDelete: Restrict)
  surfaceTenantId String        @default("")
  accessToken     String?       @db.Text
  refreshToken    String?       @db.Text
  tokenExpiresAt  DateTime?
  config          Json?
  status          SurfaceStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([orgId, surfaceId, surfaceTenantId])
  @@index([orgId])
  @@map("connected_surfaces")
}

model UserSurfaceIdentity {
  id                 String        @id @default(cuid())
  surfaceId          String
  surface            Surface       @relation(fields: [surfaceId], references: [id], onDelete: Restrict)
  surfaceWorkspaceId String        @default("")
  surfaceUserId      String
  orgId              String
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status             SurfaceStatus @default(ACTIVE)
  lastSeenAt         DateTime?
  linkedAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([surfaceId, surfaceWorkspaceId, surfaceUserId])
  @@index([orgId])
  @@index([userId])
  @@map("user_surface_identities")
}

model SurfaceAgent {
  id                        String                @id @default(cuid())
  agentId                   String
  agent                     Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  surfaceId                 String
  surface                   Surface               @relation(fields: [surfaceId], references: [id], onDelete: Restrict)
  surfaceTenantId           String                @default("")
  surfaceChannelId          String?
  /// The surface-side application identity (Slack app id, Teams bot id).
  /// Events arrive tagged with this; unique per surface so the reverse
  /// lookup (app -> agent) is guaranteed single-owner.
  externalAppId             String?
  /// Non-secret OAuth client identifier of the surface app.
  clientId                  String?
  /// AES-GCM `ciphertext:iv:authTag` — never stored plaintext.
  encryptedClientSecret     String?               @db.Text
  signingSecret             String?               @db.Text
  /// Slash-command name bound to this agent (e.g. "/euler-doctor").
  commandName               String?
  /// ConnectedSurface row whose bot token answers this agent's slash
  /// commands (the umbrella app's team connection). Read at dispatch time.
  commandConnectedSurfaceId String?
  /// Registration lifecycle: "created" (app minted) | "installed".
  status                    String?
  /// sha256 of the manifest template last pushed to the surface app —
  /// compared against the current template to detect drift.
  manifestHash              String?
  manifestSyncedAt          DateTime?
  /// Surface-idiosyncratic residue ONLY (validated by the surface's schema);
  /// anything the core queries must be a real column above.
  config                    Json?
  installs                  SurfaceAgentInstall[]
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@unique([agentId, surfaceId, surfaceTenantId])
  @@unique([surfaceId, externalAppId])
  @@index([surfaceId])
  @@map("surface_agents")
}

/// One row per workspace/tenant a surface app is installed into: the
/// credential produced by that tenant's consent. (Slack: workspace bot
/// token; Teams: per-AAD-tenant install.)
model SurfaceAgentInstall {
  id                String       @id @default(cuid())
  surfaceAgentId    String
  surfaceAgent      SurfaceAgent @relation(fields: [surfaceAgentId], references: [id], onDelete: Cascade)
  surfaceTenantId   String
  /// AES-GCM `ciphertext:iv:authTag`.
  encryptedBotToken String       @db.Text
  tenantName        String?
  botUserId         String?
  installedByUserId String?
  installedAt       DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([surfaceAgentId, surfaceTenantId])
  @@map("surface_agent_installs")
}

model SurfaceAccessToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId      String
  surfaceId  String
  surface    Surface   @relation(fields: [surfaceId], references: [id], onDelete: Restrict)
  client     String?
  name       String?
  tokenHash  String    @unique
  prefix     String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, surfaceId])
  @@index([orgId])
  @@map("surface_access_tokens")
}

/// Maps an external surface's tenant (today: a Spaces workspace, i.e.
/// public.users.workspaceId) to a claw Organization. One org can have several
/// tenant links (a Spaces org has several workspaces), so this is a table, not
/// a column. Used by JIT (users-jit.ts) to place a newly-mirrored user in the
/// RIGHT claw org instead of the hardcoded default — the prerequisite for a
/// second tenant (e.g. NammaYatri) sharing one Spaces DB.
/// `surfaceType` generalizes it: Slack/Teams later = an INSERT with a new
/// surfaceType, not a schema migration. Narrow forerunner of plan.md's
/// ConnectedSurface (which adds per-surface credentials — needed only for
/// surfaces that don't share our DB).
model SurfaceTenantLink {
  id              String       @id @default(cuid())
  surfaceType     String       @default("spaces") /// "spaces" | "slack" | "teams" | ...
  surfaceTenantId String /// Spaces workspaceId, Slack team id (T123…), ...
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  createdAt       DateTime     @default(now())

  @@unique([surfaceType, surfaceTenantId])
  @@index([orgId])
  @@map("surface_tenant_links")
}

/// Membership of a User in an Organization. Keyed by `userId` (not email — the
/// email-keying in the abandoned workspace design was a workspace-era artifact).
model OrgMember {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole   @default(MEMBER)
  invitedBy String?
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("org_members")
}

/// Per-user candidate memories awaiting the user's own review. Grouped into
/// clusters by `subsystem` so the user can approve-all per cluster.
///
/// Privacy contract: only the owning user (req.session.userId === userId) can
/// read, edit, approve, or delete these rows. No admin elevation. No other
/// agent reads them — the recall gate on `memory-search` enforces this when
/// the agent is the Digital Twin (slug=`assistant`) and the user has opted in.
model UserMemoryCandidate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Cluster label. One of: "style" | "triage" | "expertise" | "projects" |
  /// "relationships" | "preferences" | "decisions" | "context" | "docs"
  subsystem String

  /// The memory text the curator emitted.
  text       String
  /// If the user edited before approving, the edited version goes here; the
  /// curator's original stays in `text` for audit.
  editedText String?

  /// Origin records the curator drew from. JSON shape:
  ///   [{ type: "message"|"call"|"canvas", id, channelId?, ts }]
  /// Used to show citations on the review card and to dedupe across windows.
  sourceRefs Json

  /// Curator's 0-1 confidence. Used to sort the cluster view top-down and to
  /// pick "highlights" if we ever shift away from cluster-batched approval.
  signalScore Float

  /// "pending" | "approved" | "rejected"
  status            String  @default("pending")
  /// Set on approve — the Hindsight memory ID this content was retained as.
  hindsightMemoryId String?

  /// Which run emitted this candidate. "backfill:<jobId>:<source>:<windowKey>"
  /// or "daily:<YYYY-MM-DD>:<source>" or "upload:<filename>".
  source String

  /// The DigitalTwinPipelineEvent this candidate was emitted by. Lets the
  /// memories list deep-link a retained memory back to the LLM reasoning that
  /// proposed it. Null for candidates created before this link existed.
  pipelineEventId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?
  rejectedAt DateTime?

  @@index([userId, status])
  @@index([userId, subsystem, status])
  @@index([hindsightMemoryId])
  @@map("user_memory_candidates")
}

/// One observability record per curator invocation (backfill window, daily
/// source, upload, or twin-approval). Persisted best-effort so the pipeline
/// viewer can show the LLM exchange, the records fed in, and per-run counts
/// without re-running anything. Pruned to a rolling 30-day window.
model DigitalTwinPipelineEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "backfill" | "daily" | "upload" | "twin-approval" — derived from `source`.
  runType    String
  /// The pipeline source string exactly as the run built it, e.g.
  /// "backfill:<jobId>:<source>:<YYYY-MM>" or "daily:<YYYY-MM-DD>:<source>".
  source     String
  /// "messages" | "calls" | "canvases" — derived from `source`; null when the
  /// source has no per-kind segment (upload / twin-approval).
  sourceKind String?

  /// The window the fed records belong to.
  windowFrom DateTime
  windowTo   DateTime

  /// "ok" (candidates created) | "empty" (nothing created, no error) | "error".
  status String

  /// Count of records fed to the curator for this event.
  recordCount Int   @default(0)
  /// Preview of the fed records. JSON shape:
  ///   [{ id, type, ts, channelId?, channelName?, title?, textPreview }]
  records     Json?

  /// This user's already-retained memories the curator saw for dedup.
  existingMemoryCount Int @default(0)
  /// Candidates the LLM emitted (pre server-side filter).
  emittedCount        Int @default(0)
  /// Emitted candidates that survived the server-side filter ("kept" verdicts).
  keptCount           Int @default(0)
  /// Rows actually inserted into user_memory_candidates.
  candidatesCreated   Int @default(0)
  /// Of those, how many were auto-approved (retained to Hindsight immediately).
  autoApproved        Int @default(0)

  /// Wall-clock duration of the batch, ms.
  durationMs Int     @default(0)
  /// Failure message when status="error".
  error      String?
  /// Full UserMemoryCuratorTrace, verbatim. Present when the distill returned one.
  trace      Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, runType, createdAt])
  @@map("digital_twin_pipeline_events")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      String
  grantedBy String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model UserAgentConfig {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentSlug   String
  provider    String   @default("spaces")
  chainConfig Json? /// Per-user agent chain config: { onComplete, onFailure }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Denormalized org scope for org-scoped per-user agent config uniqueness.
  orgId String

  @@unique([userId, orgId, agentSlug])
  @@index([orgId])
  @@map("user_agent_configs")
}

/// Per-user, per-agent free-text custom instructions. Injected into
/// `additionalInstructions` for EVERY agent run for this user (not just the daily
/// brief) so users can tune any agent's behaviour for themselves. Same key shape
/// as UserAgentConfig; kept as its own table so the hot chain-config row stays
/// narrow and instructions can exist without a chain config. agentSlug is a plain
/// string (no FK) matching every other per-user agent table.
model UserAgentInstruction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentSlug    String
  /// The user's custom instruction text. Length-capped in the app layer.
  instructions String   @default("") @db.Text
  /// When false the row is retained but NOT injected (soft toggle, not delete).
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Denormalized org scope for org-scoped per-user-per-agent uniqueness.
  orgId String

  @@unique([userId, orgId, agentSlug])
  @@index([orgId])
  @@index([userId])
  @@map("user_agent_instructions")
}

/// Generic store for feature-generated content. First consumer: Daily Brief.
/// Named generically so future generated artifacts (weekly digest, agent
/// summaries, …) reuse it via the `kind` discriminator (plain string per the
/// repo's enum→text convention). One row per (user, kind, dateBucket).
///   kind:   "DAILY_BRIEF" | (future) "WEEKLY_DIGEST" | …
///   status: "generating" | "ready" | "failed"
model GeneratedContent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Producing agent's slug (nullable for feature-level content). No FK.
  agentSlug   String?
  /// Content-type discriminator. See doc comment above.
  kind        String    @default("DAILY_BRIEF")
  /// Calendar bucket this content is FOR (e.g. "2026-07-29" on the user's tz).
  /// Enables one-per-day idempotency without timestamp math.
  dateBucket  String
  /// Rendered content (markdown) for direct display.
  content     String    @default("") @db.Text
  /// Structured payload (the emit_brief JSON) alongside the rendered content.
  data        Json?
  /// Lifecycle state (plain string per repo convention).
  status      String    @default("generating")
  /// Provenance: the claw session that produced this content.
  sessionId   String?
  /// When the content was actually produced (distinct from createdAt/the bucket).
  generatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orgId String

  @@unique([userId, kind, dateBucket])
  @@index([orgId])
  @@index([userId, kind, dateBucket])
  @@index([status, kind])
  @@map("generated_content")
}

/// One row per user per day per activity kind, so a distinct-user count over any
/// date range is an exact COUNT(DISTINCT) rather than a fixed-window sketch.
/// Upserted, so repeat activity on the same day bumps `count` instead of adding rows.
model DailyBriefActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId  String

  /// "view" | "regenerate" | "switch".
  kind       String
  /// Calendar bucket the activity happened on (IST), matching GeneratedContent.
  dateBucket String
  /// How many times this user did this on this day.
  count      Int      @default(1)
  /// Regenerations that signal dissatisfaction — excludes retry_after_failure.
  /// A counter rather than an origin string: the row is unique per user/kind/day,
  /// so a single value would be last-write-wins across mixed origins.
  rejectionCount Int  @default(0)
  /// First occurrence on this day.
  occurredAt DateTime @default(now())
  /// Most recent occurrence on this day.
  lastSeenAt DateTime @default(now())

  @@unique([userId, kind, dateBucket])
  @@index([orgId])
  @@index([kind, dateBucket])
  @@map("daily_brief_activity")
}

model AgentChainWorkflow {
  id               String                     @id @default(cuid())
  name             String
  definition       Json
  isPublished      Boolean                    @default(true)
  /// When true, this workflow has been promoted to "global" by an admin: its
  /// bindings are opened to all users (userId="*"). Set on approval of a
  /// WorkflowGlobalRequest.
  global           Boolean                    @default(false)
  /// JSON array of trigger entries. Each entry:
  /// { id: string, type: string, channels: [{ channelId, spacesAutomationId }] }
  triggers         Json                       @default("[]")
  /// When non-null, the workflow owner has CONSENTED to run triggered
  /// executions with this user's credentials (their connected MCP/tool
  /// creds) instead of the agent's app identity. The value is the consenting
  /// user's id — always the workflow creator, since consent is self-asserted
  /// by the credential owner. Null = no consent; runs use whatever identity
  /// the trigger supplies. Read at /:id/trigger to resolve the effective
  /// userId for credential resolution.
  credentialUserId String?
  /// When non-null, this is the auto-managed SINGLE-NODE backing workflow for an
  /// agent's page-level triggers (entry node = this agent). It is hidden from
  /// the Workflows list and edited only via the agent page's Triggers section.
  /// One per agent (unique). Null = a normal user-authored chain workflow.
  agentTriggerSlug String?                    @unique
  createdByUserId  String
  createdByUser    User                       @relation("CreatedChainWorkflows", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  bindings         ChannelAgentChainBinding[]
  globalRequests   WorkflowGlobalRequest[]

  // A workflow name is scoped to its creator: a single user can't own two
  // workflows with the same name, so a name unambiguously identifies one of
  // their workflows. (Different users may reuse a name — they never see each
  // other's workflows; lookups are by id.) The composite index also serves the
  // per-user list query, so a standalone @@index([createdByUserId]) is redundant.
  @@unique([createdByUserId, name])
  @@map("agent_chain_workflows")
}

/// "Push to global" approval queue. A workflow owner requests that their
/// workflow be made available to ALL users; an admin reviews in the dashboard
/// and approves (sets workflow.global=true and rewires its bindings to
/// userId="*") or rejects. Mirrors the McpConnectorEditRequest flow.
model WorkflowGlobalRequest {
  id                String             @id @default(cuid())
  workflowId        String
  workflow          AgentChainWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  /// User who requested promotion. Plain id (no FK), mirroring edit-requests.
  requestedByUserId String
  /// "pending" | "approved" | "rejected" | "cancelled"
  status            String             @default("pending")
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([workflowId, status])
  @@map("workflow_global_requests")
}

model ChannelAgentChainBinding {
  id              String             @id @default(cuid())
  channelId       String
  entryAgentSlug  String
  // User this binding applies to (the triggering user's id == Spaces user id ==
  // claw-auth User.id). A binding fires only when THIS user triggers the entry
  // agent in the channel. The reserved sentinel "*" means channel-wide (any
  // user) and must be set explicitly; it is never a real cuid so it can't
  // collide. Legacy rows were backfilled to createdByUserId (scoped to their
  // creator), NOT "*", on purpose — that is the leak this column fixes.
  userId          String
  workflowId      String
  workflow        AgentChainWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  enabled         Boolean            @default(true)
  createdByUserId String
  createdByUser   User               @relation("CreatedChainBindings", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([channelId, entryAgentSlug, userId])
  @@index([workflowId])
  @@index([channelId])
  @@index([userId])
  @@map("channel_agent_chain_bindings")
}

model UserProviderCredentials {
  userId             String
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String /// "spaces" | "copilot" | "claude"
  encryptedKey       String?                   @db.Text
  iv                 String?
  authTag            String?
  model              String?
  baseUrl            String?
  authType           String? /// "api_key" (default) | "oauth_token" — how to send the credential at runtime
  reasoningEffort    String? /// "low" | "medium" | "high" — only meaningful for reasoning-capable models (codex gpt-5.x, etc.). Null = service default ("medium").
  /// When set, this row is a BINDING to a SharedProviderCredential (same
  /// semantics as AgentProviderCredentials.sharedCredentialId): key material
  /// comes from the shared row; model/reasoningEffort here are overrides.
  /// Critical when a personal credential is promoted to shared — the personal
  /// row must become a binding, NOT keep a sibling copy, or the two rows'
  /// refreshes would invalidate each other's OAuth session.
  sharedCredentialId String?
  sharedCredential   SharedProviderCredential? @relation(fields: [sharedCredentialId], references: [id], onDelete: SetNull)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@id([userId, provider])
  @@index([sharedCredentialId])
  @@map("user_provider_credentials")
}

model LocalHarnessDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId      String
  deviceName String
  platform   String
  tokenHash  String   @unique
  installations Json  @default("[]")
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  runs       LocalHarnessRun[]

  @@index([userId, revokedAt])
  @@map("local_harness_devices")
}

model LocalHarnessRun {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId         String
  agentSlug     String
  provider      String
  model         String?
  deviceId      String?
  device        LocalHarnessDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  status        String   @default("queued")
  envelope      Json
  progressUrl   String   @db.Text
  callbackUrl   String   @db.Text
  error         String?  @db.Text
  claimedAt     DateTime?
  finishedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
  @@map("local_harness_runs")
}

model UserSubagentConfig {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subagentName String
  provider     String /// references UserProviderCredentials.provider
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([userId, subagentName])
  @@map("user_subagent_configs")
}

/// Agent-scoped fallback for users who haven't configured a personal provider.
/// Resolution precedence at dispatch:
///   1. user's personal provider (UserProviderCredentials)
///   2. this table (shared key for the agent — e.g. team's Codex sub on Doctor)
///   3. "spaces" / LiteLLM platform default
/// Writes gated by AGENT_OWNER or admin. Decrypted key never returned to any
/// API surface — only ever decrypted in-process at dispatch time.
model AgentProviderCredentials {
  agentId            String
  agent              Agent                     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider           String /// "copilot" | "claude" | "codex" | "openrouter" | ...
  encryptedKey       String?                   @db.Text
  iv                 String?
  authTag            String?
  model              String?
  baseUrl            String?
  authType           String? /// "api_key" (default) | "oauth_token"
  reasoningEffort    String? /// "low" | "medium" | "high" — only meaningful for reasoning-capable models. Null = service default ("medium").
  createdByUserId    String?
  /// When set, this row is a BINDING: key material comes from the referenced
  /// SharedProviderCredential (this row's encryptedKey/iv/authTag stay null),
  /// while model/reasoningEffort/baseUrl here act as per-agent OVERRIDES.
  /// Solves the OAuth cross-invalidation problem: N agents on one ChatGPT
  /// account each holding a token COPY invalidate each other on every
  /// re-auth/refresh; a binding means ONE stored session shared by all.
  sharedCredentialId String?
  sharedCredential   SharedProviderCredential? @relation(fields: [sharedCredentialId], references: [id], onDelete: SetNull)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@id([agentId, provider])
  @@index([createdByUserId])
  @@index([sharedCredentialId])
  @@map("agent_provider_credentials")
}

/// Org-level named provider credential (e.g. "Team Codex") stored ONCE and
/// bound to selected agents via AgentProviderCredentials.sharedCredentialId.
/// OAuth refresh writes the rotated bundle back HERE (single-flight keyed by
/// this row's id), so exactly one live provider session exists per credential
/// no matter how many agents use it. Admin-managed; the decrypted key is never
/// returned by any API — only decrypted in-process at dispatch time.
model SharedProviderCredential {
  id              String                     @id @default(cuid())
  /// NULL = platform-wide credential (CLAW_ADMIN-only to create): bindable by
  /// agents of ANY org — e.g. one Codex ChatGPT account serving both Juspay
  /// and NY agents. Non-null = scoped to that org (owners can create/bind).
  orgId           String?
  provider        String /// "codex" | "claude" | "copilot" | "openrouter" | ...
  name            String /// display name shown in pickers, e.g. "Team Codex (NY)"
  encryptedKey    String?                    @db.Text
  iv              String?
  authTag         String?
  model           String? /// default model for bindings without an override
  baseUrl         String?
  authType        String? /// "api_key" (default) | "oauth_token"
  reasoningEffort String?
  ownerUserId     String? /// who connected it; re-auth gated to owner/admin
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  agentBindings   AgentProviderCredentials[]
  userBindings    UserProviderCredentials[]

  @@unique([orgId, provider, name])
  @@index([orgId])
  @@map("shared_provider_credentials")
}

model Agent {
  id                    String                     @id @default(cuid())
  slug                  String
  name                  String
  description           String                     @default("")
  systemPrompt          String                     @db.Text
  scope                 String                     @default("global")
  delegationTier        String                     @default("standard")
  ownerUserId           String?
  owner                 User?                      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  orgId                 String
  org                   Organization               @relation(fields: [orgId], references: [id], onDelete: Restrict)
  enabled               Boolean                    @default(true)
  isDefault             Boolean                    @default(false)
  color                 String                     @default("#6366f1")
  modelId               String                     @default("")
  config                Json                       @default("{}")
  spacesAppId           String?                    @unique
  spacesAppUserId       String?
  spacesAppToken        String?                    @db.Text
  /// HMAC-SHA256 secret claw-auth uses to verify Spaces' `X-Xyne-Signature`
  /// header on inbound webhook calls. Encrypted at rest with the AES-256-GCM
  /// 3-tuple format (ciphertext:iv:authTag, base64). Same plaintext as
  /// Spaces' `installed_apps.signingSecret` but stored under claw-auth's
  /// encryption format. See lib/spaces-app-secret.ts.
  signingSecret         String?                    @db.Text
  /// Prompt versioning. `systemPrompt` above stays the denormalized copy of the
  /// ACTIVE version so every runtime read path is unchanged. These point at the
  /// active row in `agent_prompt_versions`: `activePromptVersionId` is the row
  /// id (rollback target); `activePromptVersion` is its monotonic number
  /// (denormalized for cheap run-stamping + display).
  activePromptVersionId String?
  activePromptVersion   Int?
  kbScope               String                     @default("COLLECTIONS")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  promotedBy            String?
  promotedAt            DateTime?
  tools                 AgentTool[]
  skills                AgentSkill[]
  collections           AgentCollection[]
  shares                AgentShare[]
  mcpConnections        AgentMcpConnection[]
  providerCredentials   AgentProviderCredentials[]
  promptVersions        AgentPromptVersion[]
  surfaceAgents         SurfaceAgent[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("agents")
}

/// RBAC allow-list for Agent-to-Agent (A2A) delegation. Each enabled row grants
/// the `callerAgentId` agent permission to delegate a self-contained task to the
/// `calleeAgentId` agent at runtime. Resolution is FAIL-CLOSED: with no enabled
/// grant, xyne-claw is never handed a callable-agent tool for that pair, so the
/// LLM cannot delegate. Stored as plain ids (no FK relations) to keep the Agent
/// model untouched; uniqueness is enforced on the (caller, callee) pair.
/// See xyne-claw/src/agent-delegation.ts for the runtime governor this feeds.
model AgentDelegationGrant {
  id               String    @id @default(cuid())
  callerAgentId    String
  calleeAgentId    String
  /// 'user' (default) = the callee runs under the SAME human end-user identity
  /// as the top-level run (a callee can never exceed what the human may already
  /// do — contains the confused-deputy risk). 'callee_app' = run under the
  /// callee agent's own app identity (opt-in, riskier; audited).
  identityMode     String    @default("user")
  enabled          Boolean   @default(true)
  /// "pending" | "approved" | "rejected"
  status           String    @default("pending")
  approvedByUserId String?
  approvedAt       DateTime?
  createdByUserId  String?
  requestReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([callerAgentId, calleeAgentId])
  @@index([callerAgentId])
  @@index([calleeAgentId, status])
  @@map("agent_delegation_grants")
}

/// Append-only history of an agent's system prompt. A new row is created on
/// every prompt edit (never overwritten); the agent's denormalized
/// `systemPrompt` + `activePromptVersion(Id)` always mirror exactly one of
/// these rows. Enables history, diff, rollback, and per-run attribution.
model AgentPromptVersion {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Monotonic per agent: 1, 2, 3, … (see @@unique below).
  version         Int
  systemPrompt    String   @db.Text
  /// Optional changelog note for this version.
  note            String?  @db.Text
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([agentId, version])
  @@index([agentId, createdAt])
  @@map("agent_prompt_versions")
}

model AgentShare {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  role      String   @default("VIEWER")
  sharedBy  String?
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
  @@map("agent_shares")
}

model AgentRun {
  id               String    @id @default(cuid())
  sessionId        String    @unique
  userId           String
  agentSlug        String
  provider         String? /// LLM provider used for the run: spaces|codex|claude|copilot|openrouter
  model            String? /// Concrete model id, e.g. private-large, open-large, gpt-5.5
  triggerSource    String /// "spaces" | "scheduled" | "chat" | "api" | "automation" | "slack"
  status           String    @default("running") /// "running" | "completed" | "failed" | "cancelled"
  currentToolLabel String?
  task             String    @db.Text
  conversationId   String?
  scheduledJobId   String?
  channelId        String?
  projectId        String?
  projectName      String?
  result           String?   @db.Text
  error            String?   @db.Text
  reasoning        String?   @db.Text
  toolsUsed        String[]  @default([])
  toolInvocations  Json? /// Array<ToolInvocation> with args, result (truncated), durationMs, isError
  metadata         Json? /// Additive per-run integration metadata (for example external result callback configuration)
  tokensIn         Int?
  tokensOut        Int?
  tokensCacheRead  Int?
  tokensCacheWrite Int?
  /// Wall-clock breakdown from xyne-claw. See `LatencyMetrics` in
  /// xyne-claw/src/agent.ts. Populated on /webhook/result.
  totalMs          Int?
  llmTotalMs       Int?
  llmDecodeMs      Int?
  llmWaitMs        Int?
  llmTurns         Int?
  llmRetries       Int?
  ttftMs           Int?
  tokensPerSec     Int?
  toolMs           Int?
  lastRetryReason  String?   @db.Text
  rating           String? /// "up" | "down"
  ratingComment    String?   @db.Text
  ratedAt          DateTime?
  /// The agent's active prompt version number at run-start. Lets quality /
  /// latency be correlated to a specific prompt version. Null for runs created
  /// before prompt versioning, or if the agent has no versioned prompt.
  promptVersion    Int?
  /// True when the run used a user-scoped credential (the user's OAuth/session
  /// token — e.g. a per-user OAuth connector fetch). Such runs touch the user's
  /// private data, so the admin "All Runs" view hides OTHER users' runs where
  /// this is true. Default false (app/shared identity → safe to surface).
  usedUserToken    Boolean   @default(false)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  /// Links a completed run to the specific assistant ChatMessage it produced.
  /// Needed for branching: one user message may have multiple assistant
  /// siblings (regenerate / edit-user branches), so chronological pairing of
  /// runs ↔ assistant messages is ambiguous. Populated in the chat-callback.
  chatMessageId    String?
  orgId            String

  @@index([userId, status, startedAt])
  @@index([agentSlug, startedAt])
  @@index([provider, completedAt])
  @@index([chatMessageId])
  @@index([orgId])
  /// Every workspace-metrics window query filters on a bare completedAt range
  /// (no leading equality), which none of the composite indexes can serve —
  /// without this, each dashboard load seq-scans agent_runs 8x. Apply in prod
  /// manually: CREATE INDEX CONCURRENTLY IF NOT EXISTS
  ///   "agent_runs_completedAt_triggerSource_idx"
  ///   ON "agent_runs" ("completedAt", "triggerSource");
  @@index([completedAt, triggerSource])
  @@map("agent_runs")
}

/// Durable mapping from an agent-authored widget/card to WHERE it lives in a
/// Spaces thread + the agent identity that posted it. Generic across widget
/// `kind` ('pr' now; 'plan' etc. later) so ONE table serves every card type.
///
/// The load-bearing use: an inbound git-host webhook (e.g. Bitbucket pr:merged /
/// pr:declined) fires long AFTER the run's SessionContext (Redis, 24h TTL,
/// deleted on run completion) is gone. It looks the binding up by `externalKey`
/// (for 'pr': the normalized PR URL) to recover the thread + agent, re-derives
/// the agent's app token via `spacesAppId`, and posts a FRESH status card.
///
/// Written at card-creation time in doRenderPrCard's first-post branch;
/// COMPLEMENTS (does not replace) the live SessionContext.prMessageIds fast path.
model AgentWidgetBinding {
  id              String   @id @default(cuid())
  orgId           String
  kind            String /// 'pr' | 'plan' | future widget kinds
  screenId        String /// deterministic per-widget id (prScreenId / plan screenId)
  /// External correlate an inbound event is matched on. For 'pr' this is the
  /// normalized PR URL (lowercase, no protocol, no trailing slash). Null for
  /// widgets with no external event source (e.g. 'plan').
  externalKey     String?
  conversationId  String /// the Spaces thread the card was posted into
  channelId       String
  messageId       String? /// the posted flow-card message (informational / future update-in-place)
  spacesAppId     String /// agent lookup key → findBySpacesAppId → decrypt spacesAppToken
  spacesAppUserId String /// bot user the card is posted as (postMessage userId)
  agentSlug       String?
  status          String? /// last rendered status/state — dedup for provider re-delivery
  data            Json? /// kind-specific card-rebuild fields (pr: {provider,title,ticketId,url,desc,repo,number})
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([kind, screenId])
  @@index([kind, externalKey])
  @@index([orgId])
  @@map("agent_widget_bindings")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  agentSlug      String
  userId         String
  role           String // "user" | "assistant"
  content        String   @db.Text
  reasoning      String?  @db.Text
  status         String   @default("completed")
  createdAt      DateTime @default(now())
  /// Tree parent reference for branching conversations. A conversation is a
  /// tree: a user message can have multiple assistant children (regenerate),
  /// and an assistant message can have multiple user children (edit-user).
  /// The UI projects one selected path; siblings are reachable via the pager.
  parentId       String?

  /// The context the user attached to THIS turn (channels, tickets, canvases,
  /// calls, collections, files) as a normalized AttachedContextRef[] — the same
  /// list that drove the run. Persisted so the pills can be shown read-only
  /// above the message when a chat is reloaded. Null on assistant rows and on
  /// legacy rows written before this column existed.
  attachedContext Json?

  attachments ChatAttachment[]
  orgId       String

  @@index([conversationId, createdAt])
  @@index([userId, agentSlug])
  @@index([orgId])
  @@map("chat_messages")
}

model ChatAttachment {
  id               String   @id @default(cuid())
  chatMessageId    String?
  uploaderUserId   String
  storageProvider  String   @default("gcs")
  url              String // GCS object path (bucket-relative)
  thumbnailUrl     String?
  originalFilename String
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  metadata         Json?
  createdAt        DateTime @default(now())

  chatMessage  ChatMessage?          @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  designShares DesignArtifactShare[]

  @@index([chatMessageId])
  @@index([uploaderUserId, createdAt])
  @@map("chat_attachments")
}

/// A chat artifact the user chose to keep: a generated React project promoted out
/// of a throwaway `ChatAttachment` into something with its own id, title and URL.
/// Lives here rather than in the Spaces DB because the attachment it derives from
/// and the GCS bucket holding its bytes are both owned by this service, and
/// claw-auth's Spaces connection is read-only by Postgres grant.
model ArtifactApp {
  id                 String    @id @default(cuid())
  /// Spaces workspace, resolved from the owner at save time. Scopes who may see
  /// this once published — claw-auth's own tenant key (orgId) is a different
  /// identifier space and is not interchangeable with it.
  workspaceId        String
  ownerUserId        String
  title              String
  description        String?
  /// "PRIVATE" | "WORKSPACE". Follows the Spaces `Canvas.visibility` convention
  /// of a plain string column rather than a Postgres enum.
  visibility         String    @default("PRIVATE")
  /// The single version served to everyone else. Null means unpublished; the
  /// pin is what stops a published app changing under its viewers when the
  /// author saves a new build.
  publishedVersionId String?
  publishedAt        DateTime?
  isArchived         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  versions  ArtifactAppVersion[]
  agentRuns ArtifactAppAgentRun[]

  @@index([workspaceId, visibility])
  @@index([ownerUserId])
  @@map("artifact_apps")
}

/// One saved build of an ArtifactApp. Only the small manifest lives in the row;
/// the project files ride GCS at `storagePath`, mirroring how the chat attachment
/// splits manifest from bytes.
model ArtifactAppVersion {
  id            String   @id @default(cuid())
  /// Denormalized tenant key, stamped from the parent app on insert. Scope is
  /// already implied by appId, but every table carries its own key here (see
  /// CanvasVersion in the Spaces schema) so a query that forgets to join the
  /// parent still cannot cross tenants.
  workspaceId   String
  appId         String
  versionNumber Int
  /// Small descriptor — title, entry, file paths, dependency names. Enough to
  /// render a gallery card without fetching the project.
  manifest      Json
  /// GCS object path (bucket-relative), copied at save so deleting the
  /// originating conversation cannot break a published app.
  storagePath   String
  contentHash   String
  sizeBytes     Int
  createdBy     String
  createdAt     DateTime @default(now())

  app ArtifactApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  /// Re-saving a byte-identical build reuses the existing version instead of
  /// piling up duplicates — the agent regenerates the same app readily.
  @@unique([appId, contentHash])
  @@unique([appId, versionNumber])
  @@index([appId, createdAt])
  @@index([workspaceId])
  @@map("artifact_app_versions")
}

/// One agent run triggered from inside an artifact app.
///
/// This is an INDEX, not a second source of truth. The answer, tool calls and
/// token counts live on `AgentRun` (keyed by the same `sessionId`) and on the
/// assistant `ChatMessage`, which are already the durable writers on the
/// callback path. What this table adds is the app-shaped lookup those tables
/// cannot serve: "which run belongs to this app, for this viewer, under this
/// key" — the query a reopened app makes to resync work it started earlier.
model ArtifactAppAgentRun {
  id             String   @id @default(cuid())
  /// Denormalized tenant key, stamped at dispatch. Every table carries its own
  /// (see ArtifactAppVersion) so a query that forgets to join cannot cross
  /// tenants.
  workspaceId    String
  /// claw-auth's own tenant key. Not interchangeable with workspaceId — it is
  /// what scopes the agent lookup.
  orgId          String
  /// Null while the app is still an unsaved chat artifact; `attachmentId` then
  /// identifies it. Set once the app has been saved.
  appId          String?
  attachmentId   String?
  /// The viewer who triggered the run. Runs are never shared between viewers of
  /// a published app.
  userId         String
  /// App-chosen thread name, "default" when the app does not pass one. The
  /// (appId, userId, runKey) triple is what makes a run findable on reopen.
  runKey         String   @default("default")
  /// Stable per (app, viewer, runKey), so repeat runs continue one thread and
  /// /live + /messages both attach to it.
  conversationId String
  agentSlug      String
  /// claw's run id. Null only in the window between row creation and a
  /// successful dispatch.
  sessionId      String?  @unique
  prompt         String   @db.Text
  /// "pending" | "running" | "completed" | "failed" | "cancelled". Mirrors
  /// AgentRun.status; kept here so the in-flight check for a key is one indexed
  /// read rather than a join.
  status         String   @default("pending")
  /// Set only for dispatch-time failures. Run-time errors live on AgentRun.
  error          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  app ArtifactApp? @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, userId, runKey])
  @@index([userId, status])
  @@index([conversationId])
  @@index([workspaceId])
  @@map("artifact_app_agent_runs")
}

/// A stable, revocable public link to the latest published HTML attachment in
/// one Design Studio conversation. Only the bearer token hash is used for
/// verification; its encrypted copy exists so
/// the owner can reopen the Share dialog without rotating a live link.
model DesignArtifactShare {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  tokenCiphertext String
  tokenIv         String
  tokenAuthTag    String
  ownerUserId     String
  orgId           String
  conversationId  String
  attachmentId    String
  title           String
  expiresAt       DateTime?
  revokedAt       DateTime?
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attachment ChatAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, conversationId])
  @@index([orgId, updatedAt])
  @@index([attachmentId])
  @@map("design_artifact_shares")
}

model AgentRequest {
  id                  String   @id @default(cuid())
  targetType          String   @default("agent") // "agent" | "skill"
  agentId             String?
  agentSlug           String?
  skillId             String?
  skillSlug           String?
  requestType         String // "push_to_spaces" | "push_to_global" | "clone"
  requesterId         String
  status              String   @default("pending") // "pending" | "approved" | "rejected"
  reviewerId          String?
  reviewNote          String?
  // For requestType == "clone": the name the requester chose for their copy,
  // captured at request time and applied when the owner approves. Null → the
  // clone falls back to "<source> (Copy)".
  requestedName       String?
  // For requestType == "clone": the agent that was created when the request
  // was approved. Lets the approve path stay idempotent (replay returns the
  // same clone) and gives the frontend a deep-link target.
  resultAgentId       String?
  // ── requestType == "skill_update" (skill revision proposal) ──────────────
  // The proposer's full replacement markdown, held server-side so the (signed)
  // approval card only ever carries the requestId — the body can't be tampered
  // with client-side and the resolve step re-reads it authoritatively.
  proposedContent     String?  @db.Text
  // sha256 of the skill content the proposer diffed against, checked at approve
  // time so a concurrent edit (optimistic-concurrency drift) is rejected (409).
  baseContentHash     String?
  // sha256 of proposedContent — integrity check before persisting on approve.
  proposedContentHash String?
  // Free-text summary the proposer supplied ("what changed and why").
  requestNote         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  orgId               String

  @@index([status])
  @@index([requesterId])
  @@index([agentId])
  @@index([orgId])
  @@map("agent_requests")
}

enum AgentAuditEvent {
  AGENT_PROMOTED
  AGENT_DEMOTED
  AGENT_SHARED
  AGENT_UNSHARED
  ROLE_GRANTED
  ROLE_REVOKED
  AGENT_CREATED
  AGENT_DELETED
  REQUEST_CREATED
  REQUEST_APPROVED
  REQUEST_REJECTED
  MCP_GLOBAL_FALLBACK_ENABLED
  MCP_GLOBAL_FALLBACK_DISABLED
  MCP_GLOBAL_CREDENTIALS_SET
  MCP_GLOBAL_CREDENTIALS_REMOVED
  // Connector-definition writes — added after a launchConfigTemplate.env
  // got silently wiped to {} on a connector form save with no audit trail
  // (ppi-grafana-v2 incident, 2026-05-22). Capture actor + before/after so
  // the next mis-save is debuggable in one query.
  MCP_CONNECTOR_CREATED
  MCP_CONNECTOR_UPDATED
  MCP_CONNECTOR_DELETED
  // Global-connector edit-approval queue (post-incident hardening — direct
  // edits to scope=global rows are forbidden; all changes flow through here).
  MCP_CONNECTOR_EDIT_REQUESTED
  MCP_CONNECTOR_EDIT_APPROVED
  MCP_CONNECTOR_EDIT_REJECTED
  MCP_CONNECTOR_EDIT_SUPERSEDED
  MCP_CONNECTOR_EDIT_CANCELLED
  // Agent config/toolbox edits (incl. non-HTTP "ghost" writers). Added by
  // migration 20260617150000_agent_config_audit_event (ALTER TYPE ADD VALUE);
  // this keeps the Prisma-generated type in sync so a fresh `prisma generate`
  // (e.g. the Docker build) accepts `eventType: "AGENT_CONFIG_UPDATED"`.
  AGENT_CONFIG_UPDATED
  // General agent edits (name/description/prompt/model/enabled/slug/color).
  // Tools-only edits stay on AGENT_CONFIG_UPDATED. Added by migration
  // 20260709120000_agent_updated_event (ALTER TYPE ADD VALUE) — this keeps the
  // Prisma-generated type in sync so `eventType: "AGENT_UPDATED"` typechecks.
  AGENT_UPDATED
  // Shared provider credentials (org-level, bound to selected agents). Added
  // by migration 20260715003000_shared_provider_credentials (ALTER TYPE ADD
  // VALUE).
  PROVIDER_CREDENTIAL_PROMOTED
  PROVIDER_CREDENTIAL_BOUND
  PROVIDER_CREDENTIAL_UNBOUND
  PROVIDER_CREDENTIAL_ADOPTED
  PROVIDER_CREDENTIAL_DELETED
  // Agent-authoring tools (create/update-subagent, create-mcp). Added by
  // migration 20260818090000_agent_authoring_audit_events (ALTER TYPE ADD
  // VALUE) — kept here so a fresh `prisma generate` accepts them.
  SUBAGENT_CREATED
  SUBAGENT_UPDATED
  MCP_SERVER_CREATED
}

model AgentAuditLog {
  id          String          @id @default(cuid())
  actorUserId String?
  eventType   AgentAuditEvent
  targetId    String
  description String
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@map("agent_audit_logs")
}

model Skill {
  id          String          @id @default(cuid())
  slug        String
  name        String
  label       String          @default("")
  description String          @default("")
  content     String          @db.Text
  source      String          @default("seeded")
  scope       String          @default("global")
  ownerUserId String?
  owner       User?           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  enabled     Boolean         @default(true)
  promotedBy  String?
  promotedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orgId       String
  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  agents      AgentSkill[]
  subagents   SubagentSkill[]
  files       SkillFile[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("skills")
}

// Sibling files that ship alongside a skill's main SKILL.md (which lives in
// Skill.content). Materialized into the session workspace under
// `data/session-skills/<scope>/<slug>/<relativePath>` so pi's resource
// loader sees the whole directory.
// relativePath is always a normalized POSIX path inside the skill dir —
// no leading slash, no "..", no absolute paths. Enforced at write time.
model SkillFile {
  id           String   @id @default(cuid())
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  relativePath String
  content      String   @db.Text
  contentType  String?
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@unique([skillId, relativePath])
  @@map("skill_files")
}

model AgentSkill {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@map("agent_skills")
}

/// Per-agent Knowledge Base grant. References a Collection (and optionally a
/// specific file) in the spaces backend. There is NO foreign key — Collections
/// live in a different database (the spaces postgres), so `collectionId` /
/// `fileId` are opaque ids validated at write time against the requesting
/// user's accessible KB tree.
///
/// fileId IS NULL → grant covers the whole collection (and all descendants).
/// fileId IS NOT NULL → grant covers ONLY that single file. The unique index
/// includes fileId so an agent can have both kinds of grants on the same
/// collection (e.g. whole-collection + a file from a sibling collection).
model AgentCollection {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  collectionId String
  fileId       String?
  createdAt    DateTime @default(now())

  @@unique([agentId, collectionId, fileId])
  @@index([agentId])
  @@map("agent_collections")
}

model Tool {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String      @default("")
  source      String
  inputSchema Json        @default("{}")
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  agents      AgentTool[]

  @@map("tools")
}

model AgentTool {
  id         String @id @default(cuid())
  agentId    String
  agent      Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  toolId     String
  tool       Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  permission String @default("allow")

  @@unique([agentId, toolId])
  @@map("agent_tools")
}

model Gateway {
  id         String            @id @default(cuid())
  type       String            @unique
  name       String
  config     Json              @default("{}")
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  identities GatewayIdentity[]

  @@map("gateways")
}

model GatewayIdentity {
  id             String   @id @default(cuid())
  gatewayId      String
  gateway        Gateway  @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  externalUserId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([gatewayId, externalUserId])
  @@map("gateway_identities")
}

model McpServer {
  id                   String                    @id @default(cuid())
  name                 String
  type                 String
  url                  String
  description          String?
  enabled              Boolean                   @default(true)
  transport            String                    @default("stdio")
  credentialSchema     Json?
  credentialForm       Json?
  launchConfigTemplate Json?
  httpConfigTemplate   Json?
  healthcheckSpec      Json?
  writeToolPolicy      Json?
  connectorMeta        Json?
  /// Explicitly marks if this connector requires an OAuth browser flow.
  isOauth              Boolean                   @default(false)
  /// Whether this server type can fall back to admin-managed global
  /// credentials when a user has no personal connection. Off by default —
  /// admins must opt-in per server (e.g. enable it for shared infra creds
  /// like a corporate Bitbucket bot, but never for per-user OAuth like
  /// google/microsoft/xyne-spaces).
  allowGlobalFallback  Boolean                   @default(false)
  /// When true, binary content this server's tools return (EmbeddedResource
  /// blob / image / audio) is forwarded to the user as a file attachment
  /// instead of being dropped. Server-level because the runner only ever
  /// extracts binary blocks — a text/data tool on the same server returns text
  /// and is unaffected. Admin-toggleable; surfaced via the resolved connector
  /// definition so the runner reads it without a per-tool catalog query.
  forwardFiles         Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  connections          UserMcpConnection[]
  agentConnections     AgentMcpConnection[]
  globalCredentials    GlobalMcpCredentials[]
  editRequests         McpConnectorEditRequest[]

  @@unique([type])
  @@index([enabled])
  @@index([transport])
  @@map("mcp_servers")
}

/// Pending edit to a `scope=global` McpServer row. Direct edits to global
/// connectors are forbidden — instead an edit-request is created and a
/// CLAW_ADMIN reviews/approves before the change touches the live row.
///
/// Why: the ppi-grafana-v2 incident on 2026-05-22 (env wiped to `{}` via
/// a single non-audited save) broke every Twin call for hours. With this
/// queue, the proposed change sits visible in the admin panel; no live
/// connector ships with an un-reviewed mutation.
///
/// Lifecycle:
///   pending  → admin approve  → fields copied onto McpServer, row marked approved
///   pending  → admin reject   → discarded with note
///   pending  → owner cancel   → discarded by proposer
/// At most one `pending` request per (mcpServerId) — a new submission while
/// one is open replaces the previous (the prior row's status flips to
/// `superseded` so the audit trail is preserved).
model McpConnectorEditRequest {
  id          String    @id @default(cuid())
  mcpServerId String
  mcpServer   McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  /// User who proposed the change. Captured via x-user-id at submission time.
  proposedByUserId String
  proposedAt       DateTime @default(now())

  /// Full proposed snapshot of the editable McpServer fields. Stored as a
  /// single JSON blob so adding a new mutable field on McpServer doesn't
  /// require this model's schema to evolve.
  /// Shape: { name?, url?, description?, transport?, credentialForm?,
  ///          credentialSchema?, launchConfigTemplate?, httpConfigTemplate?,
  ///          healthcheckSpec?, writeToolPolicy?, connectorMeta? }
  proposedFields Json

  /// "pending" | "approved" | "rejected" | "superseded" | "cancelled"
  status String @default("pending")

  /// Set on approve/reject/supersede.
  reviewedByUserId String?
  reviewedAt       DateTime?
  /// Admin's reject note OR system-generated note for supersede/cancel.
  reviewNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mcpServerId, status])
  @@index([status, createdAt])
  @@map("mcp_connector_edit_requests")
}

/// Admin-managed global credentials per MCP server. At call time, user-level
/// credentials take precedence; this row is the fallback when a user hasn't
/// connected the server personally AND McpServer.allowGlobalFallback=true.
///
/// Org-scoped (2026-07-14): orgId=NULL is the deployment-wide default row
/// (legacy behavior); a row with orgId set overrides the default for that
/// org's agents/users. Uniqueness of the NULL-org default is enforced by a
/// partial unique index in the migration — Postgres treats NULLs as distinct,
/// so the composite @@unique alone would allow duplicate default rows.
model GlobalMcpCredentials {
  id             String    @id @default(cuid())
  mcpServerId    String
  mcpServer      McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  orgId          String?
  encryptedCreds String
  iv             String
  authTag        String
  setByUserId    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([mcpServerId, orgId])
  @@index([mcpServerId])
  @@map("global_mcp_credentials")
}

model UserMcpConnection {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpServerId    String
  mcpServer      McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  encryptedCreds String
  iv             String
  authTag        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, mcpServerId])
  @@map("user_mcp_connections")
}

/// Agent-scoped MCP credentials. Used when an agent must always reach a
/// specific instance of an MCP (e.g. hyperswitch-agent → Hyperswitch
/// Grafana, xyne-agent → Xyne Grafana) regardless of who's invoking it.
///
/// Resolution order in loadEffectiveCredentials:
///   1. agent  — this table, keyed by (agentId, mcpServerId)
///   2. user   — UserMcpConnection
///   3. global — GlobalMcpCredentials (when McpServer.allowGlobalFallback)
///   4. error
///
/// Same encryption envelope as UserMcpConnection (AES-GCM, paste-once,
/// never read back via API). Owner / contributors / admins can update.
model AgentMcpConnection {
  id              String    @id @default(cuid())
  agentId         String
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  mcpServerId     String
  mcpServer       McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  /// Stable short identifier for this instance, scoped to (agent, server).
  /// Surfaced in the tool prefix the agent sees (`<serverType>-<slug>__<tool>`)
  /// and in the DELETE route. Existing single-instance rows are backfilled
  /// with 'default' by the migration. Allowed chars: lowercase alnum + hyphen.
  slug            String    @default("default")
  /// Optional human-readable name shown in the admin UI, e.g. "Grafana Prod".
  /// Falls back to mcpServer.name when null.
  displayName     String?
  encryptedCreds  String
  iv              String
  authTag         String
  /// User who pasted the creds — used in audit logs.
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([agentId, mcpServerId, slug])
  @@index([agentId])
  @@map("agent_mcp_connections")
}

model ScheduledJob {
  id              String            @id @default(cuid())
  userId          String
  agentSlug       String
  task            String            @db.Text
  context         String?           @db.Text
  channelId       String?
  conversationId  String?
  // Spaces workspace the job was scheduled in. Required by Spaces app API
  // (postMessage / openDm) when the worker delivers results. Captured from
  // the `xyne_last_workspace` cookie at job-creation time. Nullable for rows
  // created before this column existed; those jobs can't deliver to Spaces
  // and will need to be recreated by the user.
  workspaceId     String?
  type            String
  delayMs         BigInt?
  cronExpression  String?
  maxRuns         Int?
  runCount        Int               @default(0)
  status          String            @default("active")
  bullJobId       String?
  bullSchedulerId String?           @unique
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  label           String?
  replyMode       String            @default("thread")
  // Override channel for `replyMode = "channel"` deliveries. NULL means
  // "use the originating channelId" so existing rows behave unchanged.
  targetChannelId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  runs            ScheduledJobRun[]
  orgId           String

  @@index([status])
  @@index([userId])
  @@index([agentSlug])
  @@index([orgId])
  @@map("scheduled_jobs")
}

model ScheduledJobRun {
  id             String       @id @default(cuid())
  scheduledJobId String
  scheduledJob   ScheduledJob @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  sessionId      String?
  status         String
  result         String?      @db.Text
  error          String?      @db.Text
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([scheduledJobId])
  @@map("scheduled_job_runs")
}

// User-created subagent definitions. Built-in subagents live in code
// (xyne-claw-shared SUBAGENT_DEFINITIONS) and are not represented here —
// validation rejects names that collide with built-ins at create time so
// the runtime resolver can simply prefer built-ins on lookup.
model SubagentDefinition {
  id               String          @id @default(cuid())
  name             String
  description      String
  progressLabels   Json
  systemPrompt     String          @db.Text
  paramName        String          @default("question")
  paramDescription String
  // Same JSON shape as Agent.config.tools — parsed by parseToolsConfig
  // in xyne-claw-shared. Defines which tools the subagent's child LLM
  // can call.
  tools            Json
  enabled          Boolean         @default(true)
  /// Per-MCP-server instance pin. Companion to AgentMcpConnection.slug —
  /// lets the subagent restrict itself to ONE agent-pinned MCP instance
  /// per server type. Example:
  ///   { "grafana": "prod", "elasticsearch": "logs-cluster" }
  /// At runtime the runner only spawns the matching agent instance and
  /// surfaces just that instance's tools (e.g. `grafana-prod__query`).
  /// NULL or missing keys = inherit all instances of that server type
  /// from the parent agent (Stance A — today's behavior).
  mcpInstanceMap   Json?
  /// Creator / owner. NULL only for legacy or admin-seeded rows. The CRUD
  /// route fills this with the requester's userId on create and uses it as
  /// the ACL anchor (owner + shares + admin can edit; everyone reads).
  createdByUserId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  orgId            String
  org              Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  skills           SubagentSkill[]
  shares           SubagentShare[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("subagent_definitions")
}

model SubagentShare {
  id                   String   @id @default(cuid())
  subagentDefinitionId String
  userId               String
  /// "EDITOR" by default. Subagents are globally visible to all users so
  /// a separate VIEWER role is meaningless; shares are strictly about
  /// granting additional edit rights beyond the owner.
  role                 String   @default("EDITOR")
  sharedBy             String?
  createdAt            DateTime @default(now())

  subagentDefinition SubagentDefinition @relation(fields: [subagentDefinitionId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subagentDefinitionId, userId])
  @@map("subagent_shares")
}

model SubagentSkill {
  id                   String             @id @default(cuid())
  subagentDefinitionId String
  subagentDefinition   SubagentDefinition @relation(fields: [subagentDefinitionId], references: [id], onDelete: Cascade)
  skillId              String
  skill                Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([subagentDefinitionId, skillId])
  @@map("subagent_skills")
}

model PendingMemoryReview {
  id                String   @id @default(cuid())
  agentSlug         String
  userId            String? /// null for "shared" scope reviews
  /// Hindsight memory ID. NULL until the candidate is approved — on approve,
  /// the curator-distilled content is retained to Hindsight and the returned
  /// memory id stored here. On reject, stays NULL (Hindsight never sees it).
  hindsightMemoryId String?
  content           String   @db.Text
  scope             String /// "shared" | "user"
  category          String? /// Set by the curator: "preference" | "fact" | "pattern" | "caution"
  /// Session that produced this candidate. Used for audit + retain tagging.
  sessionId         String?
  /// Subsystem this candidate targets (curator-classified). Subsystem
  /// taxonomy is discovered from Hindsight tags (subsystem:X), NOT hardcoded.
  subsystem         String?
  /// "create" | "update". Determines whether approve retains (+ deletes the
  /// replaced memory) or only retains.
  action            String?
  /// On update: the Hindsight memory ID this candidate will REPLACE on approve.
  /// On create: NULL.
  replacesMemoryId  String?
  /// True when the curator proposed a subsystem name that doesn't yet exist
  /// in the bank — admin should scrutinize naming before approving.
  isNewSubsystem    Boolean  @default(false)
  status            String   @default("pending") /// "pending" | "approved" | "rejected"
  spacesMessageId   String? /// Spaces message ID of the approval request (for updates)
  curatorReasoning  String?  @db.Text /// Why the nightly curator emitted this candidate
  curatorConfidence Float?
  tokensIn          Int?
  tokensOut         Int?
  toolCount         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  orgId             String

  @@index([status])
  @@index([agentSlug])
  @@index([agentSlug, status])
  @@index([orgId])
  @@map("pending_memory_reviews")
}

/// One batch-review row per (agent, date). The night after sessions run,
/// the cron groups the day's transcripts by agentSlug, applies a heuristic
/// to drop junk sessions, and creates one of these rows per agent. An admin
/// approves or rejects the whole batch (or cherry-picks specific sessions);
/// only on approval does the transcript get retained to the memory provider.
/// This means rejected sessions cost zero LLM extraction tokens.
model PendingBatchReview {
  id                 String   @id @default(cuid())
  agentSlug          String
  reviewDate         String /// YYYY-MM-DD — date the sessions ran (UTC)
  status             String   @default("pending") /// "pending" | "approved" | "rejected" | "partial"
  /// All session IDs in this batch that passed the heuristic filter
  /// (i.e., are eligible for human review).
  sessionIds         String[]
  /// Subset of sessionIds the admin actually approved. Populated on approve.
  approvedSessionIds String[] @default([])
  /// Session IDs the heuristic skipped (with reasons). JSON shape:
  /// [{ sessionId, reason }]. Surfaced to admin for transparency.
  heuristicSkipped   Json?
  /// Spaces message ID of the approval-digest message (for follow-ups).
  spacesMessageId    String?
  /// On approval, the Hindsight memory IDs returned from each retain call.
  /// JSON shape: { sessionId: [memoryId, ...] }. Used for follow-up audit / rollback.
  retainedMemoryIds  Json?
  /// Cached agent's memoryApprovalStrategy at batch creation time, so changing
  /// the agent config later doesn't break in-flight batches.
  approvalStrategy   String   @default("HUMAN_ONLY")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orgId              String

  @@unique([agentSlug, reviewDate])
  @@index([status])
  @@index([agentSlug, status])
  @@index([orgId])
  @@map("pending_batch_reviews")
}

/// One row per recalled memory per session start. Written by the nightly cron
/// in claw-auth after ingesting xyne-claw's data/recall-hits/<date>.jsonl.
/// Drives the "hot memories" panel in the agent Memory tab.
model MemoryRecallHit {
  id                String   @id @default(cuid())
  agentSlug         String
  hindsightMemoryId String
  userId            String /// The user whose session triggered the recall
  sessionId         String
  scope             String /// "shared" | "user" — denormalised for fast filtering
  rank              Int? /// 1-based position in the recall result list
  recalledAt        DateTime @default(now())
  orgId             String

  @@index([agentSlug, recalledAt])
  @@index([hindsightMemoryId])
  @@index([orgId])
  @@map("memory_recall_hits")
}

/// Active `/goal <condition>` autonomous loop for a Spaces conversation.
///
/// One UNIQUE row per conversationId (single active goal per thread). Created
/// when a user types `/goal <condition>` in a Spaces thread; flips to status
/// = "done" / "cancelled" / "failed" on the terminating event and is kept for
/// audit. The webhook re-looper reads `runPayload` to refire claw's /run with
/// the same provider/agent/skills context on each subsequent turn.
model ActiveGoal {
  id             String   @id @default(cuid())
  conversationId String   @unique /// Spaces thread id — UNIQUE
  channelId      String?
  workspaceId    String?
  userId         String /// User who started the goal
  agentSlug      String
  condition      String /// Verbatim exit-condition text
  status         String   @default("active") /// "active" | "done" | "cancelled" | "failed"
  turnCount      Int      @default(0) /// Turns completed so far
  maxTurns       Int      @default(5) /// Hard cap, enforced by relooper. Default 5: covers worker → audit → 1-2 fix cycles. Longer loops tend to burn LLM cost on judge-driven rabbit holes (e.g. judge falsely flagging missing attachments).
  lastTurnResult String? /// Most recent worker output (≤ 4KB stored)
  lastReason     String? /// Last boss reason or terminal reason
  runPayload     Json /// Stashed first-turn /run inputs to replay
  /// Audit-pass state machine — defends against LLM-judge false positives.
  /// "none"    : default. Judge fires every turn; done→terminate.
  /// "pending" : judge said done in "none" mode, audit task was fired; the
  ///             next worker result is the audit response, not a normal turn.
  /// "done"    : audit already happened (clean or reopened+fixed). Judge's
  ///             next done vote terminates without re-auditing.
  auditState     String   @default("none")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orgId          String

  @@index([userId, status])
  @@index([status, updatedAt])
  @@index([orgId])
  @@map("active_goals")
}

model ExperimentRun {
  id                 String              @id @default(cuid())
  conversationId     String
  channelId          String
  agentSlug          String
  userId             String
  orgId              String
  focus              String?
  /// Per-experiment LLM pin, forwarded as providerOverride on every epoch
  /// dispatch. NULL = the agent's normal provider resolution.
  provider           String?
  modelId            String?
  /// "experiment" (default proof-reward loop) or "understanding" (coverage-gated:
  /// end-experiment stays locked until the open-conjecture frontier is exhausted).
  /// Persisted per-run so EVERY epoch dispatch forwards it, not just the first.
  kind               String              @default("experiment")
  status             String              @default("running") /// running | finishing | done | aborted
  epoch              Int                 @default(1)
  deadlineAt         DateTime
  currentHypothesis  String?             @db.Text
  currentSessionId   String?
  lastEpochEndedAt   DateTime?
  sandboxNote        String?
  /// Basenames of files the agent actually delivered to the thread via
  /// sandbox-deliver-files. A finding may only be marked `proved` if its
  /// proofArtifactPath resolves to one of these — proof left behind in a
  /// sandbox dies with the sandbox and is worthless to a human reader.
  deliveredArtifacts String[]            @default([])
  /// Sessions of in-flight CHECKER runs. Checkers deliberately never claim
  /// currentSessionId (that would make the epoch handoff chain off their
  /// completion), which also meant `/experiment stop` could not reach them —
  /// a stopped run kept emitting checker output into the thread.
  checkerSessionIds  String[]            @default([])
  finalReport        String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  findings           ExperimentFinding[]
  reviews            ExperimentReview[]

  @@index([conversationId, status])
  @@map("experiment_runs")
}

// workspace-check:ignore — tenant scope inherited via experimentId -> ExperimentRun.orgId (FK, onDelete: Cascade); never queried cross-tenant.
model ExperimentFinding {
  id                String             @id @default(cuid())
  experimentId      String
  experiment        ExperimentRun      @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  epoch             Int
  status            String /// conjecture | proved | refuted
  title             String
  hypothesis        String             @db.Text
  note              String?            @db.Text
  proofArtifactPath String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  reviews           ExperimentReview[]

  @@index([experimentId])
  @@map("experiment_findings")
}

/// A second agent's verdict on a finding, produced at the end of each epoch.
/// Deliberately ADVISORY: a review never mutates ExperimentFinding.status.
/// An agent that can silently un-prove another agent's work is a failure mode
/// with no audit trail — so the verdict sits beside the finding and a human
/// (or the next epoch's prompt) decides what to do with it.
// workspace-check:ignore — tenant scope inherited via experimentId -> ExperimentRun.orgId (FK, onDelete: Cascade); never queried cross-tenant.
model ExperimentReview {
  id           String            @id @default(cuid())
  experimentId String
  experiment   ExperimentRun     @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  findingId    String
  finding      ExperimentFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  /// Epoch the review ran for (the epoch whose findings it checked).
  epoch        Int
  /// confirms | contradicts | stale | duplicate | unverifiable
  verdict      String
  reason       String            @db.Text
  /// Set when verdict = duplicate — the ExperimentFinding.id it duplicates.
  duplicateOf  String?
  createdAt    DateTime          @default(now())

  @@unique([findingId, epoch])
  @@index([experimentId])
  @@map("experiment_reviews")
}

/// Output of the FailureCurator — a structured "why this agent is
/// failing and what to change" finding, evidenced by 2+ AgentRun
/// sessionIds. Generated hourly by the curator worker; reviewed and
/// applied/dismissed by the operator via the metrics page.
///
/// `bucket` is the user-side symptom class:
///   agent_unable_to_do_work  — soft refusals / low-effort completions
///   failure                  — explicit fails/cancellations/retries
///   user_frustrated          — follow-up user messages express anger
///
/// `rootCause` is the actionable diagnosis the operator changes:
///   need-memory, missing-tool, prompt-ambiguity, wrong-subagent,
///   redundant-subagent-call, tool-misuse, ext-api-failure,
///   permission-denied, memory-miss, identity-bleed, no-actionable
model AgentImprovementCandidate {
  id          String   @id @default(cuid())
  agentSlug   String
  bucket      String /// see enum in failure-curator.ts
  rootCause   String /// see enum in failure-curator.ts
  finding     String   @db.Text /// 1-2 sentence concrete description
  evidence    Json /// string[] of agent_runs.sessionId — ≥2
  proposedFix Json /// { type, description } — see ImprovementCandidate type
  confidence  String   @default("medium") /// "high" | "medium" | "low"
  status      String   @default("pending") /// "pending" | "applied" | "dismissed"
  /// Audit metadata for dedupe + UI. Includes:
  ///   - mergeCount: how many curator runs reinforced this candidate
  ///   - lastEvidenceAt: max(completedAt) across all evidence sessions
  ///   - dismissUntil: ISO timestamp; suppresses similar findings for 7d
  ///                   after dismiss (matched on agentSlug+bucket+rootCause)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orgId       String

  @@index([agentSlug, status, updatedAt])
  @@index([status, createdAt])
  @@index([orgId])
  @@map("agent_improvement_candidates")
}

/// Per-agent watermark for the FailureCurator's incremental scan. The
/// hourly worker only looks at runs with completedAt > lastProcessedAt
/// since the last time we generated candidates, so we don't re-process
/// the same sessions over and over.
model AgentCuratorState {
  agentSlug       String   @id
  lastProcessedAt DateTime
  lastRunAt       DateTime @default(now())
  /// How many curator invocations have we made for this agent
  invocationCount Int      @default(0)
  /// How many candidates emitted total (across all invocations)
  candidateCount  Int      @default(0)
  updatedAt       DateTime @updatedAt

  orgId String

  @@index([orgId])
  @@map("agent_curator_state")
}

/// ── Evals ───────────────────────────────────────────────────────────────
/// A folder in the eval explorer (flat list — no nesting) holding
/// conversations. There is intentionally NO typed "source" entity —
/// the structure is plain folders; a conversation's free-form `source` string
/// is enough to tag where it came from (manual / support-email / spaces / …)
/// when an ingestion pipeline or webhook starts feeding rows in.
model EvalFolder {
  id              String             @id @default(cuid())
  name            String
  conversations   EvalConversation[]
  source          String? // e.g. "spaces"
  sourceKind      String? // "channel" | "email-channel"
  sourceChannelId String?
  createdBy       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([sourceChannelId])
  @@map("eval_folders")
}

/// One conversation to evaluate: an ordered list of turns. Lives in a folder.
/// `turns` is [{ message, expectedResponse }]. The agent to run against is NOT
/// stored here — it's chosen per-run, so the same conversation can be evaluated
/// against different agents over time.
model EvalConversation {
  id                String              @id @default(cuid())
  folderId          String
  folder            EvalFolder          @relation(fields: [folderId], references: [id], onDelete: Cascade)
  title             String
  turns             Json
  source            String?
  externalId        String?
  externalUpdatedAt DateTime?
  lastMessageId     String?
  createdBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  turnResults       EvalGeneratedTurn[]

  @@index([folderId, createdAt])
  @@map("eval_conversations")
}

/// One execution over a set of conversations. `conversationIds` is the planned
/// scope (selected conversations, or every conversation in `folderId` for a
/// batch run) — used to show progress. The browser orchestrates the replay via
/// the agent-chat SSE endpoint and writes each turn back as it completes.
model EvalGeneration {
  id              String              @id @default(cuid())
  agentSlug       String
  status          String              @default("running") /// "running" | "completed" | "failed" | "cancelled"
  genProvider     String?
  genModel        String?
  conversationIds String[]
  folderId        String?
  createdBy       String?
  /// Groups the N sibling runs (one per agent, up to 3) of a single multi-agent
  /// comparison. Each agent still gets its own EvalGeneration row (own runId,
  /// own genProvider/genModel, own turns); they share this id so the UI can pull
  /// and align them side by side. Null for a plain single-agent run.
  comparisonId    String?
  /// 0-based position of this agent within its comparison (the order the user
  /// picked them). Makes the "primary" (seq 0) baseline stable across reloads —
  /// startedAt alone can tie for back-to-back inserts. Null for single-agent runs.
  comparisonSeq   Int?
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  turnResults     EvalGeneratedTurn[]
  orgId           String

  @@index([folderId, startedAt])
  @@index([orgId])
  @@index([comparisonId])
  @@map("eval_generations")
}

/// One turn of one conversation within a run: the input, the ground-truth
/// answer, and what claw produced (answer + reasoning + tool calls). Reasoning
/// is captured by the browser off the agent-chat SSE `reasoning` stream — neither
/// claw nor claw-auth persists it otherwise.
model EvalGeneratedTurn {
  id                 String           @id @default(cuid())
  runId              String
  generation         EvalGeneration   @relation(fields: [runId], references: [id], onDelete: Cascade)
  conversationId     String
  conversation       EvalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turnIndex          Int
  inputMessage       String           @db.Text
  expectedResponse   String?          @db.Text
  clawAnswer         String?          @db.Text
  reasoning          String?          @db.Text
  toolInvocations    Json?
  status             String           @default("running") /// "running" | "completed" | "failed"
  clawConversationId String?
  sessionId          String?
  matchScore         Int?
  judgeReasoning     String?          @db.Text
  judgeModel         String?
  judgedAt           DateTime?
  judgeScores        EvalVerdict[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([runId, conversationId, turnIndex])
  @@index([runId])
  @@index([conversationId])
  @@map("eval_generated_turns")
}

/// A named LLM judge = a grading rubric (prompt) + the model that runs it. Users
/// create several; a run can be scored by multiple judges at once, and the UI
/// lets you switch which judge's scores drive the view (turns + report).
model EvalJudge {
  id        String   @id @default(cuid())
  name      String
  prompt    String   @db.Text
  model     String   @default("")
  isDefault Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("eval_judges")
}

/// One judge×model verdict on one turn. The same judge (rubric) can be scored
/// by several models in one pass — each (judge, model) pair keeps its own row.
/// `judgeName`/`model` are denormalized so a deleted judge's past scores still
/// render (no hard FK to EvalJudge on purpose).
model EvalVerdict {
  id           String            @id @default(cuid())
  turnResultId String
  turnResult   EvalGeneratedTurn @relation(fields: [turnResultId], references: [id], onDelete: Cascade)
  judgeId      String
  judgeName    String
  score        Int?
  reasoning    String?           @db.Text
  status       String            @default("scored")
  model        String            @default("default")
  passId       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([turnResultId, judgeId, model])
  @@index([turnResultId])
  @@map("eval_verdicts")
}

// ==========================================
// Search Evals — Vespa search retrieval-relevance testing
// (distinct from the agent EvalFolder/EvalGeneration models above)
// ==========================================

/// One uploaded CSV of {query, goldId, gold answer} rows. `permissionMode`
/// ("with" = scoped to createdBy's own Spaces ACL, "without" = public
/// content only — never a true unrestricted bypass, see
/// publicOnlyConditionForSchema() in vespa-direct.ts) and `asOfTimestamp` are
/// fixed at upload time — they describe the eval set's context (whose
/// access, and as of when the gold answers were valid), not a per-run
/// choice. Every run against this sheet inherits them; only entity type +
/// rank profile vary per run.
model SearchEvalSheet {
  id             String            @id @default(cuid())
  name           String
  description    String?           @db.Text /// optional free text — what this eval set is about
  orgId          String
  permissionMode String            @default("with") /// "with" | "without"
  asOfTimestamp  DateTime?
  createdBy      String?
  createdAt      DateTime          @default(now())
  queries        SearchEvalQuery[]
  runs           SearchEvalRun[]

  @@index([orgId])
  @@map("search_eval_sheets")
}

/// One row of an uploaded sheet: a query, its gold answer text (reference only,
/// not used for scoring — v1 scoring is a pure retrieval hit-check), and the
/// gold doc's own Vespa docId — the same id transformHit()/resultTransform.ts
/// put in a result's top-level `id` for every entity type (messageId for a
/// message, the file's own id, channelId, callId, the email's own id, or a
/// ticket's internal id — see mapper.ts). Required, same as `query`: a row
/// with no gold id has nothing to score against.
model SearchEvalQuery {
  id         String             @id @default(cuid())
  sheetId    String
  sheet      SearchEvalSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  query      String             @db.Text
  goldAnswer String?            @db.Text
  goldId     String             @db.Text
  createdAt  DateTime           @default(now())
  results    SearchEvalResult[]

  @@index([sheetId])
  @@map("search_eval_queries")
}

/// One run = a sheet's queries searched under a fixed entity-type + rank-profile
/// choice. `permissionMode`/`asOfTimestamp` are copied from the sheet at
/// creation time (fixed there, not chosen per run) — kept denormalized here so
/// each run's historical display is accurate even if read long after.
model SearchEvalRun {
  id                String             @id @default(cuid())
  sheetId           String
  sheet             SearchEvalSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  queryType         String[] /// entity types searched; empty = all types
  rankProfile       String? /// null = let the backend auto-pick (default_native for scored text)
  /// Overrides for the active rank profile's `input.query(<name>)` params —
  /// only meaningful when rankProfile is a real per-schema "tunable" profile
  /// (see TUNABLE_INPUTS_BY_AREA in SearchEvalsPageV3.tsx / the tunable
  /// rank-profile inputs {} block per Vespa schema); null otherwise.
  rankProfileInputs Json?
  permissionMode    String /// "with" | "without" — copied from the sheet at run creation
  asOfTimestamp     DateTime?
  status            String             @default("running") /// "running" | "completed" | "failed"
  createdBy         String?
  orgId             String
  startedAt         DateTime           @default(now())
  completedAt       DateTime?
  /// Top1/Top3/Top10 count+% and Mean Reciprocal Rank — written by the worker
  /// alongside completedAt when the run finishes (null while "running", or for
  /// runs from before this existed — the API falls back to live computation
  /// from `results` in that case). `completedAt` is the "with timestamp" this
  /// was asked to be stored with.
  queriesScored     Int?
  top1Count         Int?
  top1Pct           Float?
  top3Count         Int?
  top3Pct           Float?
  top10Count        Int?
  top10Pct          Float?
  mrr               Float?
  results           SearchEvalResult[]

  @@index([sheetId, startedAt])
  @@index([orgId])
  @@map("search_eval_runs")
}

/// One query's outcome within a run: did the row's goldId show up in the
/// top-10 Vespa results, and at what rank. `topResults` keeps up to the
/// top-20 (10 past the scoring cutoff, for manual "how close was this miss"
/// review) full result objects, each including its raw match-features.
model SearchEvalResult {
  id         String          @id @default(cuid())
  runId      String
  run        SearchEvalRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  queryId    String
  query      SearchEvalQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  hit        Boolean         @default(false)
  rank       Int?
  topResults Json /// SearchEvalTopResult[] — { id, xyneId, messageId, conversationId, relevanceScore, snippet, raw }
  debug      Json? /// SearchEvalDebugPayload[] — { stage, yql, vespaParams } per Vespa query stage, for manual confirmation
  createdAt  DateTime        @default(now())

  @@unique([runId, queryId])
  @@index([runId])
  @@map("search_eval_results")
}

// ==========================================
// MCP Gateway Registry Tables
// Backend services dynamically register their tools here
// ==========================================

model ServiceRegistry {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  tenantUniqueId   String   @map("tenant_unique_id")
  serviceName      String   @map("service_name")
  backendId        String   @map("backend_id")
  backendUrl       String   @map("backend_url")
  tools            Json
  xAuthHeaderName  String?  @map("x_auth_header_name")
  tokenEndpointUrl String?  @map("token_endpoint_url")
  registeredAt     DateTime @default(now()) @map("registered_at")

  @@unique([tenantUniqueId, serviceName, backendId], name: "unique_service_backend_tenant")
  @@index([tenantUniqueId])
  @@index([serviceName])
  @@index([tenantUniqueId, serviceName])
  @@map("service_registry")
}

// Error-pipeline bucket taxonomy + routing rules (Grafana → Claw auto-fix).
// The classifier in xyne-claw fetches these at runtime: marker regexes give
// the deterministic fast-path, descriptions feed the LLM fallback's prompt,
// mode gates the future runner. Editable without a deploy (admin UI/API).
// mode is a plain string (auto | review | drop) — no Postgres enum, per the
// enum→text convention.
model ErrorBucket {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("") // one-liner for the LLM prompt
  keywords    String[] @default([]) // literal phrases (auto-escaped, case-insensitive) — the friendly editor
  markers     String   @default("") // advanced: raw regex, unioned with keywords. Escape hatch for power patterns.
  matchOrder  Int      @default(20) // pattern-check order, ascending (1 = tried first; default bucket = 25). NOT urgency.
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, matchOrder])
  @@map("error_buckets")
}

model EntityTypeDefinition {
  workspaceId String? // denormalized tenant key (nullable; stamped on insert)
  id          String  @id @default(cuid())

  name     String // "GATEWAY" — used verbatim in prompts and on entities
  prefix   String // "gw" — entity id prefix, for readability only
  rule     String // decision rule, injected verbatim into the extraction prompt
  examples String[] @default([]) // 3-5 real spans, teaching the model the formatting range

  status           String    @default("PROPOSED") // PROPOSED | APPROVED | DEPRECATED
  proposedInRunId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  deprecatedReason String? // required when status = DEPRECATED

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Stops channel B inventing GATEWAY_2 when channel A already defined GATEWAY.
  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("entity_type_definitions")
}

/// One type-discovery pass over one channel.
model EntityExtractionRun {
  workspaceId String? // denormalized tenant key (nullable; stamped on insert)
  id          String  @id @default(cuid())
  channelId   String

  status String @default("RUNNING") // RUNNING | AWAITING_TYPE_APPROVAL | COMPLETED | FAILED | CANCELLED
  stage  String @default("FETCHING_MESSAGES") // FETCHING_MESSAGES | DISCOVERING_TYPES | DONE

  /// Full settings snapshot, so a run can be reproduced or explained later.
  settings      Json
  /// Types the pipeline proposed, awaiting human approval. Approving creates
  /// EntityTypeDefinition rows rather than editing this back.
  proposedTypes Json?

  messageCount  Int @default(0)
  documentCount Int @default(0)

  /// Type names a human approved on this run. The per-channel set written to
  /// Vespa is the union of this across the channel's completed runs, so a
  /// second run on the same channel adds to the channel's vocabulary rather
  /// than replacing it.
  approvedTypeNames String[] @default([])

  triggeredByUserId String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  errorMessage      String?

  @@index([workspaceId, channelId, status])
  @@index([workspaceId, status])
  @@map("entity_extraction_runs")
}

/// Scheduler state for an awakened agent — an agent that wakes on its own
/// (periodic heartbeat, or a reflex fired by accumulated events) instead of
/// waiting for a human to trigger it.
///
/// This table holds ONLY what the tick loop must index-scan. Every tunable
/// knob lives in `agents.config.awakening` (JSON) instead, so the existing
/// PUT /agents/:slug write path, its ACL and its audit diff keep working
/// unchanged. The split matters: Postgres cannot index-scan JSON, and the
/// claim query below runs every tick for every org.
///
/// `watermarkAt` is the exactly-once seam. It advances only after a window is
/// successfully sealed, never rewinds (see awakening/cursor.ts), and is the
/// sole source of truth for "what has this agent already seen".
model AgentAwakeningState {
  id      String @id @default(cuid())
  agentId String @unique
  orgId   String

  enabled    Boolean   @default(false)
  /// Wall-clock the tick loop compares against. Claimed with FOR UPDATE SKIP
  /// LOCKED so N pods can run the same tick without double-firing an agent.
  nextDueAt  DateTime
  lastTickAt DateTime?

  /// Exclusive upper bound of the last sealed window. The next window is
  /// (watermarkAt, now - replicaSafetyMs].
  watermarkAt        DateTime
  /// Tie-breaker for events sharing watermarkAt to the millisecond.
  watermarkMessageId String?

  /// Backoff state. A failed window increments this and pushes nextDueAt out
  /// exponentially; the first success resets it. This is the whole circuit
  /// breaker — no separate state machine.
  consecutiveFailures Int     @default(0)
  consecutiveSkips    Int     @default(0)
  lastError           String? @db.Text

  /// Reflex cadence, tracked separately from the heartbeat.
  ///
  /// A reflex checks far more often than a heartbeat (a cheap COUNT, not a
  /// window collect) and fires only once enough events have piled up. It keeps
  /// its OWN watermark on purpose: the two wake kinds are meant to see the same
  /// events for different reasons — the reflex reacts fast and shallow, the
  /// heartbeat later synthesises the whole period AND reads what the reflexes
  /// already did (requirement 7). Sharing one watermark would let a reflex
  /// consume events the heartbeat then never sees.
  reflexNextCheckAt  DateTime?
  reflexWatermarkAt  DateTime?
  /// Last time a reflex actually dispatched — enforces the minimum gap between
  /// reflex runs so a busy channel cannot fire one every check.
  reflexLastRunAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The only hot query: the per-tick claim scan.
  @@index([enabled, nextDueAt])
  /// The reflex claim scan — same shape, different cadence.
  @@index([enabled, reflexNextCheckAt])
  @@index([orgId])
  @@map("agent_awakening_state")
}

/// One row per wake attempt, whether or not it dispatched a run.
///
/// Serves three jobs at once: the idempotency guard (`idempotencyKey`), the
/// admin health view (outcome/skipReason/signals), and requirement 7 — a
/// heartbeat reads the reflex runs whose window OVERLAPS its own so it does
/// not redo work that already happened. Overlap, not containment: a reflex
/// that started before the window and ran into it consumed events this
/// heartbeat is about to see.
model AgentAwakeningRun {
  id      String @id @default(cuid())
  agentId String
  orgId   String

  /// "heartbeat" | "reflex". Plain String — Postgres enums are frozen
  /// repo-wide (scripts/validate-no-new-enums.sh).
  kind String

  /// Window bounds as epoch millis. BigInt so a JS Date round-trip cannot
  /// silently lose precision on the overlap query.
  windowStartMs BigInt
  windowEndMs   BigInt

  /// "ran" | "skipped" | "failed" | "shadow"
  outcome    String
  /// Populated when outcome = "skipped": which gate rule fired.
  skipReason String?

  eventCount Int   @default(0)
  /// Denormalized signal counts the gate decided on — what an operator needs
  /// to answer "why did/didn't it wake" without re-deriving the window.
  signals    Json?

  sessionId      String?
  idempotencyKey String  @unique
  artifactUri    String?
  injectionsUsed Int     @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// Requirement 7: overlap lookup for a heartbeat reading prior reflexes.
  @@index([agentId, windowStartMs])
  @@index([orgId, startedAt])
  @@map("agent_awakening_runs")
}
