      "containerId": "r1", "originalText": "Step 1: Identity\n\n• Agent Name (unique check)\n• Slug (auto/manual)\n• Description + Color",
      "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid",
