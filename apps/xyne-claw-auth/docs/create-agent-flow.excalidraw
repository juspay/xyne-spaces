    {"id": "r4", "type": "rectangle", "x": 850, "y": 80, "width": 220, "height": 100,
      "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0,
      "seed": 110, "version": 1, "versionNonce": 110, "isDeleted": false,
      "groupIds": [], "boundElements": [{"type": "text", "id": "t4"}], "frameId": null, "roundness": {"type": 3}},
    {"id": "t4", "type": "text", "x": 865, "y": 90, "width": 190, "height": 80,
      "text": "Step 4: Review + Create\n\n• Preview all settings\n• POST /agents (create)\n• PUT /agents/:slug\n  (set tools config)",
      "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": "r4", "originalText": "Step 4: Review + Create\n\n• Preview all settings\n• POST /agents (create)\n• PUT /agents/:slug\n  (set tools config)",
      "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 111, "version": 1, "versionNonce": 111, "isDeleted": false,
      "groupIds": [], "boundElements": null, "frameId": null, "lineHeight": 1.25, "autoResize": true},

    {"id": "r_name_check", "type": "rectangle", "x": 40, "y": 230, "width": 490, "height": 130,
      "strokeColor": "#e8590c", "backgroundColor": "#ffec99", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0,
      "seed": 120, "version": 1, "versionNonce": 120, "isDeleted": false,
      "groupIds": [], "boundElements": [{"type": "text", "id": "t_name_check"}], "frameId": null, "roundness": {"type": 3}},
    {"id": "t_name_check", "type": "text", "x": 55, "y": 240, "width": 460, "height": 110,
      "text": "Name Availability Check (debounced 500ms)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFrontend → GET /agents/check-name?name=X&slug=Y\n  → claw-auth checks agents.slug (DB unique)\n  → claw-auth calls Spaces /api/apps/check-name (case-insensitive)\n  → returns { slugAvailable, nameAvailable }\n\nUI: green check = available, red X = taken, spinner = checking",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "containerId": "r_name_check", "originalText": "Name Availability Check (debounced 500ms)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFrontend → GET /agents/check-name?name=X&slug=Y\n  → claw-auth checks agents.slug (DB unique)\n  → claw-auth calls Spaces /api/apps/check-name (case-insensitive)\n  → returns { slugAvailable, nameAvailable }\n\nUI: green check = available, red X = taken, spinner = checking",
      "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 121, "version": 1, "versionNonce": 121, "isDeleted": false,
      "groupIds": [], "boundElements": null, "frameId": null, "lineHeight": 1.25, "autoResize": true},

    {"id": "r_ai_gen", "type": "rectangle", "x": 580, "y": 230, "width": 490, "height": 130,
      "strokeColor": "#862e9c", "backgroundColor": "#f3d9fa", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0,
      "seed": 130, "version": 1, "versionNonce": 130, "isDeleted": false,
      "groupIds": [], "boundElements": [{"type": "text", "id": "t_ai_gen"}], "frameId": null, "roundness": {"type": 3}},
    {"id": "t_ai_gen", "type": "text", "x": 595, "y": 240, "width": 460, "height": 110,
      "text": "AI Prompt Generation\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nUser: \"I want an agent that reviews PRs for security\"\n  → Frontend POST /agents/generate-prompt\n  → claw-auth proxies to xyne-claw /generate-prompt\n  → xyne-claw calls LiteLLM (same model as agents)\n  → returns { prompt: \"You are a security-focused...\" }\n\nLLM config stays in xyne-claw only, claw-auth just proxies",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "containerId": "r_ai_gen", "originalText": "AI Prompt Generation\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nUser: \"I want an agent that reviews PRs for security\"\n  → Frontend POST /agents/generate-prompt\n  → claw-auth proxies to xyne-claw /generate-prompt\n  → xyne-claw calls LiteLLM (same model as agents)\n  → returns { prompt: \"You are a security-focused...\" }\n\nLLM config stays in xyne-claw only, claw-auth just proxies",
      "strokeColor": "#862e9c", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 131, "version": 1, "versionNonce": 131, "isDeleted": false,
      "groupIds": [], "boundElements": null, "frameId": null, "lineHeight": 1.25, "autoResize": true},

    {"id": "r_tools_api", "type": "rectangle", "x": 40, "y": 400, "width": 490, "height": 150,
      "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0,
      "seed": 140, "version": 1, "versionNonce": 140, "isDeleted": false,
      "groupIds": [], "boundElements": [{"type": "text", "id": "t_tools_api"}], "frameId": null, "roundness": {"type": 3}},
    {"id": "t_tools_api", "type": "text", "x": 55, "y": 410, "width": 460, "height": 130,
      "text": "Tools API (GET /tools/available)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nReturns all available tools, fetched dynamically:\n\n• subagents[] — from SUBAGENT_DEFINITIONS (shared)\n  e.g. spaces, bitbucket, grafana, deepwiki, pgm\n• writeTools[] — from adapter.writeTools per MCP server\n  e.g. spaces-create-ticket, spaces-send-message\n• customGroups[] — grouped by source (custom:pgm, custom:google)\n  each with tool slugs and names\n\nNo hardcoding in frontend — adding new tools = auto-appears",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "containerId": "r_tools_api", "originalText": "Tools API (GET /tools/available)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nReturns all available tools, fetched dynamically:\n\n• subagents[] — from SUBAGENT_DEFINITIONS (shared)\n  e.g. spaces, bitbucket, grafana, deepwiki, pgm\n• writeTools[] — from adapter.writeTools per MCP server\n  e.g. spaces-create-ticket, spaces-send-message\n• customGroups[] — grouped by source (custom:pgm, custom:google)\n  each with tool slugs and names\n\nNo hardcoding in frontend — adding new tools = auto-appears",
      "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 141, "version": 1, "versionNonce": 141, "isDeleted": false,
      "groupIds": [], "boundElements": null, "frameId": null, "lineHeight": 1.25, "autoResize": true},

    {"id": "r_acl", "type": "rectangle", "x": 580, "y": 400, "width": 490, "height": 150,
      "strokeColor": "#e03131", "backgroundColor": "#ffc9c9", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0,
      "seed": 150, "version": 1, "versionNonce": 150, "isDeleted": false,
      "groupIds": [], "boundElements": [{"type": "text", "id": "t_acl"}], "frameId": null, "roundness": {"type": 3}},
    {"id": "t_acl", "type": "text", "x": 595, "y": 410, "width": 460, "height": 130,
      "text": "Agent ACL (Access Control)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nNew agents default to scope: \"personal\"\n• Only owner + shared users + admins can see/edit/delete\n• Owner set from x-user-id header or ownerUserId body\n• Only CLAW_ADMIN can create scope: \"global\" agents\n\nPromote/Demote: admin moves personal ↔ global\nSharing: owner/admin shares with users (VIEWER/EDITOR)\nWebhook: personal agent mentions check sender access\nAudit: all mutations logged to agent_audit_logs",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "containerId": "r_acl", "originalText": "Agent ACL (Access Control)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nNew agents default to scope: \"personal\"\n• Only owner + shared users + admins can see/edit/delete\n• Owner set from x-user-id header or ownerUserId body\n• Only CLAW_ADMIN can create scope: \"global\" agents\n\nPromote/Demote: admin moves personal ↔ global\nSharing: owner/admin shares with users (VIEWER/EDITOR)\nWebhook: personal agent mentions check sender access\nAudit: all mutations logged to agent_audit_logs",
      "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 151, "version": 1, "versionNonce": 151, "isDeleted": false,
      "groupIds": [], "boundElements": null, "frameId": null, "lineHeight": 1.25, "autoResize": true},

    {"id": "r_post_create", "type": "rectangle", "x": 40, "y": 590, "width": 1030, "height": 100,
      "strokeColor": "#495057", "backgroundColor": "#e9ecef", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0,
      "seed": 160, "version": 1, "versionNonce": 160, "isDeleted": false,
      "groupIds": [], "boundElements": [{"type": "text", "id": "t_post_create"}], "frameId": null, "roundness": {"type": 3}},
    {"id": "t_post_create", "type": "text", "x": 55, "y": 600, "width": 1000, "height": 80,
      "text": "After Create — What Happens Next\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n1. POST /agents creates agent (scope: personal, ownerUserId: current user)\n2. PUT /agents/:slug/config sets tools.subagents, tools.direct, tools.custom\n3. Agent auto-registers as Spaces App (if user has XYNE-APPS:WRITE permission)\n4. Agent appears in owner's agent list with purple (subagent) and gray (tool) pills\n5. Owner can configure webhook, chain, provider, and share with other users",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "containerId": "r_post_create", "originalText": "After Create — What Happens Next\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n1. POST /agents creates agent (scope: personal, ownerUserId: current user)\n2. PUT /agents/:slug/config sets tools.subagents, tools.direct, tools.custom\n3. Agent auto-registers as Spaces App (if user has XYNE-APPS:WRITE permission)\n4. Agent appears in owner's agent list with purple (subagent) and gray (tool) pills\n5. Owner can configure webhook, chain, provider, and share with other users",
      "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 161, "version": 1, "versionNonce": 161, "isDeleted": false,
      "groupIds": [], "boundElements": null, "frameId": null, "lineHeight": 1.25, "autoResize": true}
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": null,
    "theme": "light"
  },
