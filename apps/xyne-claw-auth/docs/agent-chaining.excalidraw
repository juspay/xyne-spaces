    {
      "id": "t_config",
      "type": "text",
      "x": 915,
      "y": 100,
      "width": 370,
      "height": 330,
      "text": "agent.config.chain (per-user override)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n{\n  mode: \"deterministic\" | \"non-deterministic\",\n  maxDepth: 3,  // loops, not steps\n  onComplete: {\n    triggerAgent: \"rca-agent\",\n    task: \"Review: {{result}}\",\n    conditions: {  // deterministic only\n      toolsMustInclude: [\"...\"],\n      toolsMustExclude: [\"...\"]\n    }\n  },\n  onFailure: {\n    triggerAgent: \"assistant\",\n    escalate: true\n  }\n}",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r_config",
      "originalText": "agent.config.chain (per-user override)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n{\n  mode: \"deterministic\" | \"non-deterministic\",\n  maxDepth: 3,  // loops, not steps\n  onComplete: {\n    triggerAgent: \"rca-agent\",\n    task: \"Review: {{result}}\",\n    conditions: {  // deterministic only\n      toolsMustInclude: [\"...\"],\n      toolsMustExclude: [\"...\"]\n    }\n  },\n  onFailure: {\n    triggerAgent: \"assistant\",\n    escalate: true\n  }\n}",
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
