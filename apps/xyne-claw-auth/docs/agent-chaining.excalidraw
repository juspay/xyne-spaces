    {
      "id": "t_example",
      "type": "text",
      "x": 915,
      "y": 710,
      "width": 370,
      "height": 160,
      "text": "Example: Doctor ↔ RCA Review Loop\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nmaxDepth: 3 (= 3 full loops = 6 steps)\n\nLoop 1: Doctor fixes → RCA reviews\nLoop 2: Doctor fixes → RCA reviews\nLoop 3: Doctor fixes → RCA says LGTM\n                        ↓ judge: STOP\n\nLLM judge reads \"LGTM\" → {action: \"stop\"}",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r_example",
      "originalText": "Example: Doctor ↔ RCA Review Loop\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nmaxDepth: 3 (= 3 full loops = 6 steps)\n\nLoop 1: Doctor fixes → RCA reviews\nLoop 2: Doctor fixes → RCA reviews\nLoop 3: Doctor fixes → RCA says LGTM\n                        ↓ judge: STOP\n\nLLM judge reads \"LGTM\" → {action: \"stop\"}",
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 1031,
      "version": 2,
      "versionNonce": 1031,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "frameId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },

    {
      "id": "a1",
      "type": "arrow",
      "x": 240,
