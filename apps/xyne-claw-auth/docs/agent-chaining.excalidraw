    {
      "id": "t_judge",
      "type": "text",
      "x": 915,
      "y": 490,
      "width": 370,
      "height": 160,
      "text": "LLM Judge (non-deterministic mode)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nStructured JSON output:\n{\n  action: \"continue\" | \"stop\",\n  reason: \"found 2 issues needing fix\"\n}\n\n• Agent responds naturally (no signals)\n• Judge reads output → decides continue/stop\n• Uses response_format: json_schema",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r_judge",
      "originalText": "LLM Judge (non-deterministic mode)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nStructured JSON output:\n{\n  action: \"continue\" | \"stop\",\n  reason: \"found 2 issues needing fix\"\n}\n\n• Agent responds naturally (no signals)\n• Judge reads output → decides continue/stop\n• Uses response_format: json_schema",
      "strokeColor": "#862e9c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
