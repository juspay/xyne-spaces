    {"id":"ts2t","type":"text","x":335,"y":1065,"width":240,"height":120,"text":"xyne-claw / custom-tools.ts\n──────────────────────\nloadCustomTools(agentConfig, meta)\n\n1. resolveToolConfig(schema, config)\n   agent override → env → default\n2. Build ToolExecutionContext\n   { config, attachments[], meta }\n3. Wrap as pi-coding-agent tools","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","opacity":100,"angle":0,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"containerId":"ts2","originalText":"xyne-claw / custom-tools.ts\n──────────────────────\nloadCustomTools(agentConfig, meta)\n\n1. resolveToolConfig(schema, config)\n   agent override → env → default\n2. Build ToolExecutionContext\n   { config, attachments[], meta }\n3. Wrap as pi-coding-agent tools","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"seed":307},

