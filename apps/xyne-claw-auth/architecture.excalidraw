    {"id":"cr_note","type":"text","x":50,"y":1400,"width":250,"height":80,"text":"On startup:\nrestoreScheduledJobs()\nre-enqueues active jobs from\nPostgreSQL → BullMQ\n(survives Redis data loss)\n\nAsk User Question flow:\n1. Agent calls ask-user-question tool\n2. Question stored in Redis (24h TTL)\n3. Buttons posted in thread\n4. User clicks → /app/callback\n5. New /run with answer + Redis session","fontSize":11,"fontFamily":3,"textAlign":"left","strokeColor":"#868e96","opacity":100,"angle":0,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"seed":419},

    {"id":"cr_note2","type":"text","x":570,"y":1290,"width":250,"height":60,"text":"Types:\n  once  → delayMs (e.g. 86400000 = 24h)\n  cron  → expression (e.g. \"0 9 * * 1-5\")","fontSize":11,"fontFamily":3,"textAlign":"left","strokeColor":"#868e96","opacity":100,"angle":0,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"seed":420}
