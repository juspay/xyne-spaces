    {"id":"ts3t","type":"text","x":665,"y":1075,"width":190,"height":100,"text":"agent.ts (LLM loop)\n──────────────\nSystem prompt + context\n+ user task\n\nLLM calls tools,\nproduces result + attachments","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e1e1e","opacity":100,"angle":0,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"containerId":"ts3","originalText":"agent.ts (LLM loop)\n──────────────\nSystem prompt + context\n+ user task\n\nLLM calls tools,\nproduces result + attachments","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"seed":310},

    {"id":"ts4","type":"text","x":900,"y":1060,"width":400,"height":130,"text":"meta = {\n  userId,      // who triggered\n  agentSlug,   // which agent\n  channelId,   // where to deliver\n  conversationId\n}\n\nTools like schedule-task read meta\nto know identity + delivery target.","fontSize":12,"fontFamily":3,"textAlign":"left","strokeColor":"#868e96","opacity":100,"angle":0,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"seed":311},

