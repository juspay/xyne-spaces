# Port the bot's HTTP API listens on.
PORT=3010
# Shared secret with the backend (backend: MEET_BOT_API_KEY). Required.
MEET_BOT_API_KEY=change-me

# Name shown in the Meet when joining as a guest. A signed-in bot shows its
# Google account's name instead, so name the account "Xyne Automatic".
BOT_NAME=Xyne Automatic

# SSO sign-in of the bot's Google account (see README.md, "Google sign-in (SSO)").
# The bot account, which has the Google SSO profile assigned to it alone:
SSO_EMAIL=
# Signing key and certificate: default sso/idp-key.pem and sso/idp-cert.pem, made by
# `pnpm --filter meet-bot sso:setup`. In production pass the PEMs (\n allowed) or
# paths to mounted secrets instead:
# SSO_PRIVATE_KEY=
# SSO_PRIVATE_KEY_FILE=
# SSO_CERTIFICATE=
# SSO_CERTIFICATE_FILE=
# Must match the Google SSO profile. The URL never has to exist: the bot answers it
# inside its own browser.
# SSO_SIGN_IN_URL=https://sso.xyne-automatic.internal/saml/sign-in
# SSO_ENTITY_ID=https://sso.xyne-automatic.internal/saml/sign-in
# Without SSO: join as an anonymous guest the host must admit (Google often refuses).
ALLOW_GUEST_JOIN=false

# Browser: real Google Chrome by default. Set CHROME_PATH to use a specific binary.
# BROWSER_CHANNEL=chrome
# CHROME_PATH=/usr/bin/google-chrome-stable
# Keep the meeting's audio out of the speakers (capture is unaffected).
MUTE_AUDIO=true

# Meetings at once; each is its own browser (~1 GB memory).
MAX_CONCURRENT_SESSIONS=4
WAITING_ROOM_TIMEOUT_SECONDS=600
ALONE_TIMEOUT_SECONDS=30
MAX_MEETING_MINUTES=240
