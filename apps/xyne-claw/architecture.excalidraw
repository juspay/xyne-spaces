      "version": 2,
      "versionNonce": 1860837514,
      "index": "av",
      "backgroundColor": "transparent",
      "frameId": null,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "src/\n├── main.ts              Express server, health check, graceful shutdown\n├── config.ts            SERVER, PATHS, LITELLM, AGENT env vars\n├── agent.ts             runTask(..., cwd?) — LLM agent loop + Digital Twin prompt\n├── custom-tools.ts      loadCustomTools(agentConfig, meta) → tools + attachments\n├── mcp.ts               loadMcpToolsForUser(userId) → proxy to auth service\n├── workspace.ts         createWorkspace / deleteWorkspace — per-session isolation\n├── store.ts             initStore() — create data directory\n├── lock.ts              File-based advisory locks (session JSONL safety)\n├── routes/\n│   └── run.ts           POST /run — workspace → process → cleanup\n├── middleware/\n│   └── auth.ts          validateS2SKey — X-S2S-Key header check\n└── types/\n    └── request.ts       JwtPayload, AuthenticatedRequest interfaces\n\ndata/workspaces/{sessionId}/   ← created per request, deleted after callback",
      "autoResize": true,
      "lineHeight": 1.3095238095238095
    },
