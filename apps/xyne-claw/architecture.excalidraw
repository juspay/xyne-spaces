    {
      "id": "tlnote",
      "type": "text",
      "x": 790,
      "y": 670,
      "width": 400,
      "height": 110,
      "text": "Config Resolution (custom-tools.ts):\n  1. agentConfig[key]  ← per-agent override\n  2. process.env[key]  ← env var\n  3. field.default     ← tool schema default\n\nMeta passed to tools:\n  { userId, agentSlug, channelId, conversationId }\n\nAttachments + pendingQuestions → in callback\n\nTool filtering:\n  pgm tools → pgm-agent only\n  schedule, ask-question → all agents",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#868e96",
      "opacity": 100,
      "angle": 0,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775043960017,
      "link": null,
      "locked": false,
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "seed": 213,
      "version": 2,
      "versionNonce": 2096539734,
      "index": "ai",
      "backgroundColor": "transparent",
      "frameId": null,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Config Resolution (custom-tools.ts):\n  1. agentConfig[key]  ← per-agent override\n  2. process.env[key]  ← env var\n  3. field.default     ← tool schema default\n\nMeta passed to tools:\n  { userId, agentSlug, channelId, conversationId }\n\nAttachments + pendingQuestions → in callback\n\nTool filtering:\n  pgm tools → pgm-agent only\n  schedule, ask-question → all agents",
      "autoResize": true,
      "lineHeight": 1.111111111111111
    },
