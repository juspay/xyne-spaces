XYNE_CLAW_PORT=3002
XYNE_CLAW_S2S_KEY=your-s2s-key
XYNE_CLAW_AUTH_URL=http://localhost:3003
XYNE_CLAW_DATA_DIR=./data
XYNE_CLAW_AGENT_DIR=
XYNE_CLAW_THINKING=medium

# PGM data repo (must be OUTSIDE the monorepo to avoid git conflicts)
XYNE_PGM_DATA_PATH=/path/to/pgm-data

# LiteLLM provider
LITELLM_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-api-key
LITELLM_MODEL=claude-sonnet-4-20250514

# Entity extraction — completions for claw-auth's entity-extraction pipeline,
# served from /internal/entity-llm/complete so LITELLM_API_KEY stays on claw.
ENTITY_EXTRACTION_MODEL=glm-latest
ENTITY_EXTRACTION_TIMEOUT_MS=300000

XYNE_WORKLOAD_DATA_PATH=/tmp/workload-data

# XOR (Juspay Grid /v1/systemone, model jev-latest) — agent-creation tool/skill/knowledge picks
# and the mode router. Unset or XOR_SUGGEST=off falls back to the LLM judge.
XOR_API_KEY=
# XOR_URL=https://grid.ai.juspay.net/v1/systemone
# XOR_MODEL=jev-latest
# XOR_SUGGEST=on
# XOR_TIMEOUT_MS=2500
# Total parallel XOR requests across claw and claw-auth (Grid key limit is 5). 0 disables the gate.
# XOR_MAX_PARALLEL=4
# Set AUTHORING_PREFLIGHT=off to skip the closed-set tool preflight for agent-authoring chats.
# AUTHORING_PREFLIGHT=on
# Per-run switch for XOR mode routing (review/learn/none); off falls back to the LLM router.
# XYNE_OPT_XOR_MODE_ROUTER=on
