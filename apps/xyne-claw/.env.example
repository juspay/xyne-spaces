XYNE_CLAW_PORT=3002
XYNE_CLAW_S2S_KEY=your-s2s-key
XYNE_CLAW_AUTH_URL=http://localhost:3003
# Required for SDLC runtime-grant redemption (authenticated clone/push).
SPACES_BACKEND_URL=http://localhost:3001
XYNE_CLAW_DATA_DIR=./data
XYNE_CLAW_AGENT_DIR=
XYNE_CLAW_THINKING=medium

# PGM data repo (must be OUTSIDE the monorepo to avoid git conflicts)
XYNE_PGM_DATA_PATH=/path/to/pgm-data

# LiteLLM provider
LITELLM_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-api-key
LITELLM_MODEL=claude-sonnet-4-20250514

# Entity extraction — completions for claw-auth's entity-extraction pipeline,
# served from /internal/entity-llm/complete so LITELLM_API_KEY stays on claw.
ENTITY_EXTRACTION_MODEL=glm-latest
ENTITY_EXTRACTION_TIMEOUT_MS=300000

XYNE_WORKLOAD_DATA_PATH=/tmp/workload-data
