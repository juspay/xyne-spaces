<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Electron/V8 require JIT + writable-executable memory to run. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- App captures audio/video for calls & meetings. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Intentionally NOT granting com.apple.security.cs.allow-dyld-environment-variables
	     or com.apple.security.cs.disable-library-validation — blocking DYLD_* injection and
	     enforcing library validation, together with the RunAsNode / NodeOptions / NodeCliInspect
	     fuses, is the hardening this enables (XYNE-17963 / secops #144). If the unpacked native
	     mic-monitor binary fails to load under hardened runtime because it is not co-signed with
	     the app identity, sign it with the same identity rather than adding disable-library-validation. -->
</dict>
</plist>
