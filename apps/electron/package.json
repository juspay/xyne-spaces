{
  "name": "xyne-spaces-electron",
  "version": "1.0.59",
  "description": "Xyne Spaces - Electron Desktop App (Thin Client)",
  "main": "dist/app/main.js",
  "scripts": {
    "dev": "tsc && cross-env NODE_ENV=development electron .",
    "dev:bundled": "tsc && cross-env NODE_ENV=development USE_BUNDLED_UI=true electron .",
    "dev:fresh": "pnpm run clear-ui-data && pnpm run dev:bundled",
    "dev:watch": "concurrently \"tsc -w\" \"cross-env NODE_ENV=development nodemon --watch dist --watch ../dashboard --exec electron .\"",
    "build:dashboard": "cross-env NODE_OPTIONS=--max-old-space-size=16384 pnpm --filter xyne-spaces-dashboard run build",
    "build:mic-monitor": "bash native/mic-monitor/build.sh",
    "build:mac": "pnpm run build:mic-monitor && tsc && electron-builder --config build.prod.json",
    "build:win": "tsc && electron-builder --config build.prod.json --win nsis --x64",
    "build:win:arm64": "tsc && electron-builder --config build.prod.json --win nsis --arm64",
    "build:sandbox:mac": "pnpm run build:mic-monitor && tsc && electron-builder --config build.sbx.json",
    "build:sandbox:win": "tsc && electron-builder --config build.sbx.json --win nsis --x64",
    "copy-ui": "rimraf ui-active && cpy \"../dashboard/dist/**\" ui-active",
    "clear-ui-data": "rimraf ~/Library/Application\\ Support/xyne-spaces-electron/ui-data/",
    "lint": "eslint 'src/**/*.{ts,tsx,js}'",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist release ui-active"
  },
  "keywords": [
    "electron",
    "desktop",
    "xyne-spaces"
  ],
  "author": {
    "name": "Xyne Team",
    "email": "engineering@xyne.com"
  },
  "homepage": "https://xyne.com",
  "license": "Apache-2.0",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.211.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-logs": "^0.211.0",
    "@opentelemetry/sdk-metrics": "^2.5.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@types/node": "^24.3.1",
    "archiver": "^7.0.0",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "extract-zip": "^2.0.1",
    "form-data": "^4.0.6",
    "node-fetch": "^2.7.0",
    "systeminformation": "^5.31.17",
    "tar": "^7.5.20",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@types/archiver": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/extract-zip": "^2.0.0",
    "@types/form-data": "^2.2.1",
    "@types/node-fetch": "^2.6.13",
    "@types/tar": "^6.1.13",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.1.1",
    "eslint": "^8.57.0",
    "express": "^4.21.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
