{
  "appId": "com.xyne.spaces.sandbox",
  "extraMetadata": {
    "APP_ENV": "sandbox"
  },
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "onlyLoadAppFromAsar": true,
    "enableEmbeddedAsarIntegrityValidation": true
  },
  "productName": "Xyne Spaces Sandbox",
  "directories": {
    "output": "release/sandbox"
  },
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "onlyLoadAppFromAsar": true,
    "enableEmbeddedAsarIntegrityValidation": true
  },
  "protocols": [
    {
      "name": "Xyne Spaces Sandbox",
      "schemes": [
        "xyne-spaces-sandbox"
      ]
    }
  ],
  "files": [
    "dist",
    "assets",
    "certs",
    "ui-active",
    "native/mic-monitor/mic-monitor"
  ],
  "asarUnpack": [
    "native/mic-monitor/mic-monitor",
    "**/node_modules/sherpa-onnx-*/**"
  ],
  "mac": {
    "icon": "assets/images/xyne.png",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "target": [
      {
        "target": "pkg",
        "arch": [
          "universal"
        ]
      }
    ],
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Xyne Spaces needs access to your microphone for audio calls and meetings",
      "NSCameraUsageDescription": "Xyne Spaces needs access to your camera for video calls and meetings",
      "NSScreenCaptureUsageDescription": "Xyne Spaces needs access to screen recording for screen sharing in meetings"
    }
  },
  "win": {
    "icon": "assets/images/xyne.png",
    "signExecutable": false
  },
  "linux": {
    "icon": "assets/images/xyne.png",
    "category": "Utility",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ]
  },
  "deb": {
    "depends": ["libnss3-tools"]
  }
}
