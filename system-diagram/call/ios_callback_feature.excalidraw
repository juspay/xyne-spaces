      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "76r3-o7VAL31jul4fTveX",
      "originalText": "1. Post to WebView START_CALL_FROM_RECENTS\n2. If XyneWeb not mounted yet buffer in pendingRecentsCall\n3. Flush when setEventHandlers called",
      "autoResize": true,
      "lineHeight": 1.25
