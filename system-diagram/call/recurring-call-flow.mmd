flowchart TD
    %% ══════════════════════════════════════════════════════
    %% 1. CREATE RECURRING SERIES
    %% ══════════════════════════════════════════════════════
    CreateStart([Organizer Creates Recurring Series]) --> ValidateSeries["Validate Input
    callValidator.ts
    RecurringScheduleCallSchema"]

    ValidateSeries --> FindCreateChannel["Find or Create Channel
    channelRepository.ts
    findOrCreateDMChannel"]

    FindCreateChannel --> DeriveEndsOn["Derive endsOn
    callController.ts
    deriveEndsOnFromRRule
    explicit > UNTIL > COUNT > null"]

    DeriveEndsOn --> GuardEndsOn{endsOn <= startsOn?}
    GuardEndsOn -->|Yes - endsOn already past| Reject400(["400 — RRULE produces
    no future occurrences"])
    GuardEndsOn -->|No| CreateSeriesRecord["Create RecurringCallSeries
    recurringCallService.ts
    Status: ACTIVE
    recurrenceRule, timezone
    startTime, endTime, startsOn, endsOn"]

    CreateSeriesRecord --> CreateFirst["Create All Instances for 60-day buffer
    recurringCallService.createInstancesForDateRange
    inclusive=false, notifyParticipants=true for first only"]

    CreateFirst --> InstanceFail{Instance creation failed?}
    InstanceFail -->|Yes| Rollback["Rollback — delete orphaned
    series record (transactional)"]
    Rollback --> Error500(["500 — Failed to create
    call instances"])
    InstanceFail -->|No| ReturnSeries(["200 — seriesId + channelId
    Buffer instances pre-created"])

    %% ══════════════════════════════════════════════════════
    %% 2. createNextInstance (shared by auto-chain)
    %% ══════════════════════════════════════════════════════
    ChainStart([createNextInstance called]) --> FetchSeries["Fetch RecurringCallSeries
    DB lookup by seriesId"]
    FetchSeries --> CheckActive{Series status ACTIVE?}
    CheckActive -->|No - ENDED or CANCELLED| SkipChain(["Skip — no new instance"])
    CheckActive -->|Yes| GetNextOccurrence["getNextOccurrence
    RRule.after(afterDate, inclusive)
    Check endsOn boundary"]
    GetNextOccurrence --> HasNext{Next occurrence exists?}
    HasNext -->|No| MarkEnded["Update series
    Status: ENDED"]
    MarkEnded --> NoInstance(["null — series complete"])
    HasNext -->|Yes| CalcEndsAt["Compute endsAt
    dateUtils.addHHMMDuration
    startTime → endTime diff
    Cross-midnight safe"]
    CalcEndsAt --> CreateInstance["createCallWithParticipants
    callRepository.ts
    Status: SCHEDULED
    isRecurring: true
    recurringSeriesId set"]
    CreateInstance --> ScheduleJobs["Schedule Bull Jobs
    Reminder: startsAt − 10 min
    Auto-End: at endsAt"]
    ScheduleJobs --> InstanceCreated(["New Call instance created
    Status: SCHEDULED"])

    %% ══════════════════════════════════════════════════════
    %% 3. AUTO-END JOB → CHECK PARTICIPANTS → REPLENISH
    %% ══════════════════════════════════════════════════════
    AutoEndFires([Auto-End Bull Job fires at endsAt]) --> CheckCallStatus{Call status?}
    CheckCallStatus -->|CANCELLED| LogSkip1["Log: call cancelled, skip"]
    CheckCallStatus -->|SCHEDULED| CheckParticipants{Active participants?
    findParticipantsWithStatus
    filter response = ACCEPTED}
    CheckCallStatus -->|OTHER| LogSkip2["Log: status is X, skip"]

    CheckParticipants -->|Yes ACCEPTED| SkipEnd["Skip auto-end
    Call still active"]
    CheckParticipants -->|No ACCEPTED| EndCall["UPDATE call
    Status: ENDED
    Soft update, no delete"]

    LogSkip1 --> CheckRecurring
    LogSkip2 --> CheckRecurring
    SkipEnd --> CheckRecurring{recurringSeriesId set?}
    EndCall --> CheckRecurring

    CheckRecurring -->|Yes| ReplenishBuffer["replenishInstanceBuffer
    Count future SCHEDULED instances
    Target: 60-day buffer
    Create missing instances if needed"]
    CheckRecurring -->|No| Done1(["Done — no series chain"])
    ReplenishBuffer --> GetTarget["Calculate target count
    getOccurrencesInRange(now, now+60d)"]
    GetTarget --> EnoughInstances{scheduledCount >= targetCount?}
    EnoughInstances -->|Yes| BufferFull(["Buffer full, skip creation"])
    EnoughInstances -->|No| FindLast["Find last SCHEDULED instance
    findLastScheduledInstance"]
    FindLast --> CreateMissing["Walk forward with getNextOccurrence
    Skip if instance exists at slot
    Create with notifyParticipants=false"]
    CreateMissing --> BufferDone(["Buffer replenished"])

    %% ══════════════════════════════════════════════════════
    %% 4. JOIN VIA OLD RECURRING LINK
    %% ══════════════════════════════════════════════════════
    OldLink([User joins via old recurring link]) --> LookupCall["Find call by externalId
    callRepository.findByExternalId"]
    LookupCall --> HasSeries{call.recurringSeriesId set?}
    HasSeries -->|No| NormalJoin(["Normal join flow"])
    HasSeries -->|Yes| FindActive["Find ACTIVE instance
    findActiveCallByRecurringSeriesId"]
    FindActive --> ActiveFound{Active instance found?}
    ActiveFound -->|Yes| RedirectActive["Redirect to active instance
    callId = activeSeriesCall.externalId"]
    ActiveFound -->|No| FindLatest["Find latest SCHEDULED instance
    findLatestCallByRecurringSeriesId"]
    FindLatest --> LatestFound{Latest instance found?}
    LatestFound -->|Yes| RedirectLatest["Redirect to latest scheduled instance
    callId = latestSeriesCall.externalId"]
    LatestFound -->|No| FallbackOriginal["Use original call
    (may be ended)"]
    RedirectActive --> ContinueJoin(["Continue join flow
    with resolved call"])
    RedirectLatest --> ContinueJoin
    FallbackOriginal --> ContinueJoin

    %% ══════════════════════════════════════════════════════
    %% 5. EDIT SINGLE CALL INSTANCE  (PATCH /calls/:callId)
    %% ══════════════════════════════════════════════════════
    EditInstance([Organizer edits single instance]) --> ValidateUpdate["Validate Input
    callValidator.ts
    UpdateScheduleCallSchema"]
    ValidateUpdate --> AuthCheck1{Organizer? + SCHEDULED?}
    AuthCheck1 -->|No| Reject403a(["403/400 — Forbidden or
    invalid status"])
    AuthCheck1 -->|Yes| ResolveChannel1["Resolve channel
    explicit channelId →
    find/create DM → keep existing"]
    ResolveChannel1 --> UpdateCallRepo["updateScheduledCall
    callRepository.ts
    title, startsAt, endsAt
    add/remove participants"]
    UpdateCallRepo --> RescheduleJobs["Reschedule Bull jobs
    new reminder + auto-end times"]
    RescheduleJobs --> NotifyUpdated1["Send CALL_UPDATED
    notifications to participants
    NotificationType.CALL_UPDATED"]
    NotifyUpdated1 --> EditDone1(["200 — instance updated"])

    %% ══════════════════════════════════════════════════════
    %% 6. EDIT ENTIRE SERIES  (PATCH /calls/series/:seriesId)
    %% ══════════════════════════════════════════════════════
    EditSeries([Organizer edits entire series]) --> ValidateSeries2["Validate Input
    callValidator.ts
    UpdateRecurringSeriesSchema"]
    ValidateSeries2 --> AuthCheck2{Organizer? + not CANCELLED?}
    AuthCheck2 -->|No| Reject403b(["403/400 — Forbidden"])
    AuthCheck2 -->|Yes| ResolveChannel2["Resolve channel
    explicit channelId →
    find/create DM → keep existing"]
    ResolveChannel2 --> DetectRegen{"Needs regeneration?
    recurrenceRule changed?"}
    DetectRegen -->|Yes — structural change| UpdateSeriesRecord["Update RecurringCallSeries record
    new rule, startTime, endTime
    endsOn, timezone, channelId"]
    DetectRegen -->|No — metadata only| UpdateSeriesRecord

    %% ── Regeneration path (soft delete) ──
    UpdateSeriesRecord --> RegenBranch{needsRegeneration?}
    RegenBranch -->|Yes| Regenerate["regenerateFutureInstances
    scheduledCallRepo.findScheduledInstances()
    Remove Bull jobs (all scheduled)
    Mark SCHEDULED → CANCELLED (soft delete)
    Participants NOT deleted
    Create new instances for 60-day buffer"]
    Regenerate --> RegenerateDone(["Series regenerated
    Old instances preserved as CANCELLED
    New instances created SCHEDULED"])

    %% ── Metadata cascade path (no regeneration) ──
    RegenBranch -->|No| FindScheduled["scheduledCallRepo.findScheduledInstances()
    Find all SCHEDULED instances
    (not just future ones)"]
    FindScheduled --> CascadeTitle["Cascade title/channelId
    call.updateMany
    No time change needed"]
    CascadeTitle --> TimeChanged{startTime/endTime changed?}
    TimeChanged -->|Yes| UpdateTimes["Update startsAt/endsAt in-place
    Preserve date, change time portion
    Reschedule Bull jobs per instance"]
    TimeChanged -->|No| CheckParticipants
    UpdateTimes --> CheckParticipants{targetUserIds provided?}
    CheckParticipants -->|Yes| UpdateParticip["Delta add/remove participants
    Per SCHEDULED instance
    Keep organizer always"]
    CheckParticipants -->|No| CascadeDone
    UpdateParticip --> SendNotify2
    CascadeTitle -->|No time change| CheckParticipants
    SendNotify2["Send CALL_UPDATED notifications
    to channel participants"]
    SendNotify2 --> CascadeDone(["200 — series updated
    Metadata cascaded to instances"])

    %% ══════════════════════════════════════════════════════
    %% 7. CANCEL SINGLE INSTANCE  (DELETE /calls/:callId)
    %% ══════════════════════════════════════════════════════
    CancelInstance([Organizer cancels single instance]) --> ValidateCancel1["Validate Input
    CancelScheduledCallSchema"]
    ValidateCancel1 --> AuthCheck3{Organizer? + SCHEDULED?}
    AuthCheck3 -->|No| Reject403c(["403/400 — Forbidden or
    invalid status"])
    AuthCheck3 -->|Yes| RemoveJobs1["Remove Bull jobs
    reminder + auto-end"]
    RemoveJobs1 --> MarkCancelled["UPDATE call
    Status: CANCELLED
    Soft update, no delete"]
    MarkCancelled --> CheckSeriesReplenish{recurringSeriesId?}
    CheckSeriesReplenish -->|Yes| ReplenishAfterCancel["replenishInstanceBuffer
    Maintain 60-day buffer count"]
    CheckSeriesReplenish -->|No| CancelDone1
    ReplenishAfterCancel --> CancelDone1(["200 — instance cancelled
    Record preserved"])

    %% ══════════════════════════════════════════════════════
    %% 8. CANCEL ENTIRE SERIES  (DELETE /calls/series/:seriesId)
    %% ══════════════════════════════════════════════════════
    CancelSeries([Organizer cancels entire series]) --> ValidateCancel2["Validate Input
    CancelRecurringSeriesSchema"]
    ValidateCancel2 --> AuthCheck4{Organizer? + not CANCELLED?}
    AuthCheck4 -->|No| Reject403d(["403/400 — Forbidden or
    already cancelled"])
    AuthCheck4 -->|Yes| CancelSeriesSvc["cancelSeries
    recurringCallService.ts"]
    CancelSeriesSvc --> FindFutureSched["scheduledCallRepo.findFutureScheduledCallIds()
    Get future SCHEDULED instance IDs
    startsAt > now"]
    FindFutureSched --> RemoveJobs2["Remove Bull jobs
    From each future instance"]
    RemoveJobs2 --> MarkFutureCancelled["UPDATE calls
    Status: CANCELLED
    Only future SCHEDULED affected
    Past/present instances preserved"]
    MarkFutureCancelled --> MarkSeriesCancelled["UPDATE series
    Status: CANCELLED"]
    MarkSeriesCancelled --> CancelDone2(["200 — series cancelled
    {cancelledCalls} instances marked
    Records preserved"])

    %% ══════════════════════════════════════════════════════
    %% 9. DELETE SERIES (admin) — SOFT DELETE
    %% ══════════════════════════════════════════════════════
    DeleteSeriesAdmin([Admin deletes entire series]) --> GetAllInstances["Find ALL instances
    (regardless of status)"]
    GetAllInstances --> RemoveAllJobs["Remove ALL Bull jobs"]
    RemoveAllJobs --> MarkAllScheduledCancelled["UPDATE calls
    Only SCHEDULED → CANCELLED
    COMPLETED/HANGUP preserved
    No hard delete"]
    MarkAllScheduledCancelled --> MarkSeriesCancelledAdmin["UPDATE series
    Status: CANCELLED"]
    MarkSeriesCancelledAdmin --> AdminDone(["Series soft-deleted
    All call records preserved"])

    classDef node fill:#ffffff,stroke:#333,stroke-width:2px
    classDef success fill:#d4edda,stroke:#28a745,stroke-width:2px
    classDef reject fill:#f8d7da,stroke:#dc3545,stroke-width:2px
    classDef done fill:#d1ecf1,stroke:#0c5460,stroke-width:2px
    class Success1,Success2,Success3,Success4,Success5 success
    class Reject400,Reject403a,Reject403b,Reject403c,Reject403d reject
    class Done1,Done1b,BufferFull,BufferDone,RegenerateDone,CascadeDone,CancelDone1,CancelDone2,AdminDone,Done success