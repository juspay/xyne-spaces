    classDef agent fill:#f3e8ff,stroke:#7c3aed,stroke-width:2px
    classDef done fill:#d4edda,stroke:#28a745,stroke-width:2px
    classDef reject fill:#f8d7da,stroke:#dc3545,stroke-width:2px

    class DB1,DB3,DB4,GCS db
    class B1,B3,B4,B5 service
    class AG1,AG2,AG3,ID1,ID2,ID3,ID4,ID5,TS0,TS1,TS2 agent
    class VIEW1,VIEW2,Z1,Z3 done
