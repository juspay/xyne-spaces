{
  "name": "xyne-spaces-electron",
  "version": "1.0.22",
  "description": "Xyne Spaces - Electron Desktop App (Thin Client)",
  "main": "dist/app/main.js",
  "scripts": {
    "dev": "tsc && NODE_ENV=development electron .",
    "dev:bundled": "tsc && NODE_ENV=development USE_BUNDLED_UI=true electron .",
    "dev:fresh": "npm run clear-ui-data && npm run dev:bundled",
    "dev:watch": "concurrently \"tsc -w\" \"NODE_ENV=development nodemon --watch dist --watch ../dashboard --exec electron .\"",
    "prebuild": "cd ../dashboard && NODE_OPTIONS=\"--max-old-space-size=16384\" npm run build",
    "build": "tsc && npm run copy-ui && electron-builder",
    "copy-ui": "rm -rf ui-active && cp -r ../dashboard/dist ui-active",
    "clear-ui-data": "rm -rf ~/Library/Application\\ Support/xyne-spaces-electron/ui-data/",
    "test-release-server": "npx ts-node scripts/test-release-server.ts",
    "test-release-server:publish": "npx ts-node scripts/test-release-server.ts --publish",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist release ui-active"
  },
  "keywords": [
    "electron",
    "desktop",
    "xyne-spaces"
  ],
  "author": "Xyne Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.211.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-logs": "^0.211.0",
    "@opentelemetry/sdk-metrics": "^2.5.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@types/node": "^24.3.1",
    "archiver": "^7.0.0",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "extract-zip": "^2.0.1",
    "form-data": "^4.0.5",
    "node-fetch": "^2.7.0",
    "systeminformation": "^5.30.6",
    "tar": "^7.5.2",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/extract-zip": "^2.0.0",
    "@types/form-data": "^2.2.1",
    "@types/node-fetch": "^2.6.13",
    "@types/tar": "^6.1.13",
    "concurrently": "^9.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^26.1.1",
    "express": "^4.21.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "build": {
    "appId": "com.xyne.spaces",
    "productName": "Xyne Spaces",
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "Xyne Spaces",
        "schemes": [
          "xyne-spaces"
        ]
      }
    ],
    "files": [
      "dist",
      "assets",
      "certs",
      "ui-active"
    ],
    "mac": {
      "icon": "assets/images/xyne.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "default",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Xyne Spaces needs access to your microphone for audio calls and meetings",
        "NSCameraUsageDescription": "Xyne Spaces needs access to your camera for video calls and meetings",
        "NSScreenCaptureUsageDescription": "Xyne Spaces needs access to screen recording for screen sharing in meetings"
      }
    },
    "win": {
      "icon": "assets/images/xyne.png"
    },
    "linux": {
      "icon": "assets/images/xyne.png",
      "category": "Utility"
    }
  }
}
