{
  "name": "xyne-spaces-electron",
  "version": "1.0.51",
  "description": "Xyne Spaces - Electron Desktop App (Thin Client)",
  "main": "dist/app/main.js",
  "scripts": {
    "dev": "tsc && cross-env NODE_ENV=development electron .",
    "dev:bundled": "tsc && cross-env NODE_ENV=development USE_BUNDLED_UI=true electron .",
    "dev:fresh": "npm run clear-ui-data && npm run dev:bundled",
    "dev:watch": "concurrently \"tsc -w\" \"cross-env NODE_ENV=development nodemon --watch dist --watch ../dashboard --exec electron .\"",
    "build:dashboard": "cd ../dashboard && cross-env NODE_OPTIONS=--max-old-space-size=16384 npm run build",
    "build:mic-monitor": "bash native/mic-monitor/build.sh",
    "build": "npm run build:mic-monitor && tsc && electron-builder --config build.prod.json",
    "build:sandbox": "npm run build:mic-monitor && tsc && electron-builder --config build.sbx.json",
    "copy-ui": "rimraf ui-active && cpy \"../dashboard/dist/**\" ui-active",
    "clear-ui-data": "rimraf ~/Library/Application\\ Support/xyne-spaces-electron/ui-data/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist release ui-active"
  },
  "keywords": [
    "electron",
    "desktop",
    "xyne-spaces"
  ],
  "author": {
    "name": "Xyne Team",
    "email": "engineering@xyne.com"
  },
  "homepage": "https://xyne.com",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.211.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-logs": "^0.211.0",
    "@opentelemetry/sdk-metrics": "^2.5.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@types/node": "^24.3.1",
    "archiver": "^7.0.0",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "extract-zip": "^2.0.1",
    "form-data": "^4.0.6",
    "node-fetch": "^2.7.0",
    "systeminformation": "^5.31.17",
    "tar": "^7.5.20",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/extract-zip": "^2.0.0",
    "@types/form-data": "^2.2.1",
    "@types/node-fetch": "^2.6.13",
    "@types/tar": "^6.1.13",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "electron": "^33.3.1",
    "electron-builder": "^26.1.1",
    "express": "^4.21.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "protobufjs@7": "7.6.5",
    "protobufjs@8": "8.7.1",
    "lodash": "4.18.1",
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "minimatch@9": "9.0.9",
    "minimatch@10": "10.2.5",
    "fast-uri@3": "3.1.4",
    "fastify@5": "5.10.0",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "js-yaml@3": "3.15.0",
    "js-yaml@4": "4.3.0",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.5",
    "shell-quote": "1.10.0",
    "path-to-regexp@8": "8.4.2",
    "@opentelemetry/core@2": "2.8.0"
  }
}
