# syntax=docker/dockerfile:1
FROM mirror.gcr.io/library/node:22.22.3-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# --- shared: deps then source ---
COPY shared/package*.json ../shared/
RUN --mount=type=cache,target=/root/.npm cd ../shared && npm ci --ignore-scripts
COPY shared ../shared
RUN cd ../shared && npm run build

# --- icons: deps then source ---
COPY icons/package*.json ../icons/
RUN --mount=type=cache,target=/root/.npm cd ../icons && npm ci --ignore-scripts
COPY icons ../icons
RUN cd ../icons && npm run build

# --- dashboard: deps then source ---
COPY dashboard/package*.json ./
# The test image already builds ../shared above. Remove only the dashboard's
# workspace lifecycle hooks from the copied manifest so npm still runs package
# install scripts (for native/binary dependencies) without rebuilding shared or
# attempting to install Husky inside an image that has no .git directory.
RUN --mount=type=cache,target=/root/.npm \
    npm pkg delete scripts.postinstall scripts.prepare \
    && npm ci
COPY dashboard .

COPY package.json /package.json

# Seed .env from the tracked, non-secret dashboard/.env.test (Vite loads .env by default).
# .env.test is committed (test config only) and is the single source of truth for the
# test image. docker-compose.test.yml also layers it at runtime.
COPY dashboard/.env.test .env

# Compile the dashboard while building the image instead of making the first
# Playwright navigation cold-transform the entire Vite module graph. This layer
# remains cached for automation-only changes, and preview serves only after the
# complete test bundle is available.
RUN NODE_OPTIONS=--max-old-space-size=8192 ./node_modules/.bin/vite build --mode test

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5173"]
