  "description": "Xyne Spaces - Workflow Automation Dashboard",
  "scripts": {
    "postinstall": "cd ../shared && npm install && npm run build",
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:errors-only": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --project tsconfig.app.json --pretty",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "rm -rf dist build coverage",
    "validate": "npm run typecheck && (npm run format:check || (npm run format && exit 1)) && npm run lint",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "typescript",
    "workflow",
    "automation",
    "dashboard"
  ],
